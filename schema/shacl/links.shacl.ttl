    sh:select "SELECT ?this ?value WHERE { ?this a <https://kerfors.github.io/cdisc-for-all/def/sdtmig#SDTMIG> . ?this <https://kerfors.github.io/cdisc-for-all/def/sdtmig/SDTMIG#CDISC%20CT%20Codelist%20Code%28s%29> ?value . OPTIONAL { ?this <https://kerfors.github.io/cdisc-for-all/link/sdtmig/SDTMIG#CDISC%20CT%20Codelist%20Code%28s%29> ?t } } GROUP BY ?this ?value HAVING (COUNT(DISTINCT ?t) < (STRLEN(?value) - STRLEN(REPLACE(?value, \";\", \"\", \"q\"))) / STRLEN(\";\") + 1)" ;
.

<https://kerfors.github.io/cdisc-for-all/shape/sdtmig%20variable%20to%20model%20variable-sparql>
    a sh:SPARQLConstraint ;
    sh:message "sdtmig variable to model variable: no by rule link for the value" ;
    sh:select "SELECT $this ?value WHERE { $this <https://kerfors.github.io/cdisc-for-all/def/sdtmig/SDTMIG#Variable%20Name> ?value . FILTER NOT EXISTS { $this <https://kerfors.github.io/cdisc-for-all/rule/sdtmig/SDTMIG#Variable%20Name/sdtm-model/SDTM> ?t } }" ;
.

<https://kerfors.github.io/cdisc-for-all/shape/sdtmig%20variable%20to%20model%20variable-target>
    a sh:SPARQLTarget ;
    sh:select "SELECT ?this ?value WHERE { ?this a <https://kerfors.github.io/cdisc-for-all/def/sdtmig#SDTMIG> . ?this <https://kerfors.github.io/cdisc-for-all/def/sdtmig/SDTMIG#Variable%20Name> ?value . FILTER NOT EXISTS { ?this <https://kerfors.github.io/cdisc-for-all/rule/sdtmig/SDTMIG#Variable%20Name/sdtm-model/SDTM> ?t } }" ;
.
