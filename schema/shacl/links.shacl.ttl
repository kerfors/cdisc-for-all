<https://kerfors.github.io/cdisc-for-all/shape/cosmos%20biomedical%20concept%20to%20NCIt-sparql>
    a sh:SPARQLConstraint ;
    sh:message "cosmos biomedical concept to NCIt: no published key link for the value" ;
    sh:select "SELECT $this ?value WHERE { $this <https://kerfors.github.io/cdisc-for-all/def/cosmos/cdisc_biomedical_concepts_latest#ncit_code> ?value . FILTER NOT EXISTS { $this <https://kerfors.github.io/cdisc-for-all/link/cosmos/cdisc_biomedical_concepts_latest#ncit_code> ?t } }" ;
.

<https://kerfors.github.io/cdisc-for-all/shape/cosmos%20biomedical%20concept%20to%20NCIt-target>
    a sh:SPARQLTarget ;
    sh:select "SELECT ?this ?value WHERE { ?this a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_latest> . ?this <https://kerfors.github.io/cdisc-for-all/def/cosmos/cdisc_biomedical_concepts_latest#ncit_code> ?value . FILTER NOT EXISTS { ?this <https://kerfors.github.io/cdisc-for-all/link/cosmos/cdisc_biomedical_concepts_latest#ncit_code> ?t } }" ;
