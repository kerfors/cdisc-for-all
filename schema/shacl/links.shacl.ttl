<https://kerfors.github.io/cdisc-for-all/shape/ncit%20concept%20to%20parent-sparql>
    a sh:SPARQLConstraint ;
    sh:message "ncit concept to parent: no published key link for the value" ;
    sh:select "SELECT $this ?value WHERE { $this <https://kerfors.github.io/cdisc-for-all/def/ncit-flat/Thesaurus#parents> ?value . OPTIONAL { $this <https://kerfors.github.io/cdisc-for-all/link/ncit-flat/Thesaurus#parents> ?t } } GROUP BY $this ?value HAVING (COUNT(DISTINCT ?t) < (STRLEN(?value) - STRLEN(REPLACE(?value, \"|\", \"\", \"q\"))) / STRLEN(\"|\") + 1)" ;
.

