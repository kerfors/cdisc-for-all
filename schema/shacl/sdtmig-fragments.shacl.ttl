<https://kerfors.github.io/cdisc-for-all/def/sdtmig-fragments#CDISC%20Variable-naming%20Fragments> a sh:NodeShape ;
	sh:closed true ;
	sh:ignoredProperties _:c14n2 ;
	sh:property _:c14n0 , _:c14n1 ;
	sh:targetClass <https://kerfors.github.io/cdisc-for-all/def/sdtmig-fragments#CDISC%20Variable-naming%20Fragments> .
_:c14n0 sh:datatype xsd:string ;
	sh:maxCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 1 ;
	sh:path <https://kerfors.github.io/cdisc-for-all/def/sdtmig-fragments/CDISC%20Variable-naming%20Fragments#Fragment> .
_:c14n1 sh:datatype xsd:string ;
