<https://kerfors.github.io/cdisc-for-all/rule/cosmos/cdisc_sdtm_dataset_specializations_latest#object/cosmos/cdisc_sdtm_dataset_specializations_latest>
    a rdf:Property ;
    rdfs:label "cosmos relationship object" ;
    dcterms:type "by rule" ;
    rdfs:comment
        "A Dataset Specialization variable row to the variable row named in its object, in the same Dataset Specialization." ,
        "Rule: object equals the sdtm_variable of a row with the same domain and vlm_group_id." ;
    rdfs:domain def_cosmos:cdisc_sdtm_dataset_specializations_latest ;
    rdfs:isDefinedBy <https://kerfors.github.io/cdisc-for-all/def/links> ;
    rdfs:range def_cosmos:cdisc_sdtm_dataset_specializations_latest ;
.

<https://kerfors.github.io/cdisc-for-all/rule/cosmos/cdisc_sdtm_dataset_specializations_latest#sdtm_variable/nsv-registry/Approved%20NSVs-alpha>
    a rdf:Property ;
    rdfs:label "cosmos dataset specialization to nsv" ;
    dcterms:type "by rule" ;
    rdfs:comment
        "A Dataset Specialization variable row that is neither an SDTMIG nor an SDTM Model variable, to the NSV Registry rows of its name without the domain prefix." ,
        "Rule: Only where the row has no link to an SDTMIG or an SDTM Model variable. sdtm_variable with the domain prefix removed (only if it starts with the domain) equals the registry Variable Name as published (no trimming). Every matching registry row is linked (the registry key is Variable Name + Source(s))." ;
    rdfs:domain def_cosmos:cdisc_sdtm_dataset_specializations_latest ;
    rdfs:isDefinedBy <https://kerfors.github.io/cdisc-for-all/def/links> ;
    rdfs:range def_nsv_registry:Approved%20NSVs-alpha ;
.

<https://kerfors.github.io/cdisc-for-all/rule/cosmos/cdisc_sdtm_dataset_specializations_latest#sdtm_variable/sdtm-model/SDTM>
    a rdf:Property ;
    rdfs:label "cosmos dataset specialization to model variable" ;
    dcterms:type "by rule" ;
    rdfs:comment
        "A Dataset Specialization variable row that is not an SDTMIG variable of its domain, to an SDTM Model variable row." ,
        "Rule: Only where the row has no link to an SDTMIG variable. The class of the domain is the Class the SDTMIG table gives for that Dataset Name; with it, the rule of \"sdtmig variable to model variable\" (domain as Dataset Name, sdtm_variable as Variable Name). A domain that is not an SDTMIG dataset has no class: only Class General Observations is tried." ;
    rdfs:domain def_cosmos:cdisc_sdtm_dataset_specializations_latest ;
    rdfs:isDefinedBy <https://kerfors.github.io/cdisc-for-all/def/links> ;
    rdfs:range def_sdtm_model:SDTM ;
.

<https://kerfors.github.io/cdisc-for-all/rule/cosmos/cdisc_sdtm_dataset_specializations_latest#sdtm_variable/sdtmig/SDTMIG>
    a rdf:Property ;
    rdfs:label "cosmos dataset specialization to sdtmig variable" ;
    dcterms:type "by rule" ;
    rdfs:comment
        "A Dataset Specialization variable row to the SDTMIG variable row of the same name in its own domain." ,
        "Rule: domain equals the SDTMIG Dataset Name and sdtm_variable equals the SDTMIG Variable Name." ;
    rdfs:domain def_cosmos:cdisc_sdtm_dataset_specializations_latest ;
    rdfs:isDefinedBy <https://kerfors.github.io/cdisc-for-all/def/links> ;
    rdfs:range def_sdtmig:SDTMIG ;
.

<https://kerfors.github.io/cdisc-for-all/rule/cosmos/cdisc_sdtm_dataset_specializations_latest#subject/cosmos/cdisc_sdtm_dataset_specializations_latest>
    a rdf:Property ;
    rdfs:label "cosmos relationship subject" ;
    dcterms:type "by rule" ;
    rdfs:comment
        "A Dataset Specialization variable row to the variable row named in its subject, in the same Dataset Specialization." ,
        "Rule: subject equals the sdtm_variable of a row with the same domain and vlm_group_id." ;
    rdfs:domain def_cosmos:cdisc_sdtm_dataset_specializations_latest ;
    rdfs:isDefinedBy <https://kerfors.github.io/cdisc-for-all/def/links> ;
    rdfs:range def_cosmos:cdisc_sdtm_dataset_specializations_latest ;
.

<https://kerfors.github.io/cdisc-for-all/rule/cosmos/cdisc_sdtm_dataset_specializations_latest#value_list/sdtm-ct/SDTM%20Terminology>
    a rdf:Property ;
    rdfs:label "cosmos value list to term" ;
    dcterms:type "by rule" ;
    rdfs:comment
        "A Dataset Specialization variable row to the SDTM CT term row of each value in its value_list, within its codelist." ,
        "Rule: Only where the row has a codelist. Each value of value_list (split at \";\") equals the CDISC Submission Value of a term row of that codelist." ;
    rdfs:domain def_cosmos:cdisc_sdtm_dataset_specializations_latest ;
    rdfs:isDefinedBy <https://kerfors.github.io/cdisc-for-all/def/links> ;
    rdfs:range def_sdtm_ct:SDTM%20Terminology ;
.

<https://kerfors.github.io/cdisc-for-all/rule/sdtm-model/SDTM#Variables%20Qualified/sdtm-model/SDTM>
    a rdf:Property ;
    rdfs:label "sdtm-model variables qualified" ;
    dcterms:type "by rule" ;
    rdfs:comment
        "An SDTM Model variable row to each Model variable named in its Variables Qualified, in the same class and dataset." ,
        "Rule: Each name in Variables Qualified (split at \";\", surrounding spaces removed) equals the Variable Name of a Model row with the same Class and the same Dataset Name (both empty for a variable the Model publishes for a class)." ;
    rdfs:domain def_sdtm_model:SDTM ;
    rdfs:isDefinedBy <https://kerfors.github.io/cdisc-for-all/def/links> ;
    rdfs:range def_sdtm_model:SDTM ;
.

<https://kerfors.github.io/cdisc-for-all/rule/sdtmig/SDTMIG#Variable%20Name/sdtm-model/SDTM>
    a rdf:Property ;
    rdfs:label "sdtmig variable to model variable" ;
    dcterms:type "by rule" ;
    rdfs:comment
        "An SDTMIG variable row to the SDTM Model variable row it is an instance of." ,
        "Rule: The first that matches: the Model row with the same Class, Dataset Name and Variable Name; else the Model row without a Dataset Name, with the same Class, whose Variable Name is the general name (the IG Variable Name with its Dataset Name prefix replaced by \"--\", or the Variable Name itself if it does not start with the Dataset Name); else the same for Class General Observations; for Class Findings About, else the same for Class Findings." ;
    rdfs:domain def_sdtmig:SDTMIG ;
    rdfs:isDefinedBy <https://kerfors.github.io/cdisc-for-all/def/links> ;
    rdfs:range def_sdtm_model:SDTM ;
.
