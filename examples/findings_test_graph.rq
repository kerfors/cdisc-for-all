# The graph of one Findings test: start from an SDTM CT test code term and return every
# row and model node reached from it by the links of cdisc-for-all, with all their triples.
#
# Run over the union of the base graphs (base/<source>/<source>.ttl), the link graphs
# (linked/links.ttl, linked/by-rule.ttl, and the local -signin files if present) and the
# COSMoS model graph (linked/cosmos-model.ttl). Without the -signin files the SDTMIG and
# SDTM Model rows are not reached.
#
# Parameter: the codelist code and the CDISC Submission Value of the test code term,
# set in the VALUES line. Example: Laboratory Test Code (C65047), GLUC.
#
# Steps:
# 1. the term: the SDTM CT row with that Codelist Code and CDISC Submission Value;
# 2. the start nodes: the term, and every COSMoS SDTMGroup (Dataset Specialization) that
#    has a variable whose assigned term is that term;
# 3. the nodes: everything reached from a start node by any number of the links below
#    (every link of schema/links.yaml, and the COSMoS model properties that point to a
#    node), plus the NCI code-CUI map rows of every NCIt concept reached;
# 4. the result: every triple whose subject is one of the nodes. Nothing is added.

CONSTRUCT { ?n ?p ?o }
WHERE {
    VALUES (?codelist_code ?submission_value) { ("C65047" "GLUC") }

    # 1. the term
    ?term <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct/SDTM%20Terminology#Codelist%20Code> ?codelist_code ;
          <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct/SDTM%20Terminology#CDISC%20Submission%20Value> ?submission_value .

    # 2. the start nodes: the term itself (zero steps), or an SDTMGroup with a variable
    #    whose assigned term is the term
    ?start (<https://www.cdisc.org/cosmos/sdtm_v1.0/variables>/<https://kerfors.github.io/cdisc-for-all/link/cosmos/cdisc_sdtm_dataset_specializations_latest#assigned_term>)? ?term .

    # 3. the nodes
    ?start (
        # link: sdtm-ct term to codelist (published key)
        <https://kerfors.github.io/cdisc-for-all/link/sdtm-ct/SDTM%20Terminology#Codelist%20Code> |
        # link: sdtm-ct to NCIt (published key)
        <https://kerfors.github.io/cdisc-for-all/link/sdtm-ct/SDTM%20Terminology#Code> |
        # link: cosmos dataset specialization to codelist (published key)
        <https://kerfors.github.io/cdisc-for-all/link/cosmos/cdisc_sdtm_dataset_specializations_latest#codelist> |
        # link: cosmos dataset specialization to assigned term (published key)
        <https://kerfors.github.io/cdisc-for-all/link/cosmos/cdisc_sdtm_dataset_specializations_latest#assigned_term> |
        # link: cosmos dataset specialization to biomedical concept (published key)
        <https://kerfors.github.io/cdisc-for-all/link/cosmos/cdisc_sdtm_dataset_specializations_latest#bc_id> |
        # link: cosmos dataset specialization to data element concept (published key)
        <https://kerfors.github.io/cdisc-for-all/link/cosmos/cdisc_sdtm_dataset_specializations_latest#dec_id> |
        # link: cosmos biomedical concept to NCIt (published key)
        <https://kerfors.github.io/cdisc-for-all/link/cosmos/cdisc_biomedical_concepts_latest#ncit_code> |
        # link: cosmos data element concept to NCIt (published key)
        <https://kerfors.github.io/cdisc-for-all/link/cosmos/cdisc_biomedical_concepts_latest#ncit_dec_code> |
        # link: cosmos biomedical concept to parent (published key)
        <https://kerfors.github.io/cdisc-for-all/link/cosmos/cdisc_biomedical_concepts_latest#parent_bc_id> |
        # link: cosmos hierarchy to parent (published key)
        <https://kerfors.github.io/cdisc-for-all/link/cosmos/cdisc_biomedical_concepts_hierarchy_latest#parent_bc_id> |
        # link: sdtmig variable to codelist (published key)
        <https://kerfors.github.io/cdisc-for-all/link/sdtmig/SDTMIG#CDISC%20CT%20Codelist%20Code%28s%29> |
        # link: sdtm-model variable to NCIt (published key)
        <https://kerfors.github.io/cdisc-for-all/link/sdtm-model/SDTM#Variable%20C-Code> |
        # link: ncit concept to parent (published key)
        <https://kerfors.github.io/cdisc-for-all/link/ncit-flat/Thesaurus#parents> |
        # link: nci code-cui map to NCIt (published key)
        <https://kerfors.github.io/cdisc-for-all/link/nci-code-cui-map/nci_code_cui_map#code> |
        # link: sdtmig variable to model variable (by rule)
        <https://kerfors.github.io/cdisc-for-all/rule/sdtmig/SDTMIG#Variable%20Name/sdtm-model/SDTM> |
        # link: cosmos dataset specialization to sdtmig variable (by rule)
        <https://kerfors.github.io/cdisc-for-all/rule/cosmos/cdisc_sdtm_dataset_specializations_latest#sdtm_variable/sdtmig/SDTMIG> |
        # link: cosmos dataset specialization to model variable (by rule)
        <https://kerfors.github.io/cdisc-for-all/rule/cosmos/cdisc_sdtm_dataset_specializations_latest#sdtm_variable/sdtm-model/SDTM> |
        # link: cosmos dataset specialization to nsv (by rule)
        <https://kerfors.github.io/cdisc-for-all/rule/cosmos/cdisc_sdtm_dataset_specializations_latest#sdtm_variable/nsv-registry/Approved%20NSVs-alpha> |
        # link: cosmos value list to term (by rule)
        <https://kerfors.github.io/cdisc-for-all/rule/cosmos/cdisc_sdtm_dataset_specializations_latest#value_list/sdtm-ct/SDTM%20Terminology> |
        # link: sdtm-model variables qualified (by rule)
        <https://kerfors.github.io/cdisc-for-all/rule/sdtm-model/SDTM#Variables%20Qualified/sdtm-model/SDTM> |
        # link: cosmos relationship subject (by rule)
        <https://kerfors.github.io/cdisc-for-all/rule/cosmos/cdisc_sdtm_dataset_specializations_latest#subject/cosmos/cdisc_sdtm_dataset_specializations_latest> |
        # link: cosmos relationship object (by rule)
        <https://kerfors.github.io/cdisc-for-all/rule/cosmos/cdisc_sdtm_dataset_specializations_latest#object/cosmos/cdisc_sdtm_dataset_specializations_latest> |
        # COSMoS model: SDTMGroup to its SDTMVariables
        <https://www.cdisc.org/cosmos/sdtm_v1.0/variables> |
        # COSMoS model: SDTMVariable to its CodeList
        <https://www.cdisc.org/cosmos/sdtm_v1.0/codelist> |
        # COSMoS model: SDTMVariable to its AssignedTerm
        <https://www.cdisc.org/cosmos/sdtm_v1.0/assignedTerm> |
        # COSMoS model: SDTMVariable to its RelationShip
        <https://www.cdisc.org/cosmos/sdtm_v1.0/relationship> |
        # COSMoS model: BiomedicalConcept to its DataElementConcepts
        <https://www.cdisc.org/cosmos/biomedical_concept_v1.0dataElementConcepts> |
        # COSMoS model: BiomedicalConcept to its Coding
        <https://www.cdisc.org/cosmos/biomedical_concept_v1.0coding>
    )* ?reached .
    # the node itself (zero steps), or a code-CUI map row of it
    ?n <https://kerfors.github.io/cdisc-for-all/link/nci-code-cui-map/nci_code_cui_map#code>? ?reached .

    # 4. the result
    ?n ?p ?o .
}
