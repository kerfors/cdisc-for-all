    ct:CDISC%20Definition "An analytical technique where high performance liquid chromatography with an electrochemical detector is used to separate, identify, and quantify substances in a sample." ;
    ct:CDISC%20Submission%20Value "HPLC-EC" ;
    ct:CDISC%20Synonym%28s%29 "High-Performance Liquid Chromatography with Electrochemical Detection; HPLC-ECD; HPLC-ED" ;
