.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C92234>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which the ventricular rhythm is controlled by an electrical impulse from an artificial cardiac pacemaker." ;
    ct:CDISC%20Submission%20Value "PACED VENTRICULAR RHYTHM" ;
    ct:CDISC%20Synonym%28s%29 "Paced Ventricular Rhythm; Ventricular-paced complex(es) or rhythm" ;
    ct:Code "C92234" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Paced Ventricular Rhythm" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C92235>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which there is evidence that electrical transmission through the right ventricle is impaired." ;
    ct:CDISC%20Submission%20Value "RIGHT VENTRICULAR CONDUCTION DELAY" ;
    ct:CDISC%20Synonym%28s%29 "Right Ventricular Conduction Delay; Right Ventricular Delay" ;
    ct:Code "C92235" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Right Ventricular Conduction Delay by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C116139>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby the precordial leads are intentionally placed on the right side of the chest." ;
    ct:CDISC%20Submission%20Value "12 LEAD RIGHT-SIDED PRECORDIAL LEADS" ;
    ct:CDISC%20Synonym%28s%29 "12 Lead Right-sided Precordial Leads; Right-sided Chest Leads" ;
    ct:Code "C116139" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead Placement Right-sided Precordial Leads" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C123444>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A continuous electrocardiographic (ECG) recording utilizing 12 leads. The positioning of the electrodes may vary from the standard 12 lead ECG placement. Examples include but are not limited to 12 lead Holter with modified Mason-Likar lead placements, 12 lead exercise ECGs, and 12 lead telemetry systems." ;
    ct:CDISC%20Submission%20Value "12 LEAD CONTINUOUS ECG" ;
    ct:Code "C123444" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead Continuous ECG" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C123445>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A standard duration (typically 10 seconds) 12 lead electrocardiogram (ECG) extracted from a 12 lead continuous ECG." ;
    ct:CDISC%20Submission%20Value "12 LEAD ECG EXTRACTED FROM 12 LEAD CONTINUOUS ECG RECORDING" ;
    ct:Code "C123445" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead ECG Extracted From 12 Lead Continuous ECG Recording" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C123446>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A continuous electrocardiographic (ECG) recording utilizing 1 or more leads that records and stores data directly to the device. The subject need not be restricted to a medical facility, and may be able to participate in their customary activities of daily living." ;
    ct:CDISC%20Submission%20Value "CONTINUOUS AMBULATORY ECG" ;
    ct:Code "C123446" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "Continuous Ambulatory ECG" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C132355>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead configuration that is primarily used to record ECGs in non-human animals, and which uses six (6) electrodes to generate eight (8) ECG leads (ECG wave forms). The six electrode configuration includes the following: four (4) limb electrodes, which are placed analogous to an Einthoven configuration in humans, and two (2) chest electrodes. The eight (8) ECG leads recorded comprise three standard limb leads (leads I, II, and III), three augmented leads (Leads aVR, aVF, and aVL), and two chest leads, which are generated using two unipolar chest leads, typically CV5RL [rV2] and CV6LL [V2] for canines, or MV1 and MV2 for primates." ;
    ct:CDISC%20Submission%20Value "6 LEAD NEHB-SPORI" ;
    ct:Code "C132355" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "6 Lead NEHB-SPORI" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C132356>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) recorded using 6 electrodes to generate 8 ECG leads (ECG wave forms). The 6 electrode configuration includes 4 limb electrodes in an Einthoven configuration and two chest electrodes. The 8 ECG leads recorded consist of three standard limb leads (leads I, II, and III), three augmented leads (leads aVR, aVF, and aVL), and two chest leads (which are generated using two unipolar chest leads (typically CV5RL [rV2] and CV6LL [V2] for canines or MV1 and MV2 for non-human primates). This lead configuration is typically used to record ECGs in non-human animals." ;
    ct:CDISC%20Submission%20Value "8 LEAD STANDARD" ;
    ct:Code "C132356" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "8 Lead Standard" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C154717>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A continuous electrocardiographic (ECG) recording utilizing one or more surface leads in a non-human species." ;
    ct:CDISC%20Submission%20Value "CONTINUOUS SURFACE ECG RECORDING FOR NON-HUMAN SPECIES" ;
    ct:Code "C154717" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "Continuous Surface ECG Recording for Non-human Species" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C154718>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A continuous electrocardiographic (ECG) recording utilizing one or more implanted leads in a non-human species." ;
    ct:CDISC%20Submission%20Value "CONTINUOUS ECG RECORDING FOR NON-HUMAN SPECIES USING IMPLANTED LEADS" ;
    ct:Code "C154718" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "Continuous ECG Recording for Non-human Species Using Implanted Leads" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C158157>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram lead placement for non-human species using a five electrode lead set to monitor and/or record 7 ECG leads, analogous to the standard and augmented human limb leads and one chest lead." ;
    ct:CDISC%20Submission%20Value "7 LEAD STANDARD, NON-HUMAN" ;
    ct:Code "C158157" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "7 Lead Placement Standard for Non-Human Subjects" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C204619>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby 15 lead points are recorded using the standard 12 lead ECG positions and 3 additional leads placed on the back of the chest. The positions of these posterior leads V7 to V9 are at the same vertical level as V6 and at the horizontal positions of the left posterior axillary line (V7), left scapular line (V8), and left paravertebral line (V9)." ;
    ct:CDISC%20Submission%20Value "15 LEAD INCLUDING V7-V9" ;
    ct:Code "C204619" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "15 Lead Placement Including V7-V9" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C204620>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby 15 lead points are recorded using the standard 12 lead ECG positions and 3 additional leads placed on the right side of the chest. The positions of these right-sided leads V3R to V5R are opposite to the positions of V3-V5 on the right side of the chest." ;
    ct:CDISC%20Submission%20Value "15 LEAD INCLUDING V3R-V5R" ;
    ct:Code "C204620" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "15 Lead Placement Including V3R-V5R" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C38064>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic method for collecting continuous ECG waveforms with a variable number of discrete leads with duration longer than the standard 10 second ECG. Holter recording may be performed in patients who are ambulatory, and may collect data for 24 hours or longer." ;
    ct:CDISC%20Submission%20Value "HOLTER CONTINUOUS ECG RECORDING" ;
    ct:Code "C38064" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "Holter Monitoring" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71092>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A recording of the electrical activity of the heart displayed in the form of a vector loop, corrected for anatomic inconsistencies. (NCI)" ;
    ct:CDISC%20Submission%20Value "VECTORCARDIOGRAPH CORRECTED" ;
    ct:CDISC%20Synonym%28s%29 "Vectorcardiograph Corrected" ;
    ct:Code "C71092" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "Vectorcardiograph Corrected" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71093>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A recording of the electrical activity of the heart displayed in the form of a vector loop, uncorrected for anatomic inconsistencies. (NCI)" ;
    ct:CDISC%20Submission%20Value "VECTORCARDIOGRAPH UNCORRECTED" ;
    ct:CDISC%20Synonym%28s%29 "Vectorcardiograph Uncorrected" ;
    ct:Code "C71093" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "Vectorcardiograph Uncorrected" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71101>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby 12 leadpoints are recorded but the position of the leads is unspecified. (NCI)" ;
    ct:CDISC%20Submission%20Value "12 LEAD UNSPECIFIED" ;
    ct:CDISC%20Synonym%28s%29 "12 Lead Unspecified" ;
    ct:Code "C71101" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead Placement Unspecified" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71102>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby 12 leads are recorded, with each lead representing an electrical view of the heart. The six leads recorded in the frontal plane are derived from the placement of 3 electrodes (RA or Right Arm, LA, or Left Arm, and LL or Left Leg). These bipolar frontal leads form the basis of Einthoven's triangle, and are represented by leads I, II, and III. Three other derived (or augmented) bipolar frontal vectors are also recorded on a standard 12-lead EKG, aVR, aVF, and aVL. 6 unipolar leads, corresponding to V1 - V6 measure the electrical activity in the horizontal plane. The placement for the V leads is as follows: V1: right 4th intercostal space,V2: left 4th intercostal space, V3: halfway between V2 and V4, V4: left 5th intercostal space, mid-clavicular line, V5: horizontal to V4, anterior axillary line, V6: horizontal to V5, mid-axillary line. (NCI)" ;
    ct:CDISC%20Submission%20Value "12 LEAD STANDARD" ;
    ct:CDISC%20Synonym%28s%29 "12 Lead Standard" ;
    ct:Code "C71102" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead Placement Standard" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71103>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby 12 leadpoints are recorded but the standard lead positions have been modified for ECG recording during exercise. Exercise stress testing requires moving the limb electrodes to more central positions on the thorax. The electrodes are placed in bony prominences close to the bases of the respective limbs in order to avoid skeletal muscle artifact, provide stability for recording electrodes and to record waveforms similar to the standard limb sites. (NCI)" ;
    ct:CDISC%20Submission%20Value "12 LEAD MASON LIKAR" ;
    ct:CDISC%20Synonym%28s%29 "12 Lead Mason Likar" ;
    ct:Code "C71103" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead Placement Mason Likar" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71110>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby 12 leadpoints are recorded but the Mason Likar lead positions have been modified so that V1 to V6 on the chest are part of a single electrode pad. In addition, lead CM5 is substituted for lead aVR. (NCI)" ;
    ct:CDISC%20Submission%20Value "12 LEAD MODIFIED MASON LIKAR" ;
    ct:CDISC%20Synonym%28s%29 "12 Lead Modified Mason Likar" ;
    ct:Code "C71110" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead Placement Mason Likar Modified" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71112>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby 12 leadpoints are recorded but the standard lead positions have been modified so that all leads on the chest are part of a single electrode pad. (NCI)" ;
    ct:CDISC%20Submission%20Value "12 LEAD SINGLE PAD" ;
    ct:CDISC%20Synonym%28s%29 "12 Lead Single Pad" ;
    ct:Code "C71112" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead Placement Chest" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71114>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby the limb leads are placed on the torso for easier and faster application in emergency situations. (NCI)" ;
    ct:CDISC%20Submission%20Value "12 LEAD NON-STANDARD" ;
    ct:CDISC%20Synonym%28s%29 "12 Lead Non-Standard" ;
    ct:Code "C71114" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead Placement Non-Standard" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71115>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Limb leads on the back (shoulder and on the hips). (NCI)" ;
    ct:CDISC%20Submission%20Value "STANDARD LEADS FOR BICYCLE EXERCISE" ;
    ct:Code "C71115" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "Lead Placement Bicycle" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71116>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby the display of the 12 standard ECG leads is in an orderly sequence in a single horizontal display of: aVL, I, -aVR, II, aVF, III, V1 to V6. In the Cabrera display the limb lead aVR is inverted (-aVR) to obtain the same positive leftward orientation as the other 5 limbs. (NCI)" ;
    ct:CDISC%20Submission%20Value "12 LEAD CABRERA" ;
    ct:CDISC%20Synonym%28s%29 "12 Lead Cabrera" ;
    ct:Code "C71116" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead Placement Cabrera" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71117>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic lead placement schema in which the V leads are placed one intercostal space cephalad to the position they would have in the standard lead placement schema. (NCI)" ;
    ct:CDISC%20Submission%20Value "STANDARD LEADS ONE INTERCOSTAL SPACE HIGHER" ;
    ct:CDISC%20Synonym%28s%29 "Standard leads one intercostal space higher" ;
    ct:Code "C71117" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "Lead Placement Standard Intercostal Space Higher" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71118>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement for determining 3 orthogonal components X (right to left direction), Y (foot to head direction) and Z (back to front direction) of the heart. For this method a minimum of 4 electrodes are needed that represent the right arm, left arm, left leg and back. However, usually 7 electrodes are used to avoid dependence on the dipole location and facilitate interpretation. (NCI)" ;
    ct:CDISC%20Submission%20Value "FRANK LEAD SYSTEM" ;
    ct:CDISC%20Synonym%28s%29 "Frank lead system" ;
    ct:Code "C71118" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "Lead Placement Frank" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71119>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement for determining 3 orthogonal components X (back to front), Y (right to left) and Z (foot to head) of the heart. This system places the electrodes closer to the heart to achieve better orthogonality and a homogeneous lead field. (NCI)" ;
    ct:CDISC%20Submission%20Value "MCFEE-PARUNGAO LEAD SYSTEM" ;
    ct:CDISC%20Synonym%28s%29 "McFee-Parungao lead system" ;
    ct:Code "C71119" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "Lead Placement McFee-Parungao" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71120>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement that is a type of uncorrected vectorcardiograph. This lead system is based on a rectangular body axis. It uses an extra number of electrodes to make it three-dimensional. (NCI)" ;
    ct:CDISC%20Submission%20Value "CUBE LEAD SYSTEM" ;
    ct:CDISC%20Synonym%28s%29 "Cube lead system" ;
    ct:Code "C71120" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "Lead Placement Cube" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71121>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby the X+ lead is placed at the right mid-axillary line ate the 4th intercostal space, X- at the left mid-axillary line at he 4th intercostal space, Y+ at the proximal left leg, Y- at the superior aspect of the manubrium, Z+ at the direct posterior to Z- and Z- at the 4th intercostal space at the left sternal margin. (NCI)" ;
    ct:CDISC%20Submission%20Value "BIPOLAR UNCORRECTED XYZ LEAD SYSTEM" ;
    ct:CDISC%20Synonym%28s%29 "Bipolar uncorrected XYZ lead system" ;
    ct:Code "C71121" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "Lead Placement Bipolar Uncorrected XYZ" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71122>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement that allows monitoring and recording of cardiac electrical activity. A V1-type lead is used whose positive electrode is localized in the 4th intercostal space, 2.5cm from the sternum. Its negative electrode is placed below the left clavicle. An addition of lead V5 and aVF can be made to facilitate interpretation. (NCI)" ;
    ct:CDISC%20Submission%20Value "PSEUDO-ORTHOGONAL XYZ LEAD SYSTEM" ;
    ct:CDISC%20Synonym%28s%29 "Pseudo-orthogonal XYZ lead system" ;
    ct:Code "C71122" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "Lead Placement Pseudo Orthogonal XYZ" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71123>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby 4 chest electrodes and 1 reference electrode are used to allow for continuous monitoring at the clinical level. This placement creates a 12 lead ECG that allows the acquisition of simultaneous events in the frontal, horizontal and sagittal heart planes with the linear transformation of vectors. This system provides a three-dimensional portrayal of the heart and uses mathematical and fixed coefficients for each lead. (NCI)" ;
    ct:CDISC%20Submission%20Value "12 LEAD EASI DOWER TRANSFORMATION" ;
    ct:CDISC%20Synonym%28s%29 "12 Lead EASI Dower Transformation" ;
    ct:Code "C71123" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "Lead Placement EASI Dower Transformation" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71125>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby 12 leadpoints are recorded but one standard lead position is missing therefore requiring a Mortara source consistency filter. (NCI)" ;
    ct:CDISC%20Submission%20Value "12 LEAD 1 LEAD MISSING" ;
    ct:CDISC%20Synonym%28s%29 "12 Lead 1 Lead Missing" ;
    ct:Code "C71125" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead Placement 1 Lead Missing" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71126>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby 12 leadpoints are recorded but the standard lead positions have been modified so that the bipolar lead groups place the negative of the reference electrode over the manubrium (CM5), the right scapula (CB5), V5R (CC5) or on the forehead (CH5) and the active electrode at V5. (NCI)" ;
    ct:CDISC%20Submission%20Value "STANDARD 12-LEAD AND CM5-CC5-CH5" ;
    ct:CDISC%20Synonym%28s%29 "Standard 12-lead and CM5-CC5-CH5" ;
    ct:Code "C71126" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead Placement Standard And CC5-CM5-CH5" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71128>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiogram (ECG) lead placement whereby 12 leadpoints are recorded but the standard lead positions have been modified so that the negative reference is at CM5 and the active electrode is at the left leg position. (NCI)" ;
    ct:CDISC%20Submission%20Value "STANDARD 12-LEAD AND CC5-CM5-ML" ;
    ct:CDISC%20Synonym%28s%29 "Standard 12-lead and CC5-CM5-ML" ;
    ct:Code "C71128" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead Placement Standard And CC5-CM5-ML" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71130>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A 12-lead electrocardiogram (ECG) lead placement whereby the standard lead placement is modified by having leads V3R, V4R and V5R. The V3R through V5R leads are recorded by using a standard 12-lead ECG machine and substituting lead cables V4 for V3R, V5 for V4R, and V6 for V5R. The positions of these right-sided leads V3R to V5R are opposite to the positions of V3-V5 on the right side of the chest." ;
    ct:CDISC%20Submission%20Value "12-LEAD EXTENDED RIGHT" ;
    ct:CDISC%20Synonym%28s%29 "12-lead extended to the right by V5R, V4R, V3R" ;
    ct:Code "C71130" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead Placement Standard Extended Right" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71151/C71131>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A 12-lead electrocardiogram (ECG) lead placement whereby the standard lead placement is modified by having leads V7, V8 and V9. The V7 through V9 leads are recorded by using a standard 12-lead ECG machine and substituting lead cables V4 for V7, V5 for V8, and V6 for V9. The positions of these posterior leads V7 to V9 are at the same vertical level as V6 and at the horizontal positions of the left posterior axillary line (V7), left scapular line (V8), and left paravertebral line (V9)." ;
    ct:CDISC%20Submission%20Value "STANDARD 12-LEAD EXTENDED LEFT" ;
    ct:CDISC%20Synonym%28s%29 "Standard 12-lead extended to the left by V7, V8, V9" ;
    ct:Code "C71131" ;
    ct:Codelist%20Code "C71151" ;
    ct:Codelist%20Name "ECG Test Method" ;
    ct:NCI%20Preferred%20Term "12 Lead Placement Standard Extended Left" ;
.

