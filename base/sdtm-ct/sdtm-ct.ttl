    ct:CDISC%20Definition "An electrocardiographic finding of atrial flutter which occurs intermittently during the recording. Other rhythms which may be present are sinus rhythm, junctional rhythm, or an atrial paced rhythm." ;
    ct:CDISC%20Submission%20Value "PAROXYSMAL ATRIAL FLUTTER" ;
    ct:Code "C201381" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Paroxysmal Atrial Flutter" ;
.

