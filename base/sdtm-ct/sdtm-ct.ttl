<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42925>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A liquid preparation consisting of solid particles dispersed throughout a liquid phase in which the particles are not soluble; the suspension has been formulated in a manner to allow at least a reduction in dosing frequency as compared to that drug presented as a conventional dosage form (e.g., as a solution or a prompt drug-releasing, conventional solid dosage form). (NCI)" ;
    ct:CDISC%20Submission%20Value "SUSPENSION, EXTENDED RELEASE" ;
    ct:Code "C42925" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Extended Release Suspension Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42926>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A sterile preparation intended for parenteral use which has been formulated in a manner to allow at least a reduction in dosing frequency as compared to that drug presented as a conventional dosage form (e.g., as a solution or a prompt drug-releasing, conventional solid dosage form). (NCI)" ;
    ct:CDISC%20Submission%20Value "INJECTION, SUSPENSION, EXTENDED RELEASE" ;
    ct:Code "C42926" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Injectable Extended Release Suspension Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42927>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A solid dosage form containing a drug which allows at least a reduction in dosing frequency as compared to that drug presented in conventional dosage form. (NCI)" ;
    ct:CDISC%20Submission%20Value "TABLET, EXTENDED RELEASE" ;
    ct:CDISC%20Synonym%28s%29 "Tablet, Prolonged Release" ;
    ct:Code "C42927" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Extended Release Tablet Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42928>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A solid dosage form in which the drug is enclosed within either a hard or soft soluble container or 'shell' made from a suitable form of gelatin; additionally, the capsule is covered in a designated film coating, and which releases a drug (or drugs) in such a manner to allow at least a reduction in dosing frequency as compared to that drug (or drugs) presented as a conventional dosage form." ;
    ct:CDISC%20Submission%20Value "CAPSULE, FILM COATED, EXTENDED RELEASE" ;
    ct:Code "C42928" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Extended Release Film Coated Capsule Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42929>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A concentrated preparation of vegetable or animal drugs obtained by removal of the active constituents of the respective drugs with a suitable menstrua, evaporation of all or nearly all of the solvent, and adjustment of the residual masses or powders to the prescribed standards. (NCI)" ;
    ct:CDISC%20Submission%20Value "EXTRACT" ;
    ct:Code "C42929" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Extract Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42930>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A solid dosage form that contains medicinal substances with or without suitable diluents and is coated with a thin layer of a water-insoluble or water-soluble polymer; the tablet is formulated in such manner as to make the contained medicament available over an extended period of time following ingestion." ;
    ct:CDISC%20Submission%20Value "TABLET, FILM COATED, EXTENDED RELEASE" ;
    ct:Code "C42930" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Film Coated Extended Release Tablet Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42931>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A solid dosage form that contains medicinal substances with or without suitable diluents and is coated with a thin layer of a water-insoluble or water-soluble polymer. (NCI)" ;
    ct:CDISC%20Submission%20Value "TABLET, FILM COATED" ;
    ct:Code "C42931" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Film Coated Tablet Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42932>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A thin layer or coating. (NCI)" ;
    ct:CDISC%20Submission%20Value "FILM" ;
    ct:Code "C42932" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Film Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42933>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Any elastic aeriform fluid in which the molecules are separated from one another and have free paths. (NCI)" ;
    ct:CDISC%20Submission%20Value "GAS" ;
    ct:Code "C42933" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Gas Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42934>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A semisolid (1) dosage form that contains a gelling agent to provide stiffness to a solution or a colloidal dispersion (2). A gel may contain suspended particles. Note 1: A semisolid is not pourable; it does not flow or conform to its container at room temperature. It does not flow at low shear stress and generally exhibits plastic flow behavior. Note 2: A colloidal dispersion is a system in which particles of colloidal dimension (i.e., typically between 1 nm and 1 micrometer) are distributed uniformly throughout a liquid." ;
    ct:CDISC%20Submission%20Value "GEL" ;
    ct:Code "C42934" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Gel Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42935>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A solution that forms a gel when it comes in contact with ocular fluid, and which allows at least a reduction in dosing frequency." ;
    ct:CDISC%20Submission%20Value "SOLUTION, GEL FORMING, EXTENDED RELEASE" ;
    ct:Code "C42935" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Extended Release Gel Forming Solution Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42936>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A solid dosage form in which the drug is enclosed within either a hard or soft soluble container made from a suitable form of gelatin; through a banding process, the capsule is coated with additional layers of gelatin so as to form a complete seal. (NCI)" ;
    ct:CDISC%20Submission%20Value "CAPSULE, GELATIN COATED" ;
    ct:Code "C42936" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Gelatin Coated Capsule Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42937>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Also called pellets or pilules, are made of pure sucrose, lactose, or other polysaccharides. They are formed into small globular masses of various sizes, and are medicated by placing them in a vial and adding the liquid drug attenuation in the proportion not less than one percent (v/w). After shaking, the medicated globules are dried at temperatures not to exceed 40 degrees Centigrade. (NCI)" ;
    ct:CDISC%20Submission%20Value "GLOBULE" ;
    ct:Code "C42937" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Globule Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42938>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A small particle or grain. (NCI)" ;
    ct:CDISC%20Submission%20Value "GRANULE" ;
    ct:Code "C42938" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Granule Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42939>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A small medicinal particle or grain made available in its more stable dry form, to be reconstituted with solvent just before dispensing; the granules are so prepared to contain not only the medicinal agent, but the colorants, flavorants, and any other desired pharmaceutic ingredient. (NCI)" ;
    ct:CDISC%20Submission%20Value "GRANULE, FOR SOLUTION" ;
    ct:Code "C42939" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Granule for Solution Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42940>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A small medicinal particle or grain made available in its more stable dry form, to be reconstituted with solvent just before dispensing to form a suspension; the granules are so prepared to contain not only the medicinal agent, but the colorants, flavorants, and any other desired pharmaceutic ingredient. (NCI)" ;
    ct:CDISC%20Submission%20Value "GRANULE, FOR SUSPENSION" ;
    ct:Code "C42940" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Granule for Suspension Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42941>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A mucilaginous excretion from various plants. (NCI)" ;
    ct:CDISC%20Submission%20Value "GUM" ;
    ct:Code "C42941" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Gum Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42942>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A material containing drug intended to be inserted securely and deeply in a living site for growth, slow release, or formation of an organic union. (NCI)" ;
    ct:CDISC%20Submission%20Value "IMPLANT" ;
    ct:Code "C42942" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Implant Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42943>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A small sterile solid mass consisting of a highly purified drug (with or without excipients) made by the formation of granules, or by compression and molding; they are intended for implantation in the body (usually subcutaneously) for the purpose of providing continuous release of the drug over long periods of time." ;
    ct:CDISC%20Submission%20Value "PELLET, IMPLANTABLE" ;
    ct:Code "C42943" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Implantable Pellet Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42944>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A special class of inhalations consisting of a drug or combination of drugs, that by virtue of their high vapor pressure, can be carried by an air current into the nasal passage where they exert their effect; the container from which the inhalant generally is administered is known as an inhaler. (NCI)" ;
    ct:CDISC%20Submission%20Value "INHALANT" ;
    ct:Code "C42944" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Inhalant Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42945>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A liquid preparation containing one or more drug substances dissolved in a suitable solvent or mixture of mutually miscible solvents that is suitable for injection. (NCI)" ;
    ct:CDISC%20Submission%20Value "INJECTION, SOLUTION" ;
    ct:Code "C42945" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Injectable Solution Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42946>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A sterile preparation intended for parenteral use; five distinct classes of injections exist as defined by the USP. (NCI)" ;
    ct:CDISC%20Submission%20Value "INJECTION" ;
    ct:Code "C42946" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Injectable Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42947>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A sterile solution intended to bathe or flush open wounds or body cavities; they're used topically, never parenterally. (NCI)" ;
    ct:CDISC%20Submission%20Value "IRRIGANT" ;
    ct:Code "C42947" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Irrigant Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42948>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A class of gels--semisolid systems which consist of suspensions made up of either small inorganic particles or large organic molecules interpenetrated by a liquid--in which the structural coherent matrix contains a high portion of liquid, usually water. (NCI)" ;
    ct:CDISC%20Submission%20Value "JELLY" ;
    ct:Code "C42948" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Jelly Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42949>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A solution or mixture of various substances in oil, alcoholic solutions of soap, or emulsions intended for external application. (NCI)" ;
    ct:CDISC%20Submission%20Value "LINIMENT" ;
    ct:Code "C42949" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Liniment Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42950>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A substance composed of complexed active and/or inert ingredient(s) with natural or synthetic lipids that is intended for injection. (NCI)" ;
    ct:CDISC%20Submission%20Value "INJECTION, LIPID COMPLEX" ;
    ct:Code "C42950" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Injectable Lipid Complex Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42951>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A liquid parenteral pharmaceutical dosage form structured as a multilamellar composition of concentric phospholipid spheres that encapsulate the drug (drug delivery systems) separated by layers of water. Drug release is facilitated and controlled by in vivo erosion of the liposomes. To further increase the in vivo circulation time, liposomes in some preparations are covalently derivatized with PEG to produce PEGylated or stealth liposomes. Covalent attachment of drugs to the outer surface of liposomes can potentially serve as a delayed-release product. (NCI)" ;
    ct:CDISC%20Submission%20Value "INJECTION, SUSPENSION, LIPOSOMAL" ;
    ct:Code "C42951" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Injectable Liposomal Suspension Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42952>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A waxy solid, usually colored cosmetic, in stick form for the lips. (NCI)" ;
    ct:CDISC%20Submission%20Value "LIPSTICK" ;
    ct:Code "C42952" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Lipstick Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42953>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A dosage form consisting of a pure chemical in its liquid state. This dosage form term should not be applied to solutions. Note: A liquid is pourable; it flows and conforms to its container at room temperature. It displays Newtonian or pseudoplastic flow behavior." ;
    ct:CDISC%20Submission%20Value "LIQUID" ;
    ct:Code "C42953" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Liquid Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42954>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A solid dosage form in which the drug is enclosed within a soluble, gelatin shell which is plasticized by the addition of a polyol, such as sorbitol or glycerin, and is therefore of a somewhat thicker consistency than that of a hard shell capsule; typically, the active ingredients are dissolved or suspended in a liquid vehicle. (NCI)" ;
    ct:CDISC%20Submission%20Value "CAPSULE, LIQUID FILLED" ;
    ct:Code "C42954" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Liquid Filled Capsule Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42955>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A solid preparation containing one or more medicaments, usually in a flavored, sweetened base which is intended to dissolve or disintegrate slowly in the mouth. A lollipop is a lozenge on a stick." ;
    ct:CDISC%20Submission%20Value "LOZENGE" ;
    ct:Code "C42955" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Lozenge Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42956>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A sterile freeze dried preparation intended for reconstitution for parenteral use which has been formulated in a manner to allow at least a reduction in dosing frequency as compared to that drug presented as a conventional dosage form (e.g., as a solution). (NCI)" ;
    ct:CDISC%20Submission%20Value "INJECTION, POWDER, LYOPHILIZED, FOR SUSPENSION, EXTENDED RELEASE" ;
    ct:Code "C42956" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Lyophilized Powder for Extended Release Injectable Suspension Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42957>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A dosage form intended for the solution prepared by lyophilization ('freeze drying'), a process which involves the removal of water from products in the frozen state at extremely low pressures; this is intended for subsequent addition of liquid to create a solution that conforms in all respects to the requirements for Injections. (NCI)" ;
    ct:CDISC%20Submission%20Value "INJECTION, POWDER, LYOPHILIZED, FOR SOLUTION" ;
    ct:Code "C42957" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Lyophilized Powder for Injectable Solution Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42958>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A liquid preparation, intended for parenteral use, that contains solids suspended in a suitable fluid medium and conforms in all respects to the requirements for Sterile Suspensions; the medicinal agents intended for the suspension are prepared by lyophilization (\"freeze drying\"), a process which involves the removal of water from products in the frozen state at extremely low pressures." ;
    ct:CDISC%20Submission%20Value "INJECTION, POWDER, LYOPHILIZED, FOR SUSPENSION" ;
    ct:Code "C42958" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Lyophilized Powder for Injectable Suspension Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42959>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A sterile freeze dried preparation intended for reconstitution for parenteral use which has been formulated in a manner that would allow liposomes (a lipid bilayer vesicle usually composed of phospholipids which is used to encapsulate an active drug substance, either within a lipid bilayer or in an aqueous space) to be formed upon reconstitution. (NCI)" ;
    ct:CDISC%20Submission%20Value "INJECTION, POWDER, LYOPHILIZED, FOR LIPOSOMAL SUSPENSION" ;
    ct:Code "C42959" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Lyophilized Powder for Injectable Liposomal Suspension Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42960>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A pressurized dosage form consisting of metered dose valves which allow for the delivery of a uniform quantity of spray upon each activation. (NCI)" ;
    ct:CDISC%20Submission%20Value "AEROSOL, METERED" ;
    ct:Code "C42960" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Metered Aerosol Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42961>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A powder dosage form that is situated inside a container that has a mechanism to deliver a specified quantity. (NCI)" ;
    ct:CDISC%20Submission%20Value "POWDER, METERED" ;
    ct:Code "C42961" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Metered Powder Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42962>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A non-pressurized dosage form consisting of valves which allow the dispensing of a specified quantity of spray upon each activation. (NCI)" ;
    ct:CDISC%20Submission%20Value "SPRAY, METERED" ;
    ct:Code "C42962" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Metered Spray Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42963>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A solid dosage form containing medicinal substances that have been compressed to form a multiple-layered tablet or a tablet-within-a-tablet, the inner tablet being the core and the outer portion being the shell, which, additionally, is covered in a designated coating; the tablet is formulated in such manner as to allow at least a reduction in dosing frequency as compared to that drug presented as a conventional dosage form. (NCI)" ;
    ct:CDISC%20Submission%20Value "TABLET, MULTILAYER, EXTENDED RELEASE" ;
    ct:Code "C42963" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Multilayered Extended Release Tablet Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42964>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A solid dosage form containing medicinal substances that have been compressed to form a multiple-layered tablet or a tablet-within-a-tablet, the inner tablet being the core and the outer portion being the shell. (NCI)" ;
    ct:CDISC%20Submission%20Value "TABLET, MULTILAYER" ;
    ct:Code "C42964" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Multilayered Tablet Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42965>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An unctuous, combustible substance which is liquid, or easily liquefiable, on warming, and is soluble in ether but insoluble in water. Such substances, depending on their origin, are classified as animal, mineral, or vegetable oils. (NCI)" ;
    ct:CDISC%20Submission%20Value "OIL" ;
    ct:Code "C42965" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Oil Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42966>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A suspension or emulsion, semisolid (1) dosage form, usually containing less than 20 percent water and volatiles (2) and greater than 50 percent hydrocarbons, waxes, or polyols as the vehicle. This dosage form is generally for external application to the skin or mucous membranes. Note 1: A semisolid is not pourable; it does not flow or conform to its container at room temperature. It does not flow at low shear stress and generally exhibits plastic flow behavior. Note 2: Percent water and volatiles are measured by a loss on drying test in which the sample is heated at 105 degrees C until constant weight is achieved." ;
    ct:CDISC%20Submission%20Value "OINTMENT" ;
    ct:CDISC%20Synonym%28s%29 "oint" ;
    ct:Code "C42966" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Ointment Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42967>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A semisolid dosage form, containing a large proportion (20 - 50%) of solids finely dispersed in a fatty vehicle. This dosage form is generally for external application to the skin or mucous membranes. Note: A semisolid is not pourable; it does not flow or conform to its container at room temperature. It does not flow at low shear stress and generally exhibits plastic flow behavior. (NCI)" ;
    ct:CDISC%20Submission%20Value "PASTE" ;
    ct:Code "C42967" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Paste Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42968>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A drug delivery system that often contains an adhesive backing that is usually applied to an external site on the body. Its ingredients either passively diffuse from, or are actively transported from, some portion of the patch. Depending upon the patch, the ingredients are either delivered to the outer surface of the body or into the body. A patch is sometimes synonymous with the terms Extended Release Film and System." ;
    ct:CDISC%20Submission%20Value "PATCH" ;
    ct:Code "C42968" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Patch Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42969>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A small sterile solid mass consisting of a highly purified drug (with or without excipients) made by the formation of granules, or by compression and molding. (NCI)" ;
    ct:CDISC%20Submission%20Value "PELLET" ;
    ct:Code "C42969" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Pellet Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42970>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Substance intended for external application made of such materials and of such consistency as to adhere to the skin and attach to a dressing; plasters are intended to afford protection and support and/or to furnish an occlusion and macerating action and to bring medication into close contact with the skin." ;
    ct:CDISC%20Submission%20Value "PLASTER" ;
    ct:Code "C42970" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Plaster Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42971>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A product that is packaged under pressure and contains therapeutically active ingredients, in the form of a powder, that are released upon activation of an appropriate valve system. (NCI)" ;
    ct:CDISC%20Submission%20Value "AEROSOL, POWDER" ;
    ct:Code "C42971" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Powder Aerosol Dosage Form" ;
.

