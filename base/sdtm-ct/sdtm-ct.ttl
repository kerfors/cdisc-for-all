<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66727/C41331>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Any untoward medical occurrence in a patient or clinical investigation subject administered a pharmaceutical product and which does not necessarily have a causal relationship with this treatment. An adverse event (AE) can therefore be any unintended sign (including an abnormal laboratory finding), symptom, or disease temporally associated with the use of a medicinal (investigational) product, whether or not related to the medicinal (investigational) product. (CDISC Glossary)" ;
    ct:CDISC%20Submission%20Value "ADVERSE EVENT" ;
    ct:Code "C41331" ;
    ct:Codelist%20Code "C66727" ;
    ct:Codelist%20Name "Completion/Reason for Non-Completion" ;
    ct:NCI%20Preferred%20Term "Adverse Event" ;
.

