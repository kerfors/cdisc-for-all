    ct:NCI%20Preferred%20Term "Junctional Escape Complexes by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C116130>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding showing no cardiac electrical activity on the ECG for the entire duration of the recording." ;
    ct:CDISC%20Submission%20Value "ASYSTOLE" ;
    ct:Code "C116130" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Asystole by ECG Finding" ;
.

