    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "New High Lateral Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C102737>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves in leads III, aVF and often II, which is suggestive of myocardial infarction of the inferior wall of the left ventricle and which is new compared to prior ECGs." ;
    ct:CDISC%20Submission%20Value "NEW INFERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "New Inferior Wall Myocardial Infarction" ;
    ct:Code "C102737" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "New Inferior Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C102738>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves in leads V5, V6, I and aVL, which is suggestive of myocardial infarction of the lateral wall of the left ventricle and which is new compared to prior ECGs." ;
    ct:CDISC%20Submission%20Value "NEW LATERAL WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "New Lateral Wall Myocardial Infarction" ;
    ct:Code "C102738" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "New Lateral Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C102739>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves in leads V1, V2 and often V3, which is suggestive of myocardial infarction of the intraventricular septum and which is new compared to prior ECGs." ;
    ct:CDISC%20Submission%20Value "NEW SEPTAL WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "New Septal Wall Myocardial Infarction" ;
    ct:Code "C102739" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "New Septal Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C106496>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves with accompanying ST elevation in leads V1 to V6, I and aVL, which is suggestive of acute myocardial infarction involving the anterior and anterolateral walls of the left ventricle." ;
    ct:CDISC%20Submission%20Value "ACUTE EXTENSIVE ANTERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:Code "C106496" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Acute Extensive Anterior Wall Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C106502>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding suggestive of enlargement or thickening of both ventricles, with a combination of findings which are related to LVH and RVH, such as voltage criteria for LVH in the presence of marked right axis deviation." ;
    ct:CDISC%20Submission%20Value "BIVENTRICULAR HYPERTROPHY" ;
    ct:Code "C106502" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Biventricular Hypertrophy by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C106503>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of complete or incomplete right bundle branch block accompanied by ST elevation in leads V1-V3. This may be noted at rest or can be provoked by medication challenge." ;
    ct:CDISC%20Submission%20Value "BRUGADA SYNDROME PATTERN" ;
    ct:Code "C106503" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Brugada Syndrome Pattern by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C106520>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves in leads V1 to V6, I and aVL, which is suggestive of myocardial infarction involving the anterior and anterolateral walls of the left ventricle." ;
    ct:CDISC%20Submission%20Value "EXTENSIVE ANTERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:Code "C106520" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Extensive Anterior Wall Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C106548>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in leads V1 or V2 of an initial R wave duration greater than or equal to 40 ms, R wave greater than S wave, and upright T wave, which is suggestive of myocardial infarction of the posterior wall of the left ventricle, and which is new compared to prior ECGs. Evidence of inferior or lateral myocardial infarction is usually also present." ;
    ct:CDISC%20Submission%20Value "NEW POSTERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:Code "C106548" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "New Posterior Wall Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C106579>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of U waves which have increased amplitude, are inverted, or merged with the preceding T wave." ;
    ct:CDISC%20Submission%20Value "U WAVE ABNORMALITY" ;
    ct:CDISC%20Synonym%28s%29 "Abnormal U Wave" ;
    ct:Code "C106579" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "U Wave Abnormality by ECG Finding" ;
.

