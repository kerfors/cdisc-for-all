    ct:CDISC%20Definition "An electrocardiographic interval measured from the end of the P wave to the onset of the QRS complex of a single beat utilizing one or more leads." ;
    ct:CDISC%20Submission%20Value "PRSEGSB" ;
    ct:CDISC%20Synonym%28s%29 "PR Segment, Single Beat" ;
    ct:Code "C209540" ;
    ct:Codelist%20Code "C71153" ;
    ct:Codelist%20Name "ECG Test Code" ;
    ct:NCI%20Preferred%20Term "Single Beat PR Segment" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71153/C41255>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An act or process of elucidation; explication, or explanation of the meaning of the event or thing via the assignment of objects from the domain to the constants of a formal language, truth-values to the proposition symbols, truth-functions to the connectives, other functions to the function symbols, and extensions to the predicates, if any. The assignments are result of human logic application and are not native to the symbols of the formal language." ;
    ct:CDISC%20Submission%20Value "INTP" ;
    ct:CDISC%20Synonym%28s%29 "Interpretation" ;
    ct:Code "C41255" ;
    ct:Codelist%20Code "C71153" ;
    ct:Codelist%20Name "ECG Test Code" ;
    ct:NCI%20Preferred%20Term "Interpretation" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71153/C62093>
