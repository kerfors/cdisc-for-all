    ct:CDISC%20Definition "A type of artery that supplies blood to the fingers and includes the common palmar digital arteries, the dorsal digital arteries of the hand, and the proper palmar digital arteries. (NCI)" ;
    ct:CDISC%20Submission%20Value "PALMAR DIGITAL ARTERY" ;
    ct:Code "C177994" ;
    ct:Codelist%20Code "C74456" ;
