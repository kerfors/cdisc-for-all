    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Studies in which individuals are assigned by an investigator based on a protocol to receive specific interventions. Subjects may receive diagnostic, therapeutic or other types of interventions. The assignment of the intervention may or may not be random. The individuals are then followed and biomedical and/or health outcomes are assessed." ;
    ct:CDISC%20Submission%20Value "INTERVENTIONAL" ;
    ct:Code "C98388" ;
    ct:Codelist%20Code "C99077" ;
    ct:Codelist%20Name "Study Type Response" ;
    ct:NCI%20Preferred%20Term "Interventional Study" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C99077/C98722>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Studies that provide a means for obtaining an experimental drug or device for patients who are not adequately treated by existing therapy, who do not meet the eligibility criteria for enrollment, or who are otherwise unable to participate in another clinical study." ;
    ct:CDISC%20Submission%20Value "EXPANDED ACCESS" ;
    ct:CDISC%20Synonym%28s%29 "Compassionate Use" ;
    ct:Code "C98722" ;
    ct:Codelist%20Code "C99077" ;
    ct:Codelist%20Name "Study Type Response" ;
    ct:NCI%20Preferred%20Term "Expanded Access Study" ;
.

