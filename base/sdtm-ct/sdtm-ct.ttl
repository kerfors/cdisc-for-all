    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Ventricular Repolarization Abnormality" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C102591>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves with accompanying ST elevation in leads V3 through V6, which is suggestive of acute myocardial infarction of the anterolateral wall of the left ventricle." ;
    ct:CDISC%20Submission%20Value "ACUTE ANTEROLATERAL WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Acute Anterolateral Wall Myocardial Infarction" ;
