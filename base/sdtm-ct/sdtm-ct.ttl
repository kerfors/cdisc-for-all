    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Extreme Right Axis Deviation" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C102639>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding that occurs when electrical activation of the atria or ventricles occurs from two separate sites. This results in a P wave or QRS complex that displays merged characteristics of beats originating from the two different sites; there may be one or more occurrences during an electrocardiographic recording." ;
    ct:CDISC%20Submission%20Value "FUSION COMPLEX" ;
    ct:CDISC%20Synonym%28s%29 "Fusion Beat; Fusion Complexes" ;
