    ct:Codelist%20Code "C66737" ;
    ct:Codelist%20Name "Trial Phase Response" ;
    ct:NCI%20Preferred%20Term "Phase I/II/III Trial" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66737/C198367>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A study that begins as a Phase I study and transitions into a Phase III study upon successful completion of the Phase I portion." ;
    ct:CDISC%20Submission%20Value "PHASE I/III TRIAL" ;
    ct:CDISC%20Synonym%28s%29 "1/3; Trial Phase 1/3" ;
    ct:Code "C198367" ;
    ct:Codelist%20Code "C66737" ;
    ct:Codelist%20Name "Trial Phase Response" ;
    ct:NCI%20Preferred%20Term "Phase I/III Trial" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66737/C199989>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A type of phase 1 trial with multiple ascending doses (dose expansion) in a larger group of patients (in comparison to a Phase 1A)." ;
    ct:CDISC%20Submission%20Value "PHASE IB TRIAL" ;
