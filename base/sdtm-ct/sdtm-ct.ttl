<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C99078/C15329>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A diagnostic or treatment procedure performed by manual and/or instrumental means, often involving an incision and the removal or replacement of a diseased organ or tissue; of or relating to or involving or used in surgery or requiring or amenable to treatment by surgery." ;
    ct:CDISC%20Submission%20Value "SURGERY" ;
    ct:CDISC%20Synonym%28s%29 "Surgical Procedure" ;
