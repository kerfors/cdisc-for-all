    ct:Codelist%20Name "Intervention Type Response" ;
    ct:NCI%20Preferred%20Term "Surgical Procedure" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C99078/C16830>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Any instrument, apparatus, implement, machine, appliance, implant, reagent for in vitro use, software, material or other similar or related article, intended by the manufacturer to be used, alone or in combination for, one or more specific medical purpose(s). [After REGULATION (EU) 2017/745 OF THE EUROPEAN PARLIAMENT AND OF THE COUNCIL of 5 April 2017 on medical devices]" ;
    ct:CDISC%20Submission%20Value "DEVICE" ;
    ct:CDISC%20Synonym%28s%29 "Medical Device" ;
