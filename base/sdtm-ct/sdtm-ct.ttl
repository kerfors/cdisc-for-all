    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An optical technique used to detect volumetric changes in blood in peripheral circulation. Using low-intensity infrared light, changes in blood flow can be detected as changes in the intensity of light, with the signal being proportional to the quantity of blood flowing through the blood vessels." ;
    ct:CDISC%20Submission%20Value "PHOTOPLETHYSMOGRAPHY" ;
    ct:CDISC%20Synonym%28s%29 "PPG" ;
    ct:Code "C198843" ;
