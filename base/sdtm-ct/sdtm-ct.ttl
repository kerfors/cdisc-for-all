.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C46087>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A technique that uses radiofrequency waves and a magnet to image the body. The images are enhanced by the addition of contrast agents which selectively intensify anatomical regions to intensify the clarity of the image for diagnostic purposes. (NCI)" ;
    ct:CDISC%20Submission%20Value "CONTRAST ENHANCED MRI" ;
    ct:Code "C46087" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
