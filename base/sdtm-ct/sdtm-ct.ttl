.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C120618>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of three or more consecutive beats of supraventricular origin without reference to rate." ;
    ct:CDISC%20Submission%20Value "SUPRAVENTRICULAR RUN" ;
    ct:Code "C120618" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Supraventricular Run by ECG Finding" ;
.

