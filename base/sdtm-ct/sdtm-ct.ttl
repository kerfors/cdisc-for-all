    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An intimate mixture of dry, finely divided drugs and/or chemicals, which, upon the addition of suitable vehicles, yields a solution. (NCI)" ;
    ct:CDISC%20Submission%20Value "POWDER, FOR SOLUTION" ;
    ct:Code "C42973" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Powder for Solution Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42974>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A sterile preparation intended for reconstitution to form a solution for parenteral use. (NCI)" ;
    ct:CDISC%20Submission%20Value "INJECTION, POWDER, FOR SOLUTION" ;
    ct:Code "C42974" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Powder for Injectable Solution Dosage Form" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66726/C42975>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An intimate mixture of dry, finely divided drugs and/or chemicals, which, upon the addition of suitable vehicles, yields a suspension (a liquid preparation containing the solid particles dispersed in the liquid vehicle). (NCI)" ;
    ct:CDISC%20Submission%20Value "POWDER, FOR SUSPENSION" ;
    ct:Code "C42975" ;
    ct:Codelist%20Code "C66726" ;
