    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Any procedure or test to diagnose a disease or disorder." ;
    ct:CDISC%20Submission%20Value "DIAGNOSTIC TEST" ;
