    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Acute Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C101597>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves, which is suggestive of myocardial infarction of one or more regions of the heart, without evidence of current or ongoing acute infarction. No specification is provided for localization." ;
    ct:CDISC%20Submission%20Value "OLD OR AGE INDETERMINATE WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Old Or Age Indeterminate Wall Myocardial Infarction" ;
    ct:Code "C101597" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Old Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C102574>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of an abnormality of T wave duration or morphology or of early repolarization." ;
    ct:CDISC%20Submission%20Value "REPOLARIZATION ABNORMALITY" ;
    ct:CDISC%20Synonym%28s%29 "Repolarization Abnormality" ;
    ct:Code "C102574" ;
