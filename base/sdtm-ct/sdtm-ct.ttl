    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which two premature atrial complexes occur sequentially; there may be one or more occurrences during an electrocardiographic recording." ;
    ct:CDISC%20Submission%20Value "ATRIAL COUPLETS" ;
    ct:CDISC%20Synonym%28s%29 "Atrial Couplets" ;
    ct:Code "C102597" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Atrial Couplet by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C102598>
