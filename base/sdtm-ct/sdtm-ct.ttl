    ct:CDISC%20Synonym%28s%29 "RSR'" ;
    ct:Code "C92227" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "RSR' by ECG Finding" ;
.

