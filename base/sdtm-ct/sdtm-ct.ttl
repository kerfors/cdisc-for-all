    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic measurement of the mean amplitude (usually measured in mm) of the ST segment deviation above or below the isoelectric baseline measured from the baseline to the ST segment of a single beat utilizing one or more leads. Based on the recording gain, this measurement is reported in millivolt." ;
    ct:CDISC%20Submission%20Value "ST Segment Deviation, Single Beat" ;
    ct:CDISC%20Synonym%28s%29 "ST Segment Deviation, Single Beat" ;
    ct:Code "C117800" ;
    ct:Codelist%20Code "C71152" ;
    ct:Codelist%20Name "ECG Test Name" ;
    ct:NCI%20Preferred%20Term "ST Segment Deviation Single Beat" ;
.

