    ct:NCI%20Preferred%20Term "Blocked Atrial Premature Complex by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C102623>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding suggestive of dextrocardia with situs inversus, characterized by reversal of normal anterior R wave progression and the appearance of reversal of the right and left arm electrodes." ;
    ct:CDISC%20Submission%20Value "DEXTROCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Dextrocardia" ;
    ct:Code "C102623" ;
