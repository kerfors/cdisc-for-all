    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Single-Nucleotide Primer Extension" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C209652>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A technique to assess puffing behavior in smokers, using a smoking topography (ST) device." ;
    ct:CDISC%20Submission%20Value "SMOKING TOPOGRAPHY" ;
    ct:Code "C209652" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Smoking Topography Research" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C209653>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
