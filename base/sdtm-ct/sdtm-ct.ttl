    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Brugada Syndrome Pattern by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C106520>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves in leads V1 to V6, I and aVL, which is suggestive of myocardial infarction involving the anterior and anterolateral walls of the left ventricle." ;
    ct:CDISC%20Submission%20Value "EXTENSIVE ANTERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:Code "C106520" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Extensive Anterior Wall Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C106548>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in leads V1 or V2 of an initial R wave duration greater than or equal to 40 ms, R wave greater than S wave, and upright T wave, which is suggestive of myocardial infarction of the posterior wall of the left ventricle, and which is new compared to prior ECGs. Evidence of inferior or lateral myocardial infarction is usually also present." ;
    ct:CDISC%20Submission%20Value "NEW POSTERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:Code "C106548" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "New Posterior Wall Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C106579>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of U waves which have increased amplitude, are inverted, or merged with the preceding T wave." ;
    ct:CDISC%20Submission%20Value "U WAVE ABNORMALITY" ;
    ct:CDISC%20Synonym%28s%29 "Abnormal U Wave" ;
    ct:Code "C106579" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "U Wave Abnormality by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C107098>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which the QT interval corrected for heart rate using Bazett's formula is prolonged." ;
    ct:CDISC%20Submission%20Value "QTCB PROLONGATION" ;
    ct:CDISC%20Synonym%28s%29 "PROLONGED QTcB" ;
    ct:Code "C107098" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "QTcB Prolongation" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C107099>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which the QT interval corrected for heart rate using Fridericia's formula is prolonged." ;
    ct:CDISC%20Submission%20Value "QTCF PROLONGATION" ;
    ct:CDISC%20Synonym%28s%29 "PROLONGED QTcF" ;
    ct:Code "C107099" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "QTcF Prolongation" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C107100>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a premature ventricular complex which occurs between two normal QRS complexes which have normal timing; there may be one or more occurrences during an electrocardiographic recording." ;
    ct:CDISC%20Submission%20Value "PREMATURE VENTRICULAR COMPLEX INTERPOLATED" ;
    ct:CDISC%20Synonym%28s%29 "Interpolated VE; Interpolated Ventricular Extra Beat; Interpolated VES; Interpolated VPC; Premature Ventricular Complexes Interpolated" ;
    ct:Code "C107100" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Interpolated Premature Ventricular Complex by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111088>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of prolonged PR interval." ;
    ct:CDISC%20Submission%20Value "1ST DEGREE AV BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "1st degree AV block; PR Prolongation; Prolonged PR interval" ;
    ct:Code "C111088" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "AV Block First Degree by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111089>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of intermittent failure of atrial electrical impulse conduction to the ventricles, characterized by a progressively lengthening PR interval prior to the block of an atrial impulse." ;
    ct:CDISC%20Submission%20Value "AV MOBITZ I" ;
    ct:CDISC%20Synonym%28s%29 "AV Mobitz I; Mobitz I Second Degree AV Block; Second degree AV block- Mobitz type I; Second-degree AV block, Mobitz type I (Wenckebach); Type 1 2nd degree AV Block; Wenckebach" ;
    ct:Code "C111089" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "AV Block Second Degree Mobitz Type I by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111090>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of intermittent failure of atrial electrical impulse conduction to the ventricles, characterized by a relatively constant PR interval prior to the block of an atrial impulse." ;
    ct:CDISC%20Submission%20Value "AV MOBITZ II" ;
    ct:CDISC%20Synonym%28s%29 "Mobitz II AV Block; Mobitz II Second Degree AV Block; Type 2 2nd degree AV Block" ;
    ct:Code "C111090" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "AV Block Second Degree Mobitz Type II by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111091>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of complete failure of atrial electrical impulse conduction to the ventricles. This is manifest on the ECG by disassociation of atrial and ventricular rhythms. The atrial rate must be faster than the ventricular rate." ;
    ct:CDISC%20Submission%20Value "3RD DEGREE AV BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "3rd Degree Heart Block; AV block, complete (third-degree); Complete Heart Block" ;
    ct:Code "C111091" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "AV Block Third Degree by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111092>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a supraventricular arrhythmia characterized by the replacement of consistent P waves by rapid oscillations or fibrillatory waves that vary in size, shape and timing and are accompanied by an irregularly irregular ventricular response." ;
    ct:CDISC%20Submission%20Value "ATRIAL FIBRILLATION" ;
    ct:CDISC%20Synonym%28s%29 "Atrial fibrillation" ;
    ct:Code "C111092" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Atrial Fibrillation by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111094>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of an organized, regular atrial rhythm. Multiple P waves typically appear in the inferior leads in a saw tooth like pattern between the QRS complexes." ;
    ct:CDISC%20Submission%20Value "ATRIAL FLUTTER" ;
    ct:CDISC%20Synonym%28s%29 "Atrial flutter" ;
    ct:Code "C111094" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Atrial Flutter by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111097>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of abnormally slow heart rate with its origin in the sinus node." ;
    ct:CDISC%20Submission%20Value "SINUS BRADYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Sinus bradycardia" ;
    ct:Code "C111097" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Sinus Bradycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111100>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a tachycardia which does not originate in the ventricles or His Purkinje system. There is an abnormally high heart rate and QRS complexes are typically narrow, but aberration or preexcitation may be present." ;
    ct:CDISC%20Submission%20Value "SUPRAVENTRICULAR TACHYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Supraventricular tachycardia" ;
    ct:Code "C111100" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Supraventricular Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111102>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a rapid grossly irregular ventricular rhythm with marked variability in QRS cycle length, morphology, and amplitude." ;
    ct:CDISC%20Submission%20Value "VENTRICULAR FIBRILLATION" ;
    ct:CDISC%20Synonym%28s%29 "Ventricular fibrillation" ;
    ct:Code "C111102" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Ventricular Fibrillation by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111103>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of three or more consecutive complexes of ventricular organ with a rate greater than a certain threshold. The QRS complexes are wide and have an abnormal morphology." ;
    ct:CDISC%20Submission%20Value "VENTRICULAR TACHYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Ventricular tachycardia" ;
    ct:Code "C111103" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Ventricular Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111104>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of abnormally rapid heart rate with its origin in the sinus node." ;
    ct:CDISC%20Submission%20Value "SINUS TACHYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Sinus tachycardia" ;
    ct:Code "C111104" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Sinus Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111105>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of an organized, regular atrial rhythm. The P wave morphology must be distinct from the sinus P wave morphology." ;
    ct:CDISC%20Submission%20Value "ATRIAL TACHYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Atrial tachycardia" ;
    ct:Code "C111105" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Atrial Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111115>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A ventricular tachyarrhythmia characterized by a high ventricular rate with a regular rhythm. The electrocardiogram shows large oscillating sine wave-like complexes occurring as a result of QRS complexes and T waves being merged. The P wave is not visible. (NCI)" ;
    ct:CDISC%20Submission%20Value "VENTRICULAR FLUTTER" ;
    ct:CDISC%20Synonym%28s%29 "Ventricular flutter" ;
    ct:Code "C111115" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Ventricular Flutter by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111120>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of abnormally slow heart rate." ;
    ct:CDISC%20Submission%20Value "BRADYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Bradycardia" ;
    ct:Code "C111120" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Bradycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C111121>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of abnormally rapid heart rate." ;
    ct:CDISC%20Submission%20Value "TACHYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Tachycardia" ;
    ct:Code "C111121" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C112402>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which the QT interval corrected for heart rate using Bazett's formula is shortened." ;
    ct:CDISC%20Submission%20Value "SHORT QTCB" ;
    ct:Code "C112402" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "QTcB Shortened" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C112403>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which the QT interval corrected for heart rate using Fridericia's formula is shortened." ;
    ct:CDISC%20Submission%20Value "SHORT QTCF" ;
    ct:Code "C112403" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "QTcF Shortened" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C114147>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic recording in which the isoelectric line in one or more leads is vertically displaced resulting in low frequency upward and downward movements of the signal with varying amplitudes." ;
    ct:CDISC%20Submission%20Value "BASELINE WANDER" ;
    ct:Code "C114147" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Baseline Wander by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C114148>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic recording with intermittent mid to high frequency artifact in one or more leads due to muscular tremor or movement rather than cardiac activity." ;
    ct:CDISC%20Submission%20Value "MUSCLE TREMOR" ;
    ct:Code "C114148" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Muscle Tremor Artifact" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C114149>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic recording showing power line interference with the electrocardiographic signal. The artifact amplitude modulation has the same frequency as the AC power system present (usually 50 Hz or 60 Hz)." ;
    ct:CDISC%20Submission%20Value "AC NOISE" ;
    ct:CDISC%20Synonym%28s%29 "AC Noise" ;
    ct:Code "C114149" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Alternating Current Noise by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C114150>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic recording in which two or more of the limb electrodes are switched resulting in improper representation of the affected leads." ;
    ct:CDISC%20Submission%20Value "LIMB ELECTRODES INTERCHANGED" ;
    ct:CDISC%20Synonym%28s%29 "Limb Lead Reversal" ;
    ct:Code "C114150" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Interchanged Limb Electrodes by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C114151>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic recording in which one or more of the limb electrodes are disconnected resulting in missing waveforms (often flat lines) of the respective leads." ;
    ct:CDISC%20Submission%20Value "LIMB ELECTRODE(S) DISCONNECTED" ;
    ct:Code "C114151" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Disconnected Limb Electrodes by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C114152>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic recording in which two or more of the precordial electrodes are switched resulting in improper representation of the affected leads." ;
    ct:CDISC%20Submission%20Value "PRECORDIAL ELECTRODES INTERCHANGED" ;
    ct:CDISC%20Synonym%28s%29 "Precordial Lead Reversal" ;
    ct:Code "C114152" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Interchanged Precordial Electrodes by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C114153>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic recording in which the electrode for lead V1 is disconnected resulting in missing waveforms (flat line) for lead V1." ;
    ct:CDISC%20Submission%20Value "PRECORDIAL ELECTRODE V1 DISCONNECTED" ;
    ct:Code "C114153" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Disconnected Precordial Electrode V1 by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C114154>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic recording in which the electrode for lead V2 is disconnected resulting in missing waveforms (flat line) for lead V2." ;
    ct:CDISC%20Submission%20Value "PRECORDIAL ELECTRODE V2 DISCONNECTED" ;
    ct:Code "C114154" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Disconnected Precordial Electrode V2 by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C114155>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic recording in which the electrode for lead V3 is disconnected resulting in missing waveforms (flat line) for lead V3." ;
    ct:CDISC%20Submission%20Value "PRECORDIAL ELECTRODE V3 DISCONNECTED" ;
    ct:Code "C114155" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Disconnected Precordial Electrode V3 by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C114156>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic recording in which the electrode for lead V4 is disconnected resulting in missing waveforms (flat line) for lead V4." ;
