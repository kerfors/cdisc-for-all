    ct:Codelist%20Name "Genomic Findings Analytical Method Calculation Formula" ;
    ct:NCI%20Preferred%20Term "Transcript Fragment Count per Million Formula" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181181/C181325>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A mathematical formula that calculates the number of fragments per million fragments sampled (calculated by dividing the fragment counts by a per million scaling factor, which is derived by taking the total fragments in the sample and dividing by 1,000,000) divided by the length of the gene, in kilobases. Fragments are represented by either paired or single end reads." ;
    ct:CDISC%20Submission%20Value "FRAGMENTS PER KILOBASE MILLION FORMULA" ;
    ct:CDISC%20Synonym%28s%29 "FPKM" ;
    ct:Code "C181325" ;
    ct:Codelist%20Code "C181181" ;
    ct:Codelist%20Name "Genomic Findings Analytical Method Calculation Formula" ;
    ct:NCI%20Preferred%20Term "Fragments Per Kilobase Million Formula" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181181/C181326>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A mathematical formula that calculates the number of fragments per million fragments sampled (calculated by dividing the fragment counts by a per million scaling factor, which is derived by taking the total fragments in the sample and dividing by 1,000,000) divided by the length of the gene, in kilobases. Fragments are represented by single end reads." ;
    ct:CDISC%20Submission%20Value "READS PER KILOBASE MILLION FORMULA" ;
    ct:CDISC%20Synonym%28s%29 "RPKM" ;
    ct:Code "C181326" ;
