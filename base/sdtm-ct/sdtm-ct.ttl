.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C102596>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a sinus beat followed by a premature atrial complex for three or more consecutive cycles; a regularly irregular rhythm of normal and abnormal P waves in a 1-1 ratio." ;
    ct:CDISC%20Submission%20Value "ATRIAL BIGEMINY" ;
    ct:Code "C102596" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Atrial Bigeminy by ECG Finding" ;
.

