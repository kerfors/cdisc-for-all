<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C74456/C139206>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A bony projection from the posterior region of the iliac crest that lies over the sacroiliac joint and is the site of attachment for the thoracolumbar fascia and the posterior sacroiliac and sacrotuberous ligaments." ;
    ct:CDISC%20Submission%20Value "POSTERIOR SUPERIOR ILIAC SPINE" ;
    ct:Code "C139206" ;
    ct:Codelist%20Code "C74456" ;
    ct:Codelist%20Name "Anatomical Location" ;
    ct:NCI%20Preferred%20Term "Posterior Superior Iliac Spine" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C74456/C139207>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A dense band of avascular, regular connective tissue. It is formed as the union of the superficial and deep layers of the tensor fascia latae, creating a thick band that extends inferiorly, taking its origins from the iliac crest, the tensor fascia latae, and the gluteus maximus, travelling inferiolaterally along the thigh, and inserting on Gerdy's tubercle on the lateral aspect of the tibia. Functionally, the iliotibial band helps to flex, abduct, and medially rotate the femur at the hip joint, and it also helps to stabilize the knee laterally." ;
    ct:CDISC%20Submission%20Value "ILIOTIBIAL BAND" ;
    ct:Code "C139207" ;
    ct:Codelist%20Code "C74456" ;
    ct:Codelist%20Name "Anatomical Location" ;
    ct:NCI%20Preferred%20Term "Iliotibial Band" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C74456/C139208>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "The portion of the distal femur, identified during a dual x-ray absorptiometry (DXA) scan, that contains primarily metaphyseal or trabecular bone." ;
    ct:CDISC%20Submission%20Value "DISTAL FEMUR R1" ;
    ct:Code "C139208" ;
    ct:Codelist%20Code "C74456" ;
    ct:Codelist%20Name "Anatomical Location" ;
    ct:NCI%20Preferred%20Term "Distal Femur R1" ;
.

