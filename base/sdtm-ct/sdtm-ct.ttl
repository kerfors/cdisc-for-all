    ct:CDISC%20Synonym%28s%29 "OPA" ;
    ct:Code "C209650" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Opsonophagocytic Killing Assay" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C209651>
