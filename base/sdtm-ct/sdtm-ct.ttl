    ct:CDISC%20Synonym%28s%29 "Month" ;
    ct:Code "C29846" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Month" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C29848>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "The period of time that it takes for Earth to make a complete revolution around the sun, approximately 365 days; a specific one year period. (NCI)" ;
    ct:CDISC%20Submission%20Value "YEARS" ;
    ct:CDISC%20Synonym%28s%29 "Year" ;
    ct:Code "C29848" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Year" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C41139>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A meter is defined as the length of the path traveled by light in a vacuum during a time interval of 1/299 792 458 of a second and is equal to 1.093 61 yards.(NCI)" ;
    ct:CDISC%20Submission%20Value "m" ;
    ct:CDISC%20Synonym%28s%29 "Meter" ;
    ct:Code "C41139" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Meter" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C41140>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of time, which is equal to one thousandth of a second.(NCI)" ;
    ct:CDISC%20Submission%20Value "ms" ;
    ct:CDISC%20Synonym%28s%29 "Millisecond; ms; msec" ;
    ct:Code "C41140" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Millisecond" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42535>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "The base unit of time in the International System of Units (SI) equal to the duration of 9,192,631,770 periods of the specified light radiation corresponding to the transition between the two hyperfine levels of the cesium 133 atom in its ground state at 0 K." ;
    ct:CDISC%20Submission%20Value "s" ;
    ct:CDISC%20Synonym%28s%29 "sec; Second" ;
    ct:Code "C42535" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Second" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42536>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of electric current, named after the French physicist Andre Ampere. It is that constant current which, if maintained in two straight parallel conductors of infinite length and zero diameter separated by one meter in a vacuum, would produce between these conductors a force equal to 2(1E7) Newton per meter of length. This is dependent upon the definitions of the meter, kilogram, and second. One Ampere represents 6.24 x 1(E18) unit electric charge carriers, such as electrons, passing a specified fixed point in one second. (NCI)" ;
    ct:CDISC%20Submission%20Value "amp" ;
    ct:CDISC%20Synonym%28s%29 "Ampere" ;
    ct:Code "C42536" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Ampere" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42537>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A basic unit of thermodynamic temperature, one of the seven base units of the International System of Units (Systeme International d'Unites, SI). It is 1/273.16th of the thermodynamic temperature of the triple point of water. This sets the size of the kelvin unit for temperature differences and defines the thermodynamic temperature of an equilibrium mixture of waters ice-liquid-vapor as 273.16 K, where 0 K is the lowest possible temperature (\"absolute zero\")." ;
    ct:CDISC%20Submission%20Value "K" ;
    ct:CDISC%20Synonym%28s%29 "Kelvin" ;
    ct:Code "C42537" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Kelvin" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42538>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "The candela is the basic unit of luminous intensity. It is the luminous intensity in a given direction of a small monochromatic light source at 540 terahertz emitting 1/683 watt per steradian in that direction. This is dependent upon the definitions of the meter, kilogram, and second.(NCI)" ;
    ct:CDISC%20Submission%20Value "cd" ;
    ct:CDISC%20Synonym%28s%29 "Candela" ;
    ct:Code "C42538" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Candela" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42539>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "The base unit of amount of substance in the International System of Units (SI). It is equal to the same number of elementary units as there are atoms in 0.012 kg of carbon-12." ;
    ct:CDISC%20Submission%20Value "mol" ;
    ct:CDISC%20Synonym%28s%29 "Mole" ;
    ct:Code "C42539" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Mole" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42545>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of frequency equal to one cycle per second.(NCI)" ;
    ct:CDISC%20Submission%20Value "Hz" ;
    ct:CDISC%20Synonym%28s%29 "Cycle per Second; cycle/sec; Hertz" ;
    ct:Code "C42545" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Hertz" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42546>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of force which, when applied in a vacuum to a body having a mass of one kilogram, causes an acceleration of one meter per second squared. It is equal to 1E5 dynes. (NCI)" ;
    ct:CDISC%20Submission%20Value "Newton" ;
    ct:CDISC%20Synonym%28s%29 "Newton" ;
    ct:Code "C42546" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Newton" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42547>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of pressure equivalent to one Newton per square meter or 10 bars or to 1.45x10(E-4) pounds per square inch.(NCI)" ;
    ct:CDISC%20Submission%20Value "Pa" ;
    ct:CDISC%20Synonym%28s%29 "Pascal" ;
    ct:Code "C42547" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Pascal" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42548>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of electrical, mechanical, and thermal energy (as well as work and quantity of heat), equal to the work done when the point of application of a force of one Newton is displaced through a distance of one meter in the direction of the force or the work done when a current of one Ampere passes through a resistance of one ohm for one second. One joule is equal to 0.23889 gram-calorie (mean).(NCI)" ;
    ct:CDISC%20Submission%20Value "Joule" ;
    ct:CDISC%20Synonym%28s%29 "Joule" ;
    ct:Code "C42548" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Joule" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42549>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of power equal to the power which in one second produces or transfers the energy of one joule. The unit is used in measurements of power emitted, transferred or received as radiation, sound waves, heat flow rate, and rate of energy transfer. Equal to 1/746 of horsepower.(NCI)" ;
    ct:CDISC%20Submission%20Value "Watt" ;
    ct:Code "C42549" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Watt" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42550>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of quantity of electricity, equal to the quantity of charge transferred in one second across a conductor in which there is a constant current of one Ampere.(NCI)" ;
    ct:CDISC%20Submission%20Value "Coulomb" ;
    ct:CDISC%20Synonym%28s%29 "Coulomb" ;
    ct:Code "C42550" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Coulomb" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42551>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of electric potential and electromotive force, equal to the difference of electric potential between two points on a conducting wire carrying a constant current of one Ampere when the power dissipated between the points is one watt. This is equivalent to the potential difference across a resistance of one ohm when one Ampere of current flows through it.(NCI)" ;
    ct:CDISC%20Submission%20Value "V" ;
    ct:CDISC%20Synonym%28s%29 "Volt" ;
    ct:Code "C42551" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Volt" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42552>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of capacitance equal to the capacitance of a capacitor having an equal and opposite charge of one coulomb on each plate and a potential difference of one volt between the plates.(NCI)" ;
    ct:CDISC%20Submission%20Value "Farad" ;
    ct:CDISC%20Synonym%28s%29 "Farad" ;
    ct:Code "C42552" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Farad" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42553>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of equivalent radiation dose. One Sv is received when the actual absorbed dose of ionizing radiation, after being multiplied by the dimensionless factors Q (the relative biological efficiency or quality factor) and N (the product of any other multiplying factors that takes into account the distribution of energy throughout the dose), is one joule per kilogram. In this scheme, the relationship between the absorbed dose of radiation D and the dose equivalent H is, therefore, given by H = QND. Both Q and N are stipulated by the International Commission on Radiological Protection. One Sv is equal to 100 rem.(NCI)" ;
    ct:CDISC%20Submission%20Value "Sv" ;
    ct:CDISC%20Synonym%28s%29 "Sievert" ;
    ct:Code "C42553" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Sievert" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42554>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of electrical resistance equal to the resistance between two points on a conductor when a potential difference of one volt between them produces a current of one Ampere. Ohm is also used to measure impedance and reactance for complex resistance. A measurement in ohms is the reciprocal of a measurement in Siemens. (NCI)" ;
    ct:CDISC%20Submission%20Value "ohm" ;
    ct:CDISC%20Synonym%28s%29 "Ohm" ;
    ct:Code "C42554" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Ohm" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42555>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of electrical conductance, admittance, and susceptance. A conductor has a conductance of one Siemens if an electrical potential difference of one volt produces a one Ampere current in it. The conductance in Siemens is the reciprocal of its resistance in ohms.(NCI)" ;
    ct:CDISC%20Submission%20Value "Siemens" ;
    ct:CDISC%20Synonym%28s%29 "Siemens" ;
    ct:Code "C42555" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Siemens" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42556>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of magnetic flux, equal to the flux that produces in a circuit of one turn an electromotive force of one volt, when the flux is uniformly reduced to zero within one second.(NCI)" ;
    ct:CDISC%20Submission%20Value "Weber" ;
    ct:CDISC%20Synonym%28s%29 "V*s; V*sec; Volt Second; Volt-second; Weber" ;
    ct:Code "C42556" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Weber" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42557>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of magnetic flux density equal to the magnitude of the magnetic field vector necessary to produce a force of one Newton on a charge of one coulomb moving perpendicular to the direction of the magnetic field vector with a velocity of one meter per second. It is equivalent to one Weber per square meter.(NCI)" ;
    ct:CDISC%20Submission%20Value "Tesla" ;
    ct:CDISC%20Synonym%28s%29 "Tesla" ;
    ct:Code "C42557" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Tesla" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42558>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of electric inductance. A coil with an inductance of one Henry requires a flux of one Weber for each Ampere of induced current. If it is the current which changes, then the induced field will generate a potential difference within the coil: if the inductance is one Henry a current change of one Ampere per second generates a potential difference of one volt. The Henry is a large unit; inductances in practical circuits are measured in millihenrys or microhenrys.(NCI)" ;
    ct:CDISC%20Submission%20Value "Henry" ;
    ct:CDISC%20Synonym%28s%29 "Henry" ;
    ct:Code "C42558" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Henry" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42559>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of temperature of the temperature scale designed so that the freezing point of water is 0 degrees and the boiling point is 100 degrees at standard atmospheric pressure. The current official definition of the Celsius sets 0.01 C to be at the triple point of water and a degree to be 1/273.16 of the difference in temperature between the triple point of water and absolute zero. One degree Celsius represents the same temperature difference as one Kelvin. (NCI)" ;
    ct:CDISC%20Submission%20Value "C" ;
    ct:CDISC%20Synonym%28s%29 "Degree Celsius" ;
    ct:Code "C42559" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Degree Celsius" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42560>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of luminous flux. It is the amount of light that falls on a unit area at unit distance from a source of one candela.(NCI)" ;
    ct:CDISC%20Submission%20Value "lm" ;
    ct:CDISC%20Synonym%28s%29 "Lumen" ;
    ct:Code "C42560" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Lumen" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42561>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of illuminance equal to the direct illumination on a surface that is everywhere one meter from a uniform point source of one candela; a unit of illuminance that is equal to one lumen per square meter.(NCI)" ;
    ct:CDISC%20Submission%20Value "lx" ;
    ct:CDISC%20Synonym%28s%29 "Lux" ;
    ct:Code "C42561" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Lux" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42562>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of activity of a radionuclide, equal to one nuclear disintegration or other nuclear transition from a particular energy state occurring in an amount of a radionuclide during one second-long time interval.(NCI)" ;
    ct:CDISC%20Submission%20Value "Bq" ;
    ct:CDISC%20Synonym%28s%29 "Becquerel" ;
    ct:Code "C42562" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Becquerel" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42566>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit for measuring catalytic (e.g. enzymatic) activity, the ability of the compound to accelerate the chemical reaction by providing a lower energy pathway between the reactants and the products. One katal is that catalytic activity which will raise the rate of reaction by one mole per second in a specified assay system. When the katal is used, the measurand should be specified by reference to the measurement procedure; the measurement procedure must identify the indicator reaction. The katal is not used to express a rate of reaction itself, which should be expressed in moles per second.(NCI)" ;
    ct:CDISC%20Submission%20Value "kat" ;
    ct:CDISC%20Synonym%28s%29 "Katal" ;
    ct:Code "C42566" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Katal" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42569>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "The standard derived unit of area in the International System of Units (SI) equal to the area of a square whose sides are one meter long." ;
    ct:CDISC%20Submission%20Value "m2" ;
    ct:CDISC%20Synonym%28s%29 "Square Meter" ;
    ct:Code "C42569" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Square Meter" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42570>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of volume or capacity equal to the volume of a cube with edges one meter in length. It is equal to 1,000 liters; 1,000 cubic decimeters; 10(E6) cubic centimeters; 25.3 cubic feet; 6.29 barrels.(NCI)" ;
    ct:CDISC%20Submission%20Value "m3" ;
    ct:CDISC%20Synonym%28s%29 "Cubic Meter" ;
    ct:Code "C42570" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Cubic Meter" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42571>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of both speed (scalar) and velocity (vector), defined as the distance of one meter travelled per unit time equal to one second.(NCI)" ;
    ct:CDISC%20Submission%20Value "m/s" ;
    ct:CDISC%20Synonym%28s%29 "m/sec; Meter Per Second" ;
    ct:Code "C42571" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Meter per Second" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71620/C42572>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A unit of acceleration equal to one meter per unit of time equal to one second squared." ;
    ct:CDISC%20Submission%20Value "m/s2" ;
    ct:CDISC%20Synonym%28s%29 "m/sec2" ;
    ct:Code "C42572" ;
    ct:Codelist%20Code "C71620" ;
    ct:Codelist%20Name "Unit" ;
    ct:NCI%20Preferred%20Term "Meter per Second Squared" ;
.

