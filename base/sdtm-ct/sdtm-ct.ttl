<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C99078/C307>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A product of biological origin applicable to the prevention, treatment, or cure of a disease or condition, for example: virus, therapeutic serum, toxin, antitoxin, vaccine, blood, blood component or derivative, allergenic product, or analogous product. (FDA 21 CFR 600.3)" ;
    ct:CDISC%20Submission%20Value "BIOLOGIC" ;
    ct:Code "C307" ;
