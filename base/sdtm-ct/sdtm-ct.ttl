    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
    ct:NCI%20Preferred%20Term "Dihydropyrimidinase-Related Protein 5" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181169/C200621>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An antigen encoded by the PNMA1 gene that may promote apoptosis. It can be considered as a neuronal autoantigen and is commonly associated with autoimmune neurodegenerative disorders related to cancer, such as paraneoplastic neurologic syndrome." ;
    ct:CDISC%20Submission%20Value "MA1 ANTIGEN" ;
    ct:CDISC%20Synonym%28s%29 "Paraneoplastic Antigen Ma1; PNMA1" ;
    ct:Code "C200621" ;
    ct:Codelist%20Code "C181169" ;
    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
    ct:NCI%20Preferred%20Term "Paraneoplastic Antigen Ma1" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181169/C200624>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An antigen encoded by the PNMA2 gene and regulates apoptosis. It can be considered as a neuronal autoantigen and is commonly associated with autoimmune neurodegenerative disorders related to cancer, such as paraneoplastic neurologic syndrome." ;
    ct:CDISC%20Submission%20Value "MA2 ANTIGEN" ;
    ct:CDISC%20Synonym%28s%29 "Paraneoplastic Antigen Ma2; PNMA2; Ta Antigen" ;
    ct:Code "C200624" ;
    ct:Codelist%20Code "C181169" ;
    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
    ct:NCI%20Preferred%20Term "Paraneoplastic Antigen Ma2" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181169/C200627>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An antigen of the human liver 58 kDa cytosolic polypeptide encoded by the FTCD gene. It can be considered as an autoantigen and is commonly associated with type 2 autoimmune hepatitis." ;
    ct:CDISC%20Submission%20Value "LIVER CYTOSOLIC ANTIGEN TYPE 1" ;
    ct:CDISC%20Synonym%28s%29 "Formiminotransferase-Cyclodeaminase; LC-1; Liver Cytosol Type 1" ;
    ct:Code "C200627" ;
    ct:Codelist%20Code "C181169" ;
    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
    ct:NCI%20Preferred%20Term "Formimidoyltransferase-Cyclodeaminase" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181169/C200630>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An antigen encoded by the IARS1 gene that regulates isoleucyl-transfer RNA synthesis (attaches isoleucine to tRNA). It can be considered as an autoantigen and is commonly associated with the autoimmune diseases anti-synthetase syndrome, polymyositis and dermatomyositis." ;
    ct:CDISC%20Submission%20Value "OJ ANTIGEN" ;
    ct:CDISC%20Synonym%28s%29 "IleRS; Isoleucyl-tRNA Synthetase" ;
    ct:Code "C200630" ;
    ct:Codelist%20Code "C181169" ;
    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
    ct:NCI%20Preferred%20Term "Isoleucine-tRNA Ligase, Cytoplasmic" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181169/C200633>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An antigen encoded by the AARS1 gene that regulates alanyl-transfer RNA synthesis (attaches alanine to tRNA). It can be considered as an autoantigen and is commonly associated with the autoimmune diseases anti-synthetase syndrome, polymyositis and dermatomyositis." ;
    ct:CDISC%20Submission%20Value "PL-12 ANTIGEN" ;
    ct:CDISC%20Synonym%28s%29 "AARS; Alanyl-tRNA Synthetase; AlaRS" ;
