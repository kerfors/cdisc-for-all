    ct:NCI%20Preferred%20Term "Alanine-tRNA Ligase, Cytoplasmic" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181169/C200636>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An antigen encoded by the Sox1 gene. This protein is a transcription activator and may be involved in neuronal development. It can be considered as an autoantigen and is commonly associated with autoimmune neuropathies." ;
    ct:CDISC%20Submission%20Value "GLIAL NUCLEAR TYPE 1 ANTIGEN" ;
    ct:CDISC%20Synonym%28s%29 "Glial Nuclear Type 1 Autoantigen; Sox1; Sox1 Nuclear Antigen; Transcription Factor SOX-1" ;
    ct:Code "C200636" ;
    ct:Codelist%20Code "C181169" ;
    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
    ct:NCI%20Preferred%20Term "Transcription Factor SOX-1" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181169/C200639>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An antigen encoded by the MOG gene and is involved in the myelination of nerves in the central nervous system. It can be considered as an autoantigen and is commonly associated with the autoimmune diseases multiple sclerosis and other demyelinating diseases." ;
    ct:CDISC%20Submission%20Value "MYELIN-OLIGODENDROCYTE GLYCOPROTEIN" ;
    ct:CDISC%20Synonym%28s%29 "MOG" ;
    ct:Code "C200639" ;
    ct:Codelist%20Code "C181169" ;
    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
    ct:NCI%20Preferred%20Term "Myelin-Oligodendrocyte Glycoprotein" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181169/C200645>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An antigen encoded by the AQP4 gene that forms water-selective channels in the plasma membranes of cells, and thereby regulates brain water homeostasis. It can be considered as an autoantigen and is commonly associated with the autoimmune disease neuromyelitis optica." ;
    ct:CDISC%20Submission%20Value "AQUAPORIN 4" ;
    ct:CDISC%20Synonym%28s%29 "AQP-4; Aquaporin 4 Receptor; Aquaporin 4 Water Channel; Mercurial-Insensitive Water Channel" ;
    ct:Code "C200645" ;
    ct:Codelist%20Code "C181169" ;
    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
    ct:NCI%20Preferred%20Term "Aquaporin-4" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181169/C200651>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An antigen encoded by the DACH1 gene and regulates gene expression and cell fate determination during development. It can be considered as a neuronal autoantigen and is commonly associated with autoimmune neurodegenerative and paraneoplastic disorders related to cancer." ;
    ct:CDISC%20Submission%20Value "NEURONAL NUCLEAR TYPE 3 AUTOANTIGEN" ;
    ct:CDISC%20Synonym%28s%29 "ANNA-3 Antigen; DACH1; Dachshund Family Transcription Factor 1; Dachshund-Homolog 1" ;
    ct:Code "C200651" ;
    ct:Codelist%20Code "C181169" ;
    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
    ct:NCI%20Preferred%20Term "Dachshund Homolog 1" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181169/C200654>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An antigen encoded by the MAP1B gene and is involved in microtubule assembly and neurogenesis. It can be considered as a neuronal autoantigen and is commonly associated with autoimmune neurodegenerative and paraneoplastic disorders related to cancer." ;
    ct:CDISC%20Submission%20Value "PURKINJE CELL CYTOPLASMIC TYPE 2 ANTIGEN" ;
    ct:CDISC%20Synonym%28s%29 "MAP1B; MAP5; Microtubule Associated Protein 1B; PCA-2 Antigen" ;
    ct:Code "C200654" ;
    ct:Codelist%20Code "C181169" ;
    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
    ct:NCI%20Preferred%20Term "Microtubule-Associated Protein 1B" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181169/C200656>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A member of the collagen superfamily with a Roman numeral designation of VII. It can be considered as an autoantigen and is commonly associated with the autoimmune diseases bullous pemphigoid and epidermolysis bullosa acquisita." ;
    ct:CDISC%20Submission%20Value "COLLAGEN TYPE VII" ;
    ct:CDISC%20Synonym%28s%29 "Collagen 7; COLVII" ;
    ct:Code "C200656" ;
    ct:Codelist%20Code "C181169" ;
    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
    ct:NCI%20Preferred%20Term "Type VII Collagen" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181169/C201304>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A group of autoimmune substances found in the extracellular matrix basement membrane that may be comprised of (but not limited to) collagens and basement membrane proteins. They are commonly associated with the autoimmune diseases bullous pemphigoid, glomerulonephritis, Goodpasture's disease, and rheumatoid arthritis." ;
    ct:CDISC%20Submission%20Value "BASEMENT MEMBRANE ANTIGENS" ;
    ct:CDISC%20Synonym%28s%29 "Basement Membrane Autoantigens" ;
    ct:Code "C201304" ;
    ct:Codelist%20Code "C181169" ;
    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
    ct:NCI%20Preferred%20Term "Basement Membrane Antigens" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181169/C201305>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A group of autoimmune substances found in the neurons that may be comprised of (but not limited to) Hu, Tr, Yo and Ri proteins. They can be considered as neuronal autoantigens and are commonly associated with autoimmune neurodegenerative disorders related to cancer, such as paraneoplastic neurologic syndrome." ;
    ct:CDISC%20Submission%20Value "NEURONAL NUCLEAR AUTOANTIGENS" ;
    ct:Code "C201305" ;
    ct:Codelist%20Code "C181169" ;
    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
    ct:NCI%20Preferred%20Term "Neuronal Nuclear Autoantigens" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C181169/C201385>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A complex of viral antigens from the Epstein-Barr virus expressed during the lytic cycle. It is comprised of restricted (EA-R) components, found only in the cytoplasm, and diffuse (EA-D) components, located in the nucleus and the cytoplasm." ;
    ct:CDISC%20Submission%20Value "EPSTEIN-BARR VIRUS EARLY ANTIGEN" ;
    ct:CDISC%20Synonym%28s%29 "EBV EA" ;
    ct:Code "C201385" ;
    ct:Codelist%20Code "C181169" ;
    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
    ct:NCI%20Preferred%20Term "Epstein-Barr Virus Early Antigen" ;
.

