<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66769/C41338>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A type of adverse event that is usually transient and may require only minimal treatment or therapeutic intervention. The event does not generally interfere with usual activities of daily living." ;
    ct:CDISC%20Submission%20Value "MILD" ;
    ct:CDISC%20Synonym%28s%29 "1; Grade 1" ;
    ct:Code "C41338" ;
    ct:Codelist%20Code "C66769" ;
    ct:Codelist%20Name "Severity/Intensity Scale for Adverse Events" ;
    ct:NCI%20Preferred%20Term "Mild Adverse Event" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66769/C41339>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A type of adverse event that is usually alleviated with additional specific therapeutic intervention. The event interferes with usual activities of daily living, causing discomfort but poses no significant or permanent risk of harm to the research participant." ;
    ct:CDISC%20Submission%20Value "MODERATE" ;
    ct:CDISC%20Synonym%28s%29 "2; Grade 2" ;
    ct:Code "C41339" ;
    ct:Codelist%20Code "C66769" ;
    ct:Codelist%20Name "Severity/Intensity Scale for Adverse Events" ;
    ct:NCI%20Preferred%20Term "Moderate Adverse Event" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66769/C41340>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A type of adverse event that interrupts usual activities of daily living, or significantly affects clinical status, or may require intensive therapeutic intervention." ;
    ct:CDISC%20Submission%20Value "SEVERE" ;
    ct:CDISC%20Synonym%28s%29 "3; Grade 3" ;
    ct:Code "C41340" ;
    ct:Codelist%20Code "C66769" ;
    ct:Codelist%20Name "Severity/Intensity Scale for Adverse Events" ;
    ct:NCI%20Preferred%20Term "Severe Adverse Event" ;
.

