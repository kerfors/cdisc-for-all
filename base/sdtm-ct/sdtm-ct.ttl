.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C214703>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Human evaluation of an attribute of a subject or material using visual discernment." ;
    ct:CDISC%20Submission%20Value "VISUAL INSPECTION" ;
    ct:CDISC%20Synonym%28s%29 "Inspection; Manual Visual Inspection" ;
    ct:Code "C214703" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Visual Inspection" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C214704>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method to evaluate clotting dynamics and physical properties in which the amplitude of movement of an oscillating pin within a static blood sample is measured over time and analyzed using an optical detection system." ;
    ct:CDISC%20Submission%20Value "ROTATIONAL THROMBOELASTOMETRY" ;
    ct:CDISC%20Synonym%28s%29 "Rotational Thromboelastography; ROTEG; ROTEM" ;
    ct:Code "C214704" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Rotational Thromboelastography" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C214705>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An assay that is used to quantify cytotoxic effector cell activity (e.g., cytotoxic T cell (CTL) or natural killer (NK) cell) by measuring target cell lysis. The process involves bathing and labeling the target cells with a radioactive isotope (e.g. Chromium 51 or Indium-111) or fluorescent molecule. The target cells are then mixed with the effector cells (CTL or NK). The killing of the labeled target cells leads to the release of the radioactive isotope into the supernatant after cell lysis. Accumulation of the radioactive isotope is quantified and measured in the supernatant which indicates effector cell-mediated cytolysis." ;
    ct:CDISC%20Submission%20Value "ISOTOPE-RELEASE CYTOTOXICITY ASSAY" ;
    ct:Code "C214705" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Isotope-release Cytotoxicity Assay" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C221633>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An assay that is used to determine whether neutralizing antibodies that are present in a biological specimen can block microbial infection/proliferation ex vivo, by assessing the amount/level of metabolism (in the form of carbon dioxide production) of surviving cells." ;
    ct:CDISC%20Submission%20Value "METABOLIC INHIBITION ASSAY" ;
    ct:CDISC%20Synonym%28s%29 "Micrometabolic inhibition Assay" ;
    ct:Code "C221633" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Metabolic Inhibition Assay" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C221634>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A diagrammatic method to test visual acuity that uses the letter 'E' pointing in different directions at 90 degree angles to each other." ;
    ct:CDISC%20Submission%20Value "E CHART EYE CHART" ;
    ct:CDISC%20Synonym%28s%29 "Snellen E Optotype Chart; Tumbling E Chart" ;
    ct:Code "C221634" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Snellen E Optotype Chart" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C221635>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A diagrammatic method to test visual acuity in individuals that may have difficulty reading letters or numbers, which uses four symbols: house; apple; circle; and square." ;
    ct:CDISC%20Submission%20Value "LEA SYMBOLS EYE CHART" ;
    ct:Code "C221635" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Lea Symbols Eye Chart" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C221636>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A type of multiplex immunoassay that utilizes pairs of oligonucleotide-labeled antibodies to detect and quantify proteins in a sample. In this assay, the antibodies bind to their target proteins, and when in close proximity, the oligonucleotides are extended and amplified through a polymerase reaction. The resulting DNA products are then quantified using real-time PCR, allowing for sensitive and specific measurement of protein levels in complex biological samples." ;
    ct:CDISC%20Submission%20Value "PROXIMITY EXTENSION ASSAY" ;
    ct:CDISC%20Synonym%28s%29 "PEA" ;
    ct:Code "C221636" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Proximity Extension Assay" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C221637>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An assay to evaluate the bactericidal activity of antibodies present in serum by measuring the ability of complement and antibodies to lyse bacteria. This is performed by incubating a defined concentration of bacteria with various dilutions of serum and complement, followed by quantifying the percent bacterial survival relative to serum-negative controls. The assay assesses the functional capacity of antibodies to mediate bacterial killing through complement activation." ;
    ct:CDISC%20Submission%20Value "SERUM BACTERICIDAL ASSAY" ;
    ct:CDISC%20Synonym%28s%29 "Complement-Dependent Bactericidal Assay; SBA Assay; Serum Bactericidal Antibody Assay" ;
    ct:Code "C221637" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Serum Bactericidal Assay" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C225692>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Any assay in which the analyte is quantified using light emission that is generated from a chemical reaction." ;
    ct:CDISC%20Submission%20Value "CHEMILUMINESCENT ASSAY" ;
    ct:Code "C225692" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Chemiluminescent Assay" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C225693>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A type of chromogenic in situ hybridization that uses a two color hybridization probe, which is visualized by a peroxidase reaction" ;
    ct:CDISC%20Submission%20Value "DISH" ;
    ct:CDISC%20Synonym%28s%29 "Dual-Color Chromogenic in Situ Hybridization; Dual-Color CISH" ;
    ct:Code "C225693" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Dual-Color Chromogenic in Situ Hybridization" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C225694>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A next generation sequencing technique in which specific genes associated with immune cell markers are targeted." ;
    ct:CDISC%20Submission%20Value "IMMUNE REPERTOIRE TARGETED SEQUENCING" ;
    ct:Code "C225694" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Immune Repertoire Targeted Sequencing" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C225695>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that utilizes a combination of May-Grunwald and Giemsa stains and is used to preferentially visualize blood cells and bone marrow cells." ;
    ct:CDISC%20Submission%20Value "MAY-GRUNWALD GIEMSA STAIN" ;
    ct:CDISC%20Synonym%28s%29 "MGG Stain; Pappenheim Stain" ;
    ct:Code "C225695" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "May-Grunwald Giemsa Stain" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C225696>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that utilizes the May-Grunwald stain, an alcohol-based composition of methylene blue and eosin, and is preferentially used to visualize blood cells and bone marrow cells." ;
    ct:CDISC%20Submission%20Value "MAY-GRUNWALD STAIN" ;
    ct:CDISC%20Synonym%28s%29 "MG Stain" ;
    ct:Code "C225696" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "May-Grunwald Stain" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C225697>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microbiological technique in which bacterial cells are mixed with type-specific antisera, causing the bacterial capsule to swell and become more visible under a microscope. The reaction is based on the binding of antibodies to the polysaccharide capsule, resulting in a characteristic change in refractivity that allows identification and serotyping of encapsulated bacteria." ;
    ct:CDISC%20Submission%20Value "QUELLUNG REACTION" ;
    ct:CDISC%20Synonym%28s%29 "Neufeld Reaction" ;
    ct:Code "C225697" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Quellung Reaction" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C228301>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A next generation sequencing technique in which the genes associated with immune cell markers are sequenced." ;
    ct:CDISC%20Submission%20Value "IMMUNE REPERTOIRE SEQUENCING" ;
    ct:CDISC%20Synonym%28s%29 "Immune Repertoire Sequencing; IR-Seq" ;
    ct:Code "C228301" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Immune Repertoire Sequencing" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C228302>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method for measuring cardiac output by dividing oxygen consumption (measured from expired air) by the difference between arterial oxygen content and mixed venous oxygen content." ;
    ct:CDISC%20Submission%20Value "DIRECT FICK METHOD" ;
    ct:Code "C228302" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Direct Fick Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C228303>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method for estimating cardiac output by dividing an estimate of oxygen consumption (usually based on body surface area and age) by the difference between arterial and venous blood oxygen content, which is calculated using arterial blood gas oxygen saturation, central venous sampling for oxygen content, and hemoglobin oxygen-carrying capacity." ;
    ct:CDISC%20Submission%20Value "INDIRECT FICK METHOD" ;
    ct:Code "C228303" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Indirect Fick Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C23011>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that utilizes two separate dyes, one staining the nucleus and the other staining the cytoplasm and connective tissue. Hematoxylin is a dark purplish dye that stains the chromatin (nuclear material) within the nucleus. Eosin is an orangish-pink to red dye that stains the cytoplasmic material including connective tissue and collagen." ;
    ct:CDISC%20Submission%20Value "HEMATOXYLIN AND EOSIN STAIN" ;
    ct:CDISC%20Synonym%28s%29 "H&E Stain" ;
    ct:Code "C23011" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Hematoxylin and Eosin Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C23012>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that utilizes two or more colored, acidic dyes of contrasting colors. Masson trichrome is a mixture of three dyes including aniline blue, Beibrich scarlet and Weigert's iron hematoxylin. Other related, modified trichrome staining methods include Lillie's trichrome, Gomori's trichrome and Mallory's trichrome." ;
    ct:CDISC%20Submission%20Value "TRICHROME STAIN" ;
    ct:Code "C23012" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Trichrome Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C23014>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method for staining and identifying bacteria, based on the differential retention of a crystal violet-iodine complex within the cell membrane. Gram-positive organisms will appear blue-black or purple while Gram-negative organisms will appear red." ;
    ct:CDISC%20Submission%20Value "GRAM STAIN" ;
    ct:Code "C23014" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Gram Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C23015>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method used to examine a specimen for the presence of acid-fast microorganisms, specifically mycobacteria." ;
    ct:CDISC%20Submission%20Value "ACID FAST STAIN" ;
    ct:Code "C23015" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Acid Fast Bacillae Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C23019>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that utilizes Schiff's reagent, a solution composed of pararosanilin treated with sulfurous acid, which selectively reacts with and stains aldehydes pink to determine the presence of glycogen, mucin, mucoprotein, glycoprotein, as well as fungi. Periodic Acid Schiff staining is useful for outlining tissue structures such as basement membranes, capsules and blood vessels." ;
    ct:CDISC%20Submission%20Value "PERIODIC ACID SCHIFF STAIN" ;
    ct:Code "C23019" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Periodic Acid Schiff Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C23020>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Immunohistochemical staining techniques allow for the visualization of antigens via the sequential application of a specific antibody to the antigen (primary antibody), a secondary antibody to the primary antibody and an enzyme complex with a chromogenic substrate. The enzymatic activation of the chromogen results in a visible reaction product at the antigen site. The specimen may then be counterstained and coverslipped. Results are interpreted using a light microscope and aid in the differential diagnosis of pathophysiological processes, which may or may not be associated with a particular antigen." ;
    ct:CDISC%20Submission%20Value "IHC" ;
    ct:CDISC%20Synonym%28s%29 "Immunohistochemistry" ;
    ct:Code "C23020" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Immunohistochemistry Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C23041>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that is a combination of the Wright and Giemsa staining protocols and utilizes the Romanowsky stains, which are mixtures of eosin and thiazine dyes such as methylene blue. It produces darker blue and magenta shades than the giemsa stain alone, which may provide better contrast in microscopy." ;
    ct:CDISC%20Submission%20Value "WRIGHT-GIEMSA STAIN" ;
    ct:Code "C23041" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Wright-Giemsa Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C25300>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Any method for growing microorganisms." ;
    ct:CDISC%20Submission%20Value "MICROBIAL CULTURE" ;
    ct:CDISC%20Synonym%28s%29 "Culture Procedure" ;
    ct:Code "C25300" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Microbial Culture Procedure" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C25598>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Observing a subject or material to gain information." ;
    ct:CDISC%20Submission%20Value "OBSERVATION" ;
    ct:Code "C25598" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Observation Activity" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C28408>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A modified polymerase chain reaction (PCR) technique in which RNA sequences are reverse transcribed into complementary DNA (cDNA) transcripts by the enzyme reverse transcriptase. The cDNA is then amplified by a real time PCR reaction. The level of expression of a target gene is calculated using the crossing thresholds (CTs) or crossing points (CPs) which correspond to the numbers of cycles required for a target gene and the housekeeping, internal control gene, to reach a defined fluorescence intensity." ;
    ct:CDISC%20Submission%20Value "QUANTITATIVE REVERSE TRANSCRIPTASE POLYMERASE CHAIN REACTION" ;
    ct:CDISC%20Synonym%28s%29 "qRT-PCR; Real-Time Reverse Transcriptase PCR; rRT-PCR" ;
    ct:Code "C28408" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Quantitative Reverse Transcriptase PCR" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C28654>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An imaging technique in which X-ray images of the renal pelvis and urinary tract obtained after injection of a radiopaque substance into the ureter, usually done via a cystoscope." ;
    ct:CDISC%20Submission%20Value "RETROGRADE PYELOGRAPHY" ;
    ct:Code "C28654" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Retrograde Pyelogram" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C29934>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Magnetic resonance spectroscopy is a noninvasive imaging technique that operates by exciting and recording signals from a range of magnetic resonance frequencies, allowing the identification and quantification of several biologically significant molecules containing proton groups that resonate in the appropriate frequency range. The technique facilitates observation of the spatial distribution of metabolic patterns over a region of interest and surrounding tissue at a high spatial resolution. (NCI)" ;
    ct:CDISC%20Submission%20Value "MRS" ;
    ct:CDISC%20Synonym%28s%29 "Magnetic Resonance Spectroscopy" ;
    ct:Code "C29934" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Magnetic Resonance Spectroscopic Imaging" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C38036>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Testing conducted utilizing a manual or microprocessor audiometer to test for hearing loss." ;
    ct:CDISC%20Submission%20Value "AUDIOMETRY" ;
    ct:Code "C38036" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Audiometric Test" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C38054>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A technique used to capture and record spontaneous electrical activity of the brain by the application of electrodes to the scalp." ;
    ct:CDISC%20Submission%20Value "EEG" ;
    ct:CDISC%20Synonym%28s%29 "ELECTROENCEPHALOGRAPHY" ;
    ct:Code "C38054" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Electroencephalography" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C38056>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method to assess skeletal muscle function and nerve control, obtained by recording and studying the intrinsic electrical properties of the muscles." ;
    ct:CDISC%20Submission%20Value "ELECTROMYOGRAPHY" ;
