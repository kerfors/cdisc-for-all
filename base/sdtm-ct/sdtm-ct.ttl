.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C20177>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An imaging technique in which X-ray images of the renal pelvis and urinary tract are obtained after intravenous injection of a radiopaque substance." ;
    ct:CDISC%20Submission%20Value "INTRAVENOUS PYELOGRAPHY" ;
    ct:CDISC%20Synonym%28s%29 "IVP" ;
    ct:Code "C20177" ;
