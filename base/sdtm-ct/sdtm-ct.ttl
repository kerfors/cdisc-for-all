    ct:CDISC%20Synonym%28s%29 "T Wave Amplitude, Single Beat" ;
    ct:Code "C117815" ;
    ct:Codelist%20Code "C71153" ;
    ct:Codelist%20Name "ECG Test Code" ;
    ct:NCI%20Preferred%20Term "T Wave Amplitude Single Beat" ;
.

