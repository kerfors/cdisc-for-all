    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Junctional Bradycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71076>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding suggestive of a hypertrophied left ventricle, characterized by large QRS amplitudes and secondary findings of left atrial enlargement, left axis deviation, or typical pattern of ST depression and T wave inversion." ;
    ct:CDISC%20Submission%20Value "LEFT VENTRICULAR HYPERTROPHY" ;
    ct:CDISC%20Synonym%28s%29 "Left Ventricular Hypertrophy" ;
    ct:Code "C71076" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Left Ventricular Hypertrophy by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71077>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding suggestive of a hypertrophied right ventricle, characterized by large R wave amplitudes in the right precordial leads and secondary findings of right atrial enlargement, right axis deviation, and typical pattern of ST depression and T wave inversion in the right precordial leads." ;
    ct:CDISC%20Submission%20Value "RIGHT VENTRICULAR HYPERTROPHY" ;
    ct:CDISC%20Synonym%28s%29 "Right ventricular Hypertrophy" ;
    ct:Code "C71077" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Right Ventricular Hypertrophy by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71078>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a QRS amplitude less than or equal to 0.5 mV in the limb leads or QRS amplitude less than or equal to 1 mV in the precordial leads." ;
