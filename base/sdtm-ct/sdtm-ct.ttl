    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "New Anterior Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C102733>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves in leads V3 through V6, which is suggestive of myocardial infarction of the anterolateral wall of the left ventricle and which is new compared to prior ECGs." ;
