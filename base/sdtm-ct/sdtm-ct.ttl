    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Indirect Digital Radiography" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C209650>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An assay to assess the opsonophagocytic killing activity of antibodies that measures the functionality of phagocytic immune cells by incubating different dilutions of co-cultured bacteria, sera, and complement, and then quantifying the percent bacterial survival of a single serotype relative to serum-negative controls." ;
