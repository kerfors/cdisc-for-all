    ct:NCI%20Preferred%20Term "Triple-Phase Spiral CT" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C19935>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "In MALDI-TOF, a laser pulse is fired into a protein or peptide sample contained in a light-absorbing matrix. A small explosion vaporizes and ionizes the sample. In the presence of a high electric field, peptide ions are accelerated down an evacuated flight tube. Because large particles travel more slowly than small ones, the masses of the ionized particles are determined by measuring their arrival time at the end of the tube." ;
    ct:CDISC%20Submission%20Value "MALDI-TOF" ;
    ct:CDISC%20Synonym%28s%29 "Matrix-Assisted Laser Desorption/Ionization-Time of Flight Mass Spectrometry" ;
    ct:Code "C19935" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Matrix-Assisted Laser Desorption/Ionization-Time of Flight Mass Spectrometry" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C20055>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Any of a number of molecular biological techniques that are used to copy nucleic acid sequences within a specimen, leading to an increase in the number of copies of that sequence of interest. These techniques may be used for detection of a particular gene or microorganism of interest." ;
    ct:CDISC%20Submission%20Value "NUCLEIC ACID AMPLIFICATION TEST" ;
    ct:CDISC%20Synonym%28s%29 "NAAT" ;
    ct:Code "C20055" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Nucleic Acid Amplification Test" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C20059>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A type of spectroscopy that measures power spectral density of surface morphology by exploiting the tendency of light to disperse into a range of directions as a result of physical interaction." ;
    ct:CDISC%20Submission%20Value "LIGHT SCATTERING SPECTROSCOPY" ;
    ct:CDISC%20Synonym%28s%29 "LiSSP" ;
    ct:Code "C20059" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Light-Scattering Spectroscopy" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C20080>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "The X-ray examination of blood vessels or chambers of the heart after introduction of a radiopaque substance." ;
