    ct:NCI%20Preferred%20Term "Old or Age Indeterminate Lateral Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C102691>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in leads V1 or V2 of an initial R wave duration greater than or equal to 40 ms, R wave greater than S wave, and upright T wave, which is suggestive of myocardial infarction of the posterior wall of the left ventricle, without evidence of current or ongoing acute infarction. Evidence of inferior or lateral myocardial infarction is usually also present." ;
    ct:CDISC%20Submission%20Value "OLD OR AGE INDETERMINATE POSTERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Old Or Age Indeterminate Posterior Wall Myocardial Infarction" ;
    ct:Code "C102691" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Old or Age Indeterminate Posterior Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C102692>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding, in the presence of an old or age indeterminate inferior wall myocardial infarction, of Q waves greater than or equal to 40 ms in duration in the right ventricular leads V4R through V6R." ;
    ct:CDISC%20Submission%20Value "OLD OR AGE UNDETERMINED RIGHT VENTRICULAR MYOCARDIAL INFARCTION" ;
    ct:Code "C102692" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Old or Age Indeterminate Right Ventricular Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C102693>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves in leads V1, V2 and often V3, which is suggestive of myocardial infarction of the intraventricular septum, without evidence of current or ongoing acute infarction." ;
    ct:CDISC%20Submission%20Value "OLD OR AGE INDETERMINATE SEPTAL WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Old Or Age Indeterminate Septal Wall Myocardial Infarction" ;
    ct:Code "C102693" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Old or Age Indeterminate Septal Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C102701>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which the frontal plane QRS axis cannot be calculated." ;
