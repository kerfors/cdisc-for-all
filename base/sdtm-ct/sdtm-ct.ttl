<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C114118/C16735>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A process that provides the subject with explanations that will help in making decisions about whether to begin or continue participating in a study, after having achieved an understanding of the potential risks and benefits. Informed consent is an ongoing, interactive process rather than a one-time information session." ;
    ct:CDISC%20Submission%20Value "INFORMED CONSENT OBTAINED" ;
    ct:Code "C16735" ;
    ct:Codelist%20Code "C114118" ;
    ct:Codelist%20Name "Protocol Milestone" ;
    ct:NCI%20Preferred%20Term "Informed Consent" ;
.

