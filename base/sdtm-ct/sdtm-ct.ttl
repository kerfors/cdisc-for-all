<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C99078/C1909>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An active natural, synthetic or semi-synthetic ingredient including endogenous body substance that is intended to furnish pharmacological activity or other direct effect in the diagnosis, cure, mitigation, treatment, or prevention of disease or to affect the structure or any function of the human body, but does not include intermediates used in the synthesis of such ingredient (21 CFR 314.3(b))." ;
    ct:CDISC%20Submission%20Value "DRUG" ;
    ct:Code "C1909" ;
