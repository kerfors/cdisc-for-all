    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C101596>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding showing a current of injury with ST elevation. No specification is provided for localization." ;
    ct:CDISC%20Submission%20Value "ACUTE MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Acute Myocardial Infarction" ;
    ct:Code "C101596" ;
