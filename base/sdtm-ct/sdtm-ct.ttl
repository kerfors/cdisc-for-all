    ct:CDISC%20Definition "V2 electrode (+) placed in the 6th intercostal space on the left side of the thorax along a line parallel to the level of the point of the shoulder. (NCI)" ;
    ct:CDISC%20Submission%20Value "LEAD CV6LU" ;
    ct:Code "C90407" ;
    ct:Codelist%20Code "C90013" ;
