    ct:CDISC%20Definition "A bipolar electrocardiogram limb lead which records the voltage between the negative electrode on the right thoracic limb and the positive electrode on the left pelvic limb. (NCI)" ;
    ct:CDISC%20Submission%20Value "LEAD II" ;
    ct:Code "C90409" ;
    ct:Codelist%20Code "C90013" ;
