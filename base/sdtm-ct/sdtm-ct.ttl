    ct:NCI%20Preferred%20Term "Intravenous Pyelography" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C202396>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method for blood pressure measurement in which the motion of flow within a cannulated peripheral artery is transmitted to a transducer that converts the information into electrical signals." ;
    ct:CDISC%20Submission%20Value "INTRA-ARTERIAL DIFFERENTIAL PRESSURE TRANDUCTION" ;
    ct:Code "C202396" ;
    ct:Codelist%20Code "C85492" ;
