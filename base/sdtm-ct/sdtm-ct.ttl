    ct:CDISC%20Definition "An intimate mixture of dry, finely divided drugs and/or chemicals that may be intended for internal or external use. (NCI)" ;
    ct:CDISC%20Submission%20Value "POWDER" ;
    ct:Code "C42972" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
    ct:NCI%20Preferred%20Term "Powder Dosage Form" ;
.

