    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a P wave that does not conduct to the ventricle or result in ventricular activation." ;
    ct:CDISC%20Submission%20Value "NONCONDUCTED P WAVE PHYSIOLOGY NOT DEFINED" ;
    ct:Code "C135394" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Nonconducted P Wave Physiology Not Defined by ECG Finding" ;
.

