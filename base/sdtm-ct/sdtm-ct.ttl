    ct:CDISC%20Definition "An electrocardiographic finding of an abnormally wide QRS complex(es) of supraventricular origin with prolonged QRS duration due to aberrant AV conduction." ;
    ct:CDISC%20Submission%20Value "ABERRANTLY CONDUCTED COMPLEXES" ;
    ct:CDISC%20Synonym%28s%29 "Aberrantly Conducted Beats" ;
    ct:Code "C116132" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Aberrantly Conducted Complexes by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C116133>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of small QRS amplitudes (less than 500 microvolts) in all limb leads." ;
    ct:CDISC%20Submission%20Value "LOW VOLTAGE - LIMB LEADS ONLY" ;
    ct:Code "C116133" ;
