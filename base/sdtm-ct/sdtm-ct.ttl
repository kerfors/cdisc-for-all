    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A mathematical formula that normalizes transcript fragment counts based on the total number of transcript fragments that are sequenced. CPM equals the number of reads divided by the number of sequenced transcript fragments, and multiplied by 1,000,000." ;
    ct:CDISC%20Submission%20Value "COUNTS PER MILLION FORMULA" ;
    ct:CDISC%20Synonym%28s%29 "CPM" ;
