    ct:Codelist%20Name "ECG Test Name" ;
    ct:NCI%20Preferred%20Term "Minimum JT Duration" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71152/C62117>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "The maximum duration (time) of the JT interval, obtained from a set of measurements of the JT interval. The JT interval is defined as the time from the J point (end of ventricular depolarization, the point at which the QRS meets the ST segment) to the end of the T wave (representing the end of ventricular repolarization). (NCI)" ;
    ct:CDISC%20Submission%20Value "Summary (Max) JT Interval" ;
    ct:CDISC%20Synonym%28s%29 "Summary (Max) JT Interval" ;
    ct:Code "C62117" ;
    ct:Codelist%20Code "C71152" ;
    ct:Codelist%20Name "ECG Test Name" ;
    ct:NCI%20Preferred%20Term "Maximum JT Duration" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71152/C62125>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "The minimum duration (time) of the PR interval, obtained from a set of measurements of the PR interval. The PR interval is defined as the time from the beginning of the P wave (representing the onset of atrial depolarization) to the beginning of the R wave (representing the onset of ventricular depolarization). In some cases, a Q wave will precede the R wave, in which case the PR interval is measured from the beginning of the P wave to the beginning of the Q wave. (NCI)" ;
    ct:CDISC%20Submission%20Value "Summary (Min) PR Duration" ;
    ct:CDISC%20Synonym%28s%29 "Summary (Min) PR Duration" ;
    ct:Code "C62125" ;
    ct:Codelist%20Code "C71152" ;
    ct:Codelist%20Name "ECG Test Name" ;
    ct:NCI%20Preferred%20Term "Minimum PR Duration" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71152/C62131>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "The maximum duration (time) of the PR interval, obtained from a set of measurements of the PR interval. The PR interval is defined as the time from the beginning of the P wave (representing the onset of atrial depolarization) to the beginning of the R wave (representing the onset of ventricular depolarization). In some cases, a Q wave will precede the R wave, in which case the PR interval is measured from the beginning of the P wave to the beginning of the Q wave. (NCI)" ;
    ct:CDISC%20Submission%20Value "Summary (Max) PR Duration" ;
    ct:CDISC%20Synonym%28s%29 "Summary (Max) PR Duration" ;
    ct:Code "C62131" ;
    ct:Codelist%20Code "C71152" ;
    ct:Codelist%20Name "ECG Test Name" ;
    ct:NCI%20Preferred%20Term "Maximum PR Duration" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71152/C62133>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "The minimum duration (time) of the QT interval, obtained from a set of measurements of the QT interval. The QT interval is defined as the time from the beginning of the QRS complex to the end of the T wave, representing the time it takes for the ventricles to depolarize and subsequently repolarize. In some cases, the Q wave will be absent, in which case the QT interval is measured from the beginning of the R wave to the end of the T wave. (NCI)" ;
    ct:CDISC%20Submission%20Value "Summary (Min) QT Duration" ;
    ct:CDISC%20Synonym%28s%29 "Summary (Min) QT Duration" ;
    ct:Code "C62133" ;
    ct:Codelist%20Code "C71152" ;
    ct:Codelist%20Name "ECG Test Name" ;
    ct:NCI%20Preferred%20Term "Minimum QT Duration" ;
.

