    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A technique for measuring anatomical densities in which two X-ray beams at different energy levels are aimed at the anatomical location of interest and x-ray absorption is assessed." ;
    ct:CDISC%20Submission%20Value "DXA SCAN" ;
    ct:CDISC%20Synonym%28s%29 "DEXA Scan" ;
    ct:Code "C48789" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Dual X-ray Absorptiometry" ;
.

