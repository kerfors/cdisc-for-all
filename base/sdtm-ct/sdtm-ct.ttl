.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C202400>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An in vitro assay that is used to detect the presence of antibodies or antigens of interest by evaluating whether particles (cells, beads, etc.) clump together in response to the introduction of a specific antibody or complement." ;
    ct:CDISC%20Submission%20Value "AGGLUTINATION ASSAY" ;
    ct:Code "C202400" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Immunoagglutination Assay" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C202401>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An immunoassay in which an antigen of interest and neutralizing antibodies that are specific to the antigen are added to cells in culture that express proteins that are targets of the antigen. Antigen function is then measured to determine the neutralizing effects of the antibodies." ;
    ct:CDISC%20Submission%20Value "CELL BASED NEUTRALIZING ANTIBODY ASSAY" ;
    ct:Code "C202401" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Cell Based Neutralizing Antibody Assay" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C202402>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A type of reverse transcriptase-polymerase chain reaction combined with electrophoresis. After real-time PCR reaction, amplified gene products undergo electrophoretic separation and the level of expression of the target gene is determined by measuring the intensity of the gel bands corresponding to the target gene amplicon normalized to a housekeeping, internal control gene." ;
    ct:CDISC%20Submission%20Value "SEMI-QUANTITATIVE REVERSE TRANSCRIPTASE POLYMERASE CHAIN REACTION" ;
    ct:CDISC%20Synonym%28s%29 "sqRT-PCR" ;
    ct:Code "C202402" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Semi-Quantitative Reverse Transcriptase Polymerase Chain Reaction" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C202403>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An analytical technique wherein high performance liquid chromatography is coupled to accelerator mass spectrometry in order to separate, identify, and quantify substances in a sample." ;
    ct:CDISC%20Submission%20Value "HPLC/AMS" ;
    ct:CDISC%20Synonym%28s%29 "High Performance Liquid Chromatography/Accelerator Mass Spectrometry" ;
    ct:Code "C202403" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "High Performance Liquid Chromatography/Accelerator Mass Spectrometry" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C202404>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A process to measure the proximity of two fluorochromes whereby the excitation energy of one fluorochrome is released and absorbed by the second fluorochrome. It is used to study interactions and structure of macromolecules. (NCI)" ;
    ct:CDISC%20Submission%20Value "FLUORESCENCE RESONANCE ENERGY TRANSFER" ;
    ct:CDISC%20Synonym%28s%29 "Forster Resonance Energy Transfer; FRET" ;
    ct:Code "C202404" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Fluorescence Resonance Energy Transfer" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C202406>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method of measuring cardiac output by rapidly injecting a known quantity of dye through a central venous catheter and then monitoring arterial blood at fixed time intervals to determine the change in concentration of dye over time." ;
    ct:CDISC%20Submission%20Value "DYE DILUTION METHOD" ;
    ct:Code "C202406" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Dye Dilution Method Measurement" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C202407>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A type of blood cell analysis that uses impedance, conductivity, and laser scatter to measure cell volume, cell size, chemical composition, nuclear volume, cellular granularity, nuclear structure, and cell surface characteristics." ;
    ct:CDISC%20Submission%20Value "VOLUME CONDUCTIVITY SCATTER METHOD" ;
    ct:CDISC%20Synonym%28s%29 "VCS Method" ;
    ct:Code "C202407" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Volume Conductivity Scatter Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C202408>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A type of computed tomography that is used to construct images of blood vessels." ;
    ct:CDISC%20Submission%20Value "CT ANGIOGRAPHY" ;
    ct:CDISC%20Synonym%28s%29 "Computed Tomography Angiography; CT Scan Angiography; CTA" ;
    ct:Code "C202408" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Computed Tomography Angiography" ;
.

