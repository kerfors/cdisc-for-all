    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding for the P wave that is atypical either for the shape, duration, amplitude, axis or polarity. Abnormality of the P wave signifies aberrant propagation of the electrical impulse through the atria. (NCI)" ;
    ct:CDISC%20Submission%20Value "P WAVE ABNORMALITY" ;
    ct:CDISC%20Synonym%28s%29 "P Wave Abnormality" ;
    ct:Code "C90430" ;
