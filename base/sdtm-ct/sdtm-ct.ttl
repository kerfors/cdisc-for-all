<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C101846/C142242>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "The weight of the left ventricle in grams as estimated by a formula that uses estimated measurements from echocardiographic exams, as well as constants like the specific gravity of the myocardium. Left ventricular mass is estimated using the following equation, LV Mass (g) = 0.8 {1.04[([LVEDD + IVSd + PWd]^3 - LVEDD^3)]} + 0.6, where LVEDD is LV end-diastolic dimension, IVSd is interventricular septal thickness at end-diastole, and PWd is posterior wall thickness at end-diastole." ;
    ct:CDISC%20Submission%20Value "Left Ventricular Mass, Estimated" ;
    ct:CDISC%20Synonym%28s%29 "Left Ventricular Mass, Estimated" ;
    ct:Code "C142242" ;
    ct:Codelist%20Code "C101846" ;
    ct:Codelist%20Name "Cardiovascular Test Name" ;
    ct:NCI%20Preferred%20Term "Estimated Mass of Left Ventricle" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C101846/C142243>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "The left ventricular mass divided by the subject's body surface area." ;
    ct:CDISC%20Submission%20Value "Left Ventricular Mass Index" ;
    ct:CDISC%20Synonym%28s%29 "Left Ventricular Mass Index" ;
    ct:Code "C142243" ;
    ct:Codelist%20Code "C101846" ;
    ct:Codelist%20Name "Cardiovascular Test Name" ;
    ct:NCI%20Preferred%20Term "Left Ventricular Mass Index" ;
.

