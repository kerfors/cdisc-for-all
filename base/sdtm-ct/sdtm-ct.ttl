    ct:CDISC%20Definition "An electrocardiographic finding of an RR interval with duration greater than 3.0 seconds, regardless of the underlying rhythm." ;
    ct:CDISC%20Submission%20Value "PAUSE GREATER THAN 3.0 SECONDS" ;
    ct:Code "C119251" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Pause Greater Than Three Seconds by ECG Finding" ;
.

