.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C80407>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An echocardiographic technique in which an image of the heart is produced by ultrasonography under conditions (e.g., exercise, pharmacologic agents or pacing) intended to elicit signs and symptoms of myocardial ischemia." ;
    ct:CDISC%20Submission%20Value "STRESS ECHOCARDIOGRAPHY" ;
    ct:Code "C80407" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Stress Echocardiography Test" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C82392>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A type of magnetic resonance imaging that uses an inversion recovery sequence with a long inversion time to null fluids present in the imaging area, improving clarity of the object of interest." ;
    ct:CDISC%20Submission%20Value "FLUID ATTENUATED INVERSION RECOVERY MRI" ;
    ct:CDISC%20Synonym%28s%29 "FLAIR MRI" ;
    ct:Code "C82392" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Fluid Attenuated Inversion Recovery MRI" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85397>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method used to measure the breathing capacity of the lung by means of a spirometer." ;
    ct:CDISC%20Submission%20Value "SPIROMETRY" ;
    ct:Code "C85397" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Spirometry" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85554>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that utilizes acridine orange, a fluorescent cationic dye that is selective for nucleic acids, to determine the presence of viable cells or microorganisms in a sample. Acridine orange interacts with RNA and DNA and the lysosomal compartment of cells." ;
    ct:CDISC%20Submission%20Value "ACRIDINE ORANGE STAIN" ;
    ct:Code "C85554" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Acridine Orange Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85555>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method to determine microbial susceptibility to antibiotics in which test bacteria is inoculated onto agar plates with serial dilutions of know quantities of antibiotics. The minimum inhibitory concentration of antibiotic is assessed." ;
    ct:CDISC%20Submission%20Value "AGAR DILUTION" ;
    ct:Code "C85555" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Agar Dilution Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85556>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method to determine microbial susceptibility to high concentrations of aminoglycoside antibiotics." ;
    ct:CDISC%20Submission%20Value "HIGH LEVEL AMINOGLYCOSIDE SCREEN" ;
    ct:Code "C85556" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Aminoglycoside Screening Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85557>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method used to detect organisms that have resistance to a single concentration of antibiotics in an agar matrix." ;
    ct:CDISC%20Submission%20Value "ANTIBIOTIC AGAR SCREEN" ;
    ct:Code "C85557" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Antibiotic Agar Screening Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85558>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method to determine the microbial susceptibility to two or more antibiotics. Numerical result translated into indifference, antagonism, synergism, or additive." ;
    ct:CDISC%20Submission%20Value "ANTIMICROBIAL COMBINATION TESTING" ;
    ct:Code "C85558" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Antimicrobial Combination Testing Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85573>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Listening with a device, such as a stethoscope, to anatomical locations that produce audible sounds like the heart, lungs and abdomen." ;
    ct:CDISC%20Submission%20Value "AUSCULTATION" ;
    ct:Code "C85573" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Auscultation" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85574>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A spectrometric method that determines the type and concentration of metal elements in a sample, based upon the principle that each elemental metal absorbs a particular wavelength of ultraviolet light when exposed to heat." ;
    ct:CDISC%20Submission%20Value "ATOMIC ABSORPTION SPECTROMETRY" ;
    ct:Code "C85574" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Atomic Absorption Spectroscopy" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85576>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A test that detects beta lactamase produced by Staphylococcus species, Haemophilus species, Moraxella catarrhalis, and Neisseria gonorrhoeae." ;
    ct:CDISC%20Submission%20Value "BETA LACTAMASE" ;
    ct:Code "C85576" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Beta Lactamase Screening Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85577>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that utilizes calcofluor, a fluorescent dye that preferentially stains chitin and cellulose on the cell walls of fungi, parasites, and some cysts of the Pneumocystis genus." ;
    ct:CDISC%20Submission%20Value "CALCOFLUOR WHITE STAIN" ;
    ct:Code "C85577" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Calcofluor White Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85595>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method to determine microbial susceptibility to antibiotics in which filter paper disks containing known concentrations of antibiotics are placed on the agar surface that has been previously inoculated with the bacteria of interest. Microbial susceptibility is assessed by measuring the area around the disk that is free of microbial growth." ;
    ct:CDISC%20Submission%20Value "DISK DIFFUSION" ;
    ct:Code "C85595" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Disk Diffusion Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85596>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method to determine microbial susceptibility to antibiotics in which a plastic strip impregnated with the antibiotic of interest is placed on an agar plate that has been inoculated with bacteria. The antibiotic diffuses from the strip producing a concentration gradient of drug on the agar. The point at which the elliptical shaped area of growth inhibition meets the strip is the minimum inhibitory concentration of the drug of interest." ;
    ct:CDISC%20Submission%20Value "EPSILOMETER" ;
    ct:Code "C85596" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Epsilometry" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85598>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that utilizes Giemsa, a mixture of ethylene blue and eosin, which forms purplish-black crystals when dried. This stain preferentially binds to the phosphate groups of DNA and aggregates at areas with an increase in adenine-thymine binding, thus leading to chromosomal staining patterns that lend themselves to g-banding analysis. Additionally Giemsa can be used as a differential stain to determine microbial cell adherence to human cells as well as in the diagnosis of malaria, spirochete, and protozoal infections." ;
    ct:CDISC%20Submission%20Value "GIEMSA STAIN" ;
    ct:Code "C85598" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Giemsa Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85599>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method to determine microbial susceptibility to antibiotics in which an agar plate, which has a concentration gradient of the drug within the agar, is streaked with the microorganism of interest. Microbial susceptibility as well as minimum inhibitory concentration of antibiotic is assessed." ;
    ct:CDISC%20Submission%20Value "GRADIENT DIFFUSION" ;
    ct:Code "C85599" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Gradient Diffusion Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85642>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that utilizes India Ink, a water soluble carbon-based black ink, to determine the presence of microorganisms that are surrounded by a gelatinous capsule. This is a negative staining method in which background is stained in black and the microbes and microscopic structures of interest remain white." ;
    ct:CDISC%20Submission%20Value "INDIA INK STAIN" ;
    ct:Code "C85642" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "India Ink Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85643>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A spectrometric method that determines the type and concentration of elements or chemicals in a sample, based upon the principle that the atoms in a sample will vibrate or rotate at a specific frequency when exposed to infrared light." ;
    ct:CDISC%20Submission%20Value "INFRARED SPECTROMETRY" ;
    ct:Code "C85643" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Infrared Spectrometry" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85649>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that utilizes Iodine, an element belonging to the halogen group, which specifically stains polysaccharides such as cellulose, chitin, glycogen, and starch a blue color." ;
    ct:CDISC%20Submission%20Value "IODINE STAIN" ;
    ct:Code "C85649" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Iodine Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85650>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that utilizes a mixture of iron and hematoxylin to visualize intracellular structures in a microscopic sample. In this dye system, iron acts as a mordant to hematoxylin rendering it insoluble, thereby allowing irreversible blue-black colored dyeing to the cell nucleus." ;
    ct:CDISC%20Submission%20Value "IRON HEMATOXYLIN STAIN" ;
    ct:Code "C85650" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Iron Hematoxylin Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85651>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy acid fast staining method that utilizes kinyoun carbol fuchsin, a dye containing basic fuchsin in solution with ethyl alcohol and aqueous phenol. This acid fast staining technique does not require heating during the primary staining step involving the carbol fuchsin." ;
    ct:CDISC%20Submission%20Value "KINYOUN STAIN" ;
    ct:Code "C85651" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Kinyoun Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85697>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method to determine the minimum inhibitory concentration (MIC) of antibiotics in which growth media is pipetted into a test tube. Each tube contains a known concentration of drug and is inoculated with a known quantity of bacteria. The tubes are incubated for a specified period of time and each is assessed for bacterial cell growth. The drug concentration in the first tube showing no growth is known as the MIC for that antibiotic." ;
    ct:CDISC%20Submission%20Value "MACRO BROTH DILUTION" ;
    ct:Code "C85697" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Macro Broth Dilution Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85701>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A method to determine the minimum inhibitory concentration (MIC) of antibiotics in which growth media is pipetted into a multi-well plate. Each well contains a known concentration of drug which is inoculated with a known quantity of bacteria. The plate is incubated for a specified period of time and each well is assessed for bacterial cell growth. The drug concentration in the first well showing no growth is known as the MIC for that antibiotic." ;
    ct:CDISC%20Submission%20Value "MICRO BROTH DILUTION" ;
    ct:Code "C85701" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Micro Broth Dilution Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85702>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Any technique in which a sample is condensed in order to afford greater sensitivity for the detection of microorganisms." ;
    ct:CDISC%20Submission%20Value "MICROBIAL CONCENTRATION" ;
    ct:Code "C85702" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Microbial Concentration Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85736>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method, that does not utilize heat in the slide preparation, used to examine a specimen for the presence of acid-fast microorganisms, specifically nocardia." ;
    ct:CDISC%20Submission%20Value "MODIFIED ACID FAST STAIN" ;
    ct:Code "C85736" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Modified Acid Fast Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85776>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A quantification of the amount of light that is absorbed by or transmitted through a substance." ;
    ct:CDISC%20Submission%20Value "OPTICAL DENSITY MEASUREMENT" ;
    ct:Code "C85776" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Optical Density Measurement" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85801>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that utilizes a modified trichrome stain to determine the presence of microspordial, sporulating species. This staining technique substitutes aniline blue for the fast green counterstain of the original trichrome staining method and decreased levels of phosphotungstic acid in the reagent." ;
    ct:CDISC%20Submission%20Value "RYAN BLUE STAIN" ;
    ct:Code "C85801" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Ryan Blue Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85819>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A blood smear technique used to make a thick blood smear on a microscope slide which is generally used to look for blood parasites such as those causing malaria." ;
    ct:CDISC%20Submission%20Value "THICK SMEAR" ;
    ct:Code "C85819" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Thick Smear Technique" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85820>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A blood smear technique used to make a thin blood smear on a microscope slide which is generally used to look for blood parasites such as those causing malaria." ;
    ct:CDISC%20Submission%20Value "THIN SMEAR" ;
    ct:Code "C85820" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Thin Smear Technique" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85828>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that utilizes a modified trichrome stain to determine the presence of microspordial, sporulating species. The staining method utilizes chromotrope 2R, a red acidic dye, the counterstain fast green, and phosphotungstic acid." ;
    ct:CDISC%20Submission%20Value "WEBER GREEN STAIN" ;
    ct:Code "C85828" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Weber Green Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85829>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy staining method that utilizes the Romanowsky stains, eosin and methylene blue, solubilized in methanol. In this staining protocol, methanol is also utilized as a fixative agent prior to staining." ;
    ct:CDISC%20Submission%20Value "WRIGHT STAIN" ;
    ct:Code "C85829" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Wright Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85830>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A spectrometric method that determines the type and concentration of elements or chemicals in a sample, based upon the principle that each element emits fluorescent light of a particular wavelength when exposed to an X-ray." ;
    ct:CDISC%20Submission%20Value "X-RAY FLUORESCENCE SPECTROMETRY" ;
    ct:Code "C85830" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "X-Ray Fluorescence Spectrometry" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85831>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopy acid fast staining method that utilizes Ziehl-Neelsen carbol fuchsin, acid alcohol and methylene blue, to determine the presence of acid fast microorganisms. This acid fast staining technique requires heating during the primary staining step involving the carbol fuchsin." ;
    ct:CDISC%20Submission%20Value "ZIEHL NEELSEN ACID FAST STAIN" ;
    ct:Code "C85831" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Ziehl Neelsen Acid Fast Staining Method" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C85492/C85837>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A microscopic technique in which the light that does not come into contact with the structure or details of interest is subtracted from the ocular image. This yields an image in which the structure or details are alight while the areas where the structures or details are absent are dark." ;
    ct:CDISC%20Submission%20Value "DARK FIELD MICROSCOPY" ;
    ct:Code "C85837" ;
    ct:Codelist%20Code "C85492" ;
    ct:Codelist%20Name "Method" ;
    ct:NCI%20Preferred%20Term "Dark Field Microscopy" ;
.

