.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C161047>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of two supraventricular QRS complexes followed by a premature supraventricular complex for 3 or more consecutive cycles; a regularly irregular rhythm of normal and abnormal QRS complexes in a 2-1 ratio." ;
    ct:CDISC%20Submission%20Value "SUPRAVENTRICULAR TRIGEMINY" ;
    ct:Code "C161047" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Supraventricular Trigeminy by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C202347>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of an atrial tachycardia that lasts 30 seconds or longer." ;
    ct:CDISC%20Submission%20Value "SUSTAINED ATRIAL TACHYCARDIA" ;
    ct:Code "C202347" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Sustained Atrial Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C202348>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of idioventricular rhythm with a rate greater than 50 beats per minute that terminates in less than 30 seconds." ;
    ct:CDISC%20Submission%20Value "NON-SUSTAINED ACCELERATED IDIOVENTRICULAR RHYTHM" ;
    ct:Code "C202348" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Non-Sustained Accelerated Idioventricular Rhythm by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C202349>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of idioventricular rhythm with a rate greater than 50 beats per minute that lasts 30 seconds or longer." ;
    ct:CDISC%20Submission%20Value "SUSTAINED ACCELERATED IDIOVENTRICULAR RHYTHM" ;
    ct:Code "C202349" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Sustained Accelerated Idioventricular Rhythm by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C34902>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An episodic form of ventricular tachycardia, with abrupt onset and termination. (NCI)" ;
    ct:CDISC%20Submission%20Value "PAROXYSMAL VENTRICULAR TACHYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Paroxysmal Ventricular Tachycardia" ;
    ct:Code "C34902" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Paroxysmal Ventricular Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C34940>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding characterized by a premature activation of the whole or some part of the ventricle." ;
    ct:CDISC%20Submission%20Value "PRE-EXCITATION" ;
    ct:CDISC%20Synonym%28s%29 "Pre-excitation; Ventricular preexcitation" ;
    ct:Code "C34940" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Pre-Excitation Syndrome" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C35058>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a regular supraventricular tachycardia due to reentry within the AV node. It is characterized by P waves which typically occurs nearly simultaneously with the QRS complex, resulting in a P wave which is obscured by the QRS, merged with the QRS or which may follow the QRS." ;
    ct:CDISC%20Submission%20Value "AV NODE RE-ENTRY" ;
    ct:CDISC%20Synonym%28s%29 "AV Node Reentrant Supraventricular Tachycardia" ;
    ct:Code "C35058" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Atrioventricular Nodal Reentry Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C35059>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a junctional rhythm with a heart rate which is abnormally elevated." ;
    ct:CDISC%20Submission%20Value "JUNCTIONAL TACHYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Junctional tachycardia" ;
    ct:Code "C35059" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Junctional Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C35132>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of ventricular pre-excitation. The syndrome is characterized by a short PR interval and a long QRS interval with a delta wave." ;
    ct:CDISC%20Submission%20Value "WOLFF-PARKINSON-WHITE SYNDROME" ;
    ct:CDISC%20Synonym%28s%29 "Wolff-Parkinson-White syndrome; WPW" ;
    ct:Code "C35132" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Wolff-Parkinson-White Syndrome" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C35303>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves in leads V3 through V6, which is suggestive of myocardial infarction of the anterolateral wall of the left ventricle." ;
    ct:CDISC%20Submission%20Value "ANTEROLATERAL WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Anterolateral Wall Myocardial Infarction" ;
    ct:Code "C35303" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Anterolateral Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C35304>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves in leads V1 through V4, which is suggestive of myocardial infarction of the anteroseptal wall of the left ventricle." ;
    ct:CDISC%20Submission%20Value "ANTEROSEPTAL WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Anteroseptal MI; Anteroseptal Wall Myocardial Infarction" ;
    ct:Code "C35304" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Anteroseptal Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C35398>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves in leads III, aVF and often II, which is suggestive of myocardial infarction of the inferior wall of the left ventricle." ;
    ct:CDISC%20Submission%20Value "INFERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Inferior MI; Inferior Wall Myocardial Infarction" ;
    ct:Code "C35398" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Inferior Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C35399>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in leads V1 or V2 of an initial R wave duration greater than or equal to 40 ms, R wave greater than S wave, and upright T wave, which is suggestive of myocardial infarction of the posterior wall of the left ventricle. Evidence of inferior or lateral myocardial infarction is usually also present." ;
    ct:CDISC%20Submission%20Value "POSTERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Posterior MI; Posterior Wall Myocardial Infarction" ;
    ct:Code "C35399" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Posterior Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C35519>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding suggesting an infarction in the anatomic location of the cardiac septum. (NCI)" ;
    ct:CDISC%20Submission%20Value "SEPTAL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Septal myocardial infarction" ;
    ct:Code "C35519" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Septal Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C35586>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves in leads V5, V6, I and aVL, which is suggestive of myocardial infarction of the lateral wall of the left ventricle." ;
    ct:CDISC%20Submission%20Value "LATERAL WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Lateral MI; Lateral Wall Myocardial Infarction" ;
    ct:Code "C35586" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Lateral Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C41330>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of ST segment depression below the baseline, often described as up sloping, down sloping or horizontal. (NCI)" ;
    ct:CDISC%20Submission%20Value "ST DEPRESSION" ;
    ct:CDISC%20Synonym%28s%29 "ST depression" ;
    ct:Code "C41330" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "ST Segment Depression by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C50540>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of ST segment elevation above the baseline. (NCI)" ;
    ct:CDISC%20Submission%20Value "ST ELEVATION" ;
    ct:CDISC%20Synonym%28s%29 "ST elevation" ;
    ct:Code "C50540" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "ST Segment Elevation by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C50553>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which impaired conduction or automaticity within the sinus node results in the failure of impulse transmission from the sinoatrial node. This is manifest as dropped P waves during sinus rhythm." ;
    ct:CDISC%20Submission%20Value "SINOATRIAL EXIT BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "SA Block; Sinoatrial Block; Sinoatrial exit block" ;
    ct:Code "C50553" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Exit Block by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C50599>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of three or more consecutive complexes of ventricular origin with a rate less than a certain threshold. The QRS complexes are wide and have an abnormal morphology." ;
    ct:CDISC%20Submission%20Value "IDIOVENTRICULAR RHYTHM" ;
    ct:CDISC%20Synonym%28s%29 "Idioventricular Rhythm" ;
    ct:Code "C50599" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Idioventricular Rhythm" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C50779>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of an atypical rapid polymorphic ventricular tachycardia with a characteristic rotation of the QRS complex around the isoelectric baseline, occurring in the setting of a prolonged QT interval. In addition, the QRS complex displays a periodic waxing and waning of amplitude on the electrogram." ;
    ct:CDISC%20Submission%20Value "TORSADES DE POINTES" ;
    ct:CDISC%20Synonym%28s%29 "Torsades de pointes; Ventricular tachycardia, torsades de pointes" ;
    ct:Code "C50779" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Torsades De Pointes by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C61395>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which the R wave of a premature ventricular complex occurs on top of the T wave of the preceding beat." ;
    ct:CDISC%20Submission%20Value "R ON T PHENOMENON" ;
    ct:CDISC%20Synonym%28s%29 "R on T phenomenon" ;
    ct:Code "C61395" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "R On T Phenomenon by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62016>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of intermittent failure of atrial electrical impulse conduction to the ventricles. This is manifest on the ECG by regular P waves which intermittently are not followed by QRS complexes." ;
    ct:CDISC%20Submission%20Value "2ND DEGREE AV BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "Second Degree AV Block" ;
    ct:Code "C62016" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "AV Block Second Degree by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62234>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a ventricular tachycardia in which the QRS complexes have a uniform morphology." ;
    ct:CDISC%20Submission%20Value "VENTRICULAR TACHYCARDIA, MONOMORPHIC" ;
    ct:CDISC%20Synonym%28s%29 "Ventricular tachycardia, monomorphic" ;
    ct:Code "C62234" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Monomorphic Ventricular Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62236>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a ventricular tachycardia in which the QRS complexes have a variable morphology and often rate." ;
    ct:CDISC%20Submission%20Value "VENTRICULAR TACHYCARDIA, POLYMORPHIC" ;
    ct:CDISC%20Synonym%28s%29 "Ventricular tachycardia, polymorphic; Ventricular tachycardia, polymorphous" ;
    ct:Code "C62236" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Polymorphic Ventricular Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62239>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which the sinus rate fluctuates." ;
    ct:CDISC%20Submission%20Value "SINUS ARRHYTHMIA" ;
    ct:CDISC%20Synonym%28s%29 "Respiratory Sinus Arrhythmia; Sinus arrhythmia" ;
    ct:Code "C62239" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Sinus Arrhythmia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62240>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a supraventricular arrhythmia characterized by 3 or more distinct P wave morphologies with an isoelectric baseline, variable PR intervals and no predominant atrial rhythm. The ventricular rate is typically below 100 beats per minute." ;
    ct:CDISC%20Submission%20Value "WANDERING ATRIAL PACEMAKER" ;
    ct:CDISC%20Synonym%28s%29 "Wandering atrial pacemaker" ;
    ct:Code "C62240" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Wandering Atrial Pacemaker by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62242>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which a failure of impulse formation or conduction in the sinus node produces prolongation of the P-P interval or dropped P waves." ;
    ct:CDISC%20Submission%20Value "SINUS ARREST/PAUSE" ;
    ct:CDISC%20Synonym%28s%29 "Sinus arrest/pause; Sinus pause or arrest" ;
    ct:Code "C62242" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Sinus Arrest by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62245>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a regular atrial rhythm that does not originate in the sinus node, and which is characterized by P waves whose morphology differs from the P wave morphology during sinus rhythm." ;
    ct:CDISC%20Submission%20Value "ECTOPIC ATRIAL RHYTHM" ;
    ct:CDISC%20Synonym%28s%29 "Ectopic Supraventricular Rhythm" ;
    ct:Code "C62245" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Ectopic Atrial Rhythm by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62246>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of an abnormally short PR interval." ;
    ct:CDISC%20Submission%20Value "SHORT PR INTERVAL" ;
    ct:CDISC%20Synonym%28s%29 "Short PR interval" ;
    ct:Code "C62246" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Short PR Interval by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62248>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a type of atrioventricular dissociation characterized by the atria (P waves) and ventricles (QRS complexes) beating at similar rates, although independently." ;
    ct:CDISC%20Submission%20Value "ISORHYTHMIC DISSOCIATION" ;
    ct:CDISC%20Synonym%28s%29 "Isorhythmic dissociation" ;
    ct:Code "C62248" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Isorhythmic Atrioventricular Dissociation" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62250>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of the sudden onset of transient AV block." ;
    ct:CDISC%20Submission%20Value "PAROXYSMAL AV BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "Paroxysmal AV block" ;
    ct:Code "C62250" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Paroxysmal Atrioventricular Block by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62256>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of an ectopic impulse originating in the ventricles. The QRS morphology of these complexes is different from those of supraventricular origin. The QRS duration is often longer and the RR interval preceding the complexes is usually shorter than that of supraventricular beats; there may be one or more occurrences during an electrocardiographic recording." ;
    ct:CDISC%20Submission%20Value "PREMATURE VENTRICULAR COMPLEX" ;
    ct:CDISC%20Synonym%28s%29 "Premature Ventricular Complexes; PVC; VE; Ventricular Extra Beat; Ventricular Premature Complexes; VES; VPC" ;
    ct:Code "C62256" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Ventricular Premature Complex by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62257>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of an ectopic impulse originating in the atria and not specifically in the sinus node. The P wave morphology of these complexes is often different from a sinus P wave and the RR intervals preceding these complexes is also shorter than those of the regular beats; there may be one or more occurrences during an electrocardiographic recording." ;
    ct:CDISC%20Submission%20Value "PREMATURE ATRIAL COMPLEXES" ;
    ct:CDISC%20Synonym%28s%29 "APC; Atrial premature complex(es); PAC; Premature atrial complex; Supraventricular Extra Beat; Supraventricular Premature Beat; SVE" ;
    ct:Code "C62257" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Atrial Premature Complex by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62258>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of initial slurring (delta wave) of the QRS complex due to the presence of an accessory pathway. This characteristic ECG pattern is typically seen in Wolff-Parkinson-White syndrome." ;
    ct:CDISC%20Submission%20Value "DELTA WAVE" ;
    ct:CDISC%20Synonym%28s%29 "Delta wave" ;
    ct:Code "C62258" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Delta Wave by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62259>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which two premature ventricular complexes occur sequentially; there may be one or more occurrences during an electrocardiographic recording." ;
    ct:CDISC%20Submission%20Value "VENTRICULAR COUPLET" ;
    ct:CDISC%20Synonym%28s%29 "Ventricular Couplets; Ventricular Pair" ;
    ct:Code "C62259" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Ventricular Couplet by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62261>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a regular supraventricular tachycardia which utilizes an atrioventricular bypass tract as its retrograde limb (orthodromic tachycardia) or as its antegrade limb (antidromic tachycardia). QRS complexes during sinus rhythm may show preexcitation. During orthodromic tachycardia the preexcitation is not present and a retrograde P wave may appear after the QRS complex. During antidromic tachycardia the QRS complex is preexcited." ;
    ct:CDISC%20Submission%20Value "AV RE-ENTRANT TACHYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "AV Reentrant Supraventricular Tachycardia" ;
    ct:Code "C62261" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Atrioventricular Reentrant Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62266>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of idioventricular rhythm with a rate greater than 50 beats per minute." ;
    ct:CDISC%20Submission%20Value "ACCELERATED IDIOVENTRICULAR RHYTHM" ;
    ct:CDISC%20Synonym%28s%29 "Accelerated idioventricular rhythm" ;
    ct:Code "C62266" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Accelerated Idioventricular Rhythm by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62267>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a slightly widened QRS duration with leftward frontal plane QRS axis and typically small Q waves." ;
    ct:CDISC%20Submission%20Value "LEFT ANTERIOR FASCICULAR BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "Left anterior fascicular block; Left Anterior Hemiblock" ;
    ct:Code "C62267" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Left Anterior Fascicular Block by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62268>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of an S1Q3 pattern and QRS axis greater than or equal to 120 degrees. It is usually seen in association with other abnormalities (e.g. RBBB or RVH)." ;
    ct:CDISC%20Submission%20Value "LEFT POSTERIOR FASCICULAR BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "Left posterior fascicular block; Left Posterior Hemiblock" ;
    ct:Code "C62268" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Left Posterior Fascicular Block by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62269>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a wide QRS complex with evidence of delayed conduction to the left ventricle, manifest as a widened initial portion of the QRS complex." ;
    ct:CDISC%20Submission%20Value "LEFT BUNDLE BRANCH BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "Complete LBBB; Left bundle branch block; Left bundle-branch block" ;
    ct:Code "C62269" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Left Bundle Branch Block by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62270>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a wide QRS complex with evidence of delayed conduction to the right ventricle, manifest by a widened initial portion of the QRS." ;
    ct:CDISC%20Submission%20Value "RIGHT BUNDLE BRANCH BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "Complete RBBB; Right bundle branch block; Right bundle-branch block" ;
    ct:Code "C62270" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Right Bundle Branch Block by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C62271>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a widened QRS duration." ;
    ct:CDISC%20Submission%20Value "INTRAVENTRICULAR CONDUCTION DELAY, NONSPECIFIC" ;
    ct:CDISC%20Synonym%28s%29 "Intraventricular Conduction Defect; Intraventricular conduction delay" ;
    ct:Code "C62271" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Nonspecific Intraventricular Conduction Delay by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71029>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of ST elevation which is concave upwards, and which is often accompanied by PR segment depression." ;
    ct:CDISC%20Submission%20Value "ST ELEVATION PERICARDITIS" ;
    ct:CDISC%20Synonym%28s%29 "ST elevation pericarditis" ;
    ct:Code "C71029" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "ST Elevation Pericarditis by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71030>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a significant elevation above the baseline of the J point." ;
    ct:CDISC%20Submission%20Value "J POINT ELEVATION" ;
    ct:CDISC%20Synonym%28s%29 "J point elevation" ;
    ct:Code "C71030" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "J Point Elevation" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71031>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of changes in the ST segment and T wave that do not meet criteria for ischemia or infarction. (NCI)" ;
    ct:CDISC%20Submission%20Value "NON-SPECIFIC ST-T CHANGES" ;
    ct:CDISC%20Synonym%28s%29 "Non-specific ST-T changes" ;
    ct:Code "C71031" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Non-Specific ST-T Changes by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71032>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of an irregular, u or v shaped deflection within the contour of the T wave." ;
    ct:CDISC%20Submission%20Value "NOTCHED T WAVES" ;
    ct:CDISC%20Synonym%28s%29 "Notched T Waves" ;
    ct:Code "C71032" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "T Wave Notched by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71033>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a lack of progression of R wave height across precordial leads." ;
    ct:CDISC%20Submission%20Value "POOR R WAVE PROGRESSION" ;
    ct:CDISC%20Synonym%28s%29 "Poor R Wave Progression" ;
    ct:Code "C71033" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Poor R Wave Progression by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71034>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which the QT interval not corrected for heart rate is prolonged." ;
    ct:CDISC%20Submission%20Value "PROLONGED QT" ;
    ct:CDISC%20Synonym%28s%29 "Prolonged QT; Prolonged QT interval" ;
    ct:Code "C71034" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Prolonged QT Interval by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71035>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which there is an alternating pattern of any of the waveform components. (NCI)" ;
    ct:CDISC%20Submission%20Value "ELECTRICAL ALTERNANS" ;
    ct:CDISC%20Synonym%28s%29 "Electrical alternans" ;
    ct:Code "C71035" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Electrical Alternans by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71039>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding which comprises left, right or bilateral atrial enlargement. This is may be characterized by prolonged P wave duration, increased P wave amplitude, or multi-component P waves." ;
    ct:CDISC%20Submission%20Value "ATRIAL ENLARGEMENT" ;
    ct:CDISC%20Synonym%28s%29 "Atrial Enlargement" ;
    ct:Code "C71039" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Atrial Enlargement by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71040>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding suggesting underlying hypertrophy or dilatation of the left atrium. Electrocardiographic criteria used for the diagnosis of left atrial abnormality may include a bifid p wave, a biphasic p wave and/or a p wave duration of greater than 0.12 seconds. (NCI)" ;
    ct:CDISC%20Submission%20Value "LEFT ATRIAL ABNORMALITY" ;
    ct:CDISC%20Synonym%28s%29 "Left Atrial Enlargement; P-mitrale" ;
    ct:Code "C71040" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "P-mitrale by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71041>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding suggesting underlying hypertrophy or dilatation of the right atrium. Electrocardiographic criteria used for the diagnosis of right atrial abnormality may include a peaked p wave greater than 2.5 millimeters in amplitude in the inferior leads. (NCI)" ;
    ct:CDISC%20Submission%20Value "RIGHT ATRIAL ABNORMALITY" ;
    ct:CDISC%20Synonym%28s%29 "P-pulmonale; Right Atrial Enlargement" ;
    ct:Code "C71041" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "P-pulmonale by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71042>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of three or more consecutive complexes of ventricular origin. The QRS complexes are wide and have an abnormal morphology." ;
    ct:CDISC%20Submission%20Value "ECTOPIC VENTRICULAR RHYTHM" ;
    ct:CDISC%20Synonym%28s%29 "Ectopic ventricular rhythm" ;
    ct:Code "C71042" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Ectopic Ventricular Rhythm by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71044>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a supraventricular rhythm where the ratio of impulses generated above the atrioventricular node to the number of impulses conducted through to the ventricles is 2:1. This is manifest on the ECG as 2 P waves per QRS complex." ;
    ct:CDISC%20Submission%20Value "2:1 AV BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "2:1 AV block" ;
    ct:Code "C71044" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "2:1 Atrioventricular Block by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71045>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which the electrical activity of the atria and ventricles are independent of one another." ;
    ct:CDISC%20Submission%20Value "ATRIOVENTRICULAR DISSOCIATION" ;
    ct:CDISC%20Synonym%28s%29 "Atrioventricular dissociation; AV Dissociation" ;
    ct:Code "C71045" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Atrioventricular Dissociation by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71046>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding comprising right bundle branch block and left anterior fascicular block, or right bundle branch block and left posterior fascicular block. Defects occurring in two of the three divisions of the conduction system of the heart are considered bifascicular blocks. Technically left bundle branch block may be considered a bifascicular block. (NCI)" ;
    ct:CDISC%20Submission%20Value "BIFASCICULAR BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "Bifascicular block" ;
    ct:Code "C71046" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Bifascicular Block by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71047>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a wide QRS complex with evidence of delayed conduction to the left ventricle." ;
    ct:CDISC%20Submission%20Value "INCOMPLETE LEFT BUNDLE BRANCH BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "Incomplete left bundle branch block" ;
    ct:Code "C71047" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Incomplete Left Bundle Branch Block by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71048>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a wide QRS complex with evidence of delayed conduction to the right ventricle." ;
    ct:CDISC%20Submission%20Value "INCOMPLETE RIGHT BUNDLE BRANCH BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "Incomplete right bundle branch block; Incomplete right bundle-branch block" ;
    ct:Code "C71048" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Incomplete Right Bundle Branch Block by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71050>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a supraventricular arrhythmia characterized by 3 or more distinct P wave morphologies with an isoelectric baseline, variable PR intervals and no predominant atrial rhythm." ;
    ct:CDISC%20Submission%20Value "MULTIFOCAL ATRIAL TACHYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Multifocal atrial tachycardia" ;
    ct:Code "C71050" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Multifocal Atrial Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71051>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a rhythm which originates in the AV junction and results in a normal heart rate. It is characterized by retrograde P waves which may be obscured by or may follow the QRS complexes. The QRS complexes may be narrow or may demonstrate aberration." ;
    ct:CDISC%20Submission%20Value "JUNCTIONAL RHYTHM" ;
    ct:CDISC%20Synonym%28s%29 "Junctional rhythm" ;
    ct:Code "C71051" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Junctional Rhythm by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71052>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of ventricular tachycardia with longer than normal duration." ;
    ct:CDISC%20Submission%20Value "SUSTAINED VENTRICULAR TACHYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Sustained ventricular tachycardia" ;
    ct:Code "C71052" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Sustained Ventricular Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71053>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of ventricular tachycardia less than 30 seconds in duration. (NCI)" ;
    ct:CDISC%20Submission%20Value "NON-SUSTAINED VENTRICULAR TACHYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Non-sustained ventricular tachycardia; Ventricular tachycardia, unsustained" ;
    ct:Code "C71053" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Non-Sustained Ventricular Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71054>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a normal QRS complex followed by a premature ventricular complex for 3 or more consecutive cycles; a regularly irregular rhythm of normal and abnormal QRS complexes in a 1-1 ratio." ;
    ct:CDISC%20Submission%20Value "VENTRICULAR BIGEMINY" ;
    ct:CDISC%20Synonym%28s%29 "Bigeminy" ;
    ct:Code "C71054" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Ventricular Bigeminy by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71055>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of two normal QRS complexes followed by a premature ventricular complex for 3 or more consecutive cycles; a regularly irregular rhythm of normal and abnormal QRS complexes in a 2-1 ratio." ;
    ct:CDISC%20Submission%20Value "VENTRICULAR TRIGEMINY" ;
    ct:CDISC%20Synonym%28s%29 "Trigeminy" ;
    ct:Code "C71055" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Ventricular Trigeminy by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71065>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves with accompanying ST elevation in leads V3 and V4, which is suggestive of acute myocardial infarction of the anterior wall of the left ventricle." ;
    ct:CDISC%20Submission%20Value "ACUTE ANTERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Acute Anterior MI; Acute Anterior Wall Myocardial Infarction" ;
    ct:Code "C71065" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Acute Anterior Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71066>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves with accompanying ST elevation in leads III, aVF and often II, which is suggestive of acute myocardial infarction of the inferior wall of the left ventricle." ;
    ct:CDISC%20Submission%20Value "ACUTE INFERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Acute Inferior MI; Acute Inferior Wall Myocardial Infarction" ;
    ct:Code "C71066" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Acute Inferior Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71067>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves with accompanying ST elevation in leads V5, V6, I and aVL, which is suggestive of acute myocardial infarction of the lateral wall of the left ventricle." ;
    ct:CDISC%20Submission%20Value "ACUTE LATERAL WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Acute Lateral MI; Acute Lateral Wall Myocardial Infarction" ;
    ct:Code "C71067" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Acute Lateral Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71068>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in leads V1 or V2 of an initial R wave duration greater than or equal to 40 ms, R wave greater than S wave, upright T wave, with accompanying ST elevation, which is suggestive of acute myocardial infarction of the posterior wall of the left ventricle. Evidence of inferior or lateral myocardial infarction is usually also present." ;
    ct:CDISC%20Submission%20Value "ACUTE POSTERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Acute Posterior MI; Acute Posterior Wall Myocardial Infarction" ;
    ct:Code "C71068" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Acute Posterior Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71069>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves in leads V3 and V4, which is suggestive of myocardial infarction of the anterior wall of the left ventricle." ;
    ct:CDISC%20Submission%20Value "ANTERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Anterior MI; Anterior Wall Myocardial Infarction" ;
    ct:Code "C71069" ;
    ct:Codelist%20Code "C71150" ;
    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "Anterior Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C71073>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a delay in impulse propagation through the atria. This is characterized by broad P waves which are often biphasic in V1." ;
    ct:CDISC%20Submission%20Value "INTRAATRIAL CONDUCTION DELAY" ;
    ct:CDISC%20Synonym%28s%29 "Intraatrial Conduction Delay" ;
