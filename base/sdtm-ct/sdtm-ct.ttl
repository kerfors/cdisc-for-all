.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C90013/C90408>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A bipolar electrocardiogram limb lead which records the voltage between the negative electrode on the right thoracic limb and the positive electrode on the left thoracic limb. (NCI)" ;
    ct:CDISC%20Submission%20Value "LEAD I" ;
    ct:Code "C90408" ;
    ct:Codelist%20Code "C90013" ;
    ct:Codelist%20Name "ECG Lead" ;
    ct:NCI%20Preferred%20Term "Lead Site I" ;
.

