    ct:CDISC%20Definition "A bipolar electrocardiogram limb lead which records the voltage between the negative electrode on the left thoracic limb and the positive electrode on the left pelvic limb. (NCI)" ;
    ct:CDISC%20Submission%20Value "LEAD III" ;
    ct:Code "C90410" ;
    ct:Codelist%20Code "C90013" ;
    ct:Codelist%20Name "ECG Lead" ;
    ct:NCI%20Preferred%20Term "Lead Site III" ;
.

