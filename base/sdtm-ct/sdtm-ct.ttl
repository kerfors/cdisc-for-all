    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "Assent given by a minor or adult who is unable to give informed consent on their own behalf, to participate in a clinical trial. Assent must be accompanied by consent from a parent or legal guardian for full participation in the study." ;
    ct:CDISC%20Submission%20Value "INFORMED ASSENT OBTAINED" ;
    ct:CDISC%20Synonym%28s%29 "Informed Assent" ;
    ct:Code "C161418" ;
    ct:Codelist%20Code "C114118" ;
    ct:Codelist%20Name "Protocol Milestone" ;
    ct:NCI%20Preferred%20Term "Informed Assent" ;
.

