    ct:NCI%20Preferred%20Term "Phase Ib Trial" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C66737/C199990>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A type of phase 1 trial with a single ascending dose (dose escalation) in a smaller group of patients (in comparison to a Phase 1B)." ;
    ct:CDISC%20Submission%20Value "PHASE IA TRIAL" ;
    ct:CDISC%20Synonym%28s%29 "1A; Trial Phase 1A" ;
