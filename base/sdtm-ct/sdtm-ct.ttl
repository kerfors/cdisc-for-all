    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "T Wave Notched by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71033>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a lack of progression of R wave height across precordial leads." ;
    ct:CDISC%20Submission%20Value "POOR R WAVE PROGRESSION" ;
    ct:CDISC%20Synonym%28s%29 "Poor R Wave Progression" ;
    ct:Code "C71033" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Poor R Wave Progression by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71034>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which the QT interval not corrected for heart rate is prolonged." ;
    ct:CDISC%20Submission%20Value "PROLONGED QT" ;
    ct:CDISC%20Synonym%28s%29 "Prolonged QT; Prolonged QT interval" ;
    ct:Code "C71034" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Prolonged QT Interval by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71035>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which there is an alternating pattern of any of the waveform components. (NCI)" ;
    ct:CDISC%20Submission%20Value "ELECTRICAL ALTERNANS" ;
    ct:CDISC%20Synonym%28s%29 "Electrical alternans" ;
    ct:Code "C71035" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Electrical Alternans by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71039>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding which comprises left, right or bilateral atrial enlargement. This is may be characterized by prolonged P wave duration, increased P wave amplitude, or multi-component P waves." ;
    ct:CDISC%20Submission%20Value "ATRIAL ENLARGEMENT" ;
    ct:CDISC%20Synonym%28s%29 "Atrial Enlargement" ;
    ct:Code "C71039" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Atrial Enlargement by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71040>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding suggesting underlying hypertrophy or dilatation of the left atrium. Electrocardiographic criteria used for the diagnosis of left atrial abnormality may include a bifid p wave, a biphasic p wave and/or a p wave duration of greater than 0.12 seconds. (NCI)" ;
    ct:CDISC%20Submission%20Value "LEFT ATRIAL ABNORMALITY" ;
    ct:CDISC%20Synonym%28s%29 "Left Atrial Enlargement; P-mitrale" ;
    ct:Code "C71040" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "P-mitrale by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71041>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding suggesting underlying hypertrophy or dilatation of the right atrium. Electrocardiographic criteria used for the diagnosis of right atrial abnormality may include a peaked p wave greater than 2.5 millimeters in amplitude in the inferior leads. (NCI)" ;
    ct:CDISC%20Submission%20Value "RIGHT ATRIAL ABNORMALITY" ;
    ct:CDISC%20Synonym%28s%29 "P-pulmonale; Right Atrial Enlargement" ;
    ct:Code "C71041" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "P-pulmonale by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71042>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of three or more consecutive complexes of ventricular origin. The QRS complexes are wide and have an abnormal morphology." ;
    ct:CDISC%20Submission%20Value "ECTOPIC VENTRICULAR RHYTHM" ;
    ct:CDISC%20Synonym%28s%29 "Ectopic ventricular rhythm" ;
    ct:Code "C71042" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Ectopic Ventricular Rhythm by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71044>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a supraventricular rhythm where the ratio of impulses generated above the atrioventricular node to the number of impulses conducted through to the ventricles is 2:1. This is manifest on the ECG as 2 P waves per QRS complex." ;
    ct:CDISC%20Submission%20Value "2:1 AV BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "2:1 AV block" ;
    ct:Code "C71044" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "2:1 Atrioventricular Block by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71045>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which the electrical activity of the atria and ventricles are independent of one another." ;
    ct:CDISC%20Submission%20Value "ATRIOVENTRICULAR DISSOCIATION" ;
    ct:CDISC%20Synonym%28s%29 "Atrioventricular dissociation; AV Dissociation" ;
    ct:Code "C71045" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Atrioventricular Dissociation by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71046>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding comprising right bundle branch block and left anterior fascicular block, or right bundle branch block and left posterior fascicular block. Defects occurring in two of the three divisions of the conduction system of the heart are considered bifascicular blocks. Technically left bundle branch block may be considered a bifascicular block. (NCI)" ;
    ct:CDISC%20Submission%20Value "BIFASCICULAR BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "Bifascicular block" ;
    ct:Code "C71046" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Bifascicular Block by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71047>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a wide QRS complex with evidence of delayed conduction to the left ventricle." ;
    ct:CDISC%20Submission%20Value "INCOMPLETE LEFT BUNDLE BRANCH BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "Incomplete left bundle branch block" ;
    ct:Code "C71047" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Incomplete Left Bundle Branch Block by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71048>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a wide QRS complex with evidence of delayed conduction to the right ventricle." ;
    ct:CDISC%20Submission%20Value "INCOMPLETE RIGHT BUNDLE BRANCH BLOCK" ;
    ct:CDISC%20Synonym%28s%29 "Incomplete right bundle branch block; Incomplete right bundle-branch block" ;
    ct:Code "C71048" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Incomplete Right Bundle Branch Block by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71050>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a supraventricular arrhythmia characterized by 3 or more distinct P wave morphologies with an isoelectric baseline, variable PR intervals and no predominant atrial rhythm." ;
    ct:CDISC%20Submission%20Value "MULTIFOCAL ATRIAL TACHYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Multifocal atrial tachycardia" ;
    ct:Code "C71050" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Multifocal Atrial Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71051>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a rhythm which originates in the AV junction and results in a normal heart rate. It is characterized by retrograde P waves which may be obscured by or may follow the QRS complexes. The QRS complexes may be narrow or may demonstrate aberration." ;
    ct:CDISC%20Submission%20Value "JUNCTIONAL RHYTHM" ;
    ct:CDISC%20Synonym%28s%29 "Junctional rhythm" ;
    ct:Code "C71051" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Junctional Rhythm by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71052>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of ventricular tachycardia with longer than normal duration." ;
    ct:CDISC%20Submission%20Value "SUSTAINED VENTRICULAR TACHYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Sustained ventricular tachycardia" ;
    ct:Code "C71052" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Sustained Ventricular Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71053>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of ventricular tachycardia less than 30 seconds in duration. (NCI)" ;
    ct:CDISC%20Submission%20Value "NON-SUSTAINED VENTRICULAR TACHYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Non-sustained ventricular tachycardia; Ventricular tachycardia, unsustained" ;
    ct:Code "C71053" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Non-Sustained Ventricular Tachycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71054>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a normal QRS complex followed by a premature ventricular complex for 3 or more consecutive cycles; a regularly irregular rhythm of normal and abnormal QRS complexes in a 1-1 ratio." ;
    ct:CDISC%20Submission%20Value "VENTRICULAR BIGEMINY" ;
    ct:CDISC%20Synonym%28s%29 "Bigeminy" ;
    ct:Code "C71054" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Ventricular Bigeminy by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71055>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of two normal QRS complexes followed by a premature ventricular complex for 3 or more consecutive cycles; a regularly irregular rhythm of normal and abnormal QRS complexes in a 2-1 ratio." ;
    ct:CDISC%20Submission%20Value "VENTRICULAR TRIGEMINY" ;
    ct:CDISC%20Synonym%28s%29 "Trigeminy" ;
    ct:Code "C71055" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Ventricular Trigeminy by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71065>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves with accompanying ST elevation in leads V3 and V4, which is suggestive of acute myocardial infarction of the anterior wall of the left ventricle." ;
    ct:CDISC%20Submission%20Value "ACUTE ANTERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Acute Anterior MI; Acute Anterior Wall Myocardial Infarction" ;
    ct:Code "C71065" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Acute Anterior Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71066>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves with accompanying ST elevation in leads III, aVF and often II, which is suggestive of acute myocardial infarction of the inferior wall of the left ventricle." ;
    ct:CDISC%20Submission%20Value "ACUTE INFERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Acute Inferior MI; Acute Inferior Wall Myocardial Infarction" ;
    ct:Code "C71066" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Acute Inferior Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71067>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves with accompanying ST elevation in leads V5, V6, I and aVL, which is suggestive of acute myocardial infarction of the lateral wall of the left ventricle." ;
    ct:CDISC%20Submission%20Value "ACUTE LATERAL WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Acute Lateral MI; Acute Lateral Wall Myocardial Infarction" ;
    ct:Code "C71067" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Acute Lateral Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71068>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in leads V1 or V2 of an initial R wave duration greater than or equal to 40 ms, R wave greater than S wave, upright T wave, with accompanying ST elevation, which is suggestive of acute myocardial infarction of the posterior wall of the left ventricle. Evidence of inferior or lateral myocardial infarction is usually also present." ;
    ct:CDISC%20Submission%20Value "ACUTE POSTERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Acute Posterior MI; Acute Posterior Wall Myocardial Infarction" ;
    ct:Code "C71068" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Acute Posterior Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71069>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of pathologic Q waves in leads V3 and V4, which is suggestive of myocardial infarction of the anterior wall of the left ventricle." ;
    ct:CDISC%20Submission%20Value "ANTERIOR WALL MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Anterior MI; Anterior Wall Myocardial Infarction" ;
    ct:Code "C71069" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Anterior Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71073>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a delay in impulse propagation through the atria. This is characterized by broad P waves which are often biphasic in V1." ;
    ct:CDISC%20Submission%20Value "INTRAATRIAL CONDUCTION DELAY" ;
    ct:CDISC%20Synonym%28s%29 "Intraatrial Conduction Delay" ;
    ct:Code "C71073" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Intra-Atrial Conduction Delay by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71074>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a junctional rhythm with a heart rate which is abnormally low." ;
    ct:CDISC%20Submission%20Value "JUNCTIONAL BRADYCARDIA" ;
    ct:CDISC%20Synonym%28s%29 "Junctional bradycardia" ;
    ct:Code "C71074" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Junctional Bradycardia by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71076>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding suggestive of a hypertrophied left ventricle, characterized by large QRS amplitudes and secondary findings of left atrial enlargement, left axis deviation, or typical pattern of ST depression and T wave inversion." ;
    ct:CDISC%20Submission%20Value "LEFT VENTRICULAR HYPERTROPHY" ;
    ct:CDISC%20Synonym%28s%29 "Left Ventricular Hypertrophy" ;
    ct:Code "C71076" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Left Ventricular Hypertrophy by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71077>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding suggestive of a hypertrophied right ventricle, characterized by large R wave amplitudes in the right precordial leads and secondary findings of right atrial enlargement, right axis deviation, and typical pattern of ST depression and T wave inversion in the right precordial leads." ;
    ct:CDISC%20Submission%20Value "RIGHT VENTRICULAR HYPERTROPHY" ;
    ct:CDISC%20Synonym%28s%29 "Right ventricular Hypertrophy" ;
    ct:Code "C71077" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Right Ventricular Hypertrophy by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71078>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a QRS amplitude less than or equal to 0.5 mV in the limb leads or QRS amplitude less than or equal to 1 mV in the precordial leads." ;
    ct:CDISC%20Submission%20Value "LOW QRS VOLTAGE" ;
    ct:CDISC%20Synonym%28s%29 "Low QRS voltage" ;
    ct:Code "C71078" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Low QRS Voltage by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71080>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of ST and T wave abnormalities in the absence of pathologic Q waves, which is suggestive of myocardial infarction in one or more regions of the heart." ;
    ct:CDISC%20Submission%20Value "NON Q WAVE MYOCARDIAL INFARCTION" ;
    ct:CDISC%20Synonym%28s%29 "Non Q Wave Myocardial Infarction" ;
    ct:Code "C71080" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "Non Q Wave Myocardial Infarction by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71085>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of an inversion of the T wave from the expected axis. (NCI)" ;
    ct:CDISC%20Submission%20Value "T WAVE INVERSION" ;
    ct:CDISC%20Synonym%28s%29 "T Wave Inversion" ;
    ct:Code "C71085" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "T Wave Inversion by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71086>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which the T wave appears increased in amplitude and cresting at a point. (NCI)" ;
    ct:CDISC%20Submission%20Value "T WAVE PEAKED" ;
    ct:CDISC%20Synonym%28s%29 "T wave peaked" ;
    ct:Code "C71086" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "T Wave Peaked by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71087>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding of a T wave with both positive and negative components." ;
    ct:CDISC%20Submission%20Value "T WAVES BIPHASIC" ;
    ct:CDISC%20Synonym%28s%29 "T waves biphasic" ;
    ct:Code "C71087" ;
    ct:Codelist%20Code "C120522" ;
    ct:Codelist%20Name "Holter ECG Results" ;
    ct:NCI%20Preferred%20Term "T Waves Biphasic by ECG Finding" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C120522/C71088>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An electrocardiographic finding in which the T wave appears decreased in amplitude. (NCI)" ;
