    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An antigen encoded by the INS gene and regulates glucose metabolism. It can be considered as an autoantigen and is commonly associated with autoimmune diabetes mellitus." ;
    ct:CDISC%20Submission%20Value "INSULIN" ;
    ct:Code "C2271" ;
    ct:Codelist%20Code "C181169" ;
    ct:Codelist%20Name "Binding Agent for Immunogenicity Tests" ;
