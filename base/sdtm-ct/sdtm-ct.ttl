    ct:CDISC%20Definition "An assay technique where a primer is hybridized adjacent to the interrogated variant site and is extended by deoxyribonucleic acid (DNA) polymerase to incorporate a complementary base that can be labeled for detection." ;
    ct:CDISC%20Submission%20Value "SINGLE-NUCLEOTIDE PRIMER EXTENSION ASSAY" ;
    ct:CDISC%20Synonym%28s%29 "SNuPE" ;
    ct:Code "C209651" ;
