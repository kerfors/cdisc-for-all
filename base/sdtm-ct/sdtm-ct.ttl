    ct:CDISC%20Definition "One of the lobes of the cerebral hemisphere located superiorly to the occipital lobe and posteriorly to the frontal lobe. Cognition and visuospatial processing are its main function. (NCI)" ;
    ct:CDISC%20Submission%20Value "PARIETAL LOBE" ;
    ct:CDISC%20Synonym%28s%29 "Parietal Lobe" ;
    ct:Code "C12354" ;
    ct:Codelist%20Code "C74456" ;
    ct:Codelist%20Name "Anatomical Location" ;
    ct:NCI%20Preferred%20Term "Parietal Lobe" ;
.

