    ct:CDISC%20Definition "A solution for the preparation of an iced saline slush, which is administered by irrigation and used to induce regional hypothermia (in conditions such as certain open heart and kidney surgical procedures) by its direct application. (NCI)" ;
    ct:CDISC%20Submission%20Value "SOLUTION, FOR SLUSH" ;
    ct:Code "C42987" ;
    ct:Codelist%20Code "C66726" ;
    ct:Codelist%20Name "Dosage Form" ;
