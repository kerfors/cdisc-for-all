    ct:Codelist%20Name "ECG Result" ;
    ct:NCI%20Preferred%20Term "QTcB Shortened" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C71150/C112403>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
