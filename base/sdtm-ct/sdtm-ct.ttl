    ct:Codelist%20Name "Immunogenicity Specimen Test Details" ;
    ct:NCI%20Preferred%20Term "50% Neutralization Factor" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C189267/C214673>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "A measurement that compares the phagocytic activity of an infected individual's blood for a particular microorganism to that of a normal person. The opsonic index is the ratio of the phagocytic index of infected or immune serum divided by the phagocytic index of normal serum." ;
    ct:CDISC%20Submission%20Value "OPSONIZATION INDEX" ;
    ct:CDISC%20Synonym%28s%29 "OI; Opsonic Index" ;
    ct:Code "C214673" ;
    ct:Codelist%20Code "C189267" ;
    ct:Codelist%20Name "Immunogenicity Specimen Test Details" ;
    ct:NCI%20Preferred%20Term "Opsonization Index" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C189267/C214674>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An arbitrary measure of phagocytic activity (by phagocytes) that is assessed by counting the average number of ingested microorganisms per phagocyte after a period of incubation. It is calculated by counting the number of microorganisms ingested by phagocytes in a suspension of microorganisms, phagocytes, and serum (either normal or immune)." ;
    ct:CDISC%20Submission%20Value "PHAGOCYTIC INDEX" ;
    ct:CDISC%20Synonym%28s%29 "Phagocytic Score" ;
    ct:Code "C214674" ;
    ct:Codelist%20Code "C189267" ;
    ct:Codelist%20Name "Immunogenicity Specimen Test Details" ;
    ct:NCI%20Preferred%20Term "Phagocytic Index" ;
.

<https://kerfors.github.io/cdisc-for-all/id/sdtm-ct/SDTM%20Terminology/C189267/C41255>
    a <https://kerfors.github.io/cdisc-for-all/def/sdtm-ct#SDTM%20Terminology> ;
    ct:CDISC%20Definition "An act or process of elucidation; explication, or explanation of the meaning of the event or thing via the assignment of objects from the domain to the constants of a formal language, truth-values to the proposition symbols, truth-functions to the connectives, other functions to the function symbols, and extensions to the predicates, if any. The assignments are result of human logic application and are not native to the symbols of the formal language." ;
    ct:CDISC%20Submission%20Value "INTERPRETATION" ;
    ct:CDISC%20Synonym%28s%29 "Interpretation" ;
    ct:Code "C41255" ;
    ct:Codelist%20Code "C189267" ;
    ct:Codelist%20Name "Immunogenicity Specimen Test Details" ;
    ct:NCI%20Preferred%20Term "Interpretation" ;
.

