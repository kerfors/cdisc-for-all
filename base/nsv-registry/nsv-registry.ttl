<https://kerfors.github.io/cdisc-for-all/id/nsv-registry/Approved%20NSVs-alpha/REASDX/TAUG-T1D%20-%20P%26D%20v1.0>
    a <https://kerfors.github.io/cdisc-for-all/def/nsv-registry#Approved%20NSVs-alpha> ;
    nsv:Define-XML%20Datatype "text" ;
    nsv:Description "A textual description of what led to the diagnosis of the condition named in --TERM." ;
    nsv:Label "Reason for Diagnosis" ;
    nsv:Notes "Set to “DIABETIC KETOACIDOSIS” if “Did the subject ever have diabetic ketoacidosis?” = “Yes” and “Did the subject present with diabetic ketoacidosis when the diabetes diagnosis was made?” = “Yes”. Set to “NOT DIABETIC KETOACIDOSIS” if “Did the subject ever have diabetic ketoacidosis?” = “No” or (“Did the subject ever have diabetic ketoacidosis?” = “Yes” and “Did the subject present with diabetic ketoacidosis when the diabetes diagnosis was made?” = “No”). Set to “UNKNOWN IF DIABETIC KETOACIDOSIS” if “Did the subject ever have diabetic ketoacidosis?” = “Unknown” or (“Did the subject ever have diabetic ketoacidosis?” = “Yes” and “Did the subject present with diabetic ketoacidosis when the diabetes diagnosis was made?” = “Unknown”)." ;
    nsv:Role "Non-Standard Record Qualifier" ;
    nsv:Simple%20Datatype "Char" ;
    nsv:Source%28s%29 "TAUG-T1D - P&D v1.0" ;
    nsv:Status%20of%20the%20NSV%20Review "Approved" ;
    nsv:Status%20of%20the%20Source%20Document "Published" ;
    nsv:Used%20in%20Domain%28s%29 "MH (Medical History)" ;
    nsv:Variable%20Name "REASDX" ;
    nsv:XML%20Datatype "string" ;
.

