    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_latest> ;
    c1:bc_categories "Subject Characteristics;Reproductive Findings" ;
    c1:bc_id "C81247" ;
    c1:data_type "string" ;
    c1:dec_id "C25372" ;
    c1:dec_label "Category" ;
    c1:definition "The best estimated due date is determined by: last menstrual period (LMP) if confirmed by early ultrasound or no ultrasound performed, or early ultrasound if no known LMP or the ultrasound is not consistent with LMP, or known date of fertilization (e.g. Assisted Reproductive Technology (ART), Intrauterine Insemination (IUI)). Notes: 1. Ultrasound margin of error and \"early\" to be defined by SMFM/ACOG/NICHD workshop. 2. Pregnancy should not be re-dated by a later ultrasound after a best obstetrical estimate of EDD has been established. (adapted from reVITALize)" ;
    c1:ncit_code "C81247" ;
    c1:ncit_dec_code "C25372" ;
    c1:package_date "2026-11-02" ;
    c1:parent_bc_id "C25164" ;
    c1:result_scales "Temporal" ;
    c1:short_name "Expected Date of Confinement" ;
    c1:synonyms "Due Date;EDC;EDD;EDLVRDTC;Estimated Date of Confinement;Estimated Date of Delivery;Estimated Due Date;Expected Date of Confinement" ;
.

