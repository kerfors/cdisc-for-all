<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_hierarchy_latest/C112522>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_hierarchy_latest> ;
    c2:bc_categories "QRS;Clinical or Research Assessment Classification;Kurtzke Functional Systems Scores Clinical Classification;KFSS;KFSS1" ;
    c2:bc_definition "A standardized rating scale developed by John F. Kurtzke in 1983 to measure the level of functioning in people with multiple sclerosis based on a standard neurological examination. The questionnaire contains 7 functional system; pyramidal functions, cerebellar functions, brainstem functions, sensory function, bowel and bladder function, visual function, and cerebral (or mental) functions. The functional system (FS) scores collected from this questionnaire are used in conjunction with observations and information regarding ambulation and the use of assistive devices to rate the EDSS." ;
    c2:bc_hierarchy_full "Clinical or Research Assessment Classification (C118969); Kurtzke Functional Systems Scores Clinical Classification (C112522)" ;
    c2:bc_hierarchy_level "1" ;
    c2:bc_id "C112522" ;
    c2:bc_short_name "Kurtzke Functional Systems Scores Clinical Classification" ;
    c2:bc_short_name_id "Kurtzke Functional Systems Scores Clinical Classification (C112522)" ;
    c2:bc_synonyms "KFSS" ;
    c2:dec_n "4" ;
    c2:parent_bc_id "C118969" ;
.

