    c2:result_scales "Nominal" ;
.

<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_hierarchy_latest/C17007>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_hierarchy_latest> ;
    c2:bc_categories "Diagnostic Imaging;Medical Imaging;Tomography" ;
    c2:bc_definition "A technique for measuring the gamma radiation produced by collisions of electrons and positrons (anti-electrons) within living tissue. In positron emission tomography (PET), a subject is given a dose of a positron-emitting radionuclide attached to a metabolically active substance (for example, 2-fluoro-2-deoxy-D-glucose (FDG), which is similar to a naturally occurring sugar, glucose, with the addition of a radioactive fluorine atom). When living tissue containing the positron emitter is bombarded by electrons, gamma radiation produced by collisions of electrons and positrons is detected by a scanner, revealing in fine detail the tissue location of the metabolically-active substance administered." ;
    c2:bc_hierarchy_full "Tomography (C38093); Positron Emission Tomography (C17007)" ;
    c2:bc_hierarchy_level "1" ;
    c2:bc_id "C17007" ;
    c2:bc_short_name "Positron Emission Tomography" ;
    c2:bc_short_name_id "Positron Emission Tomography (C17007)" ;
    c2:bc_synonyms "PET Scan;PET" ;
    c2:dec_n "10" ;
    c2:parent_bc_id "C38093" ;
    c2:result_scales "Nominal" ;
.

