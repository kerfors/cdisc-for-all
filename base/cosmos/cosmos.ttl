<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C17007/C25372>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_latest> ;
    c1:bc_categories "Diagnostic Imaging;Medical Imaging;Tomography" ;
    c1:bc_id "C17007" ;
    c1:data_type "string" ;
    c1:dec_id "C25372" ;
    c1:dec_label "Category" ;
    c1:definition "A technique for measuring the gamma radiation produced by collisions of electrons and positrons (anti-electrons) within living tissue. In positron emission tomography (PET), a subject is given a dose of a positron-emitting radionuclide attached to a metabolically active substance (for example, 2-fluoro-2-deoxy-D-glucose (FDG), which is similar to a naturally occurring sugar, glucose, with the addition of a radioactive fluorine atom). When living tissue containing the positron emitter is bombarded by electrons, gamma radiation produced by collisions of electrons and positrons is detected by a scanner, revealing in fine detail the tissue location of the metabolically-active substance administered." ;
    c1:ncit_code "C17007" ;
    c1:ncit_dec_code "C25372" ;
    c1:package_date "2026-07-14" ;
    c1:parent_bc_id "C38093" ;
    c1:result_scales "Nominal" ;
    c1:short_name "Positron Emission Tomography" ;
    c1:synonyms "PET Scan;PET" ;
.

