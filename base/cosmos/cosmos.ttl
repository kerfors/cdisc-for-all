<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C102118/C25372>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_latest> ;
    c1:bc_categories "QRS;Clinical or Research Assessment Classification;Hamilton Anxiety Rating Scale Clinical Classification;HAM-A;HAMA;HAMA1" ;
    c1:bc_id "C102118" ;
    c1:data_type "string" ;
    c1:dec_id "C25372" ;
    c1:dec_label "Category" ;
    c1:definition "A standardized rating scale developed by M. Hamilton in 1959 which is used to evaluate the severity of an individual's state of neurotic anxiety. This instrument contains 14 questions or types of symptoms associated with anxiety such as fear, mood, insomnia, and somatic symptoms, which is completed during a semi-structured interview. Each symptom is rated on a scale of 0-4 with 0 being none and 4 being the most severe. A score of 0-17 is considered 'mild', while a score of 18-24 is 'mild to moderate' and a score greater than 24 is 'moderate to severe.'" ;
    c1:example_set "HAM-A" ;
    c1:ncit_code "C102118" ;
    c1:ncit_dec_code "C25372" ;
    c1:package_date "2026-07-14" ;
    c1:parent_bc_id "C118969" ;
    c1:short_name "Hamilton Anxiety Rating Scale Clinical Classification" ;
    c1:synonyms "HAM-A;HAMA;HAMA1" ;
.

