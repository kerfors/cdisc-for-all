<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_hierarchy_latest/C62667>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_hierarchy_latest> ;
    c2:bc_categories "Diagnostic Procedure;Diagnostic Imaging;NM;Nuclear Medicine" ;
    c2:bc_definition "An imaging technique that uses a small dose of a radioactive chemical (isotope) called a tracer that can detect sites of cancer growth, trauma, infection or degenerative disorders. The tracer, which is either injected into a vein or swallowed, travels through the bloodstream to the target organ, and emits gamma rays, which are detected by a gamma camera and analyzed by a computer to form an image of the target organ." ;
    c2:bc_hierarchy_full "Diagnostic Imaging Testing (C16502); Radionuclide Imaging (C62667)" ;
    c2:bc_hierarchy_level "1" ;
    c2:bc_id "C62667" ;
    c2:bc_short_name "Radionuclide Imaging" ;
    c2:bc_short_name_id "Radionuclide Imaging (C62667)" ;
    c2:bc_synonyms "Gamma Scan;Nuclear Medicine;Scintigraphy;Radioimaging" ;
    c2:dec_n "10" ;
    c2:parent_bc_id "C16502" ;
    c2:result_scales "Nominal" ;
.

