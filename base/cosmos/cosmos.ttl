    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_latest> ;
    c1:bc_categories "Respiratory System Findings;Pulmonary Function Test" ;
    c1:bc_id "C38084" ;
    c1:code "20150-9" ;
    c1:data_type "string" ;
    c1:dec_id "C44279" ;
    c1:dec_label "Unit of Volume" ;
    c1:definition "A test of lung function, the FEV1 is the volume exhaled during the first second of a forced expiratory maneuver started from the level of total lung capacity. It is the most frequently used index for assessing bronchoconstriction or bronchodilatation." ;
    c1:example_set "L;mL" ;
    c1:ncit_code "C38084" ;
    c1:ncit_dec_code "C44279" ;
    c1:package_date "2026-05-26" ;
    c1:parent_bc_id "C38081" ;
    c1:result_scales "Quantitative" ;
    c1:short_name "Forced Expiratory Volume in 1 Second" ;
    c1:synonyms "FEV1;FEV1%VC;Forced Expiratory Volume 1 Test;PFT/FEV1;Pulmonary Function Test/Forced Expiratory Volume 1" ;
    c1:system "http://loinc.org/" ;
    c1:system_name "LOINC" ;
.

