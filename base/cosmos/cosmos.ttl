    c1:dec_id "C25372" ;
    c1:dec_label "Category" ;
    c1:definition "Abnormal Involuntary Movement Scale (AIMS) Extremity Movements, Upper (arms, wrists, hands, fingers). Include movements that are choreic (rapid, objectively purposeless, irregular, spontaneous) or athetoid (slow, irregular, complex, serpentine). Do not include tremor (repetitive, regular, rhythmic movements)." ;
    c1:example_set "AIMS" ;
    c1:ncit_code "C102038" ;
    c1:ncit_dec_code "C25372" ;
    c1:package_date "2025-11-18" ;
