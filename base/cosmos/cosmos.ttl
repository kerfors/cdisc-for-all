    c2:bc_short_name_id "Direct Bilirubin Measurement (C64481)" ;
    c2:bc_synonyms "BILDIR;Conjugated Bilirubin + Albumin-Bound Bilirubin;Conjugated Bilirubin + Delta Bilirubin;Direct Bilirubin" ;
    c2:dec_n "5" ;
    c2:parent_bc_id "C74954" ;
    c2:result_scales "Quantitative;Ordinal" ;
.

