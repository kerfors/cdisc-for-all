<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C45398/>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_latest> ;
    c1:bc_categories "Laboratory Tests;Nitroso Carcinogens" ;
    c1:bc_id "C45398" ;
    c1:definition "An organic N-nitroso compound with possible carcinogenic activity characterized by the group -NNO or -NHNO in its structure, formed by combining nitrates with amines. These compounds are found in various foods and many are carcinogenic or are suspected carcinogens. Cured meats can contain nitrosamines because meats contain amines and can react during cooking with sodium nitrite that is added as a preservative. (NCI05)" ;
    c1:ncit_code "C45398" ;
    c1:package_date "2025-04-01" ;
    c1:short_name "Carcinogenic Nitrosamine" ;
.

