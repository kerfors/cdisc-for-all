<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C123567/C70856>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_latest> ;
    c1:bc_categories "Respiratory System Findings;Pulmonary Function Test" ;
    c1:bc_id "C123567" ;
    c1:data_type "decimal" ;
    c1:dec_id "C70856" ;
    c1:dec_label "Observation Result" ;
    c1:definition "The measurement of the ability of the lung to store energy, which is required for passive expiration. Reactance consists of two components: the negative component reflects capacitive behavior (C) and corresponds to both the thoraco-pulmonary elasticity and to changes in the available lung volumes in the distal compartments of the lung; the positive component of reactance has inertial characteristics (I) describing the moving air column in the bronchial tree." ;
    c1:ncit_code "C123567" ;
    c1:ncit_dec_code "C70856" ;
    c1:package_date "2026-03-31" ;
    c1:parent_bc_id "C38081" ;
    c1:result_scales "Quantitative" ;
    c1:short_name "Pulmonary Reactance" ;
    c1:synonyms "PLMXRS" ;
.

