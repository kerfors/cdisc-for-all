    c1:bc_id "C38083" ;
    c1:code "19911-7" ;
    c1:data_type "string" ;
    c1:dec_id "C44279" ;
    c1:dec_label "Unit of Volume" ;
    c1:definition "A measurement of carbon monoxide (CO) transfer from inspired gas to pulmonary capillary blood. During the test, the subject inspires a gas containing CO and one or more tracer gases to allow determination of the gas exchanging capability of the lungs." ;
    c1:example_set "L;mL" ;
    c1:ncit_code "C38083" ;
    c1:ncit_dec_code "C44279" ;
    c1:package_date "2026-03-31" ;
    c1:parent_bc_id "C38081" ;
    c1:result_scales "Quantitative" ;
    c1:short_name "Carbon Monoxide Diffusing Capability Test" ;
