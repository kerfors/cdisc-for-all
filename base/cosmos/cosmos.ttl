<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C115789/C25372>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_latest> ;
    c1:bc_categories "QRS;Functional Assessment;6 Minute Walk Functional Test;SIX MINUTE WALK;SIXMW1;6MWT" ;
    c1:bc_id "C115789" ;
    c1:data_type "string" ;
    c1:dec_id "C25372" ;
    c1:dec_label "Category" ;
    c1:definition "A standardized rating scale developed by Bruno Blake in 1963, which is a performance-based evaluation of functional exercise capacity in subjects with chronic respiratory disease and heart failure, as well as other populations such as healthy older adults and people suffering from fibromyalgia and scleroderma. This functional test contains 6 items and measures the distance an individual is able to walk over a total of six minutes on a hard, flat surface." ;
    c1:example_set "SIX MINUTE WALK" ;
    c1:ncit_code "C115789" ;
    c1:ncit_dec_code "C25372" ;
    c1:package_date "2026-07-14" ;
    c1:parent_bc_id "C222260" ;
    c1:short_name "6 Minute Walk Functional Test 2008 Version" ;
    c1:synonyms "6MWT;SIXMW1;SIX MINUTE WALK" ;
.

