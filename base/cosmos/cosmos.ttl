    c1:bc_id "C74954" ;
    c1:definition "The quantitative measurement of liver enzymes in the blood, which is useful in assessing the functional state of a patient's liver. Liver function tests include the measurement of albumin, alanine transaminase, aspartate transaminase, alkaline phosphatase, bilirubin, and gamma glutamyl transferase." ;
    c1:ncit_code "C74954" ;
    c1:package_date "2025-04-01" ;
    c1:parent_bc_id "C49237" ;
    c1:result_scales "Quantitative" ;
    c1:short_name "Liver Function Test" ;
.

