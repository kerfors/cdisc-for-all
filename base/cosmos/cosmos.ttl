<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_hierarchy_latest/C168125>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_hierarchy_latest> ;
    c2:bc_categories "Vital Signs;Cardiovascular Examination" ;
    c2:bc_definition "An assessment performed to estimate peripheral perfusion and hydration status. The test is most often conducted by applying constant manual pressure for a set time on a patient's nail bed and then releasing while observing the length of time it takes for color to return to the tissue. A prolonged return to baseline coloring may indicate compromise of peripheral blood flow." ;
    c2:bc_hierarchy_full "Cardiovascular Examination (C122008); Capillary Refill Test (C168125)" ;
    c2:bc_hierarchy_level "1" ;
    c2:bc_id "C168125" ;
