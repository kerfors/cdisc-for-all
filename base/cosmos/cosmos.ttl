<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C100768/C25372>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_latest> ;
    c1:bc_categories "QRS;Clinical or Research Assessment Classification;Karnofsky Performance Status Scale Clinical Classification;KPS SCALE;KPSS01" ;
    c1:bc_id "C100768" ;
    c1:data_type "string" ;
    c1:dec_id "C25372" ;
    c1:dec_label "Category" ;
    c1:definition "A standardized rating scale originally developed by David A. Karnofsky and Joseph H. Burchenal in 1949 which is used to evaluate the degree to which a patient is functionally impaired. This instrument consists of 3 sections, no special care needed, unable to work, and unable to care for one's self and is completed by a clinician based on their observations. There are a total of eleven levels ranging from 0-100 where 0 indicates that the patient is dead and 100 indicates that the patient is normal." ;
    c1:example_set "KPS" ;
    c1:ncit_code "C100768" ;
    c1:ncit_dec_code "C25372" ;
    c1:package_date "2026-07-14" ;
    c1:parent_bc_id "C118969" ;
    c1:short_name "Karnofsky Performance Status Scale Clinical Classification" ;
    c1:synonyms "KPS SCALE;KPSS01" ;
.

