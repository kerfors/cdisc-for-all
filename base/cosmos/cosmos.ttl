<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C74563/C25372>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_latest> ;
    c1:bc_categories "Subject Characteristics" ;
    c1:bc_id "C74563" ;
    c1:data_type "string" ;
    c1:dec_id "C25372" ;
    c1:dec_label "Category" ;
    c1:definition "A classification system used by dermatologists to determine a person's risk for sunburn. The classification is based on the skin complexion and the degree of tolerance to sun exposure and it relates to the amount of melanin pigment in the skin. It was developed by Dr. Thomas Fitzpatrick in 1975 to determine patient's skin reaction to laser and light therapy treatments. According to this system, there are six skin varieties classified from I to VI." ;
    c1:ncit_code "C74563" ;
    c1:ncit_dec_code "C25372" ;
    c1:package_date "2026-07-14" ;
    c1:parent_bc_id "C74562" ;
    c1:result_scales "Ordinal" ;
    c1:short_name "Fitzpatrick Classification Scale" ;
    c1:synonyms "SKINCLAS;Fitzpatrick Classification Scale;Fitzpatrick Skin Classification;Fitzpatrick Skin Phototype;Fitzpatrick Skin Type System;Skin Classification" ;
.

