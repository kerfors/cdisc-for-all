    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_latest> ;
    c1:bc_categories "Urologic Surgical Procedure;Urogenital Surgical Procedure" ;
    c1:bc_id "C15284" ;
    c1:data_type "string" ;
    c1:dec_id "C117511" ;
    c1:dec_label "Reported Name of Procedure" ;
    c1:definition "A surgical procedure to completely or partially remove a kidney. With a complete nephrectomy, the attached adrenal gland, perinephric fat, and regional lymph nodes are often removed as well. With a partial nephrectomy, the removed tissue contains the tumor and a rim of normal renal parenchyma only." ;
    c1:ncit_code "C15284" ;
    c1:ncit_dec_code "C117511" ;
    c1:package_date "2026-11-02" ;
    c1:parent_bc_id "C15334" ;
    c1:result_scales "Nominal" ;
    c1:short_name "Nephrectomy" ;
.

