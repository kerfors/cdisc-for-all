<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C70793/C117458>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_latest> ;
    c1:bc_categories "Trial Summary" ;
    c1:bc_id "C70793" ;
    c1:data_type "string" ;
    c1:dec_id "C117458" ;
    c1:dec_label "Trial Summary Parameter Value Code" ;
    c1:definition "An entity such as an individual, company, institution, group, or organization which takes responsibility for the initiation, management, and/or financing of a clinical study. The sponsor does not actually conduct the investigation unless the sponsor is a sponsor-investigator. A person other than an individual (e.g., corporation or agency) that uses one or more of its own employees to conduct research it has initiated is considered to be a sponsor, and the employees are considered to be investigators. [21 CFR P.50.3(k)] [21 CFR P.50.102(j)] [21 CFR P.312.3]" ;
    c1:example_set "123456789" ;
    c1:ncit_code "C70793" ;
    c1:ncit_dec_code "C117458" ;
    c1:package_date "2025-07-01" ;
    c1:parent_bc_id "C48355" ;
    c1:result_scales "Nominal" ;
    c1:short_name "Clinical Study Sponsor" ;
    c1:synonyms "Sponsor;sponsor;CLINICAL STUDY SPONSOR;SPONSOR;Study Sponsor" ;
.

