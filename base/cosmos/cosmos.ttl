<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_hierarchy_latest/C102118>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_hierarchy_latest> ;
    c2:bc_categories "QRS;Clinical or Research Assessment Classification;Hamilton Anxiety Rating Scale Clinical Classification;HAM-A;HAMA;HAMA1" ;
    c2:bc_definition "A standardized rating scale developed by M. Hamilton in 1959 which is used to evaluate the severity of an individual's state of neurotic anxiety. This instrument contains 14 questions or types of symptoms associated with anxiety such as fear, mood, insomnia, and somatic symptoms, which is completed during a semi-structured interview. Each symptom is rated on a scale of 0-4 with 0 being none and 4 being the most severe. A score of 0-17 is considered 'mild', while a score of 18-24 is 'mild to moderate' and a score greater than 24 is 'moderate to severe.'" ;
    c2:bc_hierarchy_full "Clinical or Research Assessment Classification (C118969); Hamilton Anxiety Rating Scale Clinical Classification (C102118)" ;
    c2:bc_hierarchy_level "1" ;
    c2:bc_id "C102118" ;
    c2:bc_short_name "Hamilton Anxiety Rating Scale Clinical Classification" ;
    c2:bc_short_name_id "Hamilton Anxiety Rating Scale Clinical Classification (C102118)" ;
    c2:bc_synonyms "HAM-A;HAMA;HAMA1" ;
    c2:dec_n "4" ;
    c2:parent_bc_id "C118969" ;
.

