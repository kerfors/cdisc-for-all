<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C62667/C117511>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_latest> ;
    c1:bc_categories "Diagnostic Procedure;Diagnostic Imaging;NM;Nuclear Medicine" ;
    c1:bc_id "C62667" ;
    c1:data_type "string" ;
    c1:dec_id "C117511" ;
    c1:dec_label "Reported Name of Procedure" ;
    c1:definition "An imaging technique that uses a small dose of a radioactive chemical (isotope) called a tracer that can detect sites of cancer growth, trauma, infection or degenerative disorders. The tracer, which is either injected into a vein or swallowed, travels through the bloodstream to the target organ, and emits gamma rays, which are detected by a gamma camera and analyzed by a computer to form an image of the target organ." ;
    c1:ncit_code "C62667" ;
    c1:ncit_dec_code "C117511" ;
    c1:package_date "2026-07-14" ;
    c1:parent_bc_id "C16502" ;
    c1:result_scales "Nominal" ;
    c1:short_name "Radionuclide Imaging" ;
    c1:synonyms "Gamma Scan;Nuclear Medicine;Scintigraphy;Radioimaging" ;
.

