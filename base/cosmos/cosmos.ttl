<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_hierarchy_latest/C4872>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_hierarchy_latest> ;
    c2:bc_categories "Cancer;Carcinoma" ;
    c2:bc_definition "A carcinoma arising from the breast, most commonly the terminal ductal-lobular unit. It is the most common malignant tumor in females. Risk factors include country of birth, family history, menstrual and reproductive history, fibrocystic disease and epithelial hyperplasia, exogenous estrogens, contraceptive agents, and ionizing radiation. The vast majority of breast carcinomas are adenocarcinomas (ductal or lobular). Breast carcinoma spreads by direct invasion, by the lymphatic route, and by the blood vessel route. The most common site of lymph node involvement is the axilla." ;
    c2:bc_hierarchy_full "Breast Carcinoma (C4872)" ;
    c2:bc_hierarchy_level "0" ;
    c2:bc_id "C4872" ;
    c2:bc_short_name "Breast Carcinoma" ;
    c2:bc_short_name_id "Breast Carcinoma (C4872)" ;
    c2:bc_synonyms "Cancer of the Breast" ;
    c2:dec_n "0" ;
.

