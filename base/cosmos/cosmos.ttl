    c1:bc_id "C209693" ;
    c1:data_type "string" ;
    c1:dec_id "C25372" ;
    c1:dec_label "Category" ;
    c1:definition "An arbitrary categorization of individuals based on the assemblage of physical properties related to reproduction, and commonly associated with the designation of such categories as female and male. This designation is based on some combination of observable information from organ inventories, morphological assessment, hormone assessments, genetic testing, observed primary and secondary sex characteristics, menstrual status, and/or obstetric history. Current sex designation may or may not be the same as an individual's sex assigned or reported at birth. (NCI)" ;
    c1:ncit_code "C209693" ;
    c1:ncit_dec_code "C25372" ;
    c1:package_date "2026-07-14" ;
    c1:parent_bc_id "C28421" ;
    c1:result_scales "Nominal" ;
    c1:short_name "Sex Assigned for Clinical Purpose" ;
    c1:synonyms "SXCLUSE;Sex Assigned for Clinical Purpose;Sex for Clinical Use" ;
.

