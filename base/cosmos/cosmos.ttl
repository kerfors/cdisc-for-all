    c1:data_type "string" ;
    c1:dec_id "C66973" ;
    c1:dec_label "Unit of Dose Calculation" ;
    c1:definition "The point during activity or exercise at which the effort to ventilate increases such that the exerciser experiences duress and can no longer speak. This threshold is characterized by anaerobic metabolism and lactate buildup." ;
