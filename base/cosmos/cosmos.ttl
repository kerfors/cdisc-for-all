<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C15280/>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_latest> ;
    c1:bc_categories "Surgeries;Procedures" ;
    c1:bc_id "C15280" ;
    c1:definition "Breast conservation treatment is defined as excision of the primary tumor and adjacent breast tissue, followed by radiation therapy.  This procedure is also referred to as lumpectomy, segmental mastectomy, or partial mastectomy. (from Consensus Statements: Treatment of Early-stage Breast Cancer, 1990)" ;
    c1:ncit_code "C15280" ;
    c1:package_date "2025-09-23" ;
    c1:short_name "Breast Conservation Treatment" ;
.

