    c2:bc_synonyms "Capillary Refill Time;CPLRFLT" ;
    c2:dec_n "3" ;
    c2:parent_bc_id "C122008" ;
    c2:result_scales "Quantitative" ;
.

<https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_hierarchy_latest/C16818>
    a <https://kerfors.github.io/cdisc-for-all/def/cosmos#cdisc_biomedical_concepts_hierarchy_latest> ;
    c2:bc_categories "Diagnostic Imaging;Medical Imaging;Breast Cancer Diagnostic Procedures" ;
    c2:bc_definition "A type of radiography used specifically to examine breast tissue. The procedure utilizes a low-dose of x-rays or radiation to generate an image. A mammography exam or mammogram, is used as a screening tool to detect early breast cancer in women experiencing no symptoms and to detect and diagnose breast disease." ;
    c2:bc_hierarchy_full "Diagnostic Imaging Testing (C16502); Mammography (C16818)" ;
    c2:bc_hierarchy_level "1" ;
