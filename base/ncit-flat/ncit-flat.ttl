ncit:C12467
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12467" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12467>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A cluster of nerve cell bodies located within one of two paravertebral columns comprised of bundled nerve fibers that extend from the base of the skull to the first coccygeal vertebrae, or in a subsidiary location within the sympathetic nervous system. Sympathetic ganglia play a major role in the fight or flight and other stress-mediated responses." ;
    flat:display%20name "Sympathetic Ganglion" ;
    flat:parents "C12720" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Sympathetic Ganglion|SYMPATHETIC GANGLIA" ;
.

ncit:C12468
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
