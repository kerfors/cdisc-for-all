    flat:parents "C38114" ;
    flat:semantic%20type "Functional Concept" ;
    flat:synonyms "Extracorporeal Circulation Route of Administration|EXTRACORPOREAL|EXTRACORPOREAL|EXTRACORPOREAL|Extracorporeal|Extracorporeal use|X-CORPOR" ;
.

