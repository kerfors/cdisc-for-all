    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C221643>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram negative, anaerobic bacterium in the phylum Pseudomonadota. It is an emerging urinary tract pathogen." ;
    flat:parents "C76273" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Citrobacter murliniae|CITROBACTER MURLINIAE" ;
.

ncit:C221644
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C221644" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C221644>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram negative, rod-shaped bacterium in the phylum Pseudomonadota. It is highly pathogenic, causing severe clinical infection, while also being multi-drug resistant through the production of extended-spectrum beta-lactamases." ;
    flat:parents "C76310" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterobacter bugandensis|ENTEROBACTER BUGANDENSIS" ;
.

ncit:C221645
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C221645" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C221645>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram negative, nonmotile, strictly aerobic coccobacillus in the phylum Pseudomonadota. It is oxidase-negative and catalase-positive." ;
    flat:parents "C76200" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Acinetobacter bereziniae|ACINETOBACTER BEREZINIAE|Acinetobacter genospecies 10|Acinetobacter genospecies 10" ;
.

ncit:C221646
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C221646" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C221646>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram negative, strictly aerobic bacterium in the phylum Pseudomonadota. It is part of the Acinetobacter calcoaceticus-baumannii complex and is responsible for nosocomial infections." ;
    flat:parents "C76200" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Acinetobacter nosocomialis|ACINETOBACTER NOSOCOMIALIS" ;
.

ncit:C221647
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C221647" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C221647>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of budding yeast in the genus Candidozyma that causes candidiasis in humans. Infections include superficial skin infections, wound infections, ear infections, and bloodstream infections. It spreads easily in healthcare facilities between immunocompromised individuals." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Candidozyma auris|C. auris|CANDIDOZYMA AURIS|Candida auris|Candida auris|Candida auris" ;
.

ncit:C221648
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C221648" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C221648>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A non-taxonomic grouping of fungal species that are phenotypically or genetically similar to the Candida parapsilosis species." ;
    flat:parents "C77163" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Candida parapsilosis Complex|CANDIDA PARAPSILOSIS COMPLEX" ;
.

ncit:C221649
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C221649" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C221649>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of yellow pigmented, Gram negative, rod shaped bacterium in the phylum Bacteroidetes. This species is primarily found in the midgut of the Anopheles mosquito. E. meningoceptica is pathogenic, being the causative agent of neonatal meningitis." ;
    flat:parents "C86352" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Elizabethkingia anophelis|ELIZABETHKINGIA ANOPHELIS|Elizabethkingia genomospecies 1" ;
.

