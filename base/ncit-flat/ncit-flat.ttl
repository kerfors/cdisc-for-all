    flat:code "C122040" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122040>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of apicomplexan parasites in the family Babesiidae. Babesia are spread by ticks and are the causative agent of the hemolytic disease babesiosis." ;
    flat:parents "C77916" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Babesia|BABESIA|Nuttalia" ;
.

