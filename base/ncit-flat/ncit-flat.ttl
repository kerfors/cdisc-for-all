ncit:C114866
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C114866" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C114866>" ;
    flat:concept%20in%20subset "CTRP Biomarker Terminology|CTRP Molecular Genetic Biomarker Terminology|CTRP Terminology" ;
    flat:definition "Proteins in the core histone families, histone H2A and histone H2B represent 2 of the 4 families of histones found in the core of nucleosomes. Histones in the H2A family dimerize with those in the H2B family, then two H2A/H2B dimers can associate with a tetramer containing 2 proteins from the histone H3 family and 2 proteins from the histone H4 family to form the octameric nucleosome core. The octameric complex is the basic unit for eukaryotic DNA packaging." ;
    flat:display%20name "Histone H2" ;
    flat:parents "C16687" ;
    flat:semantic%20type "Amino Acid, Peptide, or Protein" ;
    flat:synonyms "Histone H2|Histone 2" ;
.

