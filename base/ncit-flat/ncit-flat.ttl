    flat:parents "C85924" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Parvimonas|PARVIMONAS" ;
.

ncit:C86901
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86901" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86901>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-positive, cocci shaped bacteria assigned to the phylum Firmicutes. This species is indole and urease negative, nonfermenting, beta-hemolytic, and does not reduce nitrate. P. micra is commensal to the human mouth, gastrointestinal tract and female genito-urinary tract, but may become pathogenic." ;
    flat:parents "C86900" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Parvimonas micra|Micromonas micros|Micromonas micros|PARVIMONAS MICRA|Peptostreptococcus micros|Peptostreptococcus micros" ;
.

ncit:C86902
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86902" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86902>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of anaerobic, Gram positive, cocci shaped bacterium assigned to the phylum Firmicutes and the family Clostridiales XI." ;
    flat:parents "C85924" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Peptoniphilus|PEPTONIPHILUS" ;
.

ncit:C86903
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86903" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86903>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-positive, cocci shaped bacteria assigned to the phylum Firmicutes. This species is nonmotile, non-spore forming, indole positive, produce butyric acid and gas in peptone yeast extract medium with glucose, urease negative, and does not reduce nitrate, produce coagulase, hydrolyze esculin or starch, liquefy gelatin, ferment carbohydrates, or produce propionate from lactate. P. asaccharolyticus is commensal to the human intestinal tract but has been associated with genital tract, lung, skin, and brain abscesses." ;
    flat:parents "C86902" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Peptoniphilus asaccharolyticus|PEPTONIPHILUS ASACCHAROLYTICUS|Peptococcus asaccharolyticus|Peptococcus asaccharolyticus|Peptostreptococcus asaccharolyticus|Peptostreptococcus asaccharolyticus" ;
.

ncit:C86904
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86904" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86904>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-positive, cocci shaped bacteria assigned to the phylum Firmicutes. This species is nonmotile, non-spore forming, indole positive, catalase and urease negative, reduces nitrate, produces butyric acid, gas from peptone-yeast-glucose medium and propionate from lactate, coagulase and indole, and does not ferment carbohydrates or liquefy gelatin. P. indolicus is found in cattle, swine, and rats and is pathogenic to humans and possibly animals." ;
    flat:parents "C86902" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Peptoniphilus indolicus|PEPTONIPHILUS INDOLICUS|Peptostreptococcus indolicus|Peptostreptococcus indolicus" ;
.

ncit:C86905
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86905" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86905>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-positive, alpha- or beta-hemolytic bacteria in the order Lactobacillales. The species is split into two subspecies, S. dysgalactiae subsp. dysgalactiae and S. dysgalactiae subsp. equisimilis." ;
    flat:parents "C76383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus dysgalactiae|STREPTOCOCCUS DYSGALACTIAE" ;
.

ncit:C86906
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86906" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86906>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A subspecies of facultatively anaerobic, Gram positive, cocci shaped bacteria in the phylum Firmicutes. This subspecies is positive for Lancefield group G, beta hemolysis, arginine deamination, esculin hydrolysis, beta glucuronidase, and growth in 6.5% NaCl and negative for alpha and beta galactosidase, catalase, and pyrrolidonylarylamidase. It can ferment trehalose, and ribose but not sorbitol, or glycogen. S. dysgalactiae subsp. equisimilis is found in the human respiratory tract and vagina and is pathogenic, causing pharyngitis, impetigo, cellulitis, septicemia, glomerulonephritis, and toxic shock." ;
    flat:parents "C86905" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus dysgalactiae subsp equisimilis|STREPTOCOCCUS DYSGALACTIAE SUBSP. EQUISIMILIS|Streptococcus dysgalactiae subsp. equisimilis|Streptococcus equisimilis|Streptococcus equisimilis" ;
.

ncit:C86907
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86907" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86907>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of obligately anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Firmicutes and the family Clostridiales XI." ;
    flat:parents "C85924" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Tissierella|TISSIERELLA" ;
.

ncit:C86908
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86908" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86908>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of obligatively anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Firmicutes. This species is motile, 6 phosphogluconate dehydrogenase positive and urease and indole negative. T. praeacuta is found in the human intestinal tract and in lung abscesses and gangrenous lesions." ;
    flat:parents "C86907" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Tissierella praeacuta|TISSIERELLA PRAEACUTA" ;
.

ncit:C86909
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86909" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86909>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A subspecies of Treponema pallidum; an anaerobic, Gram indeterminate, spiral shaped bacteria assigned to the phylum Spirochaetes. This subspecies is motile and an obligate parasite. T. pallidum subsp. pertenue is a pathogen that is the causative agent of yaws." ;
    flat:parents "C86825" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Treponema pallidum subsp pertenue|TREPONEMA PALLIDUM SUBSP. PERTENUE|Treponema pallidum subsp. pertenue|Treponema pertenue|Treponema pertenue" ;
.

ncit:C86910
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86910" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86910>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A subspecies of aerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria and the species Salmonella enterica. S. enterica subsp. arizonae is an inhabitant of the gut of reptiles and is pathogenic in humans, although is rarely isolated from clinical specimens." ;
    flat:parents "C86731" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Salmonella enterica subsp arizonae|Arizona arizonae|Arizona hinshawii|Paracolobactrum arizonae|SALMONELLA ENTERICA SUBSP. ARIZONAE|Salmonella arizonae|Salmonella enterica subsp. arizonae" ;
.

ncit:C86913
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
