    flat:code "C32926" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C32926>" ;
    flat:definition "Mucosa consisting of the epithelium, basement membrane, lamina propria mucosae and lamina muscularis mucosae of the distal portion of the digestive tract from the small intestine to the anus." ;
