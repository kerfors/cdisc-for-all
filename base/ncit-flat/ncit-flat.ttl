    flat:definition "A dose calculation unit expressed in liter(s) per milligram." ;
    flat:parents "C66973" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Liter per Milligram|L/mg|L/mg|L/mg|L/mg|L/mg|l/mg|l/mg|mL/ug|mL/ug|nL/pg|uL/ng" ;
.

