    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12555" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12555>" ;
    flat:definition "A non-epithelial cell of mesodermal origin that is found in mesenchymal tissue and functions to support, surround, or protect other structures or organs in the body." ;
    flat:display%20name "Connective Tissue Cell" ;
    flat:parents "C12508" ;
    flat:semantic%20type "Cell" ;
    flat:synonyms "Connective and Soft Tissue Cell" ;
.

