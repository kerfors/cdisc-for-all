    flat:semantic%20type "Functional Concept" ;
    flat:synonyms "Intramedullary Route of Administration|I-MEDUL|I-MEDUL|INTRAMEDULLARY|INTRAMEDULLARY|INTRAMEDULLARY|Intramedullary|Intramedullary" ;
.

