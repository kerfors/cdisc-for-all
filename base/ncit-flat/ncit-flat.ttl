    flat:parents "C101685" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Late Lumen Loss Measurement|LLMLOSS|Late Lumen Loss|Late Lumen Loss" ;
.

ncit:C116147
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
