ncit:C214673
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C214673" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C214673>" ;
    flat:concept%20in%20subset "CDISC SDTM Immunogenicity Specimen Test Details Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A measurement that compares the phagocytic activity of an infected individual's blood for a particular microorganism to that of a normal person. The opsonic index is the ratio of the phagocytic index of infected or immune serum divided by the phagocytic index of normal serum." ;
    flat:parents "C49188" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Opsonization Index|OI|OPSONIZATION INDEX|Opsonic Index" ;
.

ncit:C214674
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C214674" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C214674>" ;
    flat:concept%20in%20subset "CDISC SDTM Immunogenicity Specimen Test Details Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An arbitrary measure of phagocytic activity (by phagocytes) that is assessed by counting the average number of ingested microorganisms per phagocyte after a period of incubation. It is calculated by counting the number of microorganisms ingested by phagocytes in a suspension of microorganisms, phagocytes, and serum (either normal or immune)." ;
    flat:parents "C49188" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Phagocytic Index|PHAGOCYTIC INDEX|Phagocytic Score" ;
.

