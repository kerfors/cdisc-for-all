    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology" ;
    flat:definition "A unit of fraction expressed as the ratio of the amount of a substance in solution, in micromoles, to the amount of a different substance in the mixture, in moles." ;
    flat:parents "C64568" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Micromole per Mole|Femtomole per Nanomole|Nanomole per Millimole|Picomole per Micromole|fmol/nmol|micromole per mole|mol/umol|nanomole per millimole|nmol/mmol|nmol/mmol|nmol/mmol|picomole per micromole|pmol/umol|umol/mol|umol/mol|umol/mol|umol/mol" ;
.

ncit:C122232
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122232" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122232>" ;
