    flat:semantic%20type "Research Activity" ;
    flat:synonyms "Clinical Study by Intent|Clinical Study Intent|Study Intent|TINDTP|Trial Indication Type|Trial Intent Type|Trial Intent Type|Trial Intent Type" ;
.

