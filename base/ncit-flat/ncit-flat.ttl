    flat:definition "A genus of facultatively anaerobic gram negative rod shaped bacterium in the phylum Proteobacteria and the family Vibrionaceae." ;
    flat:parents "C85970" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Photobacterium|PHOTOBACTERIUM" ;
.

ncit:C86647
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86647" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86647>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, rod shaped bacteria in the phylum Proteobacteria. This species is motile using one or more unsheathed polar flagella, urease, arginine dihydrolase, and lipase positive, gelatinase negative, not bioluminescent, does not require NaCl for growth, and utilizes pyruvate, lactate, glutamate, mannose, galactose, cellobiose and glycerate as its sole source of carbon and energy in 0.05% yeast extract. P. damselae is an opportunistic pathogen that has been isolated from infectious sites in damselfishes, sharks, dolphins, and humans." ;
    flat:parents "C86646" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Photobacterium damselae|CDC Group EF-5|PHOTOBACTERIUM DAMSELAE|Photobacterium damselae subsp. damselae|Photobacterium damselae subsp. damselae|Vibrio damsela|Vibrio damsela" ;
.

ncit:C86648
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86648" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86648>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria and the family Enterobacteriaceae." ;
    flat:parents "C85932" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Photorhabdus|PHOTORHABDUS" ;
.

ncit:C86649
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86649" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86649>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile using peritrichous flagella, non-spore forming, utilizes ribose and tyrosine, bioluminescent, catalase and lecithinase positive, produces a red, pink or yellow pigment, utilizes citrate as its sole carbon and energy source, oxidase and Voges-Proskauer test negative, and does not reduce nitrate. P. luminescens is found in the intestinal lumen of entomogenous nematodes and is pathogenic to insects and humans." ;
    flat:parents "C86648" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Photorhabdus luminescens|PHOTORHABDUS LUMINESCENS" ;
.

