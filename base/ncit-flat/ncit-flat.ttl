ncit:C12521
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12521" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12521>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|CTRP Biomarker Terminology|CTRP Terminology|HemOnc Agent Terminology" ;
    flat:definition "A blood cell specialized for oxygen transport, having a high concentration of hemoglobin in the cytoplasm. They are biconcave, anucleate discs, with a 6-8um diameter in humans." ;
    flat:display%20name "Erythrocyte" ;
    flat:parents "C12519" ;
    flat:semantic%20type "Cell" ;
    flat:synonyms "Erythrocyte|Blood Corpuscles|Blood Erythrocyte|ERYTHROCYTES|Erythrocytes|Erythrocytic|Normocyte|RBC|RBC|RBC|RBCs|Red Blood Cells|Red Blood Cells|Red Blood Corpuscule|Red Cell|Red blood cells|Red cells|Reticuloendothelial System, Erythrocytes|erythrocyte|red blood cell" ;
.

ncit:C12528
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12528" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12528>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|CTRP Biomarker Terminology|CTRP Terminology" ;
    flat:definition "Immature erythrocytes that have just undergone extrusion of their cell nucleus. They still contain some organelles that gradually decrease in number as the cells mature." ;
    flat:display%20name "Reticulocytes" ;
    flat:parents "C12521" ;
    flat:semantic%20type "Cell" ;
    flat:synonyms "Reticulocyte|RETICULOCYTES|Reticulocytes" ;
.

ncit:C12529
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12529" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12529>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|CTRP Biomarker Terminology|CTRP Terminology|GDC Terminology|GDC Value Terminology" ;
    flat:definition "Blood cells that are devoid of hemoglobin, capable of ameboid motion and phagocytosis, and act as the principal components of the immune system." ;
    flat:display%20name "Leukocytes" ;
    flat:parents "C12519" ;
    flat:semantic%20type "Cell" ;
    flat:synonyms "Leukocyte|LEUKOCYTE|Leukocytes|Leukocytes|Reticuloendothelial System, Leukocytes|WBC|WBCs|White Blood Cell|White Blood Cells|White Blood Cells|White Blood Corpuscle|White Cell|leukocyte|white blood cell" ;
.

ncit:C12530
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12530" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12530>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|CTRP Biomarker Terminology|CTRP Terminology|GDC Terminology|GDC Value Terminology" ;
    flat:definition "A type of leukocyte with a multilobed nucleus and cytoplasmic granules. The unique morphology of the nucleus has led to their also being known as polymorphonuclear leukocytes (PMLs or PMNs). Granulocytes are subdivided according to the staining properties of their granules into eosinophils (red with acidic dye), basophils (blue with basic dye), and neutrophils (not amenable to staining with either acidic or basic dyes)." ;
    flat:display%20name "Granulocyte" ;
    flat:parents "C12549" ;
    flat:semantic%20type "Cell" ;
    flat:synonyms "Granulocyte|GRANULOCYTE|Granular Leukocyte|Granular Leukocytes|Granulocytes|Granulocytes|Granulocytic|Granulocytic Cell|PMN|Polymorphonuclear Cell|Polymorphonuclear Leukocytes|granular leukocyte|granulocyte|polymorphonuclear leukocyte" ;
.

ncit:C12535
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12535" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12535>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|CTRP Biomarker Terminology|CTRP Terminology|GDC Terminology|GDC Value Terminology" ;
    flat:definition "White blood cells formed in the body's lymphoid tissue. The nucleus is round or ovoid with coarse, irregularly clumped chromatin while the cytoplasm is typically pale blue with azurophilic (if any) granules. Most lymphocytes can be classified as either T or B (with subpopulations of each); those with characteristics of neither major class are called null cells." ;
    flat:display%20name "Lymphocyte" ;
    flat:parents "C32725" ;
    flat:semantic%20type "Cell" ;
    flat:synonyms "Lymphocyte|LYMPHOCYTE|Lymph Cell|Lymphocytes|Lymphocytes|lymphocyte" ;
.

ncit:C12536
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12536" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12536>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|CTRP Biomarker Terminology|CTRP Terminology" ;
    flat:definition "Natural killer cells are cells that resemble large granular lymphocytes.  They do not express markers of either T or B cell lineage. They are positive for CD16, CD56, and CD 94.  These cells do possess Fc receptors for IgG and can kill target cells using antibody-dependent cell-mediated cytotoxicity. They can also use perforin to kill cells in the absence of antibody and killing may occur without previous sensitization." ;
    flat:display%20name "Natural Killer Cell" ;
    flat:parents "C39568" ;
    flat:semantic%20type "Cell" ;
    flat:synonyms "Natural Killer Cell|Killer Cell|Killer Cells|NATURAL KILLER CELL|NK|NK Cell|NK Cells|NK cell|NK-Cell|NK-LGL|killer cell|natural killer cell" ;
.

ncit:C125393
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125393" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125393>" ;
