    flat:concept%20in%20subset "CTRP Biomarker Terminology|CTRP Terminology" ;
    flat:definition "Primitive blood cells derived from embryonic mesenchyme capable of differentiating into any of the blood cell line progenitor cells (erythroblasts, young granulocytic series cells, megakaryocytes, etc.)" ;
    flat:display%20name "Hematopoietic Stem Cell" ;
    flat:parents "C32725|C12662" ;
