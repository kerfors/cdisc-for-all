    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of yeasts in the family Saccharomycetaceae with spherical, elliptical or oblong acuminate cells." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Pichia|Hansenula|PICHIA" ;
.

