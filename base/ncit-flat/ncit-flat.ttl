    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A bacterium that is assigned to the genus Streptococcus that is able to facilitate the complete rupturing of red blood cells, thus producing wide, clear, zones around colonies on blood agar plates." ;
    flat:parents "C76383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Beta-Hemolytic Streptococcus|STREPTOCOCCUS BETA-HEMOLYTIC" ;
.

