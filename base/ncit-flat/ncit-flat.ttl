.

ncit:C125985
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125985" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125985>" ;
    flat:concept%20in%20subset "CDISC SDTM Microscopic Findings Test Detail Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A score developed by Allred et al. (1998) for the proportion of tumor cells that are positive for a given biomarker. The proportion score is assigned based on the biomarker positivity measurement." ;
    flat:parents "C25338" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Allred Proportion Positive Score|ALLRED PROPORTION POSITIVE SCORE" ;
.

ncit:C125986
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125986" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125986>" ;
    flat:concept%20in%20subset "CDISC SDTM Microscopic Findings Test Detail Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A score developed by Allred et al. (1998) for the average staining intensity for all stained protein-positive cells." ;
    flat:parents "C25338" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Allred Average Staining Intensity Score|ALLRED STAINING INTENSITY SCORE" ;
.

ncit:C125987
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125987" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125987>" ;
    flat:concept%20in%20subset "CDISC SDTM Microscopic Findings Test Detail Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A score for the semi-quantitative staining of estrogen-positive (ER+) or progesterone-positive (PR+) cells in breast cancer tissue samples. It combines a score of 0 through 5 for percentage of stained cells and a score of 0-3 for the intensity of staining. A score of 0-2 is considered negative and 3-8 qualify as positive." ;
    flat:parents "C25338" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Allred Total Score|ALLRED TOTAL SCORE|Allred Score" ;
.

ncit:C125988
