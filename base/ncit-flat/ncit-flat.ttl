    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C124408>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A subspecies of Streptococcus equi that is positive for beta hemolysis, produces hyaluronic acid but not streptolysin O, and occurs in pairs or long chains. This subspecies is also lactose positive and capable of fermenting sorbitol but not trehalose." ;
    flat:parents "C86789" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus equi subsp. zooepidemicus|STREPTOCOCCUS EQUI SUBSP. ZOOEPIDEMICUS" ;
.

ncit:C124409
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C124409" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C124409>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-positive, non-sporulating, non-motile coccus-shaped bacteria in the order Lactobacillales. S.lutetiensis is positive for alpha-galactosidase and beta-glucosidase and negative for catalase, urease, alkaline phosphatase, beta-glactosidase, and beta-glucuronidase. The species has been isolated from human cerebrospinal fluid, urine, and stool." ;
    flat:parents "C76383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus lutetiensis|STREPTOCOCCUS LUTETIENSIS" ;
.

ncit:C12441
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12441" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12441>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Biospecimens Terminology|CDISC SEND Microscopic Findings Result Modifier Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|CRF6 DMG Imaging Assessment Table|GDC Terminology|GDC Value Terminology|Mapped ICDO3.1 Terminology|Mapped ICDO3.1 Topography PT Terminology|Mapped ICDO3.1 Topography Terminology|Mapped ICDO3.2 Terminology|Mapped ICDO3.2 Topography PT Terminology|Mapped ICDO3.2 Topography Terminology|mCode Radiotherapy Treatment Location Value Set|mCode Terminology|UBERON Terminology" ;
    flat:definition "Three sections, the midbrain, pons and medulla oblongata, that are located at the base of the brain. The brain stem regulates the central nervous system, and is vital as a conduit for motor and sensory innervations." ;
    flat:display%20name "Brain Stem" ;
    flat:parents "C13031" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Brain Stem|BRAIN STEM|BRAIN, BRAIN STEM|BRAIN, BRAIN STEM|Brain stem|Brain, Brain stem|Brainstem|Brainstem|Brainstem|Brainstem structure (body structure)|brain stem|brain stem|brainstem|truncus encephali" ;
.

ncit:C124410
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C124410" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C124410>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-positive, non-motile, non-spore-forming coccus-shaped bacteria in the order Lactobacillales. S. massiliensis is negative for beta-glucosidase, beta-galactosidase, beta-glucuronidase, alpha-galactosidase, urease, beta-glucosaminidase and beta-mannosidase. The species ferments maltose but is negative for fermentation of other sugars. It was originally isolated form a human clinical blood sample." ;
    flat:parents "C76383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus massiliensis|STREPTOCOCCUS MASSILIENSIS" ;
.

ncit:C124411
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C124411" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C124411>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|CTRP Biomarker Terminology|CTRP Terminology" ;
    flat:definition "A species of Gram-positive coccus-shaped bacteria in the order Lactobacillales. S. mutants is commonly found in the human oral cavity, where is a primary causative agent of tooth decay." ;
    flat:display%20name "Streptococcus mutans" ;
    flat:parents "C86798" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus mutans|STREPTOCOCCUS MUTANS" ;
.

ncit:C124412
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C124412" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C124412>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-positive coccus-shaped, non-motile bacteria in the order Lactobacillales. S. pluranimalium is positive for acid production from glucose, fructose, and trehalose. This species is primarily responsible for infection in bovine and avian species with only limited identification of infection in human clinical isolates." ;
    flat:parents "C76383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus pluranimalium|STREPTOCOCCUS PLURANIMALIUM" ;
.

ncit:C124413
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C124413" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C124413>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A non-taxonomic grouping of Streptococcal bacteria that are either alpha-hemolytic, producing a green coloration on blood agar plates, or nonhemolytic. Within this heterogeneous group, some species are commensal flora while others are human pathogens." ;
    flat:parents "C86811" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus viridans|STREPTOCOCCUS VIRIDANS|VGS|Viridans Group Streptococci|Viridans Streptococcal Species|Viridans Streptococci" ;
.

ncit:C124414
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C124414" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C124414>" ;
    flat:concept%20in%20subset "CDISC SDTM Category of Oncology Response Assessment Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized guideline developed by the Response Evaluation Criteria in Solid Tumors (RECIST) Working Group in 2000, which is an objective response criteria used to assess solid tumor response and to measure change in tumor size for use in adult and pediatric cancer clinical trials. RECIST version 1.0 contains the following key features: definitions of minimum size of measurable lesions, instructions on how many lesions to follow, and the use of uni-dimensional rather than bi-dimensional measures for evaluation of tumor burden." ;
    flat:parents "C49164" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Response Evaluation Criteria in Solid Tumors Version 1.0|RECIST 1.0" ;
.

ncit:C124415
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C124415" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C124415>" ;
    flat:concept%20in%20subset "CDISC SDTM Category of Oncology Response Assessment Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized guideline developed by the Response Evaluation Criteria in Solid Tumors (RECIST) Working Group in 2000 and revised in 2009, which is an objective response criteria used to assess solid tumor response and to measure change in tumor size for use in adult and pediatric cancer clinical trials. Major revisions in RECIST version 1.1 includes lymph node (LN) measurement, the maximum number of target lesions, the definition of disease progression, as well as the inclusion of and guidance on the use of MRI and FDG PET in the detection of new lesions." ;
    flat:parents "C49164" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Response Evaluation Criteria in Solid Tumors Version 1.1|RECIST 1.1" ;
.

