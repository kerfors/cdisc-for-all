    flat:code "C122042" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122042>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of parasitic nematode in the family Angiostrongylidae. Memebers of the genus can cause severe gastrointestinal or central nervous system disease in humans, depending on the species." ;
    flat:parents "C14248" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Angiostrongylus|ANGIOSTRONGYLUS" ;
.

ncit:C122043
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122043" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122043>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of parasitic nematode in the family Anisakidae. Members of the genus cause anisakiasis in humans. Their life cycle involves fish, crustaceans, and marine mammals. Humans become infested by eating infested fish." ;
    flat:parents "C14248" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Anisakis|ANISAKIS" ;
.

