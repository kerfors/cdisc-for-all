    flat:definition "A coding scheme used to describe the possible methods of compensation in an occupation." ;
    flat:parents "C25162" ;
    flat:semantic%20type "Functional Concept" ;
    flat:synonyms "Employee Salary Type|SALTYP" ;
.

ncit:C74569
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C74569" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C74569>" ;
    flat:concept%20in%20subset "CDISC SDTM Skin Classification Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Skin which is extremely pale white and it always burns when exposed to the sun. It is seen in people with blond or red hair and blue or hazel eyes." ;
    flat:parents "C74563" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Fitzpatrick Skin Type I|Fitzpatrick Skin Phototype I|TYPE1|TYPEI" ;
.

ncit:C74570
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C74570" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C74570>" ;
    flat:concept%20in%20subset "CDISC SDTM Skin Classification Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Skin which is white and it usually burns easily when exposed to the sun. It is usually seen in people with blond or red hair and blue or hazel eyes." ;
    flat:parents "C74563" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Fitzpatrick Skin Type II|Fitzpatrick Skin Phototype II|TYPE2|TYPEII" ;
.

