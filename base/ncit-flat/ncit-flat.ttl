    flat:definition "A genus of Gram-positive, rod-shaped bacteria in the family Firmicutes." ;
    flat:parents "C76197" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Dolosigranulum" ;
.

ncit:C122021
