    flat:parents "C118969" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Psoriasis Area and Severity Index Bozek Version Clinical Classification|PASI BOZEK|PASI Bozek Version|PASI05" ;
.

