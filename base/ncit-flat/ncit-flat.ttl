    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A bacterium that belongs to the Milleri group of the genus Streptococcus." ;
    flat:parents "C76383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus milleri Group|STREPTOCOCCUS MILLERI GROUP" ;
.

ncit:C86797
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86797" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86797>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A bacterium that belongs to the Mitis group of the genus Streptococcus." ;
    flat:parents "C76383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus mitis Group|STREPTOCOCCUS MITIS GROUP" ;
.

ncit:C86798
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
