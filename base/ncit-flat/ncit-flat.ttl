    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C39547>" ;
    flat:concept%20in%20subset "CDISC Glossary Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The probability of benefit to individuals in a defined population from a medical technology applied for a given medical problem under ideal conditions of use. Efficacy is a measure of effect of therapy among appropriate patients in whom treatment is tolerated and effectively administered, under the condition of sufficient patients' compliance, usually determined in randomized trials." ;
    flat:parents "C88183" ;
    flat:semantic%20type "Qualitative Concept" ;
    flat:synonyms "Treatment Efficacy|clinical efficacy" ;
.

