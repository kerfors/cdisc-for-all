    flat:definition "The amount of an individual's total body mass that is fat, expressed as a percent." ;
    flat:parents "C19332" ;
    flat:semantic%20type "Organism Attribute" ;
    flat:synonyms "Total Body Fat to Total Body Mass Ratio Measurement|BODYFATP|Body Fat Percentage|Total Body Fat/Total Body Mass|Total Body Fat/Total Body Mass" ;
.

ncit:C139219
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C139219" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C139219>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Vital Sign Test Code Terminology|CDISC SDTM Vital Sign Test Name Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The proportion of an individual's lean body mass to his total body weight; lean body mass is calculated by subtracting body fat from total body weight." ;
