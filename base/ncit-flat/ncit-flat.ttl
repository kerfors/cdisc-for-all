    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123549>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A protozoan parasite in the family Plasmodiidae. P. ovale is a rare causative agent of tertian malaria." ;
    flat:parents "C98268" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Plasmodium ovale|PLASMODIUM OVALE" ;
.

