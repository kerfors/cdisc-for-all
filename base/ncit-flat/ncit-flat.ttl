    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C150854>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A muscle that originates on the distal anteriomedial surface of the ulna and inserts in the distal anteriolateral surface of the radius; it is involved in the pronation of the forearm and is supplied by the anterior interosseous nerve and artery." ;
    flat:parents "C13056" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Pronator Quadratus Muscle|PRONATOR QUADRATUS MUSCLE" ;
.

