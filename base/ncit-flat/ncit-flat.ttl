    flat:parents "C2991" ;
    flat:semantic%20type "Neoplastic Process" ;
    flat:synonyms "Neoplasm|Neoplasia|Neoplasm, NOS|Neoplasms, NOS|Neoplastic Disease|Neoplastic Growth|Other Neoplasm|Tumor, NOS|neoplasia|neoplasm|tumor" ;
.

