.

ncit:C132494
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C132494" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C132494>" ;
    flat:definition "The anatomical structures that define the neck lymph node boundaries." ;
    flat:parents "C32298" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Neck Lymph Node Boundary Levels and Sublevels" ;
.

ncit:C132499
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C132499" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C132499>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The following anatomical structures define the neck lymph node boundary for level III: Superior: horizontal plane defined by the inferior body of the hyoid; inferior: horizontal plane defined by the inferior border of the cricoid cartilage; anterior (medial): lateral border of the sternohyoid muscle; posterior (lateral): lateral border of the sternocleidomastoid or sensory branches of the cervical plexus. (AJCC 8th ed.)" ;
    flat:parents "C132494" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Neck Lymph Node Boundary Level III|CERVICAL LYMPH NODE LEVEL III" ;
.

ncit:C13250
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C13250" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13250>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A tuft of capillaries situated at the entrance to each nephron, within the Bowman's capsule. This tuft functions as the first stage in filtering blood in the kidney." ;
    flat:parents "C34028" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Glomerulus|GLOMERULUS|Glomerular|Malpighian Tuft|Renal Glomerulus|renal glomerulus" ;
.

ncit:C132500
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C132500" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C132500>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The following anatomical structures define the neck lymph node boundary for level IV: Superior: horizontal plane defined by the inferior border of the cricoid cartilage; inferior: clavicle; anterior (medial): lateral border of the sternohyoid muscle; posterior (lateral): lateral border of the sternocleidomastoid or sensory branches of the cervical plexus. (AJCC 8th ed.)" ;
    flat:parents "C132494" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Neck Lymph Node Boundary Level IV|CERVICAL LYMPH NODE LEVEL IV" ;
.

ncit:C132507
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C132507" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C132507>" ;
    flat:definition "Lymph node groups found within the seven levels and sublevels of the neck. (AJCC 8th ed.)" ;
    flat:parents "C12745" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Neck Lymph Node Groups" ;
.

ncit:C132511
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C132511" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C132511>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Lymph nodes located around the middle third of the internal jugular vein, extending from the inferior border of the hyoid bone (above) to the inferior border of the cricoid cartilage (below). The anterior (medial) boundary is the lateral border of the sternohyoid muscle, and the posterior (lateral) boundary is the posterior border of the sternocleidomastoid muscle. These nodes are at greatest risk for harboring metastases from cancers arising from the oral cavity, nasopharynx, oropharynx, hypopharynx, and larynx. (AJCC 8th ed.)" ;
    flat:parents "C132507" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Middle Jugular Lymph Node Group (Level III)|MID-JUGULAR LYMPH NODE" ;
.

ncit:C132512
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C132512" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C132512>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Lymph nodes located around the lower third of the internal jugular vein, extending from the inferior border of the cricoid cartilage (above) to the clavicle below. The anterior (medial) boundary is the lateral border of the sternohyoid muscle and the posterior (lateral) boundary is the posterior border of the sternocleidomastoid muscle. These nodes are at greatest risk for harboring metastases from cancers arising from the hypopharynx, thyroid, cervical esophagus, and larynx. (AJCC 8th ed.)" ;
    flat:parents "C132507" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Lower Jugular Lymph Node Group (Level IV)|LOWER JUGULAR LYMPH NODE" ;
.

ncit:C132514
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C132514" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C132514>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Lymph nodes in this compartment include the pretracheal and paratracheal nodes, precricoid (Delphian) node, and the perithyroidal nodes, including the lymph nodes along the recurrent laryngeal nerves. The superior boundary is the hyoid bone; the inferior boundary is the suprasternal notch; and the lateral boundaries are the common carotid arteries. These nodes are at greatest risk for harboring metastases from cancers arising from the thyroid gland, glottic and subglottic larynx, apex of the piriform sinus, and cervical esophagus. (AJCC 8th ed.)" ;
    flat:parents "C132507" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Anterior Compartment Lymph Node Group (Level VI)|CERVICAL LYMPH NODE LEVEL VI|Central Compartment Lymph Nodes" ;
.

ncit:C132515
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C132515" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C132515>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Lymph nodes in this group include pretracheal, paratracheal, and esophageal groove lymph nodes, extending from the level of the suprasternal notch cephalad and up to the innominate artery caudad. These nodes are at greatest risk of involvement by thyroid cancer and cancer of the esophagus. (AJCC 8th ed.)" ;
    flat:parents "C132507" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Superior Mediastinal Lymph Node Group (Level VII)|SUPERIOR MEDIASTINAL LYMPH NODE LEVEL VII" ;
.

