    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "International Reading Speed Text Test|INTERNATIONAL READING SPEED TEXT TEST|IReST Test|IReST Test" ;
.

ncit:C178033
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C178033" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C178033>" ;
    flat:concept%20in%20subset "CDISC SDTM Microscopic Findings Test Detail Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A score originally developed by D'Haens et al. (1998) and assigned based on the histologic evaluation of acute and chronic inflammatory changes, epithelial damage, and the extent of inflammation in Crohn's disease mucosal biopsy specimens, according to the Global Histologic Disease Activity Score. (G R D'Haens, K Geboes, M Peeters, F Baert, F Penninckx, P Rutgeerts. Early lesions of recurrent Crohn's disease caused by infusion of intestinal contents in excluded ileum. Gastroenterology. 1998 Feb;114(2):262-7)." ;
    flat:parents "C217122" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Global Histologic Disease Activity Score|GHAS SCORE|GHAS Score" ;
