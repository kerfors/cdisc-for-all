    flat:definition "A group of autoimmune substances found in the neurons that may be comprised of (but not limited to) the Ri proteins Nova-1 and Nova-2. They can be considered as neuronal autoantigens and are commonly associated with autoimmune neurodegenerative disorders related to cancer, such as paraneoplastic neurologic syndrome." ;
    flat:parents "C201305" ;
    flat:semantic%20type "Amino Acid, Peptide, or Protein|Immunologic Factor" ;
    flat:synonyms "Neuronal Nuclear Type 2 Autoantigens|ANNA-2 Antigens|NEURONAL NUCLEAR TYPE 2 AUTOANTIGENS|Ri Antigens" ;
.

ncit:C201396
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C201396" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C201396>" ;
    flat:concept%20in%20subset "CDISC SDTM Binding Agent for Immunogenicity Tests Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
