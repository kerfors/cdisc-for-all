    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127304>" ;
    flat:definition "A genus of endomycete-like fungi in the phylum Ascomycota. Species in this genus may or may not be mycoparasitic." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Trichomonascus" ;
.

