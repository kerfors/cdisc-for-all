ncit:C119307
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119307" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119307>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-negative, non-fermentative, non-hemolytic, and non-halophilic, non-spore forming rod-shaped bacteria, in the phylum Proteobacteria. This species is catalase- and oxidase-positive, urease-, phenylalanine-, deaminase-, and DNase-negative, reduces nitrate to nitrite, assimilates glucose, and does not hydrolyze esculin, gelatin and starch. A. ruhlandii is commonly found in soil." ;
    flat:parents "C86079" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Achromobacter ruhlandii|ACHROMOBACTER RUHLANDII|Alcaligenes ruhlandii|Hydrogenomonas ruhlandii|Pseudomonas ruhlandii" ;
.

ncit:C119308
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119308" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119308>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-negative, strictly aerobic, oxidase-negative, non-fermentative, non-motile coccobacilli, in the phylum Proteobacteria. This species is glucose-non-acidifying, non-proteolytic, and is unable to oxidize D-glucose, to hydrolyze gelatin and to utilize DL-lactate, DL-4-aminobutyrate, citrate, azelate, beta-alanine and L-histidine. A. parvus is an opportunistic pathogen associated with nosocomial infections and may cause bacteremia or septicemia in humans." ;
    flat:parents "C76200" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Acinetobacter parvus|ACINETOBACTER PARVUS|Acinetobacter sp. phenon 4" ;
.

ncit:C119309
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119309" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119309>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-negative, strictly aerobic, oxidase-negative, non-fermentative, non-motile coccobacilli, in the phylum Proteobacteria. This species is glucose-non-acidifying, non-proteolytic, and is unable to hydrolyze gelatin. DL-lactate, citrate, azelate, D-malate, ethanol and acetate are utilized. A. ursingii is an opportunistic pathogen associated with nosocomial infections and may cause bacteremia or septicemia in humans." ;
    flat:parents "C76200" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Acinetobacter ursingii|ACINETOBACTER URSINGII|Acinetobacter sp. phenon 1" ;
.

ncit:C119310
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119310" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119310>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of white colored acremonioid fungus in the phylum Ascomycota. A. atrogriseum forms fusoid conidia in long chains." ;
    flat:parents "C118935" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Acremonium atrogriseum|ACREMONIUM ATROGRISEUM|Gliomastix atrogriseum|Phaeoscopulariopsis atrogrisea|Phialemonium atrogriseum" ;
.

ncit:C119311
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119311" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119311>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-positive, catalase-negative, nonmotile, non-spore forming, non-acid fast, nonhemolytic, straight to curved rod-shaped bacteria, in the phylum Actinobacteria. This species ferments glucose and produces acetate, succinate and acid; hydrolyzes hippurate, but does not reduce nitrate to nitrite; and does not hydrolyze esculin, gelatin or urea. A. schaalii is a part of the commensal flora of the human genitourinary tract and may cause urinary tract infections, urosepsis, bacteremia, cellulitis, spondylodiscitis, and endocarditis in humans." ;
    flat:parents "C118939" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinobaculum schaalii|ACTINOBACULUM SCHAALII|Actinotignum schaalii" ;
.

ncit:C119312
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119312" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119312>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultative anaerobic, Gram-positive, fermentative, catalase-negative, nonmotile, non-spore forming, irregular rod-shaped bacteria arranged in clusters, in the phylum Actinobacteria. This species ferments glucose, maltose, galactose and D-fructose to produce succinic acid, does not hydrolyze urea, and nitrate is not reduced to nitrite. A. europaeus is a human pathogen and may cause infections of the urinary track, of skin and of soft tissue. It has been linked to the development of breast abscesses." ;
    flat:parents "C76201" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinomyces europaeus|ACTINOMYCES EUROPAEUS" ;
.

ncit:C119313
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119313" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119313>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic rod-shaped or coccoid coryneform group 1 bacteria belonging to the genus Actinomyces that reduces nitrate, ferments carbohydrates, and is commonly found as a human pathogen in tissue, bone and blood stream infections." ;
    flat:parents "C76201" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinomyces neuii Subspecies neuii|ACTINOMYCES NEUII SUBSP. NEUII|Actinomyces neuii subsp. neuii|CDC coryneform group 1" ;
.

ncit:C119314
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119314" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119314>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of gram-positive, catalase-negative, vancomycin-susceptible coccoid bacteria belonging to the genus Aerococcus that is commonly found as a human pathogen, particularly in urinary tract infections, sepsis, and endocarditis." ;
    flat:parents "C86121" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Aerococcus sanguinicola|AEROCOCCUS SANGUINICOLA" ;
.

ncit:C119315
