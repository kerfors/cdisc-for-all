    flat:semantic%20type "Animal" ;
    flat:synonyms "Fasciola" ;
.

ncit:C122022
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122022" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122022>" ;
