    flat:synonyms "Amygdala|AMYGDALA|Amygdaloid Body|Amygdaloid Body|Amygdaloid Nucleus|Amygdaloid Nucleus|BRAIN, AMYGDALOID BODY|BRAIN, AMYGDALOID BODY" ;
.

