ncit:C178019
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C178019" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C178019>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An alphacoronavirus, first isolated in 1966, that is believed to have originated from African hipposiderid bats and utilizes aminopeptidase N as its major receptor. It is associated with respiratory infections in humans, particularly the common cold, and may have neuroinvasive properties." ;
    flat:parents "C119319" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Human Coronavirus 229E|Coronavirus 229E|HCoV-229E|HUMAN CORONAVIRUS 229E" ;
.

ncit:C178020
