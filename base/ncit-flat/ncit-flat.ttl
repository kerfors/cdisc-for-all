ncit:C13233
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C13233" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13233>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|CDISC SEND Non-Neoplastic Finding Type Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Material, such as purulent and nonpurulent fluid, cells, or cellular debris, which has escaped from blood vessels and has been deposited in tissues or on tissue surfaces, usually as a result of inflammation.  An exudate, in contrast to a transudate, is characterized by a relatively high protein content." ;
    flat:parents "C70699" ;
    flat:semantic%20type "Body Substance" ;
    flat:synonyms "Exudate|EXUDATE" ;
.

ncit:C13234
