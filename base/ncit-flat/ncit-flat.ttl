    flat:synonyms "Aberrantly Conducted Complexes by ECG Finding|ABERRANTLY CONDUCTED COMPLEXES|Aberrantly Conducted Beats" ;
.

ncit:C116133
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116133" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116133>" ;
