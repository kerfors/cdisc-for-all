    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C172592>" ;
    flat:concept%20in%20subset "CDISC SDTM Procedure Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A minimally invasive procedure in which a catheter is inserted into the femoral artery or vein in order to temporarily connect a mechanical circulatory support device that is worn outside the body to the circulatory system." ;
    flat:parents "C80452" ;
    flat:semantic%20type "Therapeutic or Preventive Procedure" ;
    flat:synonyms "Percutaneous Ventricular Assist Device Placement|PERCUTANEOUS VENTRICULAR ASSIST DEVICE PLACEMENT|PVAD Insertion|PVAD Placement" ;
.

