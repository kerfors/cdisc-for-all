    flat:code "C112242" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112242>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of non-enveloped, spherical viruses with a capsid with T=3 icosahedral symmetry in the Picornaviridae family and Enterovirus genus. The genome is composed of single-stranded, positive-sense RNA. Coxsackie A viruses are found in humans and cause hand, foot, and mouth disease, acute hemorrhagic conjunctivitis and herpangina via fecal-oral contamination." ;
    flat:parents "C14203" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Coxsackie A Virus|COXSACKIE A VIRUS|Coxsackie Virus A|Coxsackievirus A|Enterovirus A|Enterovirus EV-A|Human Coxsackievirus A|Human Enterovirus A" ;
.

ncit:C112243
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
