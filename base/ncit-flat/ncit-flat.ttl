    flat:definition "The maximum observed concentration divided by dose." ;
    flat:parents "C70918" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Maximum Concentration Dose Normalized|CMAXD|Max Conc Norm by Dose|Max Conc Norm by Dose" ;
.

