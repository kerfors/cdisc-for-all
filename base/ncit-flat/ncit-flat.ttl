    flat:definition "A genus of facultatively aerobic, Gram-positive, bacilli assigned to the phylum Actinobacteria and the family Cellulomonadaceae." ;
    flat:parents "C85923" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Cellulomonas|CELLULOMONAS" ;
.

ncit:C86250
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86250" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86250>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively aerobic, Gram-positive, bacilli assigned to the phylum Actinobacteria. This species is motile, non-spore forming, catalase positive, reduces nitrate, and hydrolyzes esculin, gelatin, and urea. C. hominis is found in soil and is pathogenic in humans." ;
    flat:parents "C86249" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Cellulomonas hominis|CELLULOMONAS HOMINIS" ;
.

ncit:C86251
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86251" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86251>" ;
