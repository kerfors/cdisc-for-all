    flat:definition "A genus of aerobic, Gram-negative, rod shaped bacterium assigned to the phylum Proteobacteria and the family Bartonellaceae." ;
    flat:parents "C85904" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bartonella|BARTONELLA" ;
.

ncit:C86185
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86185" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86185>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, catalase, oxidase, urea, and indole negative and is hemolytic. B. elizabethae causes endocarditis." ;
    flat:parents "C86184" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bartonella elizabethae|BARTONELLA ELIZABETHAE|Rochalimaea elizabethae|Rochalimaea elizabethae" ;
.

ncit:C86186
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86186" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86186>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is non-motile, oxidase, catalase, indole, and urease negative and is nonhemolytic. B. henselae is the primary agent of cat scratch disease." ;
    flat:parents "C86184" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bartonella henselae|BARTONELLA HENSELAE|Rochalimaea henselae|Rochalimaea henselae" ;
.

ncit:C86187
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86187" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86187>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, oxidase positive, indole and urease negative, and nonhemolytic. B. quintana causes trench fever." ;
    flat:parents "C86184" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bartonella quintana|BARTONELLA QUINTANA|Rochalimaea quintana|Rochalimaea quintana" ;
.

