    flat:parents "C49652" ;
    flat:semantic%20type "Research Activity" ;
    flat:synonyms "Diagnosis Study|DIAGNOSIS|Diagnostic Study" ;
.

ncit:C49654
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C49654" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C49654>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Trial Indication Type Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A type of study protocol designed to evaluate intervention(s) aimed to cure a disease or condition." ;
    flat:parents "C49652" ;
    flat:semantic%20type "Research Activity" ;
    flat:synonyms "Cure Study|CURE" ;
.

ncit:C49655
