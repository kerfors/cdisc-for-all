ncit:C64469
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C64469" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C64469>" ;
    flat:concept%20in%20subset "CDISC SDTM Laboratory Test Code Terminology|CDISC SDTM Laboratory Test Name Terminology|CDISC SDTM Microbiology Test Code Terminology|CDISC SDTM Microbiology Test Name Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The quantitative determination of bacterial populations. The two most widely used methods for determining bacterial numbers are: 1) the standard, or viable, plate count method and 2) spectrophotometric (turbidimetric) analysis." ;
    flat:parents "C51953" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Bacterial Count|BACT|BACT|Bacteria|Bacteria|Bacteria" ;
.

ncit:C64470
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C64470" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C64470>" ;
    flat:concept%20in%20subset "CDISC SDTM Cell Phenotyping Test Code Terminology|CDISC SDTM Cell Phenotyping Test Name Terminology|CDISC SDTM Laboratory Test Code Terminology|CDISC SDTM Laboratory Test Name Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|CPTAC Acute Myeloid Leukemia Baseline Form|CPTAC Baseline Medical Forms Terminology|CPTAC Terminology|GDC Terminology|GDC Value Terminology" ;
    flat:definition "The total number of white blood cells that are basophils. It is calculated by multiplying the white blood cell count by the percent of basophils in the differential white blood cell count." ;
    flat:parents "C51948" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Absolute Basophil Count|BASO|BASO|Basophil|Basophils|Basophils|Basophils|Basophils|Total Basophil Count" ;
.

ncit:C64471
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C64471" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C64471>" ;
