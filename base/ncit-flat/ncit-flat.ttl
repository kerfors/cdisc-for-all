    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112423>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A non-SI unit of pressure equal to 1/760 of a standard atmosphere (a standard atmosphere being defined as equal to 101 325 pascals). One Torr is equal to 133.3223684 pascals." ;
    flat:parents "C67332" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Torr|{Torr}|{Torr}" ;
.

