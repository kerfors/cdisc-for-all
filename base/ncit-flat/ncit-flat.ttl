    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112243>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of non-enveloped, spherical viruses with a capsid with T=3 icosahedral symmetry in the Picornaviridae family and Enterovirus genus. The genome is composed of single-stranded, positive-sense RNA. Coxsackie B viruses are found in humans and cause aseptic meningitis, Bornholm disease, arrhythmias and heart failure via fecal-oral contamination." ;
    flat:parents "C14203" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Coxsackie B Virus|COXSACKIE B VIRUS|Coxsackie Virus B|Enterovirus B|Enterovirus EV-B|Human Enterovirus B" ;
.

