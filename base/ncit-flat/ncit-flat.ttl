ncit:C112026
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112026" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112026>" ;
    flat:concept%20in%20subset "CTRP Biomarker Terminology|CTRP Terminology" ;
    flat:definition "A family of double stranded RNA viruses that carry 10-12 unique segments, which encode one to three proteins each. The RNA is surrounded by a three-layered icosahedral protein capsid and the viral particles are not enveloped. Members of this family can be transmitted orofecally, or via infected ticks or mosquitoes." ;
    flat:display%20name "Reoviridae" ;
    flat:parents "C28518" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Reoviridae|Reovirus|Respiratory Enteric Orphan Virus" ;
.

ncit:C112027
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112027" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112027>" ;
    flat:definition "A family of bullet-shaped, negative-sense viruses capable of infect a broad range of hosts in both the animal and plant kingdoms." ;
    flat:parents "C14346" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Rhabdoviridae" ;
.

ncit:C112028
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112028" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112028>" ;
    flat:definition "A family of negative-sense, enveloped RNA viruses that infect arthropods or rodents, but that can be transmitted to humans." ;
    flat:parents "C14346" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Bunyaviridae" ;
.

ncit:C112029
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112029" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112029>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of non-enveloped viruses with a capsid with T=3 icosahedral symmetry, in the family Caliciviridae. The genome is composed of a linear, single-strand of positive sense RNA. Sapoviruses are found in humans and swine and cause gastroenteritis in humans." ;
    flat:parents "C14304" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Sapovirus|SAPOVIRUS" ;
.

ncit:C112030
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112030" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112030>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of enveloped, spherical, or pleomorphic viruses with T=4 icosahedral symmetry, in the family Togaviridae. The genome is composed of a linear, single-strand of positive sense RNA. Alphaviruses are spread by insect vector, able to infect vertebrates and invertebrates, and cause arthritis, encephalitis, rashes and fever in humans." ;
    flat:parents "C77197" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Alphavirus|ALPHAVIRUS|Arboviruses Group A" ;
.

ncit:C112031
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112031" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112031>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A family of filamentous viruses with helical capsids and glycoprotein projections on their surface. The virus may have a branched morphology of varying length. The genome is composed of a linear single-strand of negative sense RNA. Filoviridae infect primates, pigs and bats in nature and are a causative agent of viral hemorrhagic fevers in humans and primates." ;
    flat:parents "C14346" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Filoviridae|FILOVIRIDAE|Filovirus" ;
.

