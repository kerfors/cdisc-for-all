    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Inductively-Coupled Plasma Mass Spectrometry|ICP-MS|ICP-MS|ICPMS|Inductively Coupled Plasma Mass Spectrometry" ;
