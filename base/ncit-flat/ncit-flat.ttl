    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127301>" ;
    flat:definition "A genus of thermally dimorphic fungi in the phylum Ascomycota that is found growing as filamentous hyphae at lower temperatures and as a yeast at 37C. Species in this genus are characterized by brown, thick-walled conidia attached along the hyphae." ;
