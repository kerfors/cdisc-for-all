ncit:C112271
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112271" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112271>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of filamentous, enveloped viruses with glycoprotein surface spikes, in the family Filoviridae. The genome is composed of a linear single-strand of negative sense RNA. The primary product of gene transcription of the fourth gene is a small glycoprotein (sGP), while RNA editing allows expression of full length glycoprotein. The Ebolavirus natural reservoir is considered to be fruit bats of the Pteropodidae family and cause severe hemorrhagic fevers in humans." ;
    flat:parents "C112031" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Ebola Virus|EBOLA VIRUS|EBOV" ;
.

ncit:C112272
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112272" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112272>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of non-enveloped, spherical and icosahedral viruses in the Picornaviridae family and Enterovirus genus. The genome is composed of single-stranded, positive-sense RNA. Echoviruses are found in humans and cause aseptic meningitis, encephalitis, paralysis and myocarditis via direct fecal-oral contamination, respiration and oral secretions, or indirect routes." ;
    flat:parents "C14203" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Echovirus|ECHOVIRUS" ;
.

