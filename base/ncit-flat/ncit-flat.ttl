    flat:code "C123541" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123541>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An obligate symbiont, flagellate protozoan in the family Trichomonadidae. P. hominis is found in the intestinal tract of infected individuals, but is considered nonpathogenic." ;
    flat:parents "C77916" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Pentatrichomonas hominis|PENTATRICHOMONAS HOMINIS" ;
.

ncit:C123542
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123542" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123542>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of fungi in the family Amphisphaeriaceae with 4-6 celled conidia and 2 or 3 apical appendages. Species within the genus are known as plant pathogens." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Pestalotiopsis|PESTALOTIOPSIS" ;
.

ncit:C123543
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123543" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123543>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of fungi in the family Herpotrichiellaceae with short conidiophores and unicellular conidia. Most species within the genus are saprophytes commonly found in soil or on decaying wood. P. richardsiae is a rare causative agent for subcutaneous phaeohyphomycosis and P. verrucosa can cause chromoblastomycosis." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Phialophora|PHIALOPHORA" ;
.

