.

ncit:C123565
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123565" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123565>" ;
    flat:concept%20in%20subset "CDISC SDTM Respiratory Test Code Terminology|CDISC SDTM Respiratory Test Name Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A calculated ratio of the forced expiratory volume in one second to the largest observed expired volume during the first six seconds of a forced vital capacity (FVC) maneuver." ;
