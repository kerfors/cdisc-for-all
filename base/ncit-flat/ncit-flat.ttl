    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C124394>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of anamorphic fungi in the family Microascaceae. Species in the genus are commonly found in soil and decaying wood, but some cause opportunistic infections in immunocompromised individuals." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Scopulariopsis|SCOPULARIOPSIS" ;
.

