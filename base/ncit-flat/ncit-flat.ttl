    flat:semantic%20type "Functional Concept" ;
    flat:synonyms "Percutaneous Route of Administration|PERCUT|PERCUT|PERCUTANEOUS|PERCUTANEOUS|PERCUTANEOUS|Percutaneous|Percutaneous|percutaneous" ;
.

