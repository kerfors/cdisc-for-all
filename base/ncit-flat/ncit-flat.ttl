    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A muscle in the posterior forearm that originates from the posterior surface of the middle third of the ulna and the adjacent interosseous membrane and attaches to the posterior surface of the base of distal phalanx of the thumb; it functions to extend the thumb at the metacarpophalangeal and interphalangeal joints and extend and abduct the wrist joint." ;
    flat:parents "C13056" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Extensor Pollicis Longus Muscle|EXTENSOR POLLICIS LONGUS MUSCLE" ;
.

ncit:C186116
