    flat:semantic%20type "Idea or Concept" ;
    flat:synonyms "Skin Response Domain|SR|Skin Response" ;
.

ncit:C112422
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112422" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112422>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of enveloped, spherical and icosahedral viruses in the Flaviviridae family and Flavivirus genus. The genome is composed of non-segmented, single-stranded, positive-sense RNA. Tick-borne encephalitis viruses are found in ticks of the Ixodes species and humans and cause tick-borne encephalitis in humans. Tick-borne encephalitis viruses are transmitted via the bite of infected ticks, primarily Ixodes ricinus or Ixodes persulcatus." ;
    flat:parents "C14208" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Tick-Borne Encephalitis Virus|FSME virus|TBEV|TICK-BORNE ENCEPHALITIS VIRUS" ;
.

