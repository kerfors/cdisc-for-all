.

ncit:C13024
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C13024" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13024>" ;
    flat:definition "Any component of the organ behind the lower part of the stomach that is fish-shaped and is a compound gland composed of both exocrine and endocrine tissues that make and secrete insulin and enzymes that help the body digest food." ;
    flat:display%20name "Pancreas Part" ;
    flat:parents "C25763" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Pancreas Part" ;
.

