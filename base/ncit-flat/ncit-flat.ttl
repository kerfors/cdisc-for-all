    flat:parents "C86957" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Sphingobacterium thalpophilum|Flavobacterium thalpophilum|Flavobacterium thalpophilum|SPHINGOBACTERIUM THALPOPHILUM" ;
