    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C161418>" ;
    flat:concept%20in%20subset "CDISC MRCT Center Clinical Research Glossary|CDISC SDTM Protocol Milestone Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
