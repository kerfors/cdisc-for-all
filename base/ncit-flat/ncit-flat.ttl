    flat:definition "A unipolar electrocardiogram lead site; the electrode is placed at the fourth intercostal space on the anterior chest wall (between ribs 4 and 5) to the right of the sternal border. In small animals, it is placed at the right fifth intercostal space near the sternum." ;
    flat:parents "C87881" ;
    flat:semantic%20type "Spatial Concept" ;
    flat:synonyms "Lead Site V1|LEAD V1|Lead C1" ;
.

ncit:C90413
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C90413" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C90413>" ;
