    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86087" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86087>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This bacteria is motile by a single polar flagellum, oxidase and catalase positive, chemoorganotrophic, gelatinase positive and can grow on L tryptophan culture. A. facilis was originally isolated from soil and is used as a soil inoculant in horticulture and agriculture." ;
    flat:parents "C86085" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Acidovorax facilis|ACIDOVORAX FACILIS" ;
.

ncit:C86088
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86088" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86088>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This bacteria is motile by a single polar flagellum, oxidase positive, chemoorganotrophic, resistant to penicillin and can reduce nitrites. A. temperans is commonly found in soil." ;
    flat:parents "C86085" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Acidovorax temperans|ACIDOVORAX TEMPERANS" ;
.

ncit:C86089
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86089" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86089>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This bacteria is nonmotile, oxidase negative, catalase positive and produces acid from glucose. A. anitratus is thought to be a commensal organism of the skin but may become pathogenic in patients with underlying conditions." ;
    flat:parents "C76200" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Acinetobacter anitratus|ACINETOBACTER ANITRATUS|Acinetobacter calcoaceticus subsp. anitratus|Acinetobacter calcoaceticus subsp. anitratus" ;
.

ncit:C86090
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86090" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86090>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod and cocci shaped bacteria assigned to the phylum Proteobacteria. This bacteria is nonmotile and oxidase negative. A. calcoaceticus is thought to be a commensal organism of the skin and throat but may become pathogenic in patients with underlying conditions, usually causing respiratory infection." ;
    flat:parents "C76200" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Acinetobacter calcoaceticus|ACINETOBACTER CALCOACETICUS" ;
.

ncit:C86091
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86091" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86091>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A non taxonomic grouping of bacteria assigned to the Acinetobacter genus that include the A. calcoaceticus and A. baumannii species." ;
    flat:parents "C76200" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Acinetobacter calcoaceticus/baumannii Complex|ACINETOBACTER CALCOACETICUS-BAUMANNII COMPLEX|Abc Complex|Acb Complex|Acinetobacter baumannii-calcoaceticus Complex" ;
.

ncit:C86092
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86092" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86092>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod and cocci shaped bacteria assigned to the phylum Proteobacteria. This bacteria is nonmotile, oxidase negative, catalase positive, gelatinase negative and can carry out glucose, galactose, mannose and xylose oxidation. A. haemolyticus is rarely pathogenic in humans." ;
    flat:parents "C76200" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Acinetobacter haemolyticus|ACINETOBACTER HAEMOLYTICUS" ;
.

ncit:C86093
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86093" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86093>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This bacteria is nonmotile, oxidase negative, nonhemolytic and does not reduce nitrates. A. johnsonii is a commensal organism on human skin and oropharynx but may be a cause of nosocomial infections." ;
    flat:parents "C76200" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Acinetobacter johnsonii|ACINETOBACTER JOHNSONII" ;
.

ncit:C86094
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86094" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86094>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod and cocci shaped bacteria assigned to the phylum Proteobacteria. This bacteria is oxidase negative, catalase positive, does not reduce nitrates, nonhemolytic and is beta xyloxidase negative. A. junii is found in human clinical samples." ;
    flat:parents "C76200" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Acinetobacter junii|ACINETOBACTER JUNII" ;
.

ncit:C86095
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86095" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86095>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod and cocci shaped bacteria assigned to the phylum Proteobacteria. This bacteria is nonmotile, oxidase negative, catalase positive and does not produce acid from galactose, mannose, rhamnose or lactose. This bacteria is found in the normal flora of humans and can cause infections, such as meningitis, septicemia, and pneumonia." ;
    flat:parents "C76200" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Acinetobacter lwoffii|ACINETOBACTER LWOFFII|Acinetobacter calcoaceticus subsp. lwoffii|Acinetobacter calcoaceticus subsp. lwoffii" ;
.

ncit:C86096
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86096" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86096>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This bacteria is nonmotile, non spore forming, catalase positive, oxidase and urease negative, highly resistant to gamma ray irradiation and hydrolyzes Tween 80. A. radioresistens is commonly found in soil and cotton." ;
    flat:parents "C76200" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Acinetobacter radioresistens|ACINETOBACTER RADIORESISTENS" ;
.

ncit:C86097
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86097" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86097>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria and the family Pasteurellaceae." ;
    flat:parents "C85951" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinobacillus|ACTINOBACILLUS" ;
.

ncit:C86098
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86098" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86098>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria. This bacteria is nonmotile, secretes leukotoxin, is catalase positive and ferments mannitol and xylose. A. actinomycetemcomitans is typically found as part of the oral flora and is a common cause of periodontitis." ;
    flat:parents "C86097" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinobacillus actinomycetemcomitans|ACTINOBACILLUS ACTINOMYCETEMCOMITANS|Aggregatibacter actinomycetemcomitans|CDC Group HB-3" ;
.

ncit:C86099
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86099" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86099>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This bacteria is nonmotile, oxidase and urease positive, weakly catalase positive, does not hydrolyze esculin and produces acid from glucose, lactose and xylose. A. equuli is a commensal organism of the horse upper respiratory tract but may cause disease in foals and zoonotic infections in humans." ;
    flat:parents "C86097" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinobacillus equuli|ACTINOBACILLUS EQUULI" ;
.

ncit:C86100
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86100" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86100>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This bacteria is nonmotile, catalase and oxidase positive, ferments sugars and is non hemolytic. A. lignieresii is part of the normal flora of the mucosa of the upper gastrointestinal tract and may cause tumorous abscesses in the tongue of cattle, sheep, horses, pigs and dogs." ;
    flat:parents "C86097" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinobacillus lignieresii|ACTINOBACILLUS LIGNIERESII" ;
.

ncit:C86101
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86101" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86101>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This bacteria is nonmotile, beta hemolytic and urease and porphyrin positive. Some serotypes of A. pleuropneumoniae cause respiratory disease in pigs." ;
    flat:parents "C86097" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinobacillus pleuropneumoniae|ACTINOBACILLUS PLEUROPNEUMONIAE|Haemophilus pleuropneumoniae|Haemophilus pleuropneumoniae" ;
.

ncit:C86102
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86102" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86102>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram negative rod shaped bacteria assigned to the phylum Proteobacteria. This bacteria is nonmotile, catalase positive, nonencapsulated, and is nicotinamide adenine dinucleotide dependent. A. suis is a commensal organism of the oral cavity and reproductive tract of pigs but may cause abortion, hemorrhage and embolic lesions in immunocompromised pigs." ;
    flat:parents "C86097" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinobacillus suis|ACTINOBACILLUS SUIS" ;
.

ncit:C86103
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86103" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86103>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This bacteria is oxidase and catalase positive, reduces nitrate, hydrolyzes urea and is indole negative. A. ureae is found rarely as a commensal organism of the human respiratory tract and may cause respiratory tract infections in humans." ;
    flat:parents "C86097" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinobacillus ureae|ACTINOBACILLUS UREAE|Pasteurella ureae|Pasteurella ureae" ;
.

ncit:C86104
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86104" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86104>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria and the family Thermomonosporaceae." ;
    flat:parents "C85910" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinomadura|ACTINOMADURA" ;
.

ncit:C86105
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86105" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86105>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive bacteria assigned to the phylum Actinobacteria. This bacteria hydrolyzes esculin, is sensitive to bacitracin, reduces nitrates and utilizes succinate. A. madurae is commonly found in soil and may cause actinomycotic mycetoma infection in immunocompromised individuals." ;
    flat:parents "C86104" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinomadura madurae|ACTINOMADURA MADURAE" ;
.

ncit:C86106
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86106" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86106>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive bacteria assigned to the phylum Actinobacteria. This bacteria does not hydrolyze esculin, reduces nitrates, does not utilize succinate and is sensitive to lysozyme. A. pelletieri is known to cause actinomycotic mycetoma." ;
    flat:parents "C86104" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinomadura pelletieri|ACTINOMADURA PELLETIERI" ;
.

ncit:C86107
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86107" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86107>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Actinobacteria. A. bovis is an opportunistic pathogen in the oral and nasopharyngeal mucous membranes and is the causative agent of actinomycosis in cattle." ;
    flat:parents "C76201" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinomyces bovis|ACTINOMYCES BOVIS|Actinocladothrix bovis|Actinocladothrix bovis|Cladothrix bovis|Cladothrix bovis|Discomyces bovis|Discomyces bovis|Nocardia bovis|Nocardia bovis|Oospora bovis|Oospora bovis|Proactinomyces bovis|Proactinomyces bovis|Sarcomyces bovis|Sarcomyces bovis|Sphaerotilus bovis|Sphaerotilus bovis|Streptothrix bovis|Streptothrix bovis" ;
.

ncit:C86108
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86108" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86108>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Actinobacteria. This bacteria hydrolyzes esculin, produces acid from xylose and is urease and catalase negative. A. israelii is found in the flora of the human oral and nasopharyngeal tract and in animals and is the most frequent cause of actinomycosis in humans." ;
    flat:parents "C76201" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinomyces israelii|ACTINOMYCES ISRAELII" ;
.

ncit:C86109
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86109" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86109>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Actinobacteria. This bacteria is catalase negative, not beta hemolytic and does not hydrolyze esculin. A. meyerii is a causative agent of actinomycosis." ;
    flat:parents "C76201" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinomyces meyerii|ACTINOMYCES MEYERII" ;
.

ncit:C86110
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86110" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86110>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Actinobacteria. This bacteria is urease positive, hydrolyzes esculin and does not produce acid from mannitol. A. naeslundii is a commensal organism of the oral cavity and colonizes tooth surfaces but may cause infection and periodontal disease in cases in which oral trauma occurs." ;
    flat:parents "C76201" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinomyces naeslundii|ACTINOMYCES NAESLUNDII" ;
.

ncit:C86111
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86111" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86111>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Actinobacteria. This bacteria is catalase positive, not beta hemolytic and sensitive to beta lactam antibiotics. A. neuii is rarely pathogenic in humans but may cause neonatal sepsis." ;
    flat:parents "C76201" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinomyces neuii|ACTINOMYCES NEUII" ;
.

ncit:C86112
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86112" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86112>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Actinobacteria. This bacteria reduces nitrates, is urease negative and does not produce acid from mannitol. A. odontolyticus is found in mucus membranes and is an opportunistic pathogen." ;
    flat:parents "C76201" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinomyces odontolyticus|ACTINOMYCES ODONTOLYTICUS" ;
.

ncit:C86113
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86113" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86113>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Actinobacteria. This bacteria is alpha hemolytic, catalase and indole negative, hydrolyzes esculin and does not reduce nitrate. A. radingae infection is often associated with breast, chest, and back abscesses." ;
    flat:parents "C76201" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinomyces radingae|ACTINOMYCES RADINGAE" ;
.

ncit:C86114
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86114" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86114>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram variable, rod shaped bacteria assigned to the phylum Actinobacteria. This bacteria is catalase negative, does not reduce nitrate and does not hydrolyze esculin, urea or gelatin. A. turicensis is most often related to genital, skin, and urinary tract infections." ;
    flat:parents "C76201" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinomyces turicensis|ACTINOMYCES TURICENSIS" ;
.

ncit:C86115
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86115" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86115>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Actinobacteria. This bacteria is catalase positive, non acid fast, urease and gelatinase negative, ferments lactose and hydrolyzes esculin. A. viscosus is a commensal organism of the human oral cavity." ;
    flat:parents "C76201" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Actinomyces viscosus|ACTINOMYCES VISCOSUS" ;
.

ncit:C86116
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86116" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86116>" ;
