    flat:code "C123516" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123516>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-positive coccus-shaped bacterium in the family Micrococcaceae. This strain of S. aureus retains its native sensitivity to methicillin and other beta-lactam antibiotics." ;
    flat:parents "C50921" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Methicillin Susceptible Staphylococcus Aureus|METHICILLIN SUSCEPTIBLE STAPHYLOCOCCUS AUREUS|MSSA|Methicillin-Susceptible Staphylococcus aureus" ;
.

