    flat:semantic%20type "Finding" ;
    flat:synonyms "Ventricular Flutter by ECG Finding|VENTRICULAR FLUTTER|VFl|Ventricular Flutter|Ventricular Flutter by EKG Finding|Ventricular flutter" ;
.

