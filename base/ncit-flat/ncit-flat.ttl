    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Ocular Comfort Index Questionnaire|OCI|OCI|OCI01" ;
.

ncit:C119096
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119096" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119096>" ;
    flat:concept%20in%20subset "CDISC QRS Terminology|CDISC Questionnaire Category Terminology|CDISC Questionnaire Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized rating scale originally developed by Lerner et al in 1998. This instrument is used to measure the degree to which health problems interfere with specific aspects of job performance and health-related productivity loss in employed individuals." ;
    flat:parents "C91105" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Work Limitations Questionnaire|WLQ|WLQ|WLQ01" ;
.

ncit:C119097
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119097" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119097>" ;
    flat:concept%20in%20subset "CDISC QRS Terminology|CDISC Questionnaire Category Terminology|CDISC Questionnaire Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized rating scale developed by the World Health Organization (WHO) to screen for excessive, hazardous or harmful alcohol consumption. The questionnaire contains 10 questions and evaluates the frequency and amount of alcohol use, alcohol-dependence symptoms and alcohol-related problems." ;
    flat:parents "C91105" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Alcohol Use Disorder Identification Test Self-Report Version Questionnaire|ADT01|AUDIT|AUDIT-SR" ;
.

ncit:C119098
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119098" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119098>" ;
    flat:concept%20in%20subset "CDISC QRS Terminology|CDISC Questionnaire Category Terminology|CDISC Questionnaire Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized rating scale developed by the World Health Organization (WHO), which is a modified version of the original Alcohol Use Disorder Identification Test (ADUIT). The questionnaire contains 3 questions, and is used to identify patients who are hazardous drinkers or have active alcohol use disorders." ;
    flat:parents "C91105" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Alcohol Use Disorder Identification Test Alcohol Consumption Questions Questionnaire|ADTC01|AUDIT-C|AUDIT-C" ;
.

ncit:C119099
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119099" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119099>" ;
    flat:concept%20in%20subset "CDISC QRS Terminology|CDISC Questionnaire Category Terminology|CDISC Questionnaire Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized rating scale originally developed by Thys van der Molen et al in 2003, which is a self-administered instrument used to measure clinical status of the airways and health-related quality of life in subjects with COPD. The 24 hour version questionnaire contains 10 questions which are divided into 3 areas or domains: symptoms, mental state and functional state." ;
    flat:parents "C91105" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Clinical COPD Questionnaire 24 Hour Version|CCQ 24 HOUR VERSION|CCQ 24 Hour Version|CCQ01" ;
.

ncit:C119100
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119100" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119100>" ;
    flat:concept%20in%20subset "CDISC QRS Terminology|CDISC Questionnaire Category Terminology|CDISC Questionnaire Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized rating scale originally developed by Thys van der Molen et al in 2003, which is a self-administered instrument used to measure clinical status of the airways and health-related quality of life in subjects with COPD. The 1 week version questionnaire contains 10 questions which are divided into 3 areas or domains: symptoms, mental state and functional state." ;
    flat:parents "C91105" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Clinical COPD Questionnaire 1 Week Version|CCQ 1 WEEK VERSION|CCQ 1 Week Version|CCQ02" ;
.

ncit:C119101
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119101" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119101>" ;
    flat:concept%20in%20subset "CDISC QRS Terminology|CDISC Questionnaire Category Terminology|CDISC Questionnaire Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized rating scale originally developed by Whiteneck et al in 1992 and modified in 2000, which is used to measure the degree to which impairments and disabilities result in handicaps in the years after initial rehabilitation. The paper version questionnaire contains 19 questions and generates 6 subscales: physical independence, cognitive independence, mobility, occupation, social integration and economic self-sufficiency." ;
    flat:parents "C91105" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Craig Handicap Assessment and Reporting Technique - Short Form Paper Version Questionnaire|CHART-SF PAPER VERSION|CHART-SF Paper Version|CHSF2" ;
.

ncit:C119102
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119102" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119102>" ;
    flat:concept%20in%20subset "CDISC QRS Terminology|CDISC Questionnaire Category Terminology|CDISC Questionnaire Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized rating scale originally developed by Finlay and Khan in 1994, which is a dermatology-specific health-related quality of life instrument. This questionnaire contains 10 questions concerning symptoms and feelings, daily activities, leisure, work, and school, personal relationships and treatment. Each question can be answered with: very much, a lot, a little or not at all." ;
    flat:parents "C91105" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Dermatology Life Quality Index Questionnaire|DLQI|DLQI|DLQI1" ;
.

ncit:C119103
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C119103" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C119103>" ;
    flat:concept%20in%20subset "CDISC QRS Terminology|CDISC Questionnaire Category Terminology|CDISC Questionnaire Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized rating scale originally developed by King et al in 1995, which is used to measure the severity of symptoms following a mild or moderate traumatic brain injury (TBI). The questionnaire requires a subject to rate the severity of 16 different cognitive, somatic, and emotional symptoms after a TBI on a scale of 0 to 4: not experienced at all (0), no more of a problem (1), a mild problem (2), a moderate problem (3), or a severe problem (4)." ;
    flat:parents "C91105" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Rivermead Post-Concussion Symptoms Questionnaire|RPQ|RPQ|RPQ01" ;
.

