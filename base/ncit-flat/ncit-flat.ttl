ncit:C111091
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C111091" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C111091>" ;
    flat:concept%20in%20subset "CDISC SDTM ECG Finding Terminology|CDISC SDTM Holter ECG Results Terminology|CDISC SDTM Terminology|CDISC SEND ECG Standard Character Result Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An electrocardiographic finding of complete failure of atrial electrical impulse conduction to the ventricles. This is manifested on the ECG by disassociation of atrial and ventricular rhythms. The atrial rate must be faster than the ventricular rate. (CDISC)" ;
    flat:parents "C26703" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "AV Block Third Degree by ECG Finding|3RD DEGREE AV BLOCK|3rd Degree Heart Block|AV Block Third Degree|AV Block Third Degree by EKG Finding|AV block, complete (third-degree)|Complete AV Block|Complete Heart Block|Complete Heart Block|Third Degree AV Block|Third Degree Atrioventricular Block" ;
.

ncit:C111092
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C111092" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C111092>" ;
    flat:concept%20in%20subset "ACC/AHA Cardiovascular and Noncardiovascular Complications of COVID-19 Terminology|ACC/AHA COVID-19 Appendix Authorized Values|Appendix 7: Diagnostic Procedures Terminology|CDISC SDTM ECG Finding Terminology|CDISC SDTM Holter ECG Results Terminology|CDISC SDTM Terminology|CDISC SEND ECG Standard Character Result Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An electrocardiographic finding of a supraventricular arrhythmia characterized by the replacement of consistent P waves by rapid oscillations or fibrillatory waves that vary in size, shape and timing and are accompanied by an irregularly irregular ventricular response. (CDISC)" ;
    flat:parents "C80503" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Atrial Fibrillation by ECG Finding|AF|AF|AFib|ATRIAL FIBRILLATION|Atrial Fibrillation|Atrial Fibrillation by EKG Finding|Atrial fibrillation" ;
.

ncit:C111094
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
