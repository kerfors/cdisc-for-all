ncit:C181324
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C181324" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C181324>" ;
    flat:concept%20in%20subset "CDISC SDTM Genomic Findings Analytical Method Calculation Formula Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A formula that normalizes transcript fragment counts based on the total number of transcript fragments that are sequenced. CPM equals the number of reads divided by the number of sequenced transcript fragments, and multiplied by 1,000,000." ;
    flat:parents "C19044" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Transcript Fragment Count per Million Formula|COUNTS PER MILLION FORMULA|CPM|CPM Formula" ;
.

ncit:C181325
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C181325" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C181325>" ;
    flat:concept%20in%20subset "CDISC SDTM Genomic Findings Analytical Method Calculation Formula Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A formula that calculates the number of fragments per million fragments sampled (calculated by dividing the fragment counts by a per million scaling factor, which is derived by taking the total fragments in the sample and dividing by 1,000,000) divided by the length of the gene, in kilobases. Fragments are represented by either paired or single end reads." ;
    flat:parents "C19044" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Fragments Per Kilobase Million Formula|FPKM|FPKM Formula|FRAGMENTS PER KILOBASE MILLION FORMULA" ;
.

ncit:C181326
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C181326" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C181326>" ;
    flat:concept%20in%20subset "CDISC SDTM Genomic Findings Analytical Method Calculation Formula Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A formula that calculates the number of reads per million fragments sampled (calculated by dividing the fragment counts by a per million scaling factor, which is derived by taking the total fragments in the sample and dividing by 1,000,000) divided by the length of the gene, in kilobases. Fragments are represented by single end reads." ;
    flat:parents "C19044" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Reads Per Kilobase Million Formula|READS PER KILOBASE MILLION FORMULA|RPKM|RPKM Formula" ;
.

ncit:C181327
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C181327" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C181327>" ;
    flat:concept%20in%20subset "CDISC SDTM Genomic Findings Analytical Method Calculation Formula Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A formula that identifies the transcripts per kilobase (RPK, derived by dividing the read counts by the length of each gene, in kilobases) divided by a per million scaling factor (which is the count of RPK values in a sample divided by 1,000,000)." ;
    flat:parents "C19044" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Transcripts Per Million Formula|TPM|TPM Formula|TRANSCRIPTS PER MILLION FORMULA" ;
.

