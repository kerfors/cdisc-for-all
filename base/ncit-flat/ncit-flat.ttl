    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C186127>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A paired facial muscle that originates from the incisive fossa of the mandible and extends upward to attach to the skin of the lower lip; it functions to elevate and protrude the lower lip and elevate and wrinkle the skin of the chin." ;
    flat:parents "C32716" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Mentalis Muscle|MENTALIS MUSCLE" ;
.

