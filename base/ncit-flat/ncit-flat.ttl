    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122047>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of obligate intracellular parasites in the family Eimeriidae. Cyclospora are transmitted through contaminated food or water. Infection causes diarrhea, nausea, and vomiting." ;
    flat:parents "C192229" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Cyclospora|CYCLOSPORA" ;
.

