    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122048>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of commensal or parasitic Amoebozoans in the class Archamoebae. Almost all species form cysts; the number of nuclei in the cyst varies from 1 to 8 among species and is one of the characteristics used to tell species apart." ;
    flat:parents "C118932" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Entamoeba|ENTAMOEBA" ;
.

