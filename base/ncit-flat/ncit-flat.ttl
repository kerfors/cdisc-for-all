    flat:definition "The administration of a drug within the tubules of an organ." ;
    flat:parents "C38291" ;
    flat:semantic%20type "Functional Concept" ;
    flat:synonyms "Intratubular Route of Administration|I-TUBUL|I-TUBUL|INTRATUBULAR|INTRATUBULAR|INTRATUBULAR|Intratubular" ;
.

ncit:C38269
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C38269" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C38269>" ;
    flat:concept%20in%20subset "CDISC SDTM Route of Administration Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|EDQM Health Care Terminology|EDQM-HC Routes and Methods of Administration Terminology|FDA Structured Product Labeling Terminology|GDC Terminology|GDC Value Terminology|SPL Drug Route of Administration Terminology" ;
    flat:definition "The administration of a drug within or introduced directly into a tumor. Method allows to achieve high concentration of the agent in the tumor and delay drug release in systemic circulation." ;
    flat:parents "C38291" ;
    flat:semantic%20type "Functional Concept" ;
    flat:synonyms "Intratumoral Route of Administration|I-TUMOR|I-TUMOR|INTRATUMOR|INTRATUMOR|INTRATUMOR|Intratumor|Intratumor|Intratumor Route of Administration|Intratumoral|Intratumoral use" ;
.

ncit:C38270
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C38270" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C38270>" ;
    flat:concept%20in%20subset "CDISC SDTM Route of Administration Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Structured Product Labeling Terminology|SPL Drug Route of Administration Terminology" ;
    flat:definition "The administration of a drug directly into the tympanic cavity has high safety profile and allows delivering high concentrations of the agent to the inner ear end organ. Perfusion is performed under the surgical microscope by inserting the needle in the posterior-inferior aspect of the tympanic membrane." ;
    flat:parents "C38291" ;
    flat:semantic%20type "Functional Concept" ;
    flat:synonyms "Intratympanic Route of Administration|I-TYMPAN|I-TYMPAN|INTRATYMPANIC|INTRATYMPANIC|INTRATYMPANIC|Intratympanic" ;
.

