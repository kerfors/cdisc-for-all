    flat:semantic%20type "Finding" ;
    flat:synonyms "Left Ventricular Hypertrophy by ECG Finding|LEFT VENTRICULAR HYPERTROPHY|Left Ventricular Hypertrophy|Left Ventricular Hypertrophy by EKG Finding" ;
