    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123510>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic trypanosomatid protozoa in the family Trypanosomatidae. L. mexicana is endemic in South and Central America and causes the mildest form of leishmaniasis." ;
    flat:parents "C123421" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Leishmania mexicana|LEISHMANIA MEXICANA" ;
.

ncit:C123511
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123511" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123511>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic trypanosomatid protozoa in the family Trypanosomatidae. L. tropica infection results in a non-ulcerating disease." ;
    flat:parents "C123421" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Leishmania tropica|LEISHMANIA TROPICA|Leishmania tropica minor" ;
.

ncit:C123512
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123512" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123512>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic nematodes in the family Onchocercidae. The lifecycle of L. loa involves deer flies as the intermediate host and humans as the definitive host. Infestation causes loa loa filariasis (loiasis)." ;
    flat:parents "C123425" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Loa loa|Eye Worm|LOA LOA" ;
.

ncit:C123513
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123513" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123513>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-negative, rod-shaped, non-spore-forming anaerobic bacterium assigned to the phylum Firmicutes. M. hypermegale can ferment glycerol and inositol and possesses key enzymes of the pentose phosphate pathway. It is native to the intestines of poultry." ;
    flat:parents "C113447" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Megamonas hypermegale|Bacteroides hypermegas|MEGAMONAS HYPERMEGALE|Megamonas hypermegas|Sphaerophorus hypermegas" ;
.

ncit:C123514
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123514" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123514>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic flatworms in the family Heterophyidae. The lifecycle of M. yokogawai involves snails as the first intermediate host, freshwater fish as the second intermediate host, and humans, fish-eating carnivores, or birds as the definitive host. Infestation causes metagonimiasis." ;
    flat:parents "C123338" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Metagonimus yokogawai|Japanese Fluke|METAGONIMUS YOKOGAWAI" ;
.

ncit:C123515
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123515" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123515>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-positive coccus-shaped bacterium in the family Micrococcaceae. This strain of S. aureus is resistant to methicillin and other beta-lactam antibiotics through the expression of penicillin-binding proteins acquired from other species." ;
    flat:parents "C50921" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Methicillin Resistant Staphylococcus Aureus|AB MRSA|MRSA|Methicillin-Resistant Staphylococcus aureus|Methicillin-resistant Staphylococcus aureus|STAPHYLOCOCCUS AUREUS, METHICILLIN-RESISTANT" ;
.

ncit:C123516
