.

ncit:C23010
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C23010" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C23010>" ;
    flat:concept%20in%20subset "CDISC SDTM Biospecimen Events Dictionary Derived Term Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|CTRP Intervention Terminology|CTRP Terminology|GDC Property Terminology|GDC Terminology" ;
    flat:definition "Any of the various methods that use a dye, reagent, or other material for producing coloration in tissues or microorganisms for microscopic examination." ;
    flat:display%20name "Staining Method" ;
    flat:parents "C16680" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Staining Method|STAINING|Stain|Staining|stain type|stain_type" ;
.

ncit:C23011
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C23011" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C23011>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|GDC Terminology|GDC Value Terminology" ;
    flat:definition "Hematoxylin-and-eosin, or H&E, is a routine staining procedure of tissue sections. This staining method uses two separate dyes, one staining the nucleus and the other staining the cytoplasm and connective tissue. Hematoxylin is a dark purplish dye that stains the chromatin (nuclear material) within the nucleus. Eosin is an orangish-pink to red dye that stains the cytoplasmic material including connective tissue and collagen." ;
    flat:display%20name "Hematoxylin and Eosin Staining Method" ;
    flat:parents "C23043" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Hematoxylin and Eosin Staining Method|H and E|H and E Staining|H and E Staining Method|H&E|H&E Stain|H&E Staining|H&E Staining Method|HEMATOXYLIN AND EOSIN STAIN|Haemotoxylin and Eosin (H&E)|HandE|Hematoxylin and Eosin|Hematoxylin and Eosin Staining" ;
.

ncit:C23012
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C23012" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C23012>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A histological staining method that uses acid dyes and washes to selectively dye the structural elements in tissue samples in three or more contrasting colors." ;
    flat:display%20name "Trichrome Staining Method" ;
    flat:parents "C23044" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Trichrome Staining Method|TRICHROME STAIN" ;
.

ncit:C23014
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C23014" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C23014>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "This is a method (named after the Danish bacteriologist, Hans Christian Gram) for staining and identifying bacteria. It is based on the differential retention of a crystal violet-iodine complex within the cell membrane. Gram-positive organisms will appear blue-black or purple while Gram-negative organisms will appear red." ;
    flat:display%20name "Gram Staining Method" ;
    flat:parents "C23044" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Gram Staining Method|GRAM STAIN|Gram Staining" ;
.

ncit:C23015
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C23015" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C23015>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The use of acid-fast stain to examine a specimen for the presence of acid-fast microorganisms, specifically mycobacteria." ;
    flat:display%20name "Acid Fast Bacillae Staining Method" ;
    flat:parents "C23044" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Acid Fast Bacillae Staining Method|ACID FAST STAIN|AFB Staining|Acid Fast Bacillae Staining|Acid Fast Staining" ;
.

ncit:C23019
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C23019" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C23019>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|EWS Authorized Value Terminology|EWS Immunohistochemistry Table" ;
    flat:definition "This is an all-round useful stain for many things, including glycogen, mucin, mucoprotein, glycoprotein, as well as fungi. The reaction is based on the oxidation of glycol group to aldehydes by periodate. The schiff's reagent selectively stains the aldehydes to a rose pink color. PAS is useful for outlining tissue structures--basement membranes, capsules, blood vessels, etc." ;
    flat:display%20name "Periodic Acid Schiff Staining Method" ;
    flat:parents "C23044" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Periodic Acid Schiff Staining Method|PAS|PAS Staining Method|PERIODIC ACID SCHIFF STAIN|Periodic Acid-Schiff Staining" ;
.

ncit:C23020
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C23020" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C23020>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|CTRP Intervention Terminology|CTRP Terminology|GDC Terminology|GDC Value Terminology" ;
    flat:definition "Immunohistochemical staining techniques allow for the visualization of antigens via the sequential application of a specific antibody to the antigen (primary antibody), a secondary antibody to the primary antibody and an enzyme complex with a chromogenic substrate. The enzymatic activation of the chromogen results in a visible reaction product at the antigen site. The specimen may then be counterstained and coverslipped. Results are interpreted using a light microscope and aid in the differential diagnosis of pathophysiological processes, which may or may not be associated with a particular antigen." ;
    flat:display%20name "Immunohistochemistry Staining Method" ;
    flat:parents "C23044" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Immunohistochemistry Staining Method|Cell/Tissue, Immunohistochemistry|IHC|IHC|IHC|Immunohistochemistry|Immunohistochemistry|Immunohistochemistry (IHC)|immunohistochemistry" ;
.

ncit:C2304
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C2304" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C2304>" ;
    flat:concept%20in%20subset "CDISC SDTM Binding Agent for Immunogenicity Tests Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|CTRP Biomarker Terminology|CTRP Disease Terminology|CTRP Molecular Genetic Biomarker Terminology|CTRP Terminology" ;
    flat:definition "Thyroglobulin (2768 aa, ~305 kDa) is encoded by the human TG gene. This protein is involved in thyroid hormone synthesis." ;
    flat:display%20name "Thyroglobulin" ;
    flat:parents "C1746" ;
    flat:semantic%20type "Amino Acid, Peptide, or Protein|Hormone" ;
    flat:synonyms "Thyroglobulin|TG|THYROGLOBULIN|Tg|Thyroid Thyroglobulin|thyroglobulin" ;
.

ncit:C23041
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C23041" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C23041>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A microscopy staining method that combines the Wright and Giemsa staining protocols and utilizes Romanowsky stain variants containing eosin Y and thiazine dyes to enhance morphological detail in peripheral blood and bone marrow smears." ;
    flat:display%20name "Wright-Giemsa Staining Method" ;
    flat:parents "C23043" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Wright-Giemsa Staining Method|WRIGHT-GIEMSA STAIN|Wright-Giemsa|Wright-Giemsa Staining" ;
.

ncit:C23043
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C23043" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C23043>" ;
    flat:definition "\"Routine\" histology staining generally refers to staining performed using hematoxylin and eosin. Hematoxylin stains the nuclei in cells and other cationic elements purple. Eosin is an anionic dye and binds to cytoplasmic proteins below pH6 giving a pink color. (From Biogenex)" ;
    flat:display%20name "Routine Histology Staining Method" ;
    flat:parents "C23010" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Routine Histology Staining Method|Routine Histology Staining" ;
.

ncit:C23044
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C23044" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C23044>" ;
    flat:definition "Histological technique in which special stains are used to visualize specific tissue and cellular structures. These are dyes that bind to the cellular components either physically or by chemical bonds. (From Biogenex)." ;
    flat:display%20name "Special Histology Staining Method" ;
    flat:parents "C23010" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Special Histology Staining Method|Special Histology Staining" ;
.

ncit:C2317
