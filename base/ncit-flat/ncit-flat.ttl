    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C114867" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C114867>" ;
