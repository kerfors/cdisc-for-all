    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Coagulation Index Measurement|CI|COAGIDX|Coagulation Index|Coagulation Index" ;
.

ncit:C112240
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112240" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112240>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of non-enveloped, spherical viruses with an icosahedral symmetry of triple capsid structure in the Reoviridae family and Coltivirus genus. The genome is composed of segmented, double-stranded RNA. Colorado tick fever viruses are found in adult wood ticks, humans and mammals, and cause Colorado tick fever in humans. Colorado tick fever viruses are transmitted mainly via the bite of infected Rocky Mountain wood ticks (Dermacentor andersoni)." ;
    flat:parents "C112026" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Colorado Tick Fever Virus|COLORADO TICK FEVER VIRUS|CTFV" ;
.

