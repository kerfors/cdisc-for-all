    flat:parents "C15787" ;
    flat:semantic%20type "Health Care Activity" ;
    flat:synonyms "Stratification Factors|STRATFCT|Stratification Factor|Stratification Factor" ;
.

ncit:C161570
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C161570" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C161570>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SEND Biospecimens Terminology|CDISC SEND Microscopic Findings Result Modifier Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The portion of the reproductive tract that connects the fallopian tubes to the uterus. The prominence of the uterine horns are variable across species and may be the location at which embryo implantation occurs in some species." ;
    flat:parents "C13039" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Uterine Horn|UTERINE HORN" ;
.

ncit:C161601
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C161601" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C161601>" ;
