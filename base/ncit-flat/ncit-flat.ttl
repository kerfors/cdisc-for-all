    flat:code "C123548" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123548>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A protozoan parasite in the family Plasmodiidae. P. malariae causes quartan malaria, a milder form of malaria than that caused by P. falciparum or P. vivax." ;
    flat:parents "C98268" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Plasmodium malariae|PLASMODIUM MALARIAE" ;
.

