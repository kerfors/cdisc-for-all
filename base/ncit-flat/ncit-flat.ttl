    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A bacterium that belongs to the Mutans group of the genus Streptococcus." ;
    flat:parents "C76383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus mutans Group|STREPTOCOCCUS MUTANS GROUP" ;
.

ncit:C86799
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86799" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86799>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Established Names and Unique Ingredient Identifier Codes Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, cocci shaped bacteria in the phylum Firmicutes. This species is alpha hemolytic, urease and catalase negative, sialidase and alpha glucosidase positive and does not hydrolyze esculin. It can ferment ribose, raffinose, and trehalose but not inulin, cellobiose, mannitol, or sorbitol. S. oralis is found in the human oral cavity and respiratory tract and can be a pathogen that causes dental caries, gum disease, and endocarditis following oral trauma." ;
    flat:parents "C76383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus oralis|STREPTOCOCCUS ORALIS|STREPTOCOCCUS ORALIS" ;
.

ncit:C86800
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86800" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86800>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, cocci shaped bacteria in the phylum Firmicutes. This species is alpha hemolytic, alpha glucosidase and arginine deaminase positive and negative for sialidase, urease, and catalase. It can ferment lactose, and raffinose but not mannitol, sorbitol, or inulin. S. parasanguinis is found in normal human oral and respiratory flora but is a pathogen that can cause endocarditis if it colonizes the blood." ;
    flat:parents "C76383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus parasanguinis|STREPTOCOCCUS PARASANGUINIS|Streptococcus parasanguis|Streptococcus parasanguis" ;
.

ncit:C86802
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86802" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86802>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, cocci shaped bacteria in the phylum Firmicutes. This species is positive for Lancefield groups E, P, U and V, esculin hydrolysis, pyrrolidonylarylamidase, arginine deamination, CAMP test, beta hemolysis, and growth in 6.5% NaCl and negative for catalase. It can ferment sorbitol, trehalose, maltose, mannitol, ribose, and sucrose but not melibiose, arabinose, inulin, raffinose, or sorbose. S. porcinus is a commensal organism in pigs and pathogenic in humans, causing genitourinary tract infections and complications during parturition." ;
    flat:parents "C76383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus porcinus|STREPTOCOCCUS PORCINUS" ;
.

ncit:C86803
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86803" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86803>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Established Names and Unique Ingredient Identifier Codes Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, cocci shaped bacteria in the phylum Firmicutes. This species is beta hemolytic, Lancefield group A, pyrrolidonylarylamidase, and arginine deaminase positive and catalase negative. It can ferment salicin, rhamnose, and trehalose but not sorbitol, or ribose. S. pyogenes is found on normal human skin but can act as a pathogen causing streptococcal pharyngitis, acute rheumatic fever, scarlet fever, skin infections, acute glomerulonephritis and necrotizing fasciitis." ;
    flat:parents "C76383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus pyogenes|Group A Beta-Hemolytic Streptococcus pyogenes|Group A Beta-hemolytic Streptococcus pyogenes|Micrococcus scarlatinae|STREPTOCOCCUS PYOGENES|STREPTOCOCCUS PYOGENES|Streptococcus erysipelatos|Streptococcus hemolyticus|Streptococcus scarlatinae" ;
.

ncit:C86804
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86804" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86804>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Established Names and Unique Ingredient Identifier Codes Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, cocci shaped bacteria in the phylum Firmicutes. This species is alpha hemolytic, hydrolyzes esculin and is negative for arginine deaminase, and catalase. It can ferment inulin, salicin, and raffinose but not mannitol, or sorbitol. S. salivarius is found in the normal flora of the mouth and respiratory tract and is rarely a human pathogen causing opportunistic infections." ;
    flat:parents "C86805" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptococcus salivarius|STREPTOCOCCUS SALIVARIUS|STREPTOCOCCUS SALIVARIUS" ;
.

ncit:C86805
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
