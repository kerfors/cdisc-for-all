    flat:code "C122041" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122041>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of free-living amoeba in the family Balamuthiidae. Its life cycle includes a cystic stage and a trophozoite stage, both of which are infectious." ;
    flat:parents "C118932" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Balamuthia|BALAMUTHIA" ;
.

ncit:C122042
