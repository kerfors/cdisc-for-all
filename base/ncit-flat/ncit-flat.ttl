    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Allele Specific Primer Polymerase Chain Reaction|PCR-SSP|SEQUENCE SPECIFIC PRIMER POLYMERASE CHAIN REACTION" ;
.

