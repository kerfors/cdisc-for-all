    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13282>" ;
    flat:definition "An anatomical element found within cells or tissues that are smaller than cells and are at or below the size that can be resolved by light microscopy." ;
