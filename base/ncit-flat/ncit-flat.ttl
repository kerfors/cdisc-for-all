    flat:parents "C77200" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Rhinovirus C|Human Rhinovirus C|RHINOVIRUS C" ;
.

ncit:C112410
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112410" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112410>" ;
