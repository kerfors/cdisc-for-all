    flat:code "C74571" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C74571>" ;
    flat:concept%20in%20subset "CDISC SDTM Skin Classification Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Skin which is darker white and it sometimes burns when exposed to the sun. This type of skin can be seen in people with any hair or eye color." ;
    flat:parents "C74563" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Fitzpatrick Skin Type III|Fitzpatrick Skin Phototype III|TYPE3|TYPEIII" ;
.

