    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C201394>" ;
    flat:concept%20in%20subset "CDISC SDTM Binding Agent for Immunogenicity Tests Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A group of autoimmune substances found in the neurons that may be comprised of (but not limited to) the Hu proteins HuD, HuC, HuR (HuA), and HuB (Hel-N1) and Hel-N2. They can be considered as neuronal autoantigens and are commonly associated with autoimmune neurodegenerative disorders related to cancer, such as paraneoplastic neurologic syndrome." ;
    flat:parents "C201305" ;
    flat:semantic%20type "Amino Acid, Peptide, or Protein|Immunologic Factor" ;
    flat:synonyms "Neuronal Nuclear Type 1 Autoantigens|ANNA-1 Antigens|Hu Antigens|NEURONAL NUCLEAR TYPE 1 AUTOANTIGENS" ;
.

