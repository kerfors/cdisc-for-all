    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C114179" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C114179>" ;
    flat:concept%20in%20subset "CDISC SDTM ECG Finding Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An electrocardiographic recording in which measurements (particularly of QRS amplitudes) and/or interpretations are not performed because QRS complexes have been truncated. (CDISC)" ;
    flat:parents "C114120" ;
    flat:semantic%20type "Qualitative Concept" ;
    flat:synonyms "Incomplete ECG Measurements Due to Truncation of QRS Complexes|INCOMPLETE MEASUREMENTS DUE TO TRUNCATION OF QRS COMPLEXES" ;
.

ncit:C114180
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C114180" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C114180>" ;
    flat:concept%20in%20subset "CDISC SDTM ECG Finding Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A printed electrocardiographic recording with poor printout quality (e.g. a faded paper ECG tracing or ECG with inconsistent printing speed) such that measurements and/or interpretation cannot be performed. (CDISC)" ;
    flat:parents "C114120" ;
    flat:semantic%20type "Qualitative Concept" ;
    flat:synonyms "ECG Evaluation Not Performed Due to Poor Quality of Printed ECG|ECG EVALUATION NOT PERFORMED DUE TO POOR QUALITY OF PRINTED ECG" ;
.

ncit:C114181
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C114181" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C114181>" ;
    flat:concept%20in%20subset "CDISC SDTM ECG Finding Terminology|CDISC SDTM Holter ECG Results Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A digital electrocardiographic recording which is corrupted (i.e. ECG signal cannot be restored) such that measurements and/or interpretation cannot be performed. (CDISC)" ;
    flat:parents "C114120" ;
    flat:semantic%20type "Qualitative Concept" ;
    flat:synonyms "ECG Evaluation Not Performed Due to Corrupted Digital ECG File|ECG EVALUATION NOT PERFORMED DUE TO CORRUPTED DIGITAL ECG FILE" ;
.

