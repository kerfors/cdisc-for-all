    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C39567>" ;
    flat:definition "Group of lymphocytes. A T-lymphocyte is a white blood cell differentiated in the thymus that possesses highly specific cell-surface antigen receptors. A natural killer cell resembles a T-lymphocyte, but it does not express markers of either T or B cell lineage. Its cytotoxic activity is not antibody dependent." ;
    flat:parents "C12535" ;
    flat:semantic%20type "Cell" ;
    flat:synonyms "T-Lymphocyte and Natural Killer Cell|T-Lymphocyte and NK-Cell" ;
.

