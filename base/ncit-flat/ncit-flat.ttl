ncit:C163504
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163504" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163504>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A muscle in the foot that flexes and abducts the fifth toe at the metatarsophalangeal joint and supports the lateral arch. It originates in the medial and lateral processes of the posterior calcaneal tuberosity and inserts into the lateral side of the base of the proximal phalanx of the fifth toe and the fifth metatarsal. It is innervated by the lateral planter nerve and is supplied by the lateral planter artery." ;
    flat:parents "C13056" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Abductor Digiti Minimi Muscle|ABDUCTOR DIGITI QUINTI MUSCLE|Abductor Digiti Minimi|Abductor Minimi Digiti" ;
.

ncit:C163505
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163505" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163505>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A muscle in the foot that abducts and flexes the great toe at metatarsophalangeal joint. It originates in the medial process of the posterior calcaneal tuberosity and the flexor retinaculum and inserts into the medial side of the base of the proximal phalanx of the great toe. It is innervated by the medial plantar nerve and is supplied by the medial plantar artery." ;
    flat:parents "C13056" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Abductor Hallucis Muscle|ABDUCTOR HALLUCIS MUSCLE" ;
.

ncit:C163506
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163506" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163506>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A muscle in the lower extremity that adducts, flexes, and helps to rotate the thigh. It originates on the external surface of body of pubis and the anterior surface of the inferior pubic ramus and inserts in the pectineal line and the medial lip of the linea aspera. It is innervated by the anterior or posterior division of the obturator nerve and is supplied by the obturator and medial circumflex femoral arteries." ;
    flat:parents "C13056" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Adductor Brevis Muscle|ADDUCTOR BREVIS MUSCLE" ;
.

ncit:C163507
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163507" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163507>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The larger of two heads of the adductor hallucis muscle. It originates from the sheath of the peroneus longus tendon and the plantar surface of the bases of the second to fourth metatarsal bones in the foot." ;
    flat:parents "C25769" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Oblique Head of Adductor Hallucis Muscle|ADDUCTOR HALLUCIS MUSCLE, OBLIQUE HEAD" ;
.

ncit:C163508
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163508" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163508>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The smaller of two heads of the adductor hallucis muscle. It originates from the deep transverse metatarsal ligament and the plantar surface of the metatarsophalangeal joints of the lateral three toes." ;
    flat:parents "C25769" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Transverse Head of Adductor Hallucis Muscle|ADDUCTOR HALLUCIS MUSCLE, TRANSVERSE HEAD" ;
.

ncit:C163509
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163509" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163509>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A muscle located in the medial compartment of the thigh that adducts and medially rotates the thigh. It originates on the external surface of the pubis body and inserts into the middle third of the linea aspera. It is innervated by the obturator nerve and branches of the sciatica nerve and supplied by the obturator and medial circumflex femoral arteries." ;
    flat:parents "C13056" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Adductor Longus Muscle|ADDUCTOR LONGUS MUSCLE" ;
.

ncit:C163510
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163510" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163510>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A muscle located in the medial compartment of the thigh that adducts, flexes, extends, and medially rotates the thigh at the hip joint. It originates on the ischiopubic ramus and ischial tuberosity, and inserts into the gluteal tuberosity of the femur, medial lip of the linea aspera, medial supracondylar ridge, and adductor tubercle. It is innervated by the obturator and tibial nerves and supplied by branches of the deep femoral and popliteal arteries, and the inferior gluteal and obturator arteries." ;
    flat:parents "C13056" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Adductor Magnus Muscle|ADDUCTOR MAGNUS MUSCLE" ;
.

ncit:C163511
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163511" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163511>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "One of two small facial muscles that are located behind the occipitofrontalis and orbicularis oculis muscles, with which they blend, and allow movement of the eyebrows. They originate in the medial superciliary arch and insert into the skin above the middle of the supraorbital margins. They are innervated by the temporal branch of the facial nerve and supplied by branches from the superficial temporal and ophthalmic arteries." ;
    flat:parents "C13073" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Corrugator Supercilii Muscle|CORRUGATOR SUPERCILII MUSCLE" ;
.

ncit:C163512
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163512" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163512>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Two muscles located in the upper extremity, the triceps brachii and anconeus, that allow for straightening of the arm at the elbow joint." ;
    flat:parents "C13056" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Elbow Extensors|ELBOW EXTENSOR MUSCLES" ;
.

ncit:C163513
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163513" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163513>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A group of three muscles located in the upper extremity, the brachialis, biceps brachii, and the brachioradialis, that allow for bending of the arm at the elbow joint." ;
    flat:parents "C13056" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Elbow Flexors|ELBOW FLEXOR MUSCLES" ;
.

ncit:C163514
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163514" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163514>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A muscle on the dorsal side of the foot that helps to extend the second, third and fourth toes. It originates on the superolateral surface of the anterior calcaneus and inserts into the lateral sides of the tendons of extensor digitorum longus on the second, third and fourth toes. It is innervated by the deep peroneal nerve and supplied by the dorsalis pedis artery." ;
    flat:parents "C13056" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Extensor Digitorum Brevis Muscle|EXTENSOR DIGITORUM BREVIS MUSCLE" ;
.

ncit:C163515
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163515" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163515>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A muscle on the dorsal side of the foot that helps to extend the big toe. It originates on the superior surface of the anterior calcaneus and inserts into the dorsal surface of the base of the proximal phalanx of the big toe. It is innervated by the deep fibular nerve and supplied by the dorsalis pedis artery." ;
    flat:parents "C13056" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Extensor Hallucis Brevis Muscle|EXTENSOR HALLUCIS BREVIS MUSCLE" ;
.

ncit:C163516
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163516" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163516>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A group of muscles that originate on the bones on the posterior side of the forearm and insert into the bones of the phalanges through long tendons. The finger extensors, including the abductor pollicis longus, extensor pollicis brevis, extensor pollicis longus, extensor indicis, extensor digitorum, and extensor digiti minimi muscles, allow for straightening of the fingers to open the hand." ;
    flat:parents "C13056" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Finger Extensors|FINGER EXTENSOR MUSCLES" ;
.

ncit:C163517
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163517" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163517>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A group of muscles that originate on the bones on the palmar side of the arm and forearm and insert into the bones of the phalanges of the hand through long tendons; the finger flexors, including the flexor digitorum superficialis, flexor digitorum profundus, and flexor pollicis longus muscles, allow for bending of the fingers." ;
    flat:parents "C13056" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Finger Flexors|FINGER FLEXOR MUSCLES" ;
.

ncit:C163518
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C163518" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C163518>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A muscle in the foot that allows flexion of the four lateral toes and supports the medial and lateral longitudinal arches. It originates on the medial process of the posterior calcaneal tuberosity and inserts as tendons into the borders of the middle phalanx of the four lateral toes. It is innervated by the medial plantar nerve and supplied by the medial and lateral plantar arteries." ;
    flat:parents "C13056" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Flexor Digitorum Brevis Muscle|FLEXOR DIGITORUM BREVIS MUSCLE" ;
.

