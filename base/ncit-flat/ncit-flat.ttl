    flat:definition "A genus of non motile, Gram positive, non sporeforming bacterium assigned to the phylum Actinobacteria and the family Intrasporangiaceae." ;
    flat:parents "C85941" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Knoellia|KNOELLIA" ;
.

ncit:C86467
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
