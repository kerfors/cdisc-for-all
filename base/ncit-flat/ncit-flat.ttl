ncit:C116129
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116129" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116129>" ;
    flat:concept%20in%20subset "CDISC SDTM ECG Finding Terminology|CDISC SDTM Holter ECG Results Terminology|CDISC SDTM Terminology|CDISC SEND ECG Standard Character Result Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An electrocardiographic finding of an escape beat following a pause that originates at the AV junction; this manifests as a QRS complex of supraventricular origin not immediately preceded by a P wave. (CDISC)" ;
    flat:parents "C41328" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Junctional Escape Complexes by ECG Finding|JUNCTIONAL ESCAPE COMPLEXES|Junctional Escape Beat|Junctional Escape Complex" ;
.

ncit:C116130
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116130" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116130>" ;
    flat:concept%20in%20subset "CDISC SDTM ECG Finding Terminology|CDISC SDTM Holter ECG Results Terminology|CDISC SDTM Terminology|CDISC SEND ECG Standard Character Result Terminology|CDISC SEND Terminology|CDRH Health Effects - Clinical Signs and Symptoms or Conditions Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An electrocardiographic finding showing no cardiac electrical activity on the monitor or printed strip for the entire duration of the recording. (CDISC)" ;
    flat:parents "C41328" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Asystole by ECG Finding|ASYSTOLE|Asystole" ;
.

ncit:C116131
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116131" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116131>" ;
