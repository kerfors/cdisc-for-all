ncit:C127708
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127708" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127708>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of filamentous fungi in the phylum Ascomycota with conidial heads and characterized by smooth ascospores. E. herbariorum is the source for aspergiolide A, an anthraquinone derivative." ;
    flat:parents "C127282" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Eurotium herbariorum|Aspergillus glaucus|Aspergillus herbariorum|EUROTIUM HERBARIORUM" ;
.

ncit:C127709
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127709" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127709>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anamorphic, thermophilic black yeast in the phylum Ascomycota that is commonly isolated from saunas, steam baths, and dish washers. E. dermatitidis is considered a human opportunistic pathogen." ;
    flat:parents "C127283" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Exophiala dermatitidis|EXOPHIALA DERMATITIDIS|Wangiella dermatitidis" ;
.

ncit:C127710
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127710" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127710>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of saprobic fungi in the phylum Ascomycota. E. jeanselmei is the causative agent of maduromycosis, an asymptomatic disease which presents with black or brown macular lesions." ;
    flat:parents "C127283" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Exophiala jeanselmei|EXOPHIALA JEANSELMEI|Phialophora jeanselmei|Pullularia jeanselmei|Torula jeanselmei" ;
.

ncit:C127711
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127711" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127711>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of filamentous fungi in the phylum Ascomycota. Infection with F. chlamydosporum is associated with superficial mycoses and keratitis in immunocompetent individuals and with invasive and disseminated infection in immunocompromised individuals." ;
    flat:parents "C77185" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Fusarium chlamydosporum|FUSARIUM CHLAMYDOSPORUM" ;
.

ncit:C127712
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127712" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127712>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A fungal plant pathogen in the phylum Ascomycota." ;
    flat:parents "C77185" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Fusarium incarnatum|FUSARIUM INCARNATUM|Fusarium pallidoroseum|Fusarium semitectum" ;
.

ncit:C127713
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127713" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127713>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of filamentous yeast-like fungi in the family Endomycetaceae normally found in plant tissues, silage and soil. It is also a component of the natural flora of the human mouth, skin and gastrointestinal tract." ;
    flat:parents "C122315" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Geotrichum klebahnii|GEOTRICHUM KLEBAHNII|Geotrichum penicillatum|Trichosporon penicillatum" ;
.

ncit:C127714
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127714" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127714>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of yeast-like fungi in the phylum Basidiomycota having cell walls containing xylose and lacking septal pores. It is characterized by an optimum growth temperature of 17 C, assimilation of nitrate, and an absence of growth with lactate." ;
    flat:parents "C127302" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Guehomyces pullulans|Basidiotrichosporon pullulans|GUEHOMYCES PULLULANS|Monilia pullulans|Oidium pullulans|Oospora pullulans|Tausonia pullulans|Trichosporon pullulans" ;
.

ncit:C127715
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127715" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127715>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-negative, pleomorphic, coccobacilli bacteria in the phylum Proteobacteria that is positive for nitrate reduction and for growth with glucose, fructose, maltose, and sucrose." ;
    flat:parents "C76324" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Haemophilus paraphrohaemolyticus|HAEMOPHILUS PARAPHROHAEMOLYTICUS" ;
.

ncit:C127716
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127716" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127716>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of fungi in the phylum Basidiomycota. This species is positive for assimilation of arabinose, sucrose, maltose, galactose, and others. It is generally non-fermenting." ;
    flat:parents "C127284" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Hannaella luteola|Chromotorula luteola|Cryptococcus luteolus|HANNAELLA LUTEOLA|Hannaella luteolus|Rhodotorula luteola|Torula luteola|Torulopsis luteola" ;
.

ncit:C127717
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127717" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127717>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of apiculate yeast in the phylum Ascomycota that are found on dates, grapes, tomatoes, figs, and in soil. This species is only able to ferment glucose." ;
    flat:parents "C127285" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Hanseniaspora guilliermondii|Acaromyces laviae|HANSENIASPORA GUILLIERMONDII|Hanseniaspora apuliensis|Hanseniaspora melligeri|Kloeckera apiculata|Kloeckera apis|Willia guilliermondii" ;
.

ncit:C127718
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127718" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127718>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of apiculate yeast in the phylum Ascomycota frequently found on mature fruits and particularly on grapes where it forms part of the grape and fermentation microbiome." ;
    flat:parents "C127285" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Hanseniaspora uvarum|HANSENIASPORA UVARUM|Hanseniaspora apiculata|Kloeckera apiculata|Kloeckeraspora uvarum" ;
.

ncit:C127719
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127719" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127719>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of apiculate yeast in the phylum Ascomycota with hat or bell-shaped spores." ;
    flat:parents "C127285" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Hanseniaspora valbyensis|HANSENIASPORA VALBYENSIS" ;
.

ncit:C127720
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127720" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127720>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-negative, motile, spirillum-shaped bacteria in the phylum Proteobacteria that is unable to grow in N2-free medium and lacks the nitrogen-fixing genes nifH and nifD. H. huttiense is oxidase- and catalase-positive, nitrate reduction negative, and able to hydrolyse urea." ;
    flat:parents "C127286" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Herbaspirillum huttiense|HERBASPIRILLUM HUTTIENSE|Pseudomonas huttiensis" ;
.

ncit:C127721
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127721" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127721>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of saprophytic fungi in the phylum Ascomycota with two-celled yeast-like cells producing annelloconidia. H. werneckii is the causative agent of tinea nigra in humans." ;
    flat:parents "C127287" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Hortaea werneckii|Exophiala werneckii|HORTAEA WERNECKII" ;
.

ncit:C127722
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127722" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127722>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-negative, catalase-positive, oxidase-negative bacteria in the in phylum Proteobacteria that is positive for assimilation of caprylate and the absence of assimilation of isobutyrate, isovalerate, or glutarate." ;
    flat:parents "C127288" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kerstersia gyiorum|KERSTERSIA GYIORUM" ;
.

ncit:C127723
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127723" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127723>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of apiculate yeast in the phylum Ascomycota with polar budding and evanescent asci containing 1 to 4 hat-shaped ascospores." ;
    flat:parents "C127285" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Kloeckera japonica|KLOECKERA JAPONICA" ;
.

ncit:C127724
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127724" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127724>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of yeasts in the family Saccharomycetaceae and phylum Ascomycota with the ability to utilize lactose and convert it into lactic acid. The species is heterothallic, with a predominantly haploid life cycle. K. lactis has emerged as an important yeast species for research and industrial biotechnology." ;
    flat:parents "C114123" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Kluyveromyces lactis|Candida sphaerica|KLUYVEROMYCES LACTIS|Kluyveromyces drosophilarum|Kluyveromyces lactis var. drosophilarum|Kluyveromyces lactis var. lactis|Kluyveromyces marxianus lactis|Kluyveromyces marxianus var. drosophilarum|Kluyveromyces marxianus var. lactis|Saccharomyces lactis" ;
.

ncit:C127725
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127725" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127725>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of yeast-like fungi in the phylum Ascomycota. K. ohmeri is a causative agent of fungemia in immunocompromised patients. This species is widely used in the food industry for fermentation of fruits, pickles and rinds." ;
    flat:parents "C127289" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Kodamaea ohmeri|Candida guilliermondii var. membranifaciens|KODAMAEA OHMERI|Pichia ohmeri|Yamadazyma ohmeri" ;
.

ncit:C127727
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127727" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127727>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of gram-positive, rod-shaped, non-motile bacteria in the phylum Firmicutes." ;
    flat:parents "C76197" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Lysinibacillus|LYSINIBACILLUS" ;
.

ncit:C127728
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127728" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127728>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of fungi in the phylum ascomycota characterized by brown diffusible pigment that is produced in primary cultures and the occasional presence of phialides. This species is a causative agent of eumycetoma." ;
    flat:parents "C127291" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Madurella mycetomatis|MADURELLA MYCETOMATIS|Madurella ikedae|Madurella mycetomi|Streptotrix mycetomatis" ;
.

ncit:C127729
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127729" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127729>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of obligatory lipophilic, anthropophilic yeast in the phylum Basidiomycota that is part of the normal human skin flora. This species is the causative agent of pityriasis versicolor." ;
    flat:parents "C127292" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Malassezia furfur|MALASSEZIA FURFUR|Pityrosporum orbiculare|Pityrosporum ovale|Saccharomyces ovalis" ;
.

ncit:C127730
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127730" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127730>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A zoophilic species of lipophilic yeast in the phylum Basidiomycota that can be found within the microflora of healthy mammals. M. pachydermatis can be distinguished from other species in the genus by its ability to grow on Sabouraud agar." ;
    flat:parents "C127292" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Malassezia pachydermatis|MALASSEZIA PACHYDERMATIS|Pityrosporum pachydermatis" ;
.

ncit:C127731
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127731" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127731>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of yeast in the phylum Ascomycota commonly found on grapes, cherries, flowers, and spoiled fruit. Each cell of M. pulcherrima contains a single globule of oil and the species is being investigated as a source for a palm oil alternative." ;
    flat:parents "C127293" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Metschnikowia pulcherrima|Candida pulcherrima|METSCHNIKOWIA PULCHERRIMA" ;
.

ncit:C127732
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127732" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127732>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anthropophilic fungi in the phylum Ascomycota that is characterized by spindle shaped macroconidia, clavate microconidia, and pitted or spiny external walls. This species is a causative agent of tinea capitis and tinea corporis." ;
    flat:parents "C127294" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Microsporum audouinii|MICROSPORUM AUDOUINII" ;
.

ncit:C127733
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127733" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127733>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of fungi in the phylum Ascomycota characterized by thick-walled, roughened macroconidia with a distorted shape. This species is a causative agent of tinea capitis and tinea corporis." ;
    flat:parents "C127294" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Microsporum distortum|MICROSPORUM DISTORTUM|Microsporum canis var. distortum" ;
.

ncit:C127734
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127734" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127734>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of fungi in the phylum Ascomycota with macroconidia that are small, broad, irregular, and spindle-shaped with rough thick walls and few septa. This species is a causative agent of ringworm in horses and humans." ;
    flat:parents "C127294" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Microsporum equinum|MICROSPORUM EQUINUM" ;
.

ncit:C127735
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127735" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127735>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anthropophilic fungi in the phylum Ascomycota characterized by \"bamboo hyphae\". This species is a causative agent of juvenile tinea capitis in humans." ;
    flat:parents "C127294" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Microsporum ferrugineum|MICROSPORUM FERRUGINEUM" ;
.

ncit:C127736
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127736" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127736>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of soil-associated keratinophilic fungi in the phylum Ascomycota with a world-wide distribution. This species is known for causing diseases on human skin, particularly associated with rural and agricultural workers." ;
    flat:parents "C127294" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Microsporum gypseum|Arthroderma gypseum|Gymnoascus gypseus|MICROSPORUM GYPSEUM|Nannizzia gypsea" ;
.

ncit:C127737
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127737" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127737>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of salt- and acid-tolerant fungi in the phylum Ascomycota. This species is used in the production of pigments." ;
    flat:parents "C127295" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Monascus ruber|MONASCUS RUBER" ;
.

ncit:C127738
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C127738" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C127738>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of saprobic fungi in the phylum Zygomycota with sporangiophores that are hyaline, slightly roughened, tapering towards the apex, and erect with repeated sympodial branching." ;
    flat:parents "C120708" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Mucor ramosissimus|MUCOR RAMOSISSIMUS" ;
.

ncit:C127739
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
