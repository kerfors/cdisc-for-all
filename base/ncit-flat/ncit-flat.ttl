    flat:semantic%20type "Organism Attribute" ;
    flat:synonyms "Lean Body Mass to Total Body Mass Ratio Measurement|LBMTBMR|Lean Body Mass/Total Body Mass|Lean Body Mass/Total Body Mass" ;
.

