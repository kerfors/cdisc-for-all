    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C139533>" ;
    flat:definition "A term that refers to the staging of breast cancer, following the rules of the TNM AJCC v8 classification system. This staging system should only be used in global regions where biomarker tests are not routinely available. (from AJCC 8th Ed.)" ;
    flat:parents "C139532" ;
    flat:semantic%20type "Neoplastic Process" ;
    flat:synonyms "Breast Cancer by AJCC v8 Anatomic Stage|Breast Carcinoma by AJCC v8 Anatomic Stage" ;
.

