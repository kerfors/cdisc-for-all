    flat:code "C86958" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86958>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod and cocci shaped bacteria assigned to the phylum Bacteroidetes. This species contains sphingolipids, can ferment glucose, reduces nitrite to nitrogen, is oxidase positive and is urease negative. S. mizutaii is not reported to be a human pathogen." ;
    flat:parents "C86957" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Sphingobacterium mizutaii|Flavobacterium mizutae|Flavobacterium mizutae|SPHINGOBACTERIUM MIZUTAII" ;
.

ncit:C86959
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86959" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86959>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod and cocci shaped bacteria assigned to the phylum Bacteroidetes. This species contains sphingolipids, can ferment glucose and is oxidase and urease positive. S. multivorum can be pathogenic in immunocompromised individuals." ;
    flat:parents "C86957" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Sphingobacterium multivorum|CDC Group IIK-2|CDC Group IIk-2|SPHINGOBACTERIUM MULTIVORUM" ;
.

ncit:C86960
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
