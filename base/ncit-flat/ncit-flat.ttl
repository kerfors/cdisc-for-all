    flat:semantic%20type "Diagnostic Procedure" ;
    flat:synonyms "Forced Expiratory Volume in 1 Second to Forced Vital Capacity in 6 Seconds|FEV1/FVC6|FEV1/FVC6|FEV1FVC6" ;
.

ncit:C123566
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123566" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123566>" ;
    flat:concept%20in%20subset "CDISC SDTM Respiratory Test Code Terminology|CDISC SDTM Respiratory Test Name Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The volume of oxygen consumed by the body per heartbeat while at rest." ;
    flat:parents "C38081" ;
    flat:semantic%20type "Diagnostic Procedure" ;
