    flat:code "C13277" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13277>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|CDISC SEND Biospecimens Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Structured Product Labeling Terminology|SPL Tissue Form Product Type Terminology" ;
