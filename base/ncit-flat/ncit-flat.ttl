    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C139554>" ;
    flat:definition "A term that refers to the staging of breast cancer, following the rules of the TNM AJCC v8 classification system. This staging system should be used in countries where HER2, ER, and PR biomarker tests are routinely performed for patient care (U.S., Canada, etc.). (from AJCC 8th Ed.)" ;
    flat:parents "C139532" ;
    flat:semantic%20type "Neoplastic Process" ;
    flat:synonyms "Breast Cancer by AJCC v8 Prognostic Stage|Breast Cancer by AJCC v8 Prognostic Stage Group|Breast Carcinoma by AJCC v8 Prognostic Stage" ;
.

