    flat:definition "A genus of aerobic, Gram positive, cocci shaped bacterium assigned to the phylum Firmicutes and the family Planococcaceae." ;
    flat:parents "C85954" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Planococcus|PLANOCOCCUS" ;
.

ncit:C86651
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
