ncit:C201390
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C201390" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C201390>" ;
    flat:concept%20in%20subset "CDISC SDTM Binding Agent for Immunogenicity Tests Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A group of autoimmune substances found in the striated muscles that may be comprised of (but not limited to) the muscle proteins titin, myosin, actin, ryanodine receptor and potassium voltage-gated channel subunit Kv1.4. They are commonly associated with the autoimmune diseases rheumatic fever and myasthenia gravis." ;
    flat:parents "C20972" ;
    flat:semantic%20type "Immunologic Factor|Organic Chemical" ;
    flat:synonyms "Striated Muscle Autoantigens|STRIATED MUSCLE AUTOANTIGENS" ;
.

