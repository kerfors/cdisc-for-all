    flat:concept%20in%20subset "CDISC SDTM Respiratory Test Code Terminology|CDISC SDTM Respiratory Test Name Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A measurement used to describe airway behavior irrespective of lung volume; it is calculated as airway resistance (Raw) multiplied by functional residual capacity (FRC)." ;
    flat:parents "C38081" ;
    flat:semantic%20type "Diagnostic Procedure" ;
    flat:synonyms "Specific Airway Resistance|SRAW|sRAW" ;
.

