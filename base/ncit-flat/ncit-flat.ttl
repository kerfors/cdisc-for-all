ncit:C228281
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C228281" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C228281>" ;
    flat:concept%20in%20subset "CDISC SDTM Laboratory Analytical Method Calculation Formula Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A mathematical formula that estimates liver pathology through the assessment of a three-parameter blood test: tissue inhibitor of metalloproteinases 1 (TIMP-1); amino-terminal propeptide of type III procollagen (PIIINP); and hyaluronic acid (HA). ELF Score Formula = 2.494 + 0.846 x ln(HA) + 0.735 x ln(PIIINP) + 0.391 x ln(TIMP-1). (Lichtinghagen R, Pietsch D, Bantel H, Manns MP, Brand K, Bahr MJ. The Enhanced Liver Fibrosis (ELF) score: normal values, influence factors and proposed cut-off values. J Hepatol. 2013 Aug;59(2):236-42.)" ;
    flat:parents "C19044" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Enhanced Liver Fibrosis Score Formula|ENHANCED LIVER FIBROSIS SCORE FORMULA" ;
.

