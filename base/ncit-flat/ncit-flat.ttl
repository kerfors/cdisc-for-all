    flat:definition "A genus of anaerobic, Gram positive, cocci shaped bacterium assigned to the phylum Firmicutes and the family Peptococcaceae." ;
    flat:parents "C85952" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Peptococcus|PEPTOCOCCUS" ;
.

ncit:C86643
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86643" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86643>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of obligately anaerobic, Gram-positive, cocci shaped bacteria assigned to the phylum Firmicutes. This species is nonmotile, nonhemolytic, produces hydrogen sulfide and a black pigment that disappears upon exposure to air, indole and esculin negative, and does not reduce nitrate, ferment carbohydrates, liquefy gelatin or serum, or utilize lactate, starch or hippurate. P. niger is commensal to the human intestinal tract and has been isolated from the human naval and urine of adult women." ;
    flat:parents "C86642" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Peptococcus niger|Micrococcus niger|Micrococcus niger|PEPTOCOCCUS NIGER" ;
.

ncit:C86644
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
