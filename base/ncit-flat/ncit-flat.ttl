    flat:synonyms "CDISC SDTM BRIDG Activity Mood Terminology|BRDGMOOD|BRIDG Activity Mood|SDTM-BRDGMOOD" ;
.

ncit:C125924
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125924" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125924>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of parasitic nematodes in the family Strongyloididae that infects the gastrointestinal tract of mammals, birds, reptiles and amphibians, and has an unusual life cycle that includes free-living dioecious adult generations. Infection in immunocompromised individuals can result in potentially fatal disseminated strongyloidiasis." ;
    flat:parents "C14248" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Strongyloides|STRONGYLOIDES" ;
.

ncit:C125925
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125925" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125925>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of parasitic cestodes in the family Taeniidae that infect mammals and are characterized by ribbon-like bodies." ;
    flat:parents "C122045" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Taenia|TAENIA" ;
.

ncit:C125926
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125926" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125926>" ;
    flat:definition "A genus of ascomycetous yeasts in the family Saccharomycetaceae. Species in this genus reproduce vegetatively by multilateral budding. Cells are globose or ellipsoid and pseudohyphae may be formed. Members of this genus are vigorous fermenters but will not grow on nitrate as a sole source of nitrogen." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Torulaspora" ;
.

ncit:C125927
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125927" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125927>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of parasitic nematodes in the family Toxocaridae that is commonly found in the digestive tracts of carnivorous animals, with the final host being domestic animals. The typical route of infection is through ingestion of larvae contaminated soil. Human infections more frequently occur in children." ;
    flat:parents "C14248" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Toxocara|TOXOCARA" ;
.

ncit:C125928
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125928" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125928>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of parasitic nematodes in the family Trichinellidae that is found in the digestive tract of a broad spectrum of both wild and domestic mammals. The typical route of infection is through oral ingestion of larvae contaminated tissue." ;
    flat:parents "C14248" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Trichinella|TRICHINELLA" ;
.

ncit:C125929
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125929" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125929>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of parasitic nematodes in the family Trichuridae that is found in the mucosa of the lower intestines of humans and domestic animals. The typical route of infection is through oral ingestion of egg contaminated food, water, or soil." ;
    flat:parents "C14248" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Trichuris|TRICHURIS" ;
.

ncit:C125930
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125930" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125930>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of parasitic nematodes in the family Strongylidae that affect domestic and wild ruminants, pigs, horses, and poultry. All Trichostrongylus species have a direct life cycle with no intermediate host. The typical route of infection is through oral ingestion of larvae-contaminated water or vegetation." ;
    flat:parents "C14248" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Trichostrongylus|TRICHOSTRONGYLUS" ;
.

ncit:C125931
