    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C28076>" ;
    flat:concept%20in%20subset "CTRP Terminology|GDC Property Terminology|GDC Terminology|ICDC Property Terminology|ICDC Terminology" ;
    flat:definition "A term that refers to the cellular differentiation of a malignant cellular infiltrate. A cancer is defined through grades I-IV (or 1-4), or as well, moderately, poorly differentiated or undifferentiated." ;
