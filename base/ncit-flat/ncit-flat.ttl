ncit:C225099
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C225099" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C225099>" ;
    flat:concept%20in%20subset "CDISC QRS Terminology|CDISC Questionnaire Category Terminology|CDISC Questionnaire Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized 10-item questionnaire developed by Colter et al in 2018 as an updated version of a standardized five-item questionnaire originally developed in 2010 to assess symptoms of post exertional malaise (PEM) in patients with myalgic encephalomyelitis and chronic fatigue (ME/CFS). The updated measure utilizes a five-point rating scale and includes five supplementary items focused on symptom duration and recovery to better distinguish PEM associated with ME/CFS from other fatigue-related conditions." ;
    flat:parents "C91105" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "DePaul Symptom Questionnaire - Post Exertional Malaise 2018 Version - 10 Item|DSQ-PEM 2018|DSQ-PEM 2018|DSQ1" ;
.

