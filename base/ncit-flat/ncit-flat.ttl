ncit:C85595
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C85595" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C85595>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A method to determine microbial susceptibility to antibiotics in which filter paper disks containing known concentrations of antibiotics are placed on the agar surface that has been previously inoculated with the bacteria of interest. Microbial susceptibility is assessed by measuring the area around the disk that is free of microbial growth." ;
    flat:parents "C85540" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Disk Diffusion Method|DISK DIFFUSION|Disk Diffusion Susceptibility Testing" ;
.

ncit:C85596
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C85596" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C85596>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A method to determine microbial susceptibility to antibiotics in which a plastic strip impregnated with the antibiotic of interest is placed on an agar plate that has been inoculated with bacteria. The antibiotic diffuses from the strip producing a concentration gradient of drug on the agar. The point at which the elliptical shaped area of growth inhibition meets the strip is the minimum inhibitory concentration of the drug of interest." ;
    flat:parents "C85540" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Epsilometry|E-Test|EPSILOMETER" ;
.

