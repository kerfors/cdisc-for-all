ncit:C19133
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C19133" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C19133>" ;
    flat:definition "The detection of deletions and/or duplications/amplifications of specific DNA sequences, usually via comparative genomic hybridization (CGH)-based methods. The procedure utilizes probes that can detect and distinguish between deletions and duplications of short internal sequences (i.e. within a single exon) and deletions or duplications/amplifications of whole gene sequences." ;
    flat:parents "C18280" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Deletion/Duplication Analysis|Amplification and Deletion Detection|Amplification or Deletion Detection|Del/Dup Analysis|Deletion and Duplication Analysis|Deletion and Duplication Assay|Deletion/Duplication Mutation Analysis" ;
.

