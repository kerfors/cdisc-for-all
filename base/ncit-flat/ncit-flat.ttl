    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13275>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|CDISC SEND Biospecimens Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|GDC Terminology|GDC Value Terminology|mCode Genomic Specimen Type Value Set|mCode Terminology" ;
    flat:definition "The watery fluid in the mouth made by the salivary glands. Saliva moistens food to help digestion and it helps protect the mouth against infections." ;
    flat:parents "C34062" ;
    flat:semantic%20type "Body Substance" ;
    flat:synonyms "Saliva|Head and Neck, Saliva|SALIVA|saliva" ;
.

ncit:C13276
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
