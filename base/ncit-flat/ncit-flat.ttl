    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Phenotypic Multiple Antigen Bead-based Multiplex Assay|PHENOTYPIC MULTIPLE ANTIGEN BEAD-BASED MULTIPLEX ASSAY" ;
.

ncit:C130179
