    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C198347>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A type of cell-based assay that measures the ability of a biological specimen to inhibit transduction of the target cell line (for example, antibody-dependent inhibition of recombinant adeno-associated virus vector transfection)." ;
    flat:parents "C150876" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Cell-based Transduction Inhibition Assay|CELL-BASED TRANSDUCTION INHIBITION ASSAY" ;
.

