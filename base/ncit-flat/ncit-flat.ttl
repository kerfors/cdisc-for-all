ncit:C111100
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C111100" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C111100>" ;
    flat:concept%20in%20subset "ACC/AHA Cardiovascular and Noncardiovascular Complications of COVID-19 Terminology|ACC/AHA COVID-19 Appendix Authorized Values|Appendix 7: Diagnostic Procedures Terminology|CDISC SDTM ECG Finding Terminology|CDISC SDTM Holter ECG Results Terminology|CDISC SDTM Terminology|CDISC SEND ECG Standard Character Result Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An electrocardiographic finding of a tachycardia which does not originate in the ventricles or His Purkinje system. There is an abnormally high heart rate and QRS complexes are typically narrow, but aberration or preexcitation may be present. (CDISC)" ;
    flat:parents "C27158" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Supraventricular Tachycardia by ECG Finding|SUPRAVENTRICULAR TACHYCARDIA|SVT|Supraventricular Tachycardia|Supraventricular Tachycardia by EKG Finding|Supraventricular tachycardia|Supraventricular tachycardia" ;
.

ncit:C111101
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C111101" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C111101>" ;
    flat:concept%20in%20subset "ACC/AHA Cardiovascular and Noncardiovascular Complications of COVID-19 Terminology|ACC/AHA COVID-19 Appendix Authorized Values|Appendix 7: Diagnostic Procedures Terminology" ;
    flat:definition "An electrocardiographic finding of an atypical cardiac rhythm resulting from a pathologic process in the cardiac ventricles." ;
    flat:parents "C111075" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Ventricular Arrhythmia by ECG Finding|Ventricular Arrhythmia|Ventricular Arrhythmia by EKG Finding|Ventricular arrhythmia" ;
.

ncit:C111102
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C111102" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C111102>" ;
    flat:concept%20in%20subset "CDISC SDTM ECG Finding Terminology|CDISC SDTM Holter ECG Results Terminology|CDISC SDTM Terminology|CDISC SEND ECG Standard Character Result Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An electrocardiographic finding of a rapid grossly irregular ventricular rhythm with marked variability in QRS cycle length, morphology, and amplitude. The rate is typically greater than 300 bpm. (CDISC)" ;
    flat:parents "C111101" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Ventricular Fibrillation by ECG Finding|VENTRICULAR FIBRILLATION|VF|VFib|Ventricular Fibrillation|Ventricular Fibrillation by EKG Finding|Ventricular fibrillation" ;
.

ncit:C111103
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C111103" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C111103>" ;
    flat:concept%20in%20subset "CDISC SDTM ECG Finding Terminology|CDISC SDTM Holter ECG Results Terminology|CDISC SDTM Terminology|CDISC SEND ECG Standard Character Result Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An electrocardiographic finding of three or more consecutive complexes of ventricular organ with a rate greater than a certain threshold (100 or 120 beats per minute are commonly used). The QRS complexes are wide and have an abnormal morphology. (CDISC)" ;
    flat:parents "C111101" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Ventricular Tachycardia by ECG Finding|VENTRICULAR TACHYCARDIA|Ventricular Tachycardia|Ventricular Tachycardia by EKG Finding|Ventricular tachycardia" ;
.

ncit:C111104
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C111104" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C111104>" ;
    flat:concept%20in%20subset "CDISC SDTM ECG Finding Terminology|CDISC SDTM Holter ECG Results Terminology|CDISC SDTM Terminology|CDISC SEND ECG Standard Character Result Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An electrocardiographic finding of abnormally rapid heart rate with its origin in the sinus node. Thresholds for different age, sex, and patient populations exist." ;
    flat:parents "C111100" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Sinus Tachycardia by ECG Finding|SINUS TACHYCARDIA|Sinus Tachycardia|Sinus Tachycardia by EKG Finding|Sinus tachycardia" ;
.

ncit:C111105
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C111105" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C111105>" ;
    flat:concept%20in%20subset "CDISC SDTM ECG Finding Terminology|CDISC SDTM Holter ECG Results Terminology|CDISC SDTM Terminology|CDISC SEND ECG Standard Character Result Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An electrocardiographic finding of an organized, regular atrial rhythm with atrial rate between 101 and 240 beats per minute. The P wave morphology must be distinct from the sinus P wave morphology. (CDISC)" ;
    flat:parents "C111100" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Atrial Tachycardia by ECG Finding|ATRIAL TACHYCARDIA|Atrial Tachycardia|Atrial Tachycardia by EKG Finding|Atrial tachycardia" ;
.

