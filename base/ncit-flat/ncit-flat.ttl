    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Expanded Disability Rating Scale - Postacute Interview Caregiver Version Questionnaire|ED1|EXPANDED DRS-PI CAREGIVER VERSION|Expanded DRS-PI Caregiver Version" ;
.

