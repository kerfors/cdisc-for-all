    flat:definition "A genus of Gram-positive bacteria in the phylum Actinobacteria that contains over 500 separate species. Streptomyces spp. produce over 60% of all clinically relevant antibiotics, including antibacterial and antifungal agents." ;
    flat:parents "C85984" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptomyces|STREPTOMYCES" ;
.

ncit:C14281
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
