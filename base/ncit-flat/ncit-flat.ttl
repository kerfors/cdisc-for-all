ncit:C161408
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C161408" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C161408>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A technique that measures the pulmonary exchange of a set of six different inert gases dissolved together in saline (or dextrose) and infused intravenously. The measurements are then used to compute the distribution of ventilation/perfusion ratios that best describes the exchange of the six gases simultaneously. (Wagner PD. The multiple inert gas elimination technique (MIGET). Intensive Care Med. 2008 Jun;34(6):994-1001.)" ;
    flat:parents "C38081" ;
    flat:semantic%20type "Diagnostic Procedure" ;
    flat:synonyms "Multiple Inert Gas Elimination Technique|MIGET|MIGET" ;
.

