    flat:semantic%20type "Animal" ;
    flat:synonyms "Hymenolepis nana|Dwarf Tapeworm|HYMENOLEPIS NANA|Taenia nana|Vampirolepis nana" ;
.

ncit:C122324
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122324" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122324>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of obligately anaerobic, Gram-positive, rod-shaped, non-motile, spore-forming bacteria in the family Clostridiaceae. I. bartlettii is negative for lecithinase, lipase, catalase and urease, and is unable to hydrolyze esculin or gelatin, or reduce nitrate to nitrite, but positive for acid phosphatase, galactosidase and beta-glucuronidase. The species was originally isolated from fecal samples." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Intestinibacter bartlettii|Clostridium bartlettii|INTESTINIBACTER BARTLETTII" ;
.

ncit:C122325
