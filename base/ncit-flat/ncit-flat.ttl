    flat:semantic%20type "Finding" ;
    flat:synonyms "T Wave Notched by ECG Finding|NOTCHED T WAVES|Notched T Wave|Notched T Waves|T Wave Notched|T Wave Notched by EKG Finding" ;
.

ncit:C71033
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C71033" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C71033>" ;
