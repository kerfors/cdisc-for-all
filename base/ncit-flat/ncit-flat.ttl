    flat:concept%20in%20subset "CTRP Biomarker Terminology|CTRP Molecular Genetic Biomarker Terminology|CTRP Terminology" ;
    flat:definition "The presence or absence of Her2/Neu on a tissue sample." ;
    flat:display%20name "HER2/Neu Status" ;
    flat:parents "C94299" ;
    flat:semantic%20type "Laboratory or Test Result" ;
    flat:synonyms "HER2/Neu Status|ERBB2 Status|Her2/Neu Value" ;
.

ncit:C16153
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C16153" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16153>" ;
