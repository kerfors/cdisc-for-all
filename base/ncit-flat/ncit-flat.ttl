ncit:C112356
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112356" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112356>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of enveloped, brick-shaped viruses in the family Poxviridae. The genome is composed of linear, double-stranded DNA and the virus is capable of infection either with or without its external membrane envelope. Molluscipoxviruses may be sexually transmitted and cause molluscum contagiosum in humans." ;
    flat:parents "C187440" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Molluscipoxvirus|MOLLUSCIPOXVIRUS|Molluscipox Virus" ;
.

ncit:C112357
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112357" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112357>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of enveloped and brick-shaped viruses in the Poxviridae family and Molluscipoxvirus genus. The genome is composed of non-segmented, linear double-stranded DNA. Molluscum contagiosum viruses are found in humans and can cause the disease Molluscum contagiosum. Molluscum contagiosum viruses are transmitted via direct person-to-person contact and contact with infected fomites." ;
    flat:parents "C112356" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Molluscum Contagiosum Virus|MCV|MOCV|MOLLUSCUM CONTAGIOSUM VIRUS" ;
.

ncit:C112358
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112358" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112358>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of enveloped, spherical viruses in the family Bunyaviridae. The genome is composed of a circular single-strand of negative sense RNA. Nairoviruses are tick-borne with human and animal hosts and cause hemorrhagic fevers and gastroenteritis in humans." ;
    flat:parents "C112028" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Nairovirus|NAIROVIRUS" ;
.

ncit:C112359
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112359" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112359>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of enveloped and pleomorphic viruses in the Paramyxoviridae family and Henipavirus genus. The genome is composed of non-segmented, negative-sense, single-stranded RNA. Nipah viruses are found naturally in Pteropid fruit bats, and are zoonotic pathogens in domestic animals (mainly in pigs) and humans. Nipah viruses cause respiratory diseases, relapse and fatal encephalitis in humans." ;
    flat:parents "C112290" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Nipah Virus|NIPAH VIRUS|NiV" ;
.

ncit:C112360
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112360" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112360>" ;
    flat:concept%20in%20subset "CDISC SDTM Laboratory Test Code Terminology|CDISC SDTM Laboratory Test Name Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The determination of the amount of nitric oxide present in a sample." ;
    flat:parents "C49237" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Nitric Oxide Measurement|NITRICOX|NO|Nitric Oxide|Nitric Oxide" ;
.

ncit:C112362
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112362" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112362>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of non-enveloped, capsid covered viruses with T=3 icosahedral symmetry, in the family Caliciviridae. The genome is composed of a linear, single-strand of positive sense RNA. Noroviruses are transmitted by the fecal-oral route and cause gastroenteritis in humans." ;
    flat:parents "C14304" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Norovirus|NOROVIRUS|NoV|Norwalk-like virus" ;
.

ncit:C112363
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112363" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112363>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of non-enveloped and spherical viruses with a capsid with T=3 icosahedral symmetry in the Caliciviridae family and Norovirus genus. The genome is composed of single-stranded, positive-sense RNA. Norwalk viruses are found in humans and causes acute viral gastroenteritis. Norwalk viruses are transmitted via oral ingestion or fecal-oral contamination." ;
    flat:parents "C112362" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Norwalk Virus|NORWALK VIRUS|NV|Norwalk calicivirus" ;
.

ncit:C112365
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112365" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112365>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of non-enveloped, non-turreted viruses with a triple capsid structure, in the family Reoviridae. The genome is composed of linear, segmented double-stranded RNA. Orbiviruses are infective in a wide range of arthropod and vertebrate hosts and primarily cause disease in animals." ;
    flat:parents "C112026" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Orbivirus|ORBIVIRUS" ;
.

ncit:C112366
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112366" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112366>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of enveloped, spherical viruses in the family Bunyaviridae. The genome is composed of three linear, segmented single-strands of negative sense RNA. Orthobunyaviruses are mostly transmitted by gnats and cause encephalitis in humans." ;
    flat:parents "C112028" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Orthobunyavirus|Bunyavirus|ORTHOBUNYAVIRUS" ;
.

ncit:C112367
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112367" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112367>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of enveloped, oval-shaped virions with surface filaments, in the family Poxviridae. The genome is composed of non-segmented, double-stranded DNA. Two distinct infection virus particles exist for Parapoxviruses and cause non-serious infection in humans." ;
    flat:parents "C187440" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Parapoxvirus|PARAPOXVIRUS" ;
.

ncit:C112368
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112368" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112368>" ;
    flat:concept%20in%20subset "CDISC SDTM Respiratory Test Code Terminology|CDISC SDTM Respiratory Test Name Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The change in PEF following administration of a bronchodilator relative to the pre-treatment PEF value. (CDISC)" ;
    flat:parents "C38081" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Peak Expiratory Flow Reversibility|PEF Reversibility|PEF Reversibility|PEF Reversibility|PEFREV" ;
.

ncit:C112370
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112370" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112370>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Tumor or Lesion Properties Test Code Terminology|CDISC SDTM Tumor or Lesion Properties Test Name Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The most recently recorded sum of diameters minus the baseline sum of diameters divided by the baseline sum of diameters, multiplied by 100." ;
    flat:parents "C96621" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Percent Change From Baseline in Sum of Diameter|PCBSD|Percent Change Baseline in Sum of Diam|Percent Change Baseline in Sum of Diam" ;
.

ncit:C112371
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112371" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112371>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Tumor or Lesion Properties Test Code Terminology|CDISC SDTM Tumor or Lesion Properties Test Name Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
