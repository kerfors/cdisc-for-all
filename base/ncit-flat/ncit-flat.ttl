    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122044" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122044>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of parasitic nematodes in the family Capillariidae. Members of this genus infect dogs and cats, livestock, poultry, and wild mammals, birds and fish." ;
    flat:parents "C14248" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Capillaria|CAPILLARIA|Hairworm" ;
.

