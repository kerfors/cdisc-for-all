.

ncit:C191331
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C191331" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C191331>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A diagrammatic method to test visual acuity that uses a set of cards with familiar pictures placed in either the top or bottom half of the card, used for those individuals who are unable to provide a verbal response to questions, including infants, toddlers, and other non verbal individuals." ;
    flat:parents "C38060" ;
    flat:semantic%20type "Diagnostic Procedure" ;
    flat:synonyms "Cardiff Acuity Cards|CARDIFF ACUITY CARDS" ;
.

ncit:C191332
