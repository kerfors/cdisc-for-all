    flat:parents "C19988" ;
    flat:semantic%20type "Phenomenon or Process" ;
    flat:synonyms "Gastrointestinal Process" ;
.

ncit:C41604
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C41604" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C41604>" ;
    flat:definition "The process of preparing a sample or portion of a sample for storage, preservation, or further analysis." ;
    flat:parents "C48177" ;
    flat:semantic%20type "Activity" ;
    flat:synonyms "Specimen Processing" ;
.

ncit:C42301
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42301" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42301>" ;
    flat:definition "The officer who presides at the meetings of an organization, committee, or other organizational structure." ;
    flat:parents "C198995" ;
    flat:semantic%20type "Human" ;
    flat:synonyms "Chairperson|Chair|Chairman|Chairwoman" ;
.

ncit:C42532
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42532" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42532>" ;
    flat:definition "A base or derived unit of weight or measure that belongs to the decimal International System of Units (Systeme International d'Unites, SI) derived from and extending the metric system." ;
    flat:parents "C70769" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Unit of International System of Units|SI Unit" ;
.

ncit:C42533
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42533" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42533>" ;
    flat:definition "The base units are a choice of seven well-defined units within the International System of Units (Systeme International d'Unites, SI), which by convention are regarded as dimensionally independent and therefore defined in an absolute way without referring to any other units: the meter, the kilogram, the second, the ampere, the kelvin, the mole, and the candela. The base units are consistent with the part of the metric system called the MKS system." ;
    flat:parents "C42532" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Base Unit of International System of Units|Base SI Unit" ;
.

ncit:C42534
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42534" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42534>" ;
    flat:definition "Derived units of the International System of Units (Systeme International d'Unites, SI) are those formed by combining base SI units according to the algebraic relations linking the corresponding quantities. The names and symbols of some of the units thus formed can be replaced by special names and symbols which can themselves be used to form expressions and symbols of other derived units." ;
    flat:parents "C42532" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Derived Unit of International System of Units|Derived SI Unit" ;
.

ncit:C42535
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42535" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42535>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit for Vital Sign Result Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Structured Product Labeling Terminology|GDC Terminology|GDC Value Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|OS Authorized Value Terminology|OS Lab Table|PQ/CMC Units of Measure Terminology|SPL UCUM Terminology|UCUM Terminology" ;
    flat:definition "A unit of time, one of the seven base units of the International System of Units (Systeme International d'Unites, SI). The second is the duration of 919 263 177 0 periods of the specified light radiation corresponding to the transition between the two hyperfine levels of the caesium 133 atom in its ground state at 0 K. According to the convention, 60 seconds constitute one minute; 3,600 seconds constitute one hour." ;
    flat:parents "C42574|C42533" ;
    flat:semantic%20type "Temporal Concept" ;
    flat:synonyms "Second|SECOND|Seconds|s|s|s|s|s|s|s|s|s|sec|sec|second|second|second|second|seconds" ;
.

ncit:C42536
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42536" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42536>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "A unit of electric current, one of the seven base units of the International System of Units (Systeme International d'Unites, SI). It is that constant current which, if maintained in two straight parallel conductors of infinite length and zero diameter separated by one meter in a vacuum, would produce between these conductors a force equal to 2x10E7 newton per meter of length. This is dependent upon the definitions of the meter, kilogram, and second. One ampere represents 6.24 x 10E18 unit electric charge carriers, such as electrons, passing a specified fixed point in one second." ;
    flat:parents "C67323|C42533" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Ampere|A|A|A|A|A|A|Ampère|amp|amp|ampere|ampère" ;
.

ncit:C42537
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42537" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42537>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit for Vital Sign Result Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|PQ/CMC Units of Measure Terminology" ;
    flat:definition "A basic unit of thermodynamic temperature, one of the seven base units of the International System of Units (Systeme International d'Unites, SI). It is 1/273.16th of the thermodynamic temperature of the triple point of water. This sets the size of the kelvin unit for temperature differences and defines the thermodynamic temperature of an equilibrium mixture of waters ice-liquid-vapor as 273.16 K, where 0 K is the lowest possible temperature (\"absolute zero\")." ;
    flat:parents "C44276|C42533" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Kelvin|Degree Kelvin|K|K|K|K|K|K|K|degree Kelvin|kelvin" ;
.

ncit:C42538
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42538" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42538>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology" ;
    flat:definition "A unit of luminous intensity, one of the seven base units of the International System of Units (Systeme International d'Unites, SI). It is the luminous intensity in a given direction of a small monochromatic light source at 540 terahertz emitting 1/683 watt per steradian in that direction. This is dependent upon the definitions of the meter, kilogram, and second." ;
    flat:parents "C42533" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Candela|candela|candela|cd|cd|cd|cd|cd|cd" ;
.

ncit:C42539
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42539" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42539>" ;
    flat:concept%20in%20subset "CDISC SDTM Pharmacokinetic Parameter Unit of Measure Terminology|CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Structured Product Labeling Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|PQ/CMC Units of Measure Terminology|SPL UCUM Terminology|UCUM Terminology" ;
    flat:definition "A unit of amount of substance, one of the seven base units of the International System of Units (Systeme International d'Unites, SI). It is the amount of substance that contains as many elementary units as there are atoms in 0.012 kg of carbon-12. When the mole is used, the elementary entities must be specified and may be atoms, molecules, ions, electrons, other particles, or specified groups of such particles." ;
    flat:parents "C48470|C48453|C42533" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Mole|M|M|MOLE|MOLE|mol|mol|mol|mol|mol|mol|mol|mol|mol|mole|mole|mole|mole (chemical)|mole (chemical)|mole(s)" ;
.

ncit:C42545
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42545" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42545>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit for Vital Sign Result Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "A SI derived unit of frequency; equal to one oscillation (one cycle) per second." ;
    flat:parents "C67313|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Hertz|Cycle per Second|Cycle per Second|Cycle/Second|Cycle/s|Herz|Herz|Hz|Hz|Hz|Hz|Hz|Hz|Hz|cycle/sec|hertz|hertz|{cycle}/s|{cycle}/s" ;
.

ncit:C42546
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42546" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42546>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|PQ/CMC Units of Measure Terminology|UCUM Terminology" ;
    flat:definition "A SI derived unit of force. The force which, when applied in a vacuum to a body having a mass of one kilogram, causes an acceleration of one meter per second squared. It is equal to 10E5 dynes." ;
    flat:parents "C69180|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Newton|N|N|N|N|N|N|N|newton|newton" ;
.

ncit:C42547
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42547" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42547>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit for Vital Sign Result Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "A SI derived unit of pressure equivalent to one newton per square meter or 10 bars or to 1.45x10E-4 pounds per square inch." ;
    flat:parents "C67333|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Pascal|P|P|Pa|Pa|Pa|Pa|Pa|Pa|pascal|pascal" ;
.

ncit:C42548
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42548" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42548>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "A unit of electrical, mechanical, and thermal energy (as well as work and quantity of heat) in the SI system, equal to the work done when the point of application of a force of one newton is displaced through a distance of one meter in the direction of the force or the work done when a current of one ampere passes through a resistance of one ohm for one second. Joule is equal to 0.23889 gram-calorie (mean)." ;
    flat:parents "C67275|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Joule|J|J|J|J|J|J|Watt second|joule|joule|joule" ;
.

ncit:C42549
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42549" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42549>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit for Vital Sign Result Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "A SI unit of power equal to the power which in one second produces or transfers the energy of one joule. The unit is used in measurements of power emitted, transferred or received as radiation, sound waves, heat flow rate, and rate of energy transfer." ;
    flat:parents "C69431|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Watt|W|W|W|W|W|W|watt|watt" ;
.

ncit:C42550
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42550" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42550>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology" ;
    flat:definition "A SI derived unit of quantity of electricity, equal to the quantity of charge transferred in one second across a conductor in which there is a constant current of one ampere." ;
    flat:parents "C68747|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Coulomb|Amp-second|Ampere second|C|C|C|C|C|coulomb" ;
.

ncit:C42551
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42551" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42551>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "A SI derived unit of electric potential and electromotive force, equal to the difference of electric potential between two points on a conducting wire carrying a constant current of one ampere when the power dissipated between the points is one watt, equivalent to the potential difference across a resistance of one ohm when one ampere of current flows through it." ;
    flat:parents "C67322|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Volt|V|V|V|V|V|V|V|volt|volt|volt" ;
.

ncit:C42552
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42552" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42552>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "A SI unit of capacitance equal to the capacitance of a capacitor having an equal and opposite charge of one coulomb on each plate and a potential difference of one volt between the plates." ;
    flat:parents "C67320|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Farad|F|F|F|F|F|F|farad|farad" ;
.

ncit:C42553
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42553" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42553>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "The international system (SI) unit for radiation dose equivalent equal to 1 Joule/kilogram. 1 sievert = 100 rem." ;
    flat:parents "C69440|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Sievert|Sv|Sv|Sv|Sv|Sv|Sv|Sv|sievert|sievert" ;
.

ncit:C42554
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42554" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42554>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "A unit of electrical resistance equal to the resistance between two points on a conductor when a potential difference of one volt between them produces a current of one ampere. Ohm is also used to measure impedance and reactance for complex resistance. A measurement in ohms is the reciprocal of a measurement in siemens." ;
    flat:parents "C68787|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Ohm|ohm|ohm|ohm" ;
.

ncit:C42555
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42555" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42555>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "A unit of electrical conductance, admittance, and susceptance. A conductor has a conductance of one siemens if an electrical potential difference of one volt produces a one ampere current in it. The conductance in siemens is the reciprocal of its resistance in ohms." ;
    flat:parents "C68785|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Siemens|Reciprocal ohm|S|S|S|S|S|S|mho|mho|mho|mho|mho|siemens|siemens" ;
.

ncit:C42556
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42556" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42556>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "A SI derived unit of magnetic flux, equal to the flux that produces in a circuit of one turn an electromotive force of one volt, when the flux is uniformly reduced to zero within one second." ;
    flat:parents "C68792|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Weber|V*s|V*sec|V.s|V.s|Volt Second|Volt-second|Wb|Wb|Wb|Wb|Wb|Wb|weber|weber" ;
.

ncit:C42557
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42557" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42557>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|CRF6 DIPG Imaging Assessment Table|CRF6 DMG Imaging Assessment Table|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "A SI unit of magnetic flux density equal to the magnitude of the magnetic field vector necessary to produce a force of one newton on a charge of one coulomb moving perpendicular to the direction of the magnetic field vector with a velocity of one meter per second. It is equivalent to one weber per square meter." ;
    flat:parents "C68794|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Tesla|MRI field strength (T)|T|T|T|T|T|T|tesla|tesla" ;
.

ncit:C42558
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42558" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42558>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "A SI derived unit of electric inductance. A coil with an inductance of one henry requires a flux of one weber for each ampere of induced current. If it is the current which changes, then the induced field will generate a potential difference within the coil: if the inductance is one henry a current change of one ampere per second generates a potential difference of one volt. The henry is a large unit; inductances in practical circuits are measured in millihenrys or microhenrys." ;
    flat:parents "C67321|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Henry|H|H|H|H|H|H|henry" ;
.

ncit:C42559
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42559" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42559>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit for Vital Sign Result Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|CPTAC Baseline Medical Forms Terminology|CPTAC Surgery-Anesthesia Form|CPTAC Terminology|FDA Structured Product Labeling Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|OS Authorized Value Terminology|OS Vitals Table|PQ/CMC Units of Measure Terminology|SPL UCUM Terminology|UCUM Terminology" ;
    flat:definition "A unit of temperature of the temperature scale designed so that the freezing point of water is 0 degrees and the boiling point is 100 degrees at standard atmospheric pressure. The current official definition of the Celsius sets 0.01 C to be at the triple point of water and a degree to be 1/273.16 of the difference in temperature between the triple point of water and absolute zero. One degree Celsius represents the same temperature difference as one Kelvin." ;
    flat:parents "C44276|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Degree Celsius|C|C|C|C|Cel|Cel|Cel|Cel|Cel|Cel|Cel|Celsius|Celsius Degree|Degree C|Degree Centigrade|celsius temperature|degree Celsius|degree Celsius|degree Celsius|degree Celsius" ;
.

ncit:C42560
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42560" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42560>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "A SI derived unit of luminous flux. It is the amount of light that falls on a unit area at unit distance from a source of one candela." ;
    flat:parents "C69429|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Lumen|lm|lm|lm|lm|lm|lm|lm|lumen|lumen|lumen" ;
.

ncit:C42561
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C42561" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C42561>" ;
    flat:concept%20in%20subset "CDISC SDTM Terminology|CDISC SDTM Unit of Measure Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|HL7 FHIR v5.0.0 R5 Unit of Measure Terminology|HL7 Unit of Measure Terminology|ICH Unit of Measure Terminology|UCUM Terminology" ;
    flat:definition "A SI derived unit of illuminance equal to the direct illumination on a surface that is everywhere one meter from a uniform point source of one candela; a unit of illuminance that is equal to one lumen per square meter." ;
    flat:parents "C69430|C42534" ;
    flat:semantic%20type "Quantitative Concept" ;
    flat:synonyms "Lux|lux|lux|lux|lx|lx|lx|lx|lx|lx|lx" ;
.

