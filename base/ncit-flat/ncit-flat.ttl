    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86080>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative bacteria assigned to the phylum Proteobacteria. This bacteria is motile by flagella, oxidase positive, urease negative, hydrolyzes esculin and is unable to ferment glucose. A. dentrificans is normally found in soil but has been isolated from human clinical specimens." ;
