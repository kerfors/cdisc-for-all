    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122325>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of coccidian parasites in the family Eimeriidae. They are the causative agents of isosporiasis. Most members of the genus infect a single host species." ;
    flat:parents "C192229" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Isospora|ISOSPORA" ;
.

