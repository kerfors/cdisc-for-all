    flat:parents "C71100" ;
    flat:semantic%20type "Classification" ;
    flat:synonyms "12 Lead Placement Standard Extended Left|STANDARD 12-LEAD EXTENDED LEFT|Standard 12-lead extended to the left by V7, V8, V9|Standard 12-lead extended to the left by V7, V8, V9" ;
.

