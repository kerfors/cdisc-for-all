.

ncit:C116151
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116151" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116151>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genomic microarray-based method able to detect single nucleotide polymorphisms." ;
    flat:parents "C44282" ;
    flat:semantic%20type "Molecular Biology Research Technique" ;
    flat:synonyms "Single Nucleotide Polymorphism Array|Genotype Chip|SNP ARRAY|SNP Genotyping|SNP Probe" ;
.

ncit:C116152
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116152" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116152>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A molecular biology method combining crosslinking-immunoprecipitation and high-throughput sequencing techniques to detect and map RNA-protein interactions. In CLIP, whole tissues, organisms or individual cell types are treated with UV irradiation, which introduces covalent bonds between RNA-protein complexes. This is followed by immunoprecipitation and removal of the protein component of the crosslinked complex. The purified RNAs are then fragmented, reduced in size and subjected to high-throughput sequencing for the identification of RNA binding sites." ;
    flat:parents "C192768" ;
    flat:semantic%20type "Molecular Biology Research Technique" ;
    flat:synonyms "Cross-linking Immunoprecipitation High-throughput Sequencing|CLIP SEQUENCING|CLIP Sequencing|CLIP-Seq|HITS-CLIP" ;
.

ncit:C116153
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116153" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116153>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genomic microarray-based method using cDNA from two samples, labeled with two separate fluorophores/dyes at different emission wavelengths, and hybridized to a single microarray for laser excitation in a microarray scanner. Relative fluorescence intensity of each dye can be measured and used in log- or intensity- ratio based comparative analysis for gene expression between the two experimental conditions." ;
    flat:parents "C44282" ;
    flat:semantic%20type "Molecular Biology Research Technique" ;
    flat:synonyms "Two Color Microarray|Dual-channel Microarray|TWO-COLOR MICROARRAY|Two-channel Expression Array|Two-channel Microarray|Two-color Microarray-based Gene Expression" ;
.

ncit:C116154
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116154" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116154>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A technique used to identify the sequence of individual nucleobases in a single strand of DNA fragment template, which can be a plasmid insert, genomic DNA or a PCR product. In addition, direct sequencing of genomic DNA or PCR products does not require sub-cloning of the gene of interest into a vector." ;
    flat:parents "C153598" ;
    flat:semantic%20type "Molecular Biology Research Technique" ;
    flat:synonyms "Direct Sequencing|DIRECT SEQUENCING" ;
.

ncit:C116155
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116155" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116155>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|pFDA Bioinformatics/Genomics Terminology|precisionFDA Terminology" ;
    flat:definition "A process to identify and determine the primary structure of, and the order of constituents in a biopolymer." ;
    flat:parents "C17565" ;
    flat:semantic%20type "Molecular Biology Research Technique" ;
    flat:synonyms "Biopolymer Sequencing|SEQUENCING|Sequencing" ;
.

ncit:C116156
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116156" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116156>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A molecular cytogenetic method combining chromosomal comparative genomic hybridization technique and microarray to detect chromosomal aberrations and changes in DNA copy numbers in the genome, using oligonucleotides immobilized on a solid support as targets for hybridization." ;
    flat:parents "C198497" ;
    flat:semantic%20type "Molecular Biology Research Technique" ;
    flat:synonyms "Oligonucleotide Array-based Comparative Genomic Hybridization|OLIGO ACGH|Oligonucleotide Array-based CGH" ;
.

ncit:C116157
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116157" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116157>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A molecular cytogenetic method combining chromosomal comparative genomic hybridization technique and microarray to detect chromosomal aberrations and changes in DNA copy numbers, using bacterial artificial chromosome clones containing target DNA fragments for hybridization. This method is especially sensitive in detecting single copy changes in the genome." ;
    flat:parents "C198497" ;
    flat:semantic%20type "Molecular Biology Research Technique" ;
    flat:synonyms "Bacterial Artificial Chromosome Array-based Comparative Genomic Hybridization|BAC ACGH|BAC Array-based CGH|Bacterial Artificial Chromosome Array-based CGH" ;
.

ncit:C116158
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116158" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116158>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A technique used to deliver high-throughput digital PCR. The digital array partitions a sample premixed with PCR reagents into hundreds of individual PCR reactions, which allows the absolute quantification of target sequences and rare allele detection, as compared to conventional real-time quantitative PCR." ;
    flat:parents "C17003" ;
    flat:semantic%20type "Molecular Biology Research Technique" ;
    flat:synonyms "Digital Array|DIGITAL PCR ARRAY" ;
.

ncit:C116159
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116159" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116159>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A screening method used to determine abnormal DNA copy number changes in complex genomes. This method uses unique short probes which can be quantitatively recovered and amplified after hybridization to genomic DNA. In addition, the probes can be specifically designed for any genomic region of interest (such as locus, telomere, chromosomal segment, whole chromosome or total genome) with high hybridization specificity." ;
    flat:parents "C179019" ;
    flat:semantic%20type "Molecular Biology Research Technique" ;
    flat:synonyms "Multiplex Amplifiable Probe Hybridization|MAPH" ;
.

ncit:C116160
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116160" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116160>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A DNA mapping technique based on complete restriction enzyme digestion of a set of overlapping clones that provides highly redundant coverage of the mapping target." ;
    flat:parents "C17094" ;
    flat:semantic%20type "Molecular Biology Research Technique" ;
    flat:synonyms "Multiple Complete Digest Restriction Fragment Mapping|MULTIPLE-COMPLETE-DIGEST RESTRICTION FRAGMENT MAPPING|Multiple Complete Digestion" ;
.

ncit:C116161
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116161" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116161>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A type of high-throughput, multiplex PCR method used to determine abnormal DNA copy number changes of up to 50 genomic DNA or RNA sequences with a single pair of PCR primers. It is frequently used in the detection of genetic aberrations in tumors, and can distinguish sequences differing in only a single nucleotide." ;
    flat:parents "C179019|C17003" ;
    flat:semantic%20type "Molecular Biology Research Technique" ;
    flat:synonyms "Multiplex Ligation-dependent Probe Amplification|MLPA|MULTIPLEX LIGATION-DEPENDENT PROBE AMPLIFICATION" ;
.

ncit:C116162
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116162" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116162>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A technique used for constructing the ordered and high-resolution genome or chromosome sized restriction enzyme map of an organism from a single, stained DNA molecule, digested by the restriction enzyme and imaged by an optical microscope." ;
    flat:parents "C17094" ;
    flat:semantic%20type "Molecular Biology Research Technique" ;
    flat:synonyms "Optical Mapping|OPTICAL MAPPING|Optical Map" ;
.

