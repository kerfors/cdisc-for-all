.

ncit:C14217
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C14217" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14217>" ;
    flat:concept%20in%20subset "CTRP Biomarker Terminology|CTRP Terminology" ;
    flat:definition "A heterogeneous family of morphologically similar viruses, all of which contain double-stranded DNA and which infect man and a wide variety of other vertebrates. Infections produce type A inclusion bodies; in many instances, infection may remain latent for many years, even in the presence of specific circulating antibodies. Virions are enveloped, ether-sensitive, and vary up to 200 nm in diameter; the nucleocapsids are 100 nm in diameter and of icosahedral symmetry, with 162 capsomeres. The family includes herpes simplex virus, cytomegalovirus, EB virus (all of which infect humans) and many others." ;
    flat:display%20name "Herpesvirus" ;
    flat:parents "C14348" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Herpesvirus|Herpes Virus|Herpesviridae|Virus-Herpes|herpesvirus" ;
.

