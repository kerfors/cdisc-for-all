ncit:C20852
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C20852" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C20852>" ;
    flat:concept%20in%20subset "CDISC SDTM Evaluator Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A registered nurse (RN) with advanced training in diagnosing and treating illness.  NPs are master's degree prepared health experts that focus on helping patients achieve total health and prevent disease.  NPs focus on disease prevention, wellness, and patient education.  NPs prescribe medications, treat illness, and perform physical examinations.  NPs can function independently of physician intervention, but require a practice agreement with a physician. NPs are licensed by a state authority." ;
    flat:parents "C20825" ;
    flat:semantic%20type "Biomedical Occupation or Discipline" ;
    flat:synonyms "Nurse Practitioner|APRN|Advanced Practice Registered Nurse|NP|NP|NURSE PRACTITIONER|nurse practitioner" ;
.

