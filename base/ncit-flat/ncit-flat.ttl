    flat:semantic%20type "Virus" ;
    flat:synonyms "Murine Pneumonia Virus|MPV|MURINE PNEUMONIA VIRUS|Murine Orthopneumovirus|Murine orthopneumovirus|PVM" ;
.

ncit:C221642
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C221642" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C221642>" ;
