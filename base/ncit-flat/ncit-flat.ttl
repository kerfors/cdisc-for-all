.

ncit:C13280
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C13280" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13280>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|CDISC SEND Biospecimens Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|NICHD Terminology|Pediatric Adverse Events Terminology Mapped to MedDRA|Pediatric Adverse Events Terminology" ;
    flat:definition "The liquid secreted by the sweat glands, having a salty taste and a pH that varies from 4.5 to 7.5. Sweat produced by the eccrine sweat glands is clear with a faint characteristic odor, and contains water, sodium chloride, and traces of albumin, urea, and other compounds. Its composition varies with many factors, e.g., fluid intake, external temperature and humidity, and some hormonal activity. Sweat produced by the larger, deeper, apocrine sweat glands of the axillae contains, in addition, organic material which on bacterial decomposition produces an offensive odor." ;
    flat:parents "C13409" ;
    flat:semantic%20type "Body Substance" ;
    flat:synonyms "Sweat|PERSPIRATION|Perspiration|SWEAT|Sweats" ;
.

