    flat:semantic%20type "Virus" ;
    flat:synonyms "Human Papillomavirus-34|34|HPV 34|HPV-34|HPV34|HUMAN PAPILLOMAVIRUS TYPE 34|Human Papillomavirus Type 34" ;
.

