ncit:C12435
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12435" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12435>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|GDC Terminology|GDC Value Terminology" ;
    flat:definition "Tissue responsible for the body movements and the shape and size changes of internal organs.  Muscle tissue is composed of specialized contractile cells.  There are two types of muscle tissue recognized: striated and smooth muscle.  The striated muscle tissue is further subdivided into skeletal, visceral striated, and cardiac muscle." ;
    flat:display%20name "Muscle Tissue" ;
    flat:parents "C12471" ;
    flat:semantic%20type "Tissue" ;
    flat:synonyms "Muscle Tissue|MUSCLE TISSUE" ;
.

