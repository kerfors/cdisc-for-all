    flat:code "C2317" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C2317>" ;
    flat:definition "A class of food constituents, also known as fats and oils, that serve as a source of energy and essential fatty acids in animals. The major components of lipids are fatty acids, triglycerides, phospholipids, glycolipids, sphingolipids, steroids (cholesterol), and lipoproteins." ;
    flat:parents "C616|C54060" ;
    flat:semantic%20type "Chemical Viewed Functionally" ;
    flat:synonyms "Dietary Lipid|Dietary Fat|Total Dietary Fat|Total Dietary Lipid" ;
.

