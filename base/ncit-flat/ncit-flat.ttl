    flat:semantic%20type "Research Activity" ;
    flat:synonyms "Phase II Trial|2|Clinical Trials, Phase II|PHASE II TRIAL|Phase 2|Phase 2|Phase 2 Study|Phase II Clinical Trial|Phase II Protocol|Phase II Study|Trial Phase 2|phase 2|phase 2 (study)|phase II trial" ;
.

ncit:C15602
