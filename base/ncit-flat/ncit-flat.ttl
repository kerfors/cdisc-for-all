    flat:synonyms "Lesion Restenosis Indicator|LRSTIND" ;
.

ncit:C116148
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C116148" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C116148>" ;
    flat:concept%20in%20subset "CDISC SDTM Cardiovascular Test Code Terminology|CDISC SDTM Cardiovascular Test Name Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An indication as to whether there is re-narrowing of a stent implanted at a lesion site to treat a prior stenosis, to a diameter stenosis of greater than 50% within the stent." ;
    flat:parents "C93593" ;
    flat:semantic%20type "Qualitative Concept" ;
    flat:synonyms "In-Stent Restenosis Indicator|INRSTIND" ;
.

