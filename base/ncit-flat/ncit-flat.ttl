    flat:definition "An indication as to whether the subject was born prior to 38 weeks gestation." ;
    flat:parents "C19332" ;
    flat:semantic%20type "Organism Attribute" ;
    flat:synonyms "Premature Birth Indicator|PREMBRTH|premature at birth|premature_at_birth" ;
.

ncit:C112401
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112401" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112401>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of viruses in the Poxviridae family and Parapoxvirus genus. Pseudocowpox viruses are mainly found in cattle and cause mild sores on cow teats and udders. Pseudocowpox viruses can also infect humans via direct contact with infected dairy cattle during the milking process, and cause the skin disease milker's nodule." ;
    flat:parents "C112367" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Pseudocowpox Virus|PSEUDOCOWPOX VIRUS|Paravaccinia virus|Pseudocowpoxvirus" ;
.

ncit:C112402
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112402" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112402>" ;
    flat:concept%20in%20subset "CDISC SDTM ECG Finding Terminology|CDISC SDTM Holter ECG Results Terminology|CDISC SDTM Terminology|CDISC SEND ECG Standard Character Result Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An electrocardiographic finding in which the QT interval corrected for heart rate using Bazett's formula is shortened. Thresholds for different age, sex, and patient populations exist." ;
    flat:parents "C41328" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "QTcB Shortened|SHORT QTCB" ;
.

