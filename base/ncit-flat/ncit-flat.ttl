    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125953>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A method to quantify the opaqueness of a liquid using a turbidimeter, by measuring the decrease in light intensity due to the scattering effect of suspended immunoaggregates in a liquid sample. The immunoaggregates are target antigens agglutinated to antigen-specific antibody-coated polystyrene latex-enhanced particles." ;
    flat:parents "C111328" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Particle-Enhanced Turbidimetric Immunoassay|PARTICLE-ENHANCED TURBIDIMETRIC IMMUNOASSAY|PETIA" ;
.

ncit:C125954
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125954" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125954>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Any bacteria with a shape between that of a sphere and a rod that requires oxygen to grow or respirate and has a cell wall that contains low levels of peptidoglycan and stains pink with the Gram staining technique." ;
    flat:parents "C122319" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Aerobic Gram-Negative Coccobacillus|AEROBIC GRAM-NEGATIVE COCCOBACILLUS" ;
.

ncit:C125955
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125955" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125955>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Any bacteria with a shape between that of a sphere and a rod that does not require oxygen to grow or respirate and has a cell wall that contains low levels of peptidoglycan and stains pink with the Gram staining technique." ;
    flat:parents "C122319|C119323" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Anaerobic Gram-Negative Coccobacillus|ANAEROBIC GRAM-NEGATIVE COCCOBACILLUS" ;
.

ncit:C125956
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125956" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125956>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of nonsegmented, negative-strand ssRNA viruses in the Pneumovirinae subfamily that uniquely accomplishes cell fusion without the help of an attachment protein. This virus has a genome of about 13 kb, encoding eight proteins. The virion is enveloped and spherical with a diameter of about 150 nm" ;
    flat:parents "C14308" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Metapneumovirus|METAPNEUMOVIRUS" ;
.

ncit:C125957
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125957" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125957>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Harmless or beneficial population of microorganisms or plant life that normally occur in specific areas of the body or the environment." ;
    flat:parents "C68564" ;
    flat:semantic%20type "Classification" ;
    flat:synonyms "Normal Flora|NORMAL FLORA" ;
.

ncit:C125958
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125958" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125958>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of gram-positive, aerobic actinomycetes bacteria in the genus Streptomyces that has a branching, filamentous growth pattern and is associated with black grained mycetoma disease in humans." ;
    flat:parents "C14278" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Streptomyces paraguayensis|STREPTOMYCES PARAGUAYENSIS" ;
.

ncit:C125959
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125959" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125959>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The only fungal genus in the Syncephalastraceae family within the Mucorales order. Sporangiospores are produced asexually through the development of cylindrical merosporangia; however, syncephalastrum also undergoes a sexual cycle that produces zygospores. It is primarily isolated from animal excrement, plant material, and soil in tropical or subtropical regions." ;
    flat:parents "C77194" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Syncephalastrum|SYNCEPHALASTRUM" ;
.

ncit:C125960
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125960" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125960>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic cestodes in the genus Taenia that is acquired through the ingestion of infected bovine tissue. Humans are the definitive host of the adult cestodes, resulting in taeniasis." ;
    flat:parents "C125925" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Taenia saginata|Beef Tapeworm|TAENIA SAGINATA" ;
.

ncit:C125961
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125961" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125961>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic cestodes in the genus Taenia that is acquired through the ingestion of infected porcine tissue. Humans are the definitive host of the adult cestodes, resulting in taeniasis. Taenia solium also causes cysticercosis, a tissue infection caused by larval cysts, which results when humans serve as an intermediate host." ;
    flat:parents "C125925" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Taenia solium|Cysticercus cellulosae|Pork Tapeworm|TAENIA SOLIUM" ;
.

ncit:C125962
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125962" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125962>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of ascomycetous yeast in the Torulaspora genus that has the ability to ferment and assimilate carbon compounds." ;
    flat:parents "C125926" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Torulaspora delbrueckii|TORULASPORA DELBRUECKII" ;
.

ncit:C125963
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125963" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125963>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic nematodes in the genus Toxocara where canids are the definitive host.  Human infection occurs through the accidental ingestion of infective larvae in the tissues of other terrestrial mammals, which serve as paratenic hosts. Toxocara canis is the most common cause of toxocariasis in humans." ;
    flat:parents "C125927" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Toxocara canis|Dog Roundworm|TOXOCARA CANIS" ;
.

ncit:C125964
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125964" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125964>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic nematodes in the genus Toxocara where felids are the definitive host.  Paratenic hosts include invertebrates, birds, and rodents. Human infection most commonly occurs in children through accidental ingestion of larvated eggs from a contaminated environment." ;
    flat:parents "C125927" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Toxocara cati|Cat Roundworm|Feline Roundworm|TOXOCARA CATI" ;
.

ncit:C125965
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125965" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125965>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic nematodes in the genus Trichinella that is found worldwide. There are four region-specific subspecies that have different carnivorous animal hosts. Trichinosis infection may occur through the ingestion of raw or undercooked animal tissue that contains encysted larvae. The larvae invade intestinal mucosa, where sexual maturation occurs. Female nematodes penetrate the mucosa and larvae travel through the bloodstream to penetrate and encyst in muscle tissue." ;
    flat:parents "C125928" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Trichinella spiralis|TRICHINELLA SPIRALIS" ;
.

ncit:C125966
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125966" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125966>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of green-spored ascomycetes fungi in the family Hypocreaceae where nonseptate conidia are produced on two- or three-branched conidiophores. Trichoderma is present in all soil.  Some species are pathogenic to other fungi and others have reportedly caused opportunistic infection in immune-compromised humans, particularly children." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Trichoderma|TRICHODERMA" ;
.

ncit:C125967
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125967" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125967>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of flagellated protozoan parasite in the genus Trichomonas that resides in the genitourinary tract of both male and female humans, which are the only natural hosts. Transmission occurs through sexual intercourse, and results in trichomonal vaginitis in females or urethral infection in males." ;
    flat:parents "C89825" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Trichomonas vaginalis|TRICHOMONAS VAGINALIS" ;
.

ncit:C125968
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125968" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125968>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic roundworms in the family Trichostrongylidae that infest horses and ruminants, causing anorexia, persistent diarrhea, and weight loss. Adult T. axei are slender, measuring up to 8 mm long, and are usually found in the stomach of infected animals. Humans are rarely infected." ;
    flat:parents "C125930" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Trichostrongylus axei|TRICHOSTRONGYLUS AXEI" ;
.

ncit:C125969
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125969" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125969>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic roundworms in the family Trichostrongylidae that causes black scour disease in sheep, cattle, and goats." ;
    flat:parents "C125930" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Trichostrongylus colubriformis|Bankrupt Worm|Black Scour Worm|TRICHOSTRONGYLUS COLUBRIFORMIS" ;
.

ncit:C12597
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12597" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12597>" ;
    flat:definition "Gametes, also known as sex cells or germ cells, are the cells that come together during fertilization or conception in organisms that reproduce sexually.  Their genetic complement consists of a single set of unpaired chromosomes." ;
    flat:display%20name "Germ Cells" ;
    flat:parents "C12508" ;
    flat:semantic%20type "Cell" ;
    flat:synonyms "Germ Cell|Gamete|Gametes|Germ Cells|Reproductive Cells|Sex Cell|Sexual Cell|germ cell|reproductive cell" ;
.

ncit:C125970
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125970" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125970>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic roundworms in the family Trichostrongylidae that is most prevalent in Asian countries." ;
    flat:parents "C125930" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Trichostrongylus orientalis|TRICHOSTRONGYLUS ORIENTALIS" ;
.

ncit:C125971
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125971" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125971>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic roundworms in the family Trichostrongylidae that most often infests sheep, goats, and camels." ;
    flat:parents "C125930" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Trichostrongylus probolurus|TRICHOSTRONGYLUS PROBOLURUS" ;
.

ncit:C125972
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125972" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125972>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic roundworms in the family Trichostrongylidae that most often infests sheep, goats, camel, deer, and rabbits and are mostly found in the proximal third of the small intestine." ;
    flat:parents "C125930" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Trichostrongylus vitrinus|TRICHOSTRONGYLUS VITRINUS" ;
.

ncit:C125973
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125973" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125973>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic roundworms in the family Trichuridae most commonly found in tropical Asia and, to a lesser degree, in Africa and South America. Infestation with T. trichiura is generally confined to the cecum and colon but can be present in more distal segments of the GI tract in heavily infected individuals." ;
    flat:parents "C125929" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Trichuris trichiura|Human Whipworm|TRICHURIS TRICHIURA" ;
.

ncit:C125974
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125974" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125974>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of anamorphic molds in the phylum Basidiomycota characterized by the zig-zag shape of the fertile portions of the conidiogenous cells and the absence of distinct denticles. Tritirachium species are hyphal in culture and the colonies are colored in shades ranging from pale pinkish or lilac to brown." ;
    flat:parents "C77169" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Tritirachium|TRITIRACHIUM" ;
.

ncit:C125975
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125975" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125975>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic flagellate protozoa in the order Kinetoplastida. T. b. gambiense is transmitted by the tsetse fly and causes West African trypanosomiasis. Humans are the main reservoir for T. b. gambiense, but this species can also be found in animals." ;
    flat:parents "C125931" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Trypanosoma brucei gambiense|TRYPANOSOMA BRUCEI GAMBIENSE" ;
.

ncit:C125976
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125976" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125976>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic flagellate protozoa in the order Kinetoplastida. T. b. rhodesiense is transmitted by the tsetse fly and causes East African trypanosomiasis. Wild game animals are the main reservoir of T. b. rhodesiense." ;
    flat:parents "C125931" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Trypanosoma brucei rhodesiense|TRYPANOSOMA BRUCEI RHODESIENSE" ;
.

ncit:C125977
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125977" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125977>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic euglenoid protozoan in the family Trypanosomatidae. T. cruzi is passed between mammalian hosts through the feces of a triatomine insect vector. Infection in humans causes Chagas disease." ;
    flat:parents "C125931" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Trypanosoma cruzi|TRYPANOSOMA CRUZI" ;
.

ncit:C125978
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125978" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125978>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of saprophytic fungi in the family Pleosporaceae with numerous, usually solitary, multicelled conidia that are typically obovoid, dark brown, and often rough-walled. Ulocladium species are commonly found in the soil and on decaying herbaceous plants but they also grown indoors on cellulose containing materials." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Ulocladium|ULOCLADIUM" ;
.

ncit:C125979
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125979" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125979>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of smut fungi in the phylum Basidiomycota with a branched, septate, hyaline, intercellular mycellium, with or without haustoria. Species in this genus infect the floral parts of wheat, barley, oat, maize, sugarcane, rye and wild grasses." ;
    flat:parents "C77169" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Ustilago|USTILAGO" ;
.

ncit:C125980
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125980" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125980>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Strains of Staphylococcus aureus that are not readily killed by vancomycin antibiotics. Vancomycin resistance is acquired by mutation and thickening of the cell wall due to accumulation of excess amounts of peptidoglycan." ;
    flat:parents "C50921" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Vancomycin Resistant Staphylococcus Aureus|STAPHYLOCOCCUS AUREUS, VANCOMYCIN RESISTANT|VRSA|Vancomycin-Resistant Staphylococcus Aureus|Vancomycin-resistant Staphylococcus aureus" ;
.

ncit:C125981
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125981" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125981>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A non-taxonomic grouping of enterococcus species that are sensitive to vancomycin antibiotics." ;
    flat:parents "C76311" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Vancomycin Susceptible Enterococcus|VANCOMYCIN SUSCEPTIBLE ENTEROCOCCUS|VSE|Vancomycin-Susceptible Enterococcus" ;
.

ncit:C125982
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C125982" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125982>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of nonmotile, non-spore-forming, anaerobic, Gram negative, cocci shaped bacteria in the family Veillonellaceae. This species is a normal part of human oral microbiota." ;
    flat:parents "C86837" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Veillonella atypica|VEILLONELLA ATYPICA|Veillonella parvula subsp. atypica" ;
.

ncit:C125983
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
