    flat:definition "A disease that has spread beyond its primary site to nearby tissues and body structures." ;
    flat:parents "C209927" ;
    flat:semantic%20type "Finding" ;
    flat:synonyms "Locally Advanced Disease|DISEASE BECAME LOCALLY ADVANCED" ;
.

