    flat:parents "C81183" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Methionine Measurement|MET|Methionine|Methionine" ;
.

ncit:C122239
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122239" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122239>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of nematodes in the family Ancylostomatidae. A. braziliense infects domestic dogs and cats, wild canids, and occasionally humans. It is endemic in the southern United States." ;
    flat:parents "C120705" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Ancylostoma braziliense|ANCYLOSTOMA BRAZILIENSE|Ancylostoma ceylanicum|Ancylostoma ceylonicum" ;
.

ncit:C122240
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122240" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122240>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of nematodes in the family Ancylostomatidae. A. caninum infects domestic dogs and wild canids. It occasionally infects cats and humans. It is largely restricted to temperate, tropical, and sub-tropical regions." ;
    flat:parents "C120705" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Ancylostoma caninum|ANCYLOSTOMA CANINUM|Dog Hookworm" ;
.

ncit:C122241
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122241" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122241>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of nematodes in the family Ancylostomatidae. A. duodenale infects humans, cats, and dogs. The species is most commonly found in the Mediterranean region, Southeast Asia, and scattered in the Southern Americas." ;
    flat:parents "C120705" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Ancylostoma duodenale|ANCYLOSTOMA DUODENALE|European Hookworm|Old World Hookworm" ;
.

ncit:C122242
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122242" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122242>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic nematode in the family Angiostrongylidae. A. cantonensis causes eosinophilic meningitis and is prevalent in Southeast Asia and tropical Pacific islands." ;
    flat:parents "C122042" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Angiostrongylus cantonensis|ANGIOSTRONGYLUS CANTONENSIS|Rat Lungworm" ;
.

ncit:C122243
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122243" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122243>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic nematode in the family Anisakidae. A. simplex is the causative agent of anisakiasis." ;
    flat:parents "C122043" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Anisakis simplex|ANISAKIS SIMPLEX|Herring Worm" ;
.

ncit:C122244
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122244" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122244>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A non-taxanomic grouping of bacteria that have been assigned to the Aspergillus genus and are morphologically and physiologically similar to Aspergillus flavus." ;
    flat:parents "C77180" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Aspergillus Flavus Complex|ASPERGILLUS FLAVUS COMPLEX" ;
.

ncit:C122245
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122245" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122245>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A non-taxanomic grouping of bacteria that have been assigned to the Aspergillus genus and are morphologically and physiologically similar to Aspergillus fumigatus." ;
    flat:parents "C77180" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Aspergillus Fumigatus Complex|ASPERGILLUS FUMIGATUS COMPLEX" ;
.

ncit:C122246
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122246" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122246>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|CDISC SEND Microscopic Findings Result Modifier Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of ciliated intestinal protozoan parasites in the family Balantiididae. Infection occurs by ingestion of a cyst, with the motile trophozoite residing in the large intestine. B. coli is the largest protozoan that infects humans." ;
    flat:parents "C122015" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Balantidium coli|BALANTIDIUM COLI|Paramecium coli" ;
.

ncit:C122247
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122247" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122247>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of a Gram-positive, anaerobic, rod-shaped bacterium in the family Bifidobacteriaceae. B. animalis does not ferment alpha-l-fucose, D-glucuronate, amylose, arabinogalactan, porcine gastric mucin, arabic gum, ghatti gum, or tragacanth gum. This bacteria is a normal part of the gut flora and is frequently used as a probiotic." ;
    flat:parents "C86194" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bifidobacterium animalis|BIFIDOBACTERIUM ANIMALIS" ;
.

ncit:C122248
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122248" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122248>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A bacterial species in the family Bifidobacteriaceae. B. breve ferments alpha-l-fucose but does not ferment D-blucuronate, arabinogalactan, xylan, porcine gastric mucin, or gums. This bacteria is a normal part of the gut flora and is frequently used as a probiotic." ;
    flat:parents "C86194" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bifidobacterium breve|BIFIDOBACTERIUM BREVE|Bifidobacterium parvulorum" ;
.

ncit:C122249
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122249" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122249>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A bacterial species in the family Bifidobacteriaceae. B. pseudocatenulatum hydrolyzes phytate and ferments amylopectin and amylose and does not ferment D-galactosamine, D-glucuronate, arabinogalactan, pectin, or gums. This bacteria is a normal part of the gut flora and is frequently used as a probiotic." ;
    flat:parents "C86194" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bifidobacterium pseudocatenulatum|BIFIDOBACTERIUM PSEUDOCATENULATUM" ;
.

ncit:C122250
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122250" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122250>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of moderately fast growing dematiaceous fungi in the family Pleosporaceae with straight, fusiform to ellipsoidal pseudoseptate conidia. The genus contains about 45 species which are mostly subtropical and tropical plant parasites; however several species, notably B. australiensis, B. hawaiiensis, and B. spicifera are well documented human pathogens." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Bipolaris|BIPOLARIS" ;
.

ncit:C122251
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122251" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122251>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of protozoan parasites in the family Blastocystidae. External transmission of B. hominis is believed to occur by infection with a cyst. The cysts infect epithelial cells of the digestive tract and multiply asexually." ;
    flat:parents "C122016" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Blastocystis hominis|BLASTOCYSTIS HOMINIS" ;
.

ncit:C122252
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122252" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122252>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-negative, anaerobic, spiral-shaped bacteria in the family Spirochaetaceae. B. miyamotoi can be transferred to humans through the bite of an infected tick and is the causative agent of Borrelia miyamotoi disease, a relapsing fever." ;
    flat:parents "C86206" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Borrelia miyamotoi|BORRELIA MIYAMOTOI" ;
.

ncit:C122253
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122253" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122253>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, rod-shaped bacteria in the family Enterobacteriaceae. B. ferragutiae is positive for lysine decarboxylase and D-sorbitol metabolism and negative for ketogluconate and malonate activity. It was originally isolated from soil." ;
    flat:parents "C86228" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Buttiauxella ferragutiae|BUTTIAUXELLA FERRAGUTIAE|CDC Enteric Group 63" ;
.

ncit:C122254
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122254" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122254>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, rod-shaped bacteria in the family Enterobacteriaceae. B. gaviniae is positive for arginine dihydrolase, 5-ketogluconate, and palatinose reactions and negative for ornithine decarboxylase and raffinose reactions." ;
    flat:parents "C86228" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Buttiauxella gaviniae|BUTTIAUXELLA GAVINIAE|CDC Enteric Group 64" ;
.

ncit:C122255
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122255" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122255>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, rod-shaped bacteria in the family Enterobacteriaceae. B. noackiae is positive for N-acetyl-L-glutamine, L-arginine dihydrolase, melibiose, and L-ornithine decarboxylase." ;
    flat:parents "C86228" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Buttiauxella noackiae|BUTTIAUXELLA NOACKIAE|CDC Enteric Group 59" ;
.

ncit:C122256
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122256" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122256>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic nematodes in the family Capillariidae. C. hepaticum causes hepatic capillariasis in rodents and other mammals. Its life cycle is completed in a single host species but the eggs must mature outside of the host body prior to infecting a new host." ;
    flat:parents "C122044" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Calodium hepaticum|CALODIUM HEPATICUM|Capillaria hepatica" ;
.

ncit:C122257
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122257" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122257>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic nematodes in the family Capillariidae. C. philippinensis causes intestinal capillariasis. Its life cycle involves fish as intermediate hosts and fish-eating birds as definitive hosts. Humans acquire C. philippinensis by eating infested fish." ;
    flat:parents "C122044" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Capillaria philippinensis|CAPILLARIA PHILIPPINENSIS|Paracapillaria philippinensis" ;
.

ncit:C122258
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122258" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122258>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of rapidly growing moniliaceous fungi in the family Chaetomiaceae characterized by the production of solitary, hyaline, smooth walled aleurioconidia. Species in this genus are normally found in soil, air, cellulose and plant debris. Some species within the genus are causative agents of infections in immunocompromised individuals." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Chaetomium|CHAETOMIUM" ;
.

ncit:C122259
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122259" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122259>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of nonpathogenic flagellates in the family Retortamonadidae. C. mesnili trophozoites reside in the human cecum and/or colon and transmission occurs by ingestion of cysts." ;
    flat:parents "C122017" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Chilomastix mesnili|CHILOMASTIX MESNILI" ;
.

ncit:C12226
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12226" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12226>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|GDC Terminology|GDC Value Terminology|Mapped ICDO3.1 Terminology|Mapped ICDO3.1 Topography PT Terminology|Mapped ICDO3.1 Topography Terminology|Mapped ICDO3.2 Terminology|Mapped ICDO3.2 Topography PT Terminology|Mapped ICDO3.2 Topography Terminology" ;
    flat:definition "The lining of the fleshy folds surrounding the mouth. It is comprised of the epithelium, basement membrane, lamina propria mucosae, and lamina muscularis mucosae." ;
    flat:display%20name "Mucosa of Lip, NOS" ;
    flat:parents "C77637" ;
    flat:semantic%20type "Tissue" ;
    flat:synonyms "Mucosa of the Lip|Labial Mucosa|MUCOSA OF THE LIP|Mucosa of Lip|Mucosa of lip, NOS|Non-Hair Bearing Lip|labial mucosa" ;
.

ncit:C122260
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122260" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122260>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of of hyaline hyphomycetes fungi in the family Onygenaceae characterized by the production of solitary, hyaline, smooth walled aleurioconidia. Although they are rarely encountered in human skin infections, Chrysosporium species have been identified as an emerging infectious agent in North American snakes." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Chrysosporium|CHRYSOSPORIUM" ;
.

ncit:C122261
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122261" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122261>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of fungi in the family Davidiellaceae with olive-green to brown or black colonies and dark-pigmented conidia that are formed in simple or branching chains. Cladosporium species occur as a plant pathogens and contaminants for other foods and their airborne spores are significant allergens." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Cladosporium|CLADOSPORIUM" ;
.

ncit:C122262
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122262" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122262>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of liver fluke in the class Trematoda. The life cycle of C. sinensis involves freshwater snails, fish, and humans. In humans they are found mainly in the common bile duct and gall bladder where they feed on bile." ;
    flat:parents "C123338" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Clonorchis sinensis|CLONORCHIS SINENSIS|Chinese Liver Fluke|Oriental liver fluke" ;
.

ncit:C122263
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122263" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122263>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of gram-positive, obligate anaerobic bacteria in the family Clostridiaceae. C. aldenense is differentiated from others in the clostridioforme group by exhibiting a positive indole reaction." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium aldenense|CLOSTRIDIUM ALDENENSE" ;
.

ncit:C122264
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122264" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122264>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of gram-positive, obligate anaerobic bacteria in the family Clostridiaceae. C. aldenense is indole positive and produces acid from glucose, maltose, mannose, rhamnose, sucrose, trehalose, and xylose but not from cellobiose, esculin, lactose, mannitol, melezitose, raffinose, salicin, sorbitol, or starch. This species does not hydrolyze urea, esculin, starch, or gelatin or reduce nitrate." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium citroniae|CLOSTRIDIUM CITRONIAE" ;
.

ncit:C122265
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122265" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122265>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of mesophilic and nonmotile bacteria in the family Clostridiaceae. C. oroticum is distinguished by its occurrence as oval Gram-positive cells in chains of 100 or more units and its ability to metabolize orotic acid." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium oroticum|CLOSTRIDIUM OROTICUM|Zymobacterium oroticum" ;
.

ncit:C122266
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122266" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122266>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of helically coiled, obligately anaerobic, non-motile, gram-positive, spore-forming, rod-shaped bacteria in the family Clostridiaceae. Unlike most clostridia, C. spiroforme does not produce butyric acid as an end product of glucose fermentation. The species produces a toxin that is associated with severe diarrhea and enterocolitis in rabbits." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium spiroforme|CLOSTRIDIUM SPIROFORME" ;
.

ncit:C122267
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122267" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122267>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Any rod-shaped, gram-negative, non-spore forming bacteria that is capable of fermenting lactose to produce acid and gas." ;
    flat:parents "C122046" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Coliform Bacteria, Lactose Fermenting|COLIFORM BACTERIA, LACTOSE FERMENTING" ;
.

ncit:C122268
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122268" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122268>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Any rod-shaped, gram-negative, non-spore forming bacteria that is incapable of fermenting lactose to produce acid and gas." ;
    flat:parents "C122046" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Coliform Bacteria, Non-Lactose Fermenting|COLIFORM BACTERIA, NON-LACTOSE FERMENTING" ;
.

ncit:C122269
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122269" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122269>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of non-motile, catalase-positive, non-lipophilic, pleomorphic coryneform bacteria in the family Corynebacteriaceae. C. coyleae is characterized by slow fermentative acid production from glucose but no acid production from maltose and sucrose and a strongly positive CAMP reaction. The species produces acid from fructose, glucose, maltose, and sucrose and is urease-positive." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium coyleae|CORYNEBACTERIUM COYLEAE" ;
.

ncit:C122270
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122270" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122270>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A biovar of Corynebacterium diphtheriae distinguished by its morphogenic and biochemical properties. Biovar gravis is nitrate positive and positive for fermentation of glucose, maltose, and starch. This biovar is one of the two main disease-causing biovars." ;
    flat:parents "C86312" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium diphtheriae bv. gravis|CORYNEBACTERIUM DIPHTHERIAE TYPE GRAVIS" ;
.

ncit:C122271
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122271" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122271>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A biovar of Corynebacterium diphtheriae. Biovar intermedius is nitrate positive and positive for fermentation of glucose and maltose." ;
    flat:parents "C86312" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium diphtheriae bv. intermedius|CORYNEBACTERIUM DIPHTHERIAE TYPE INTERMEDIUS" ;
.

ncit:C122272
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122272" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122272>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A biovar of Corynebacterium diphtheriae. Biovar mitis is nitrate positive and positive for fermentation of glucose and maltose." ;
    flat:parents "C86312" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium diphtheriae bv. mitis|CORYNEBACTERIUM DIPHTHERIAE TYPE MITIS" ;
.

ncit:C122273
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122273" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122273>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A biovar of Corynebacterium diphtheriae distinguished by its morphogenic and biochemical properties. Biovar belfanti is positive for fermentation of glucose and maltose. This biovar is one of the two main disease-causing biovars." ;
    flat:parents "C86312" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium diphtheriae bv. belfanti|CORYNEBACTERIUM DIPHTHERIAE VAR. BELFANTI" ;
.

ncit:C122274
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122274" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122274>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, non-motile, non-spore forming, non-partially acid-fast, gram-positive, coryneform bacteria in the family Corynebacteriaceae. C. mucifaciens is catalase positive, nonfermenting, nitrate reduction negative, and urea and esculin hydrolysis negative; acid was produced from glucose but not from maltose, mannitol, and xylose. The species is nonlipophilic and negative for the CAMP reaction." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium mucifaciens|CORYNEBACTERIUM MUCIFACIENS" ;
.

ncit:C122275
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122275" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122275>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of nonlipophilic, non-motile, fermentative, catalase-positive bacteria in the family Corynebacteriaceae. C. simulans is positive for nitrate and the nitrite reductase test, does not ferment maltose, and is unable to acidify ethylene glycol." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium simulans|CORYNEBACTERIUM SIMULANS" ;
.

ncit:C122276
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122276" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122276>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic protozoa in the family Cryptosporidiidae. C. parvum is one of the main agents of cryptosporidiosis. Transmission occurs mainly through contact with contaminated water and infection is generally self-limiting in immunocompetent individuals." ;
    flat:parents "C77214" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Cryptosporidium parvum|CRYPTOSPORIDIUM PARVUM" ;
.

ncit:C122277
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122277" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122277>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of hyphomycete fungi in the family Pleosporaceae. Members of the genus are normally found in the soil, but are facultative pathogen of many plant species. Three species have been recovered from human infections, principally from cases of mycotic keratitis." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Curvularia|CURVULARIA" ;
.

ncit:C122278
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122278" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122278>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of apicomplexan, cyst-forming coccidian protozoa in the family Eimeriidae. C. cayetanensis appears to be the causative agent of all cases of human cyclosporiasis and humans are its only known host." ;
    flat:parents "C122047" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Cyclospora cayetanensis|CYCLOSPORA CAYETANENSIS|Cyclospora cayetanesis" ;
.

ncit:C122279
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122279" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122279>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of enveloped and spherical positive sense ssRNA viruses in the subfamily Coronavirinae of the family Coronaviridae with a diameter of about 120 nm. Deltacoronaviruses have a nonopartite, linear genome of 26-26.5 kb. Birds are the most common reservoir for deltacoronaviruses." ;
    flat:parents "C26431" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Deltacoronavirus|Coronavirus Group 3|DELTACORONAVIRUS" ;
.

ncit:C12228
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12228" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12228>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|CPTAC Baseline Medical Forms Terminology|CPTAC Head and Neck Squamous Cell Carcinoma Baseline Form|CPTAC Terminology|GDC Terminology|GDC Value Terminology|Mapped ICDO3.1 Terminology|Mapped ICDO3.1 Topography PT Terminology|Mapped ICDO3.1 Topography Terminology|Mapped ICDO3.2 Terminology|Mapped ICDO3.2 Topography PT Terminology|Mapped ICDO3.2 Topography Terminology|mCode Radiotherapy Treatment Location Value Set|mCode Terminology|UBERON Terminology" ;
    flat:definition "The posterior one third of the tongue behind the terminal sulcus that forms the anterior aspect of the oropharynx responsible for swallowing and modification of the voice in speech." ;
    flat:display%20name "Base of Tongue" ;
    flat:parents "C38626|C38617" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Base of Tongue|BASE OF THE TONGUE|Base of the Tongue|Base of tongue|Base of tongue|Base of tongue, NOS|Posterior Tongue|Structure of root of tongue (body structure)|posterior part of tongue" ;
.

ncit:C122280
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122280" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122280>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-negative, non-motile, non-sporulating, rod-shaped bacteria in the family Veillonellaceae. D. micraerophilus is generally anaerobic but will also grow under microaerophilic conditions. It can be differentiated from other Dialister species by phenylalanine arylamidase activity and tyrosine arylamidase activity." ;
    flat:parents "C122009" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Dialister micraerophilus|DIALISTER MICRAEROPHILUS" ;
.

ncit:C122281
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122281" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122281>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-negative, non-fermenting, anaerobic, rod-shaped bacterium in the family Veillonellaceae. The species was first isolated from nasopharyngeal secretions of patients during the flu epidemic of 1918 to 1921." ;
    flat:parents "C122009" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Dialister pneumosintes|Bacillus pneumosintes|Bacteroides pneumosintes|DIALISTER PNEUMOSINTES" ;
.

ncit:C122282
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122282" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122282>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of nonflagellate trichomonad parasites in the family Dientamoebidae. Infections occurs through direct fecal-oral spread. Nonhuman primates are its only natural hosts." ;
    flat:parents "C122010" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Dientamoeba fragilis|DIENTAMOEBA FRAGILIS" ;
.

ncit:C122283
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122283" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122283>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of hematophagous parasitic nematodes in the superfamily Filarioidea. Species in this genus are transmitted by gnats to humans and other vertebrates, producing microfilariae in the blood or tissue fluids. They live as adults in deep connective tissue or on membranes or visceral surfaces." ;
    flat:parents "C14248" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Dipetalonema|DIPETALONEMA" ;
.

ncit:C122284
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122284" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122284>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of tapeworms in the family Diphyllobothriidae. The lifecycle of D. latum involves crustaceans, freshwater fish, and humans. Humans become infested by eating infested fish. The resulting tapeworm is the largest human tapeworm." ;
    flat:parents "C122045" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Diphyllobothrium latum|Broad Fish Tapeworm|DIPHYLLOBOTHRIUM LATUM" ;
.

ncit:C122285
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122285" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122285>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of tapeworms in the family Dipylidiidae. The definitive host for D. caninum is the dog, with intermediate hosts of fleas and chewing lice. Humans can become infected by ingesting an infected flea." ;
    flat:parents "C122045" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Dipylidium caninum|Cucumber Tapeworm|DIPYLIDIUM CANINUM|Double-pore Tapeworm|Flea Tapeworm" ;
.

ncit:C122286
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122286" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122286>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of gram-positive, catalase-negative, non-pigmented, nonmotile, coccus-shaped bacteria in the family Carnobacteriaceae. D. pigrum is positive for pyrrolidonylarylamidase, leucine aminopeptidase, and arginine dehydrogenase." ;
    flat:parents "C122020" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Dolosigranulum pigrum|DOLOSIGRANULUM PIGRUM" ;
.

ncit:C122287
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122287" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122287>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of Gram-positive, obligately anaerobic, non-spore-forming, rod-shaped bacterium in the phylum Firmicutes." ;
    flat:parents "C76197" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Dorea|DOREA" ;
.

ncit:C122288
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122288" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122288>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic nematode in the family Dracunculidae. The lifecycle of D. medinensis involves copepods and humans. Humans become infected by drinking water containing infected copepods." ;
    flat:parents "C122011" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Dracunculus medinensis|DRACUNCULUS MEDINENSIS|Guinea worm" ;
.

ncit:C122289
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122289" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122289>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of cyclophyllid tapeworms in the family Taeniidae. The lifecycle for E. granulosus involves ungulates as the intermediate host and canids as the definitive host. Infestation causes cystic echinococcosis. Humans are not a natural host of the parasite, but in very rare cases can be infected by ingesting eggs from canid feces." ;
    flat:parents "C122025" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Echinococcus granulosus|ECHINOCOCCUS GRANULOSUS|Hydatid Worm|Hyper Tapeworm" ;
.

ncit:C12229
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12229" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12229>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Biospecimens Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|GDC Terminology|GDC Value Terminology|Mapped ICDO3.1 Terminology|Mapped ICDO3.1 Topography PT Terminology|Mapped ICDO3.1 Topography Terminology|Mapped ICDO3.2 Terminology|Mapped ICDO3.2 Topography PT Terminology|Mapped ICDO3.2 Topography Terminology" ;
    flat:definition "The roof of the oral cavity. It separates the oral cavity from the nasal cavity." ;
    flat:display%20name "Palate" ;
    flat:parents "C38617" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Palate|PALATE|Palate, NOS|palate" ;
.

ncit:C122290
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122290" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122290>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of cyclophyllid tapeworms in the family Taeniidae. The lifecycle for E. multilocularis involves rodents as the intermediate host and canids as the definitive host. This species causes alveolar echinococcosis." ;
    flat:parents "C122025" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Echinococcus multilocularis|ECHINOCOCCUS MULTILOCULARIS" ;
.

ncit:C122291
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122291" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122291>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of cyclophyllid tapeworms in the family Taeniidae. Common in the neotropics, E. vogeli has a lifecycle that involves the paca as the intermediate host and the bush dog as the definitive host. This species causes polycystic echinococcosis in humans." ;
    flat:parents "C122025" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Echinococcus vogeli|ECHINOCOCCUS VOGELI" ;
.

ncit:C122292
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122292" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122292>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of tick-borne bacteria in the family Anaplasmataceae. Ehrlichia are obligately intracellular pathogens and are the causative agent of ehrlichiosis." ;
    flat:parents "C76196" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Ehrlichia|Cowdria|EHRLICHIA|Kurlovia|Nicollea" ;
.

ncit:C122293
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122293" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122293>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|CDISC SEND Microscopic Findings Result Modifier Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of single-celled microsporidian fungi in the family Unikaryonidae. Members of the genus are obligate intracellular parasites and were once thought to be protozoans or protists. Encephalitozoonosis is rare in healthy people, but it is a common cause of severe infections in immunocompromised individuals." ;
    flat:parents "C123335" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Encephalitozoon|ENCEPHALITOZOON|Septata" ;
.

ncit:C122294
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122294" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122294>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of amoebozoa in the phylum Archamoebae. Although E. nana is generally considered nonpathogenic it may be a cause of intermittent or chronic diarrhea." ;
    flat:parents "C122018" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Endolimax nana|ENDOLIMAX NANA" ;
.

ncit:C122295
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122295" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122295>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of commensal parasite in the class Archamoebae. E. coli is considered nonpathogenic." ;
    flat:parents "C122048" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Entamoeba coli|ENTAMOEBA COLI" ;
.

ncit:C122296
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122296" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122296>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of commensal parasite in the class Archamoebae. E. hartmanni is considered nonpathogenic. Cysts are transmitted through contaminated food or water." ;
    flat:parents "C122048" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Entamoeba hartmanni|ENTAMOEBA HARTMANNI" ;
.

ncit:C122297
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122297" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122297>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic parasitic protozoa in the class Archamoebae. E. histolytica is the causative agent of invasive amoebiasis. Cysts are transmitted through contaminated food or water." ;
    flat:parents "C122048" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Entamoeba histolytica|ENTAMOEBA HISTOLYTICA" ;
.

ncit:C122298
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122298" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122298>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of commensal parasite in the class Archamoebae. E. polecki is considered nonpathogenic. This species is primarily a parasite of pigs and monkeys, and human infection is more prevalent in areas where the people have animal contact." ;
    flat:parents "C122048" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Entamoeba polecki|ENTAMOEBA POLECKI" ;
.

ncit:C122299
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122299" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122299>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A non-taxonomic grouping of at least six bacterial species that are morphologically similar to the Enterobacter cloacae species." ;
    flat:parents "C76310" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterobacter cloacae Complex|ENTEROBACTER CLOACAE COMPLEX" ;
.

ncit:C12230
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12230" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12230>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Biospecimens Terminology|CDISC SEND Microscopic Findings Result Modifier Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|CPTAC Baseline Medical Forms Terminology|CPTAC Head and Neck Squamous Cell Carcinoma Baseline Form|CPTAC Terminology|GDC Terminology|GDC Value Terminology|Mapped ICDO3.1 Terminology|Mapped ICDO3.1 Topography PT Terminology|Mapped ICDO3.1 Topography Terminology|Mapped ICDO3.2 Terminology|Mapped ICDO3.2 Topography PT Terminology|Mapped ICDO3.2 Topography Terminology|mCode Radiotherapy Treatment Location Value Set|mCode Terminology|UBERON Terminology" ;
    flat:definition "The bony anterior part of the roof of the mouth separating the nose from the mouth." ;
    flat:display%20name "Hard Palate" ;
    flat:parents "C38617" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Hard Palate|HARD PALATE|Hard palate|Hard palate|Hard palate structure (body structure)|PALATE, HARD|PALATE, HARD|hard palate|hard palate|palatum durum" ;
.

ncit:C122300
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122300" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122300>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic pinworms in the family Oxyuridae. Infestation with E. vermicularis causes enterobiasis in humans. Its entire lifecycle takes place in the gastrointestinal tract of a single human host." ;
    flat:parents "C122012" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Enterobius vermicularis|ENTEROBIUS VERMICULARIS" ;
.

ncit:C122301
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122301" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122301>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-positive, catalase-negative, facultatively anaerobic, fermentative, non-motile, coccus-shaped bacteria in the family Enterococcaceae." ;
    flat:parents "C76311" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterococcus saccharolyticus|ENTEROCOCCUS SACCHAROLYTICUS|Streptococcus saccharolyticus" ;
.

ncit:C122302
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122302" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122302>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of microsporidian fungi in the family Enterocytozoonidae. Members of the genus are obligate intracellular parasites, infectibg intestinal epithelial cells. Cases of intestinal microsporidiosis due to Enterocytozoon are sometimes seen in immunocompromised individuals." ;
    flat:parents "C123335" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Enterocytozoon|ENTEROCYTOZOON" ;
.

ncit:C122303
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122303" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122303>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of nonpathogenic flagellate protozoa in the family Enteromonadidae. Trophozoites reside in the large intestine of humans, primates, and rodents, and infection occurs after the ingestion of cysts in fecal-contaminated food or water." ;
    flat:parents "C122019" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Enteromonas hominis|ENTEROMONAS HOMINIS" ;
.

ncit:C122304
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122304" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122304>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of dematiaceous mitosporic fungi in the family Pleosporaceae. Members of the genus are normally found in soil, plant litter, decaying plants, or damaged plant tissue, but may also occur on building materials. Epicoccum infection in humans or animals has not been documented." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Epicoccum|EPICOCCUM" ;
.

ncit:C122305
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122305" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122305>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Any strain of Escherichia coli that is resistant to penicillins, cephalosporins, and aztreonam. These strains are often cross-resistant to trimethoprim/sulfamethoxazole and quinolones." ;
    flat:parents "C14206" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Escherichia coli, Extended-spectrum Beta-lactamase Positive|ESCHERICHIA COLI, ESBL|Escherichia coli, Extended-spectrum Beta-lactamases" ;
.

ncit:C122306
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122306" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122306>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of asexual dematiaceous fungi in the family Pleosporaceae which produces conidia with an exserted hilum. Members of the genus live on plant material like grasses, rotten wood, and in the soil, but three species have been identified as human pathogens." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Exserohilum|EXSEROHILUM" ;
.

ncit:C122307
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122307" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122307>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of gram-positive, catalase-negative, facultatively anaerobic, coccus-shaped bacteria in the family Firmicutes. F. hominis is a normal part of the female genital tract flora but may act as an opportunistic pathogen." ;
    flat:parents "C86392" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Facklamia hominis|FACKLAMIA HOMINIS" ;
.

ncit:C122308
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122308" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122308>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of flatworms in the family Fasciolidae. The life cycle of F. hepatica involves snails as the intermediate host and humans and herbivores as the definitive host. Infection usually occurs through consumption of contaminated water plants." ;
    flat:parents "C122021" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Fasciola hepatica|FASCIOLA HEPATICA|Sheep liver fluke" ;
.

ncit:C122309
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122309" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122309>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic tremadoda flatworms in the family Fasciolidae. The life cycle of F. buski involes snails as the intermediate host and pigs and humans as the definitive host. It is the largest intestinal fluke of humans." ;
    flat:parents "C122022" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Fasciolopsis buski|FASCIOLOPSIS BUSKI" ;
.

ncit:C12231
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12231" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12231>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Biospecimens Terminology|CDISC SEND Microscopic Findings Result Modifier Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|GDC Terminology|GDC Value Terminology|Mapped ICDO3.1 Terminology|Mapped ICDO3.1 Topography PT Terminology|Mapped ICDO3.1 Topography Terminology|Mapped ICDO3.2 Terminology|Mapped ICDO3.2 Topography PT Terminology|Mapped ICDO3.2 Topography Terminology|mCode Radiotherapy Treatment Location Value Set|mCode Terminology|UBERON Terminology" ;
    flat:definition "The muscular extension of the hard palate which comprises the posterior of the oral cavity and the floor of the nasal cavity." ;
    flat:display%20name "Soft Palate" ;
    flat:parents "C38617" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Soft Palate|PALATE, SOFT|PALATE, SOFT|SOFT PALATE|Soft palate structure (body structure)|Soft palate, NOS|soft palate|soft palate" ;
.

ncit:C122310
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122310" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122310>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of strictly anaerobic, Gram-variable, bacillus-shaped bacteria with variable motility in the family Firmicutes. Bacteria in the genus are asaccharolytic and weakly fermentative on glucose, fructose, and ribose." ;
    flat:parents "C76197" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Flavonifractor|FLAVONIFRACTOR" ;
.

ncit:C122311
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122311" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122311>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of soil fungi in the family Herpotrichiellaceae characterized by indistinct melanised conidiophores with blunt, scattered denticles bearing conidia singly or in short chains that eventually become branched. Both species in this genus can cause chromoblastomycosis following skin damage." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Fonsecaea|FONSECAEA" ;
.

ncit:C122312
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122312" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122312>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of non-motile bacteria in the family Fusobacteriaceae. F. periodonticum is characterized by its ability to ferment only on glucose, fructose, and galactose and an ability to hydrolyze hippurate." ;
    flat:parents "C76323" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Fusobacterium periodonticum|FUSOBACTERIUM PERIODONTICUM" ;
.

ncit:C122313
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122313" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122313>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of enveloped and spherical positive sense ssRNA viruses in the subfamily Coronavirinae of the family Coronaviridae with a diameter of about 120 nm. Gammacoronaviruses have a nonopartite, linear genome of 27-32 kb. Birds are the most common reservoir for gammacoronaviruses." ;
    flat:parents "C26431" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Gammacoronavirus|Coronavirus group 3|GAMMACORONAVIRUS" ;
.

ncit:C122314
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122314" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122314>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Either of two genera of filamentous fungi in the phylum Ascomycota that are characterized by conidiophores bearing branched clusters of small oval- or pear-shaped arthroconidia. Geomyces destructans is the causative agent of white-nose syndrome in hibernating bats." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Geomyces|GEOMYCES" ;
.

ncit:C122315
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122315" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122315>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of fungi in the family Endomycetaceae, found in soil and water and characterized by chains of hyaline, smooth, one-celled, subglobose to cylindrical, slimy arthroconidia. Species within Geotrichum are the causative agents of geotrichosis." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Geotrichum|GEOTRICHUM" ;
.

ncit:C122316
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122316" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122316>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of flagellated protozoan parasite in the family Hexamitidae. It is the causative agent of giardiasis." ;
    flat:parents "C77213" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Giardia lamblia|GIARDIA LAMBLIA|Giardia duodenalis|Giardia intestinalis|Lamblia intestinalis" ;
.

ncit:C122317
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122317" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122317>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of asexual fungi in the family Hypocreaceae characterized by hyphae, conidiophores, and conidia borne from hyaline phialides. Gliocladium is not known to be pathogenic in humans or animals." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Gliocladium|GLIOCLADIUM" ;
.

ncit:C122318
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122318" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122318>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic nematodes in the family Gnathostomatidae. The life cycle of G. spinigerum involves copepods of the genus Cyclops as the first intermediate host, freshwater fish as the second intermediate host, and canine and feline species, and possibly pigs, as the the definitive hosts." ;
    flat:parents "C122023" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Gnathostoma spinigerum|GNATHOSTOMA SPINIGERUM" ;
.

ncit:C122319
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122319" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122319>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Any bacteria with a shape between that of a sphere and a rod that contains low levels of peptidoglycan in its cell wall and stains pink with the Gram staining technique." ;
    flat:parents "C173514" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Gram-Negative Coccobacillus|GRAM-NEGATIVE COCCOBACILLUS" ;
.

ncit:C12232
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
