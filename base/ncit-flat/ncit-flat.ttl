    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123537>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic Gram-negative coccobacillus in the family Rhodobacteraceae. This species is catalase and oxidase positive and can reduce nitrate. P. yeei is found naturally in soil and brines and has be identified as an unusual etiologic opportunistic agent of peritonitis." ;
    flat:parents "C123337" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Paracoccus yeei|CDC Group EO-2|PARACOCCUS YEEI" ;
.

ncit:C123538
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123538" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123538>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic flatworms in the family Troglotrematidae. The lifecycle of P. westermani involves freshwater snails as the first intermediate host, freshwater crustaceans as the second intermediate host, and humans or cats as the definitive host. Infestation causes paragonimiasis." ;
    flat:parents "C123338" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Paragonimus westermani|Japanese Lung Fluke|Oriental Lung Fluke|PARAGONIMUS WESTERMANI" ;
.

ncit:C123539
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123539" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123539>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram positive, facultatively anaerobic, non-motile, non-spore forming, cocci shaped bacterium in the family Lactobacillaceae. This species possesses a strictly fermentative metabolism with lactic acid as the major metabolic end product. P. pentosaceus can be found in plant materials, ripened cheese, and a variety of processed meats." ;
    flat:parents "C86641" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Pediococcus pentosaceus|PEDIOCOCCUS PENTOSACEUS|Pediococcus hennebergii" ;
.

ncit:C12354
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12354" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12354>" ;
