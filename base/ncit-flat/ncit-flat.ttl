    flat:code "C125931" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125931>" ;
    flat:definition "A genus of kinetoplastid, unicellular, parasitic flagellate protozoa in the phylum Euglenozoa. Most trypanosomes are heteroxenous, requiring more than one obligatory host to complete its life cycle." ;
    flat:parents "C77916" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Trypanosoma|Trypanosome" ;
.

