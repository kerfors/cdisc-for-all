    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A subtype of Staphylococcus characterized by an inability to produce free plasma coagulase." ;
    flat:parents "C62583" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Coagulase-Negative Staphylococcus|CNS|COAGULASE NEGATIVE STAPHYLOCOCCUS|CONS" ;
.

