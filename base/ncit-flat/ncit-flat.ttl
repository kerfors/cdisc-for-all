ncit:C13252
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C13252" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13252>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A clear, transparent, sometimes faintly yellow and slightly opalescent fluid that is collected from the tissues throughout the body, flows in the lymphatic vessels (through the lymph nodes), and is eventually added to the venous blood circulation. Lymph consists of a clear liquid portion, varying numbers of white blood cells (chiefly lymphocytes), and a few red blood cells." ;
    flat:parents "C13236" ;
    flat:semantic%20type "Body Substance" ;
    flat:synonyms "Lymph|LYMPH|Reticuloendothelial System, Lymph|lymph|lymphatic fluid" ;
.

