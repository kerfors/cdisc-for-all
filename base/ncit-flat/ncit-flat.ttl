    flat:semantic%20type "Tissue" ;
    flat:synonyms "Subcutis|SUBCUTIS|Subcutaneous Adipose Tissue|Subcutaneous Tissue|Subcutaneous Tissue|Subcutaneous Tissue|Subcutaneous Tissue|hypodermis" ;
.

