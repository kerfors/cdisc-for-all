    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13272>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Biospecimens Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology|GDC Terminology|GDC Value Terminology|Mapped ICDO3.1 Terminology|Mapped ICDO3.1 Topography PT Terminology|Mapped ICDO3.1 Topography Terminology|Mapped ICDO3.2 Terminology|Mapped ICDO3.2 Topography PT Terminology|Mapped ICDO3.2 Topography Terminology|mCode Genomic Specimen Type Value Set|mCode Terminology|UBERON Terminology" ;
    flat:definition "An organ present in some vertebrates during embryonic gestation that surrounds the fetus and provides it with nutrients and oxygen, facilitates gas and waste exchange between the fetus and mother, and provides parasitic cloaking from the mother's immune system by excretion of neurokinin B." ;
    flat:parents "C34055" ;
    flat:semantic%20type "Embryonic Structure" ;
    flat:synonyms "Placenta|PLACENTA|Placental|allantoic placenta|eutherian placenta|placenta|placenta" ;
.

ncit:C13273
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C13273" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13273>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Pulmonary surfactant lines the lung epithelium and lowers surface tension to prevent collapse at end-expiration. Deficiency of pulmonary surfactant results in respiratory distress syndrome (RDS) in premature infants. Lung surfactant is synthesized in alveolar type II cells, stored in lamellar bodies and secreted via exocytosis." ;
    flat:parents "C13722" ;
    flat:semantic%20type "Body Substance" ;
    flat:synonyms "Lung Surfactant|LUNG SURFACTANT|Surfactant|Surfactant, Lung" ;
.

ncit:C13275
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
