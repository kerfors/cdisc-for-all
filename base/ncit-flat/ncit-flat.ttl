ncit:C221633
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C221633" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C221633>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An assay that is used to determine whether neutralizing antibodies that are present in a biological specimen can block microbial infection/proliferation ex vivo, by assessing the amount/level of metabolism (in the form of carbon dioxide production) of surviving cells." ;
    flat:parents "C150876" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Metabolic Inhibition Assay|METABOLIC INHIBITION ASSAY|Micrometabolic inhibition Assay" ;
.

ncit:C221634
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C221634" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C221634>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A diagrammatic method to test visual acuity that uses the letter 'E' pointing in different directions at 90 degree angles to each other." ;
    flat:parents "C123467" ;
    flat:semantic%20type "Diagnostic Procedure" ;
    flat:synonyms "Snellen E Optotype Chart|E CHART EYE CHART|Tumbling E Chart" ;
.

ncit:C221635
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C221635" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C221635>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A diagrammatic method to test visual acuity in individuals that may have difficulty reading letters or numbers, which uses four symbols: house; apple; circle; and square." ;
    flat:parents "C156778" ;
    flat:semantic%20type "Diagnostic Procedure" ;
    flat:synonyms "Lea Symbols Eye Chart|LEA SYMBOLS EYE CHART" ;
.

ncit:C221636
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C221636" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C221636>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A type of multiplex immunoassay that utilizes pairs of oligonucleotide-labeled antibodies to detect and quantify proteins in a sample. In this assay, the antibodies bind to their target proteins, and when in close proximity, the oligonucleotides are extended and amplified through a polymerase reaction. The resulting DNA products are then quantified using real-time PCR, allowing for sensitive and specific measurement of protein levels in complex biological samples." ;
    flat:parents "C18962" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Proximity Extension Assay|Olink PEA|PEA|PROXIMITY EXTENSION ASSAY" ;
.

ncit:C221637
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C221637" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C221637>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An assay to evaluate the bactericidal activity of antibodies present in serum by measuring the ability of complement and antibodies to lyse bacteria. This is performed by incubating a defined concentration of bacteria with various dilutions of serum and complement, followed by quantifying the percent bacterial survival relative to serum-negative controls. The assay assesses the functional capacity of antibodies to mediate bacterial killing through complement activation." ;
    flat:parents "C150876" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Serum Bactericidal Assay|Complement-Dependent Bactericidal Assay|SBA Assay|SERUM BACTERICIDAL ASSAY|Serum Bactericidal Antibody Assay" ;
.

