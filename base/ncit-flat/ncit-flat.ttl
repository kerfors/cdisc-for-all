    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86467>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of Gram positive, cocci shaped bacterium assigned to the phylum Actinobacteria and the family Micrococcaceae." ;
    flat:parents "C85946" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kocuria|KOCURIA" ;
.

ncit:C86468
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86468" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86468>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, cocci shaped bacteria assigned to the phylum Actinobacteria. This species is oxidase positive, nonencapsulated, non spore forming and hydrolyzes esculin. K. kristinae is part of the normal flora of the skin but may have pathogenic potential in surgical patients." ;
    flat:parents "C86467" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kocuria kristinae|KOCURIA KRISTINAE|Micrococcus kristinae|Micrococcus kristinae" ;
.

ncit:C86469
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86469" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86469>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram positive, cocci shaped bacteria assigned to the phylum Actinobacteria. This species is oxidase and indole negative, nonencapsulated, non spore forming, nonhemolytic, benzidine positive and saprophytic. K. rosea is part of the normal flora of the skin but may have pathogenic potential in surgical patients." ;
    flat:parents "C86467" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kocuria rosea|KOCURIA ROSEA" ;
.

ncit:C86470
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86470" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86470>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram positive, cocci shaped bacteria assigned to the phylum Actinobacteria. This species is oxidase negative, urease, nitrate and nitrite reductase positive, forms yellow colonies in culture, nonencapsulated and non spore forming. K. varians is part of the normal flora of the skin but may have pathogenic potential in surgical patients." ;
    flat:parents "C86467" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kocuria varians|KOCURIA VARIANS" ;
.

ncit:C86471
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86471" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86471>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of nonspore forming, aerobic, gram positive bacterium assigned to the phylum Firmicutes and the family Planococcaceae." ;
    flat:parents "C85954" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kurthia|KURTHIA" ;
.

ncit:C86472
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86472" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86472>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram positive, cocci shaped bacterium assigned to the phylum Actinobacteria and the family Dermacoccaceae." ;
    flat:parents "C85929" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kytococcus|KYTOCOCCUS" ;
.

ncit:C86473
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86473" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86473>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, cocci shaped bacteria assigned to the phylum Actinobacteria. This species is nonencapsulated, nonendosporeforming, nonmotile, catalase positive, oxidase negative and hydrolyzes gelatin. K. sedentarius is rarely part of the normal flora of the skin and is mostly pathogenic, being the causative agent of pitted keratolysis." ;
    flat:parents "C86472" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kytococcus sedentarius|KYTOCOCCUS SEDENTARIUS" ;
.

ncit:C86474
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86474" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86474>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|NCI Drug Dictionary Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is nonmotile, homofermentative, indole negative, produces vitamin K, lactase and amylase and does not ferment mannitol. L. acidophilus is a commensal organism of the gastrointestinal tract, mouth and vagina with probiotic activity." ;
    flat:parents "C76352" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Lactobacillus acidophilus|LACTOBACILLUS ACIDOPHILUS" ;
.

ncit:C86475
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86475" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86475>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic/microaerophilic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is nonmotile, ferments D ribose, galactose, arabinose and maltose, catalase positive, does not ferment mannose and hydrolyzes hippurate. L. brevis is non pathogenic but may be a concern for brewers due to its beer and wine spoilage ability." ;
    flat:parents "C76352" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Lactobacillus brevis|LACTOBACILLUS BREVIS" ;
.

ncit:C86476
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86476" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86476>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is nonmotile, heterofermentative, amylase positive and ferments mannitol. L. casei is non pathogenic and a commensal organism of the mouth and digestive tract." ;
    flat:parents "C76352" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Lactobacillus casei|LACTOBACILLUS CASEI" ;
.

ncit:C86477
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86477" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86477>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is homofermentative and catalase negative. L. catenaformis is found in the intestinal and pulmonary cavities." ;
    flat:parents "C76352" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Lactobacillus catenaformis|LACTOBACILLUS CATENAFORMIS|Lactobacillus catenaforme|Lactobacillus catenaforme" ;
.

ncit:C86478
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86478" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86478>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is nonmotile, ferments L arabinose, esculin and sucrose, catalase negative and alpha galactosidase positive. L. fermentum is a commensal organism of the urogenital tract with probiotic activity." ;
    flat:parents "C76352" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Lactobacillus fermentum|LACTOBACILLUS FERMENTUM|Lactobacillus cellobiosus" ;
.

ncit:C86479
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86479" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86479>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is nonmotile, produces DL Lactic Acid from glucose fermentation, catalase negative, and does not produce acid from trehalose. L. gallinarum is a commensal organism of the gastrointestinal tract." ;
    flat:parents "C76352" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Lactobacillus gallinarum|LACTOBACILLUS GALLINARUM" ;
.

ncit:C86480
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86480" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86480>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is obligately homofermentative, requires pyridoxal for growth in culture and ferments trehalose and esculin but not lactose. L. jensenii is a colonizer of the healthy vaginal tract and inhibits the growth of gonococcal organisms therein, but may be pathogenic in immunocompromised individuals." ;
    flat:parents "C76352" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Lactobacillus jensenii|LACTOBACILLUS JENSENII" ;
.

ncit:C86481
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86481" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86481>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is nonmotile, catalase negative, produces acid from trehalose, nonsporeforming and produces lactic acid. L. johnsonii is a commensal organism of the upper gastrointestinal tract with probiotic activity." ;
    flat:parents "C76352" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Lactobacillus johnsonii|LACTOBACILLUS JOHNSONII" ;
.

ncit:C86482
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86482" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86482>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is nonmotile, non spore forming, nitrate negative and does not hydrolyze esculin or hippurate. L. salivarius is a commensal organism of the oral cavity." ;
    flat:parents "C76352" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Lactobacillus salivarius|LACTOBACILLUS SALIVARIUS" ;
.

ncit:C86483
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86483" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86483>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of Gram positive, cocci shaped, lactic acid bacterium assigned to the phylum Firmicutes and the family Streptococcaceae." ;
    flat:parents "C85967" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Lactococcus|Doederlein bacillus|Doederlein bacillus|LACTOCOCCUS" ;
.

ncit:C86484
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86484" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86484>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, cocci shaped bacteria assigned to the phylum Firmicutes. This species is nonmotile, catalase and cytochrome oxidase negative, nonsporulating, and alpha hemolytic on blood agar. L garvieae is a zoonotic pathogen, especially in fish." ;
    flat:parents "C86483" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Lactococcus garvieae|LACTOCOCCUS GARVIEAE" ;
.

ncit:C86485
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86485" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86485>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Established Names and Unique Ingredient Identifier Codes Terminology" ;
    flat:definition "A species of Gram positive, cocci shaped, lactic acid bacteria assigned to the phylum Firmicutes. This species is nonmotile, catalase negative, nonsporulating and produces lactic acid from lactose fermentation. L lactis may be an opportunistic pathogen in humans and animals. Most significantly this microorganism is used commercially in the production of buttermilk and cheese." ;
    flat:parents "C86483" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Lactococcus lactis|LACTOCOCCUS LACTIS|LACTOCOCCUS LACTIS" ;
.

ncit:C86486
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86486" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86486>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram negative, rod shaped bacterium in the phylum Fusobacteria and the family Enterobacteriaceae." ;
    flat:parents "C85932" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Leclercia|LECLERCIA" ;
.

ncit:C86487
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86487" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86487>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria in the phylum Proteobacteria. This species is motile, lactose and beta glucuronidase negative, beta glucosidase positive and utilizes cellobiose as a carbon source. L. adecarboxylata is an opportunistic pathogen in immunocompromised patients." ;
    flat:parents "C86486" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Leclercia adecarboxylata|CDC Enteric Group 41|CDC Enteric Group 41|LECLERCIA ADECARBOXYLATA" ;
.

ncit:C86488
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86488" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86488>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, gram negative, rod shaped bacteria in the phylum Proteobacteria. This species is motile, nonacid fast, nonencapsulated, nonfermentative and catalase positive. L. longbeachae is normally found in soil and potting compost and is pathogenic when inhaled, being the causative agent of Pontiac fever." ;
    flat:parents "C76353" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Legionella longbeachae|LEGIONELLA LONGBEACHAE" ;
.

ncit:C86489
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86489" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86489>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, gram negative, rod shaped bacteria in the phylum Proteobacteria. This species is motile by flagella, nonacid fast, pleomorphic, nonencapsulated, nonfermentative, urease negative and oxidase and catalase positive. L. pneumophila is pathogenic, being the causative agent of legionellosis or Legionnaires disease." ;
    flat:parents "C76353" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Legionella pneumophila|LEGIONELLA PNEUMOPHILA" ;
.

ncit:C86490
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86490" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86490>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of Gram positive, coryneform bacterium assigned to the phylum Actinobacteria and the family Microbacteriaceae." ;
    flat:parents "C85945" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Leifsonia|LEIFSONIA" ;
.

ncit:C86491
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86491" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86491>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod shaped, coryneform bacteria assigned to the phylum Actinobacteria. This species is motile by long peritrichous flagella, catalase and oxidase positive, produces yellow colonies and hydrolyzes starch. L. aquatica is an opportunistic pathogen in immunocompromised patients." ;
    flat:parents "C86490" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Leifsonia aquatica|Corynebacterium aquaticum|Corynebacterium aquaticum|LEIFSONIA AQUATICA" ;
.

ncit:C86492
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86492" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86492>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram negative, rod shaped bacterium in the phylum Proteobacteria and the family Enterobacteriaceae." ;
    flat:parents "C85932" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Leminorella|LEMINORELLA" ;
.

ncit:C86493
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86493" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86493>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria in the phylum Proteobacteria. This species is nonmotile, hydrogen sulfide, tyrosine and L arabinose positive, produces acid from dulcitol, oxidase negative, and urea, phenylalanine, and D mannose negative. L. grimontii is an emerging nosocomial pathogen, especially in immunocompromised patients." ;
    flat:parents "C86492" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Leminorella grimontii|CDC Enteric Group 57|CDC Enteric Group 57|LEMINORELLA GRIMONTII" ;
.

ncit:C86494
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86494" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86494>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria in the phylum Proteobacteria. This species is hydrogen sulfide positive, citrate and oxidase negative and produces acid from L arabinose and D xylose but not dulcitol. L. richardii is an emerging nosocomial pathogen, especially in immunocompromised patients." ;
    flat:parents "C86492" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Leminorella richardii|LEMINORELLA RICHARDII" ;
.

ncit:C86495
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86495" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86495>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, gram positive, cocci shaped bacteria in the phylum Firmicutes. This species is nonmotile, catalase and oxidase negative, produces acid from arabinose and trehalose and hydrolyzes esculin. L. citreum is usually nonpathogenic and is commonly found in farming soil; it is used as a starter culture for the fermentation of kimchi." ;
    flat:parents "C76357" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Leuconostoc citreum|LEUCONOSTOC CITREUM" ;
.

ncit:C86496
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86496" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86496>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, gram positive, cocci shaped bacteria in the phylum Firmicutes. This species is nonmotile, catalase and oxidase negative, produces acid from lactose and does not hydrolyze esculin. L. lactis is not a normal colonizer of humans and may be an opportunistic pathogenic." ;
    flat:parents "C76357" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Leuconostoc lactis|LEUCONOSTOC LACTIS" ;
.

ncit:C86497
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86497" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86497>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, gram positive, cocci shaped bacteria in the phylum Firmicutes. This species is nonmotile, catalase and oxidase negative, produces acid from arabinose, raffinose and trehalose and hydrolyzes esculin. L. mesenteroides is usually nonpathogenic and is used as a starter culture for the fermentation of cabbage during sauerkraut production." ;
    flat:parents "C76357" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Leuconostoc mesenteroides|LEUCONOSTOC MESENTEROIDES" ;
.

ncit:C86498
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86498" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86498>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, gram positive, cocci shaped bacteria in the phylum Firmicutes. This species is nonmotile, catalase and oxidase negative, produces acid from arabinose and hydrolyzes esculin. L. psuedomesenteroides is an opportunistic nosocomial pathogen in patients with underlying disease." ;
    flat:parents "C76357" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Leuconostoc pseudomesenteroides|LEUCONOSTOC PSEUDOMESENTEROIDES" ;
.

ncit:C86499
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86499" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86499>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is motile, catalase positive, oxidase and indole negative, nitrate reduction variable, produces acid from glucose and mannitol and hydrolyzes esculin. L. grayi is found in soil and animal feces and generally regarded as nonpathogenic, although infection has been documented in immunocompromised patients." ;
    flat:parents "C76359" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Listeria grayi|LISTERIA GRAYI" ;
.

ncit:C86500
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86500" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86500>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is motile by flagella and pilli, nonsporulating and halotolerant. L. innocua is commonly found in food and in the soil, and is nonpathogenic." ;
    flat:parents "C76359" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Listeria innocua|LISTERIA INNOCUA" ;
.

ncit:C86501
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86501" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86501>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is catalase positive, oxidase negative, nonsporulating, hydrolyzes esculin and produces acid from glucose and D xylose. L. ivanovii is pathogenic in animals but not humans." ;
    flat:parents "C76359" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Listeria ivanovii|LISTERIA IVANOVII|Listeria bulgarica|Listeria monocytogenes Serovar 5|Listeria monocytogenes subsp. perhaemolytica|Listeria perhaemolytica" ;
.

ncit:C86502
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86502" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86502>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is motile by up to four peritrichous flagella, catalase positive, hemolytic, produces acid from glucose, trehalose, levulose and salacin, indole negative and does not reduce nitrate. L. monocytogenes is a food borne pathogen, being the causative agent of listeriosis in humans and animals." ;
    flat:parents "C76359" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Listeria monocytogenes|Bacterium monocytogenes hominis|Corynebacterium infantisepticum|Corynebacterium parvulum|LISTERIA MONOCYTOGENES|Listerella hepatolytica" ;
.

ncit:C86503
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86503" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86503>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is motile by peritrichous flagella, asporogenous, catalase positive, oxidase negative, produces acid from D glucose and D xylose and hydrolyzes esculin. L. seeligeri is found in soil and is regarded as nonpathogenic." ;
    flat:parents "C76359" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Listeria seeligeri|LISTERIA SEELIGERI" ;
.

ncit:C86504
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86504" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86504>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria in the phylum Firmicutes. This species is motile by peritrichous flagella, asporogenous, catalase positive, oxidase negative, unable to reduce nitrates to nitrites, hydrolyzes esculin and produces acid from D glucose, D xylose and alpha methyl D mannoside. L. welshimeri is found in soil and is regarded as nonpathogenic." ;
    flat:parents "C76359" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Listeria welshimeri|LISTERIA WELSHIMERI" ;
.

ncit:C86505
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86505" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86505>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of anaerobic, Gram positive, large cocci shaped bacterium assigned to the phylum Firmicutes and the family Staphylococcaceae." ;
    flat:parents "C85966" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Macrococcus|MACROCOCCUS" ;
.

ncit:C86506
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86506" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86506>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, large cocci shaped bacteria assigned to the phylum Firmicutes. This species is nonmotile, nonhemolytic, produces acid from maltose, beta D fructose and D trehalose, reduces nitrate, produces acetoin, catalase and oxidase positive and urease negative. M. caseolyticus is a nonpathogenic, commensal organism of the skin and is commonly isolated from foods such as meat and cheese." ;
    flat:parents "C86505" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Macrococcus caseolyticus|MACROCOCCUS CASEOLYTICUS|Staphylococcus caseolyticus|Staphylococcus caseolyticus" ;
.

ncit:C86507
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86507" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86507>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram negative, rod shaped bacterium in the phylum Fusobacteria and the family Pasteurellaceae." ;
    flat:parents "C85951" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mannheimia|MANNHEIMIA" ;
.

ncit:C86508
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86508" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86508>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria in the phylum Fusobacteria. This species is nonmotile, beta hemolytic, and ferments D sorbitol, D xylose and maltose, but not trehalose. M. haemolytica is a commensal organism of the upper respiratory tract of ruminants but may become pathogenic, causing pneumonia." ;
    flat:parents "C86507" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mannheimia haemolytica|MANNHEIMIA HAEMOLYTICA|Pasteurella haemolytica|Pasteurella haemolytica" ;
.

ncit:C86510
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86510" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86510>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of obligately aerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile by single polar flagellum, alpha glucosidase and alkaline phosphatase positive, catalase positive, has pink tinted colonies, and produces acid from galactose, xylose and methanol. M. mesophilicum is an opportunistic but rare human pathogen and is normally found from environmental sources such as soil and vegetation." ;
    flat:parents "C76361" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Methylobacterium mesophilicum|METHYLOBACTERIUM MESOPHILICUM|Pseudomonas mesophilica|Pseudomonas mesophilica" ;
.

ncit:C86512
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86512" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86512>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, coryneform bacteria assigned to the phylum Actinobacteria. This species is motile, nonfermentative, forms yellow pigmented colonies, catalase positive, oxidase negative and hydrolyzes esculin and gelatin. M. paraoxydans is pathogenic and one of the most common species of Microbacterium to be isolated from clinical specimens." ;
    flat:parents "C85511" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Microbacterium paraoxydans|MICROBACTERIUM PARAOXYDANS" ;
.

ncit:C86513
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86513" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86513>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of obligately aerobic, Gram positive, cocci shaped bacteria in the phylum Actinobacteria. This species is halotolerant, coagulase negative, susceptible to bacitracin and does not ferment glucose. M. luteus is found in soil, dust, water and air and is a commensal organism of the skin, mouth and upper respiratory tract but may be considered pathogenic in immunocompromised individuals." ;
    flat:parents "C77086" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Micrococcus luteus|MICROCOCCUS LUTEUS|Sarcina lutea" ;
.

ncit:C86514
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86514" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86514>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, cocci shaped bacteria in the phylum Actinobacteria. This species is nonmotile, catalase and urease positive, indole negative, does not reduce nitrate, is negative for the methyl red test and contains the amino sugar galactosamine in the cell wall. M lylae has been isolated from human skin and is considered pathogenic in immunocompromised individuals." ;
    flat:parents "C77086" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Micrococcus lylae|MICROCOCCUS LYLAE" ;
.

ncit:C86515
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86515" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86515>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Firmicutes and the family Veillonellaceae." ;
    flat:parents "C85969" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mitsuokella|MITSUOKELLA" ;
.

ncit:C86516
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86516" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86516>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Firmicutes. This species is susceptible to Kanamycin and Penicillin, ferments rhamnose, mannitol, D-tagatose and melezitose, grows in the presence of Brilliant green and reduces nitrate. M. multacida is a commensal organism of the gastrointestinal tract." ;
    flat:parents "C86515" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mitsuokella multacida|MITSUOKELLA MULTACIDA" ;
.

ncit:C86517
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86517" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86517>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of anaerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria and the family Actinomycetaceae." ;
    flat:parents "C85912" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mobiluncus|MOBILUNCUS" ;
.

ncit:C86518
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86518" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86518>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, curved rod shaped bacterium assigned to the phylum Actinobacteria. This species is motile by one to six flagella that originate from the same spot on each cell and is oxidase, indole and catalase negative. M. curtisii is found in the vaginal tract and is pathogenic, being a causative agent of bacterial vaginosis." ;
    flat:parents "C86517" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mobiluncus curtisii|MOBILUNCUS CURTISII" ;
.

ncit:C86519
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86519" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86519>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria. This species is motile by one to eight flagella from multiple origins, oxidase and catalase negative, does not hydrolyze esculin, is stimulated from arginine, weakly reduces nitrate and produces acid from glycogen. M. mulieris is found in the vaginal tract and is a causative agent of vaginitis." ;
    flat:parents "C86517" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mobiluncus mulieris|MOBILUNCUS MULIERIS" ;
.

ncit:C86520
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86520" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86520>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram negative, rod shaped bacterium in the phylum Proteobacteria and the family Enterobacteriaceae." ;
    flat:parents "C85932" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Moellerella|MOELLERELLA" ;
.

ncit:C86521
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86521" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86521>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium in the phylum Proteobacteria. This species is nonmotile, indole negative, resistant to colistin, lactose positive and produces acid from D-glucose, lactose and raffinose. M. wisconsensis is found in water and may be associated with diarrheal symptoms in humans." ;
    flat:parents "C86520" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Moellerella wisconsensis|CDC Enteric Group 46|CDC Enteric Group 46|MOELLERELLA WISCONSENSIS" ;
.

ncit:C86523
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86523" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86523>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is oxidase positive, negative for urease, phenylalanine deaminase and tryptophan deaminase, is unable to grow on solid medium at 4 to 10 degrees C, and is relatively halointolerant. M. atlantae is normally found in human blood and is an emerging nosocomial pathogen." ;
    flat:parents "C86009" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Moraxella atlantae|CDC Group M-3|MORAXELLA ATLANTAE" ;
.

ncit:C86524
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86524" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86524>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod shaped, bacteria assigned to the phylum Proteobacteria. This species is oxidase positive, nonmotile, and requires serum or blood for growth in culture. M. bovis is pathogenic, being the causative agent of infectious bovine keratoconjunctivitis. However only the piliated variant can colonize the conjunctiva." ;
    flat:parents "C86009" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Moraxella bovis|MORAXELLA BOVIS" ;
.

ncit:C86525
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86525" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86525>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, cocci shaped, bacteria assigned to the phylum Proteobacteria. This species is positive for oxidase, catalase, butyrate esterase, and y-glutamyl-aminopeptidase activities, negative for phenylalanine deaminase, urease, lipase and lecithinase activity and relatively halointolerant. M. canis is an upper-airway commensal of dogs and cats and is considered nonpathogenic in humans." ;
    flat:parents "C86009" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Moraxella canis|MORAXELLA CANIS" ;
.

ncit:C86526
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86526" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86526>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, cocci shaped bacteria assigned to the phylum Proteobacteria. This species is oxidase positive, nonmotile, sensitive to penicillin, and requires serum for growth. M. lacunata is a commensal organism of the human upper respiratory tract and most commonly associated with eye infections, but has been reported to cause rare invasive infections in humans, including endocarditis, septic arthritis, cellulitis, meningitis, bacteremia and purulent pericarditis." ;
    flat:parents "C86009" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Moraxella lacunata|MORAXELLA LACUNATA|Moraxella liquefaciens|Moraxella liquefaciens" ;
.

ncit:C86527
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86527" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86527>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is oxidase and catalase positive, urease and alkaline phosphatase negative, nonmotile, relatively halointolerant, susceptible to penicillin, grows on blood agar or nutrient agar and does not reduce nitrate. M. lincolnii has been isolated from humans with respiratory infections." ;
    flat:parents "C86009" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Moraxella lincolnii|MORAXELLA LINCOLNII" ;
.

ncit:C86528
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86528" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86528>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, nonhemolytic, oxidase and catalase positive, indole negative and reduces nitrate. M. nonliquefaciens is a commensal organism of the upper respiratory tract but may become pathogenic in immunocompromised individuals." ;
    flat:parents "C86009" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Moraxella nonliquefaciens|MORAXELLA NONLIQUEFACIENS" ;
.

ncit:C86529
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86529" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86529>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, cocci shaped bacteria assigned to the phylum Proteobacteria. This species is oxidase and catalase positive, does not reduce nitrate and is negative for urea and lysine hydrolysis. M. oblonga has been isolated from the oral cavity of a sheep." ;
    flat:parents "C86009" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Moraxella oblonga|MORAXELLA OBLONGA" ;
.

ncit:C86530
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86530" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86530>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, cocci shaped bacteria assigned to the phylum Proteobacteria. This species is oxidase and catalase positive, nonmotile and asaccharolytic. M. osloensis is commensal in the human respiratory tract and rarely pathogenic." ;
    flat:parents "C86009" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Moraxella osloensis|MORAXELLA OSLOENSIS" ;
.

ncit:C86531
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86531" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86531>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram negative, rod shaped bacterium in the phylum Proteobacteria and the family Enterobacteriaceae." ;
    flat:parents "C85932" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Morganella|MORGANELLA" ;
.

ncit:C86533
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86533" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86533>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is acid-fast, nonmotile, does not reduce nitrate, is amidase, urease and nicotinamidase positive and benzamidase, isonicotinamidase, succinamidase and acetamidase negative. M. abscessus is a rapidly growing mycobacterium found in water, soil and dust, and can cause a variety of serious infections of the skin, soft tissues and lungs, especially in persons with chronic lung diseases." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium abscessus|MYCOBACTERIUM ABSCESSUS|Mycobacterium chelonae subsp. abscessus|Mycobacterium chelonae subsp. abscessus" ;
.

ncit:C86535
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86535" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86535>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is acid fast, catalase positive, niacin, peroxidase, nitrate reductase, and urease negative, and may be susceptible to pnitrobenzoate, ethambutol, pyrazinamide, rifampin, and streptomycin. M. avium is found in soil and dust particles and can cause infection when inhaled or ingested, especially causing disseminated infection in immunocompromised patients." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium avium|MYCOBACTERIUM AVIUM" ;
.

ncit:C86536
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86536" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86536>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rods assigned to the phylum Actinobacteria. This species is acid fast, oxidase negative, urease and catalase positive, nonmotile and nonsporulating. M. chelonae is a fast growing mycobacterium isolated from environmental, animal and human sources and is often associated with post-operative soft tissue infection." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium chelonae|MYCOBACTERIUM CHELONAE|Mycobacterium chelonae subsp. chelonae|Mycobacterium chelonae subsp. chelonae" ;
.

ncit:C86537
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86537" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86537>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria. This species is acid fast, nonmotile, is unable to grow well in glycerol agar, produces pigment and has a slower growth rate than Mycobacterium fortuitum. M. flavescens is a commensal organism of the respiratory tract and is not associated with clinical disease." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium flavescens|MYCOBACTERIUM FLAVESCENS" ;
.

ncit:C86538
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86538" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86538>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria. This species is acid fast, nonmotile, urease negative and catalase, nitrate reductase, and esculin positive. M. fortuitum is found in natural and processed water sources, sewage and dirt, and can cause various clinical syndromes, including local disease after injury or surgical trauma, and disseminated infection in immunocompromised patients." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium fortuitum|MYCOBACTERIUM FORTUITUM" ;
.

ncit:C86539
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86539" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86539>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A non taxonomic grouping of bacteria assigned to and including related species from the Mycobacterium genus not including those bacteria in the Mycobacterium tuberculosis complex." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium fortuitum Complex|MYCOBACTERIUM FORTUITUM COMPLEX" ;
.

ncit:C86540
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86540" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86540>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria. This species is acid fast, nonmotile, grows on Lowenstein-Jensen medium, and does not grow in the presence of ethambutol or isoniazid. M. gastri is found in soil and water, occasionally in human stomach contents, is rarely associated with human disease and may be considered nonpathogenic." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium gastri|MYCOBACTERIUM GASTRI" ;
.

ncit:C86541
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86541" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86541>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria. This species is acid fast, nonmotile, catalase and urease positive, negative for 3-day arylsulfatase and Tween 80 hydrolysis, and does not reduce nitrate. M. gordonae is commonly found in tap water and soil, is commensal in human mucus membranes, urine and gastric fluid and is rarely pathogenic except in immunocompromised individuals." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium gordonae|MYCOBACTERIUM GORDONAE|Mycobacterium aquae|Mycobacterium aquae" ;
.

ncit:C86542
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86542" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86542>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria. This species is acid fast, nonmotile, catalase negative, requires haemin for growth and is characterized by exclusively intracellular development. M. haemophilum has an unknown reservoir and mode of transmission and is known to be pathogenic in immunocompromised individuals." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium haemophilum|MYCOBACTERIUM HAEMOPHILUM" ;
.

ncit:C86544
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86544" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86544>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria. This species is acid fast, stains with carbol fuchsin rather than a traditional Gram stain, has the longest doubling time of all known bacteria, and has never been cultured in vitro. Mycobacterium leprae is pathogenic, being the causative agent of leprosy." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium leprae|MYCOBACTERIUM LEPRAE" ;
.

ncit:C86545
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86545" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86545>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria. This species is acid fast, nonmotile with optimum growth on Lowenstein-Jensen medium, urease and catalase positive, niacin and nitrate negative, and produces pigment when cultured and exposed to light. M. marinum is commonly found in bodies of fresh or saltwater and skin infections in humans are usually acquired from contact with aquariums or fish." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium marinum|MYCOBACTERIUM MARINUM|Mycobacterium balnei|Mycobacterium balnei" ;
.

ncit:C86546
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86546" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86546>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria. This species is acid fast, grows rapidly on egg medium, is urease, arylsulfatase and nitrate reductase positive, benzamidase and isonicotinamidase negative, and has a relatively low tolerance to cefmetazole and cefoxitin. M. peregrinum is found in soil and water-related sources and is related to surgical site and catheter related infections." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium peregrinum|MYCOBACTERIUM PEREGRINUM" ;
.

ncit:C86547
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86547" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86547>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria. This species is acid fast, nonmotile, acid phosphatase and iron uptake negative and catalase, urease, pyrazinamidase and nicotinamidase positive. M. scrofulaceum is found in environmental sources such as house dust, soil, water, and sewage as well as food sources such as raw milk, and it is frequently associated with cervical adenitis in children." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium scrofulaceum|MYCOBACTERIUM SCROFULACEUM" ;
.

ncit:C86548
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86548" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86548>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria. This species is acid fast, does not grow on MacConkey agar, catalase, urease and niacin positive, and negative for nitrite reduction and Tween 80 hydrolysis. M. simiae is found primarily in the southwestern United States, Israel and Cuba, with tap water as its suspected reservoir. It causes infection mainly in immunocompromised patients and is often resistant to most conventional anti-tuberculosis medications including rifabutin." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium simiae|MYCOBACTERIUM SIMIAE|Mycobacterium habana|Mycobacterium habana" ;
.

ncit:C86587
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86587" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86587>" ;
    flat:definition "Chlorophyll-containing, mainly aquatic eukaryotic organisms lacking true stems and roots and leaves." ;
    flat:parents "C14258" ;
    flat:semantic%20type "Plant" ;
    flat:synonyms "Algae" ;
.

ncit:C86590
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86590" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86590>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is acid-fast, grows on MacConkey's agar, is iron uptake and nitrite reduction positive, and 3 day arylsulfatase negative. M. smegmatis was originally isolated from the human genitourinary tract, is also found in soil and water, and causes human post-traumatic wound infections and lung infections." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium smegmatis|MYCOBACTERIUM SMEGMATIS" ;
.

ncit:C86591
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86591" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86591>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is urease, nitrate reduction, Tween 80 hydrolysis, and arylsulfatase positive, acid-fast, does not produce acid from glucose, mannitol or sorbitol, but it does produce a distinctive lipid on chromatography appearing dense and brown. M. szulgai is found in the environment, primarily in water, and it rarely causes infection, but may cause pulmonary disease in patients with a history of alcoholism, cigarette smoking, obstructive pulmonary disease, or immunocompromised patients." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium szulgai|MYCOBACTERIUM SZULGAI" ;
.

ncit:C86592
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86592" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86592>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is acid-fast, positive for nitrate reductase, tellurite reductase, catalase and Tween hydrolysis, and is negative for urease. M. terrae is found mainly in soil and on vegetables and can cause disease in the joints, tendons, lungs, and gastrointestinal and genitourinary tracts." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium terrae|MYCOBACTERIUM TERRAE" ;
.

ncit:C86593
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86593" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86593>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is acid-fast, rapidly growing, catalase, urease and Tween 80 hydrolysis positive, and tellurite reductase, iron uptake, and arylsulfatase (14 days) negative, and is susceptible to ciprofloxacin. M. thermoresistibile is found in soil and is strongly associated with pulmonary and skin infections, but rarely isolated from clinical samples." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium thermoresistibile|MYCOBACTERIUM THERMORESISTIBILE" ;
.

ncit:C86594
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86594" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86594>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A group of four closely related tuberculosis-causing bacteria: M. bovis, M. africanum, M. canetti and M. microti." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium tuberculosis Complex|MYCOBACTERIUM TUBERCULOSIS COMPLEX" ;
.

ncit:C86595
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86595" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86595>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is acid-fast, catalase, urease and nitrate reduction negative, positive for acid phosphatase activity, and is resistant to isoniazid, para-aminosalicylic acid (PAS) and ethambutol, but sensitive to rifampicin and streptomycin. M. ulcerans is found in the wetlands of tropical and subtropical countries, causes an ulcerative skin disease known as Buruli ulcer, and there is some evidence that it may be transmitted through the bites of infected aquatic insects." ;
    flat:parents "C76369" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycobacterium ulcerans|MYCOBACTERIUM ULCERANS|Mycobacterium buruli|Mycobacterium buruli" ;
.

ncit:C86597
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86597" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86597>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-negative, pseudo-cocci shaped bacteria assigned to the phylum Firmicutes. This species is nonmotile, metabolizes arginine with the subsequent release of ammonia into the broth medium, resistant to penicillins and cephalosporins, while tetracycline (adults only) and erythromycin are effective chemotherapeutic agents. M. hominis is commensal in the urogenital flora of adults, but is an opportunistic pathogen implicated in female genital infections and may also cause infections in newborns, especially in those that are immunosuppressed." ;
    flat:parents "C73540" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycoplasma hominis|MYCOPLASMA HOMINIS" ;
.

ncit:C86598
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86598" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86598>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-negative, pseudo-cocci shaped bacteria assigned to the phylum Firmicutes. This species is nonmotile, urease negative, does not hydrolyze carbohydrates, gelatin, or casein, and is sensitive to penicillin, erythromycin and aminoglycosides. M. orale is commensal in the human oropharynx and is usually non-pathogenic, but can cause infections in immunosuppressed patients and is a common contaminant found in cultured cells." ;
    flat:parents "C73540" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycoplasma orale|MYCOPLASMA ORALE" ;
.

ncit:C86599
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86599" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86599>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-negative, pseudo-cocci shaped bacteria assigned to the phylum Firmicutes. This species is motile, grows best in SP-4 medium supplemented with glucose and is positive for beta-hemolysis. M. pneumoniae is a common cause of community-acquired pneumonia, especially in people younger than 40." ;
    flat:parents "C73540" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Mycoplasma pneumoniae|MYCOPLASMA PNEUMONIAE" ;
.

ncit:C86600
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86600" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86600>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, diplococci shaped bacteria assigned to the phylum Proteobacteria. This species is oxidase and catalase positive, reduces nitrite, galactosidase negative, does not hydrolyze tributyrin, and does not grow on MacConkey's agar. N. canis is found in the throat of cats and dogs and can be pathogenic." ;
    flat:parents "C76371" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Neisseria canis|NEISSERIA CANIS" ;
.

ncit:C86601
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86601" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86601>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-negative, diplococci shaped bacteria assigned to the phylum Proteobacteria. This species is oxidase positive, reduces nitrite, but not nitrate, produces carbonic anhydrase, does not hydrolyze tributyrin, is non-hemolytic, and does not produce acid from glucose, maltose, fructose, sucrose, mannose, or lactose. N. cinerea is commensal in the human nasal and oropharyngeal tract, and is considered non-pathogenic, but can become pathogenic in immunocompromised individuals." ;
    flat:parents "C76371" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Neisseria cinerea|Micrococcus cinereus|Micrococcus cinereus|NEISSERIA CINEREA" ;
.

ncit:C86602
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86602" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86602>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, diplococci shaped bacteria assigned to the phylum Proteobacteria. This species is catalase and oxidase positive, non-hemolytic, pigmented, susceptible to colistin, produces polysaccharides from sucrose, and does not produce acid from glucose, maltose, fructose, sucrose, mannose or lactose. N. flavescens is commensal in the human oral cavity and can become pathogenic in immunocompromised individuals causing endocarditis, meningitis, and septicemia." ;
    flat:parents "C76371" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Neisseria flavescens|NEISSERIA FLAVESCENS" ;
.

ncit:C86603
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86603" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86603>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, diplococci shaped bacteria assigned to the phylum Proteobacteria. This species is oxidase and catalase positive, grows best on blood agar medium or chocolate medium, is non-hemolytic, produces acid from glucose, but not from maltose, fructose, sucrose, mannose or lactose, does not synthesize polysaccharides, and reduces nitrite but not nitrate. N. gonorrhoeae is the causative agent of gonorrhea and is transmitted via sexual contact." ;
    flat:parents "C76371" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Neisseria gonorrhoeae|NEISSERIA GONORRHOEAE" ;
.

ncit:C86604
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86604" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86604>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, diplococci shaped bacteria assigned to the phylum Proteobacteria. This species is catalase and oxidase positive, nonmotile, colistin-resistant, grows on chocolate agar in high humidity, and is characterized by its ability to produce acid from glucose, maltose, and lactose, as well as by its ability to produce beta-galactosidase. N. lactamica is commensal in the human nasopharynx, commonly isolated from children, and is rarely pathogenic." ;
    flat:parents "C76371" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Neisseria lactamica|NEISSERIA LACTAMICA" ;
.

ncit:C86605
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86605" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86605>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Established Names and Unique Ingredient Identifier Codes Terminology|NICHD Terminology|Pediatric Immunization Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, diplococci shaped bacteria assigned to the phylum Proteobacteria. This species is catalase and oxidase positive, non-hemolytic, non-pigmented, does not reduce nitrate or nitrite, does not synthesize polysaccharides, grows on blood, chocolate, or Muller-Hinton agar, and produces acid from glucose and maltose but not fructose, sucrose, mannose, or lactose. N. meningitidis, known commonly as meningococcus, is the causative agent of cerebrospinal meningitis, but is also associated with other human infections, but can be commensal in the oropharynx and nasopharynx of carriers." ;
    flat:parents "C76371" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Neisseria meningitidis|Beta-Lactamase Negative Neisseria meningitidis|NEISSERIA MENINGITIDIS|NEISSERIA MENINGITIDIS" ;
.

ncit:C86606
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86606" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86606>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, diplococci shaped bacteria assigned to the phylum Proteobacteria. This species is catalase and oxidase positive, non-hemolytic, produces a yellowish pigment, reduces both nitrate and nitrite, synthesizes polysaccharides, and produces acid from glucose, maltose, fructose, and sucrose, but not mannose or lactose. N. mucosa is commensal in the human nasopharynx and is rarely pathogenic." ;
    flat:parents "C76371" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Neisseria mucosa|NEISSERIA MUCOSA" ;
.

ncit:C86607
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86607" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86607>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, cocci shaped bacteria assigned to the phylum Proteobacteria. This species is catalase and oxidase positive, produces a yellowish pigment, reduces nitrate, but not nitrite, requires cystine-cysteine for growth, produces large amounts of polysaccharides, and produces acid from glucose and maltose, but not sucrose or lactose. N. polysaccharea is commensal in the nasopharynx of infants and children and is considered nonpathogenic." ;
    flat:parents "C76371" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Neisseria polysaccharea|NEISSERIA POLYSACCHAREA" ;
.

ncit:C86608
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86608" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86608>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, cocci shaped bacteria assigned to the phylum Proteobacteria. This species is catalase and oxidase positive, produces a grayish white pigment, utilizes glucose, maltose, fructose, and sucrose, but not mannose or lactose, reduces nitrite, but not nitrate, synthesizes polysaccharides, and spontaneously agglutinates in saline. N. sicca is found in the nasopharynx, saliva, and sputum of humans, but is also an opportunistic pathogen." ;
    flat:parents "C76371" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Neisseria sicca|NEISSERIA SICCA" ;
.

ncit:C86609
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86609" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86609>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, cocci shaped bacteria assigned to the phylum Proteobacteria. This species is catalase and oxidase positive, produces a yellowish pigment, non-hemolytic, utilizes glucose and maltose, but not mannose or lactose, reduces nitrite but not nitrate, and some strains spontaneously agglutinate in saline. N. subflava is commensal in the human nasopharynx, but has been isolated in the cerebrospinal fluid of individuals with meningitis." ;
    flat:parents "C76371" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Neisseria subflava|NEISSERIA SUBFLAVA" ;
.

ncit:C86610
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86610" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86610>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, catalase and oxidase positive, non-pigmented, alpha-hemolytic only on sheep's blood agar, does not utilize carbohydrates, reduces nitrite, but not nitrate, does not synthesize polysaccharides, and does not require salts to grow. N. weaverii is commensal in dogs, but is often found in human wounds resulting from dog bites." ;
    flat:parents "C76371" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Neisseria weaverii|CDC Group M-5|CDC Group M-5|NEISSERIA WEAVERII|Neisseria weaveri" ;
.

ncit:C86611
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86611" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86611>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is catalase and urease positive, acid-fast, hydrolyzes esculin but not casein, reduces nitrate, and characteristically produces a mycelium that fragments into bacillary and coccoid elements. N. asteroides is naturally found in soil, ans lake and marine sediment where it digests plant matter; but in humans it is an opportunistic pathogen and one of the causative agents of nocardiosis in immunocompromised individuals." ;
    flat:parents "C76372" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Nocardia asteroides|NOCARDIA ASTEROIDES" ;
.

ncit:C86612
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86612" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86612>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A non taxonomic grouping of bacteria assigned to and including at least four related species from the Nocardia genus." ;
    flat:parents "C76372" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Nocardia asteroides Complex|NOCARDIA ASTEROIDES COMPLEX" ;
.

ncit:C86613
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86613" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86613>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is nonmotile, catalase and urease positive, acid-fast, oxidase negative, hydrolyzes casein, elastin, esculin, hypoxanthine, testosterone, and tyrosine, but not xanthine, produces acid phosphatase, and reduces nitrate. N. brasiliensis is naturally found in soil and is one of the main causative agents of nocardiosis." ;
    flat:parents "C76372" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Nocardia brasiliensis|NOCARDIA BRASILIENSIS" ;
.

ncit:C86614
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86614" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86614>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is spore forming, nonacid-fast, urease negative, catalase positive, hydrolyzes starch, gelatin, esculin, xanthine, and hypoxanthine, reduces nitrate, and produces an aerial hyphae and substrate mycelium that fragments into coccoid elements. N. dassonvillei is found in the environment including mildewed grain and in is pathogenic in humans, though cases are rare." ;
    flat:parents "C76372" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Nocardia dassonvillei|NOCARDIA DASSONVILLEI|Nocardiopsis antarctica|Nocardiopsis antarcticus|Nocardiopsis dassonvillei|Streptothrix dassonvillei" ;
.

ncit:C86615
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86615" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86615>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase and urease positive, reduces nitrate, does not produce acid phosphatase, hydrolyzes esculin and testosterone, but not casein, elastin, hypoxanthine, tyrosine, and xanthine, and produces a mycelium and aerial hyphae that fragments into coccoid elements. N. farcinica is found in soil and is a causative agent of nocardiosis." ;
    flat:parents "C76372" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Nocardia farcinica|NOCARDIA FARCINICA" ;
.

ncit:C86616
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86616" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86616>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is nonmotile, catalase and urease positive, reduces nitrate, does not produce phosphate and utilizes glucose and fructose as its only carbon source. N. nova is found in the soil and is a causative agent of nocardiosis." ;
    flat:parents "C76372" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Nocardia nova|NOCARDIA NOVA" ;
.

ncit:C86617
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86617" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86617>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is nonmotile, catalase and urease positive, reduces nitrate, hydrolyzes esculin, hypoxanthine, and xanthine, but not casein, elastin, testosterone, or tyrosine. N. otitidiscaviarum is found in soil and has only been associated with a few cases of nocardiosis." ;
    flat:parents "C76372" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Nocardia otitidiscaviarum|NOCARDIA OTITIDISCAVIARUM|Nocardia caviae|Nocardia caviae" ;
.

ncit:C86618
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86618" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86618>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Any rod shaped, anaerobic bacteria that cannot convert carbohydrates into acids and alcohols and has a cell wall that contains low levels of peptidoglycan and stains pink with the Gram staining technique." ;
    flat:parents "C86421" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Non-Fermentative Gram Negative Bacillus|NON-FERMENTATIVE GRAM-NEGATIVE BACILLUS|Non-Fermentative Gram-Negative Rod|Non-fermentative Gram-negative Rod" ;
.

ncit:C86619
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86619" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86619>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria and the family Brucellaceae." ;
    flat:parents "C85919" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Ochrobactrum|OCHROBACTRUM" ;
.

ncit:C86620
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86620" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86620>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile using peritrichous flagella, catalase, urease and oxidase positive, indole negative, grows on MacConkey's agar, nonpigmented, does not hydrolyze casein, Tween 20, or Tween 80, reduces both nitrate and nitrite, produces acid from glucose, arabinose, ethanol, fructose, rhamnose and xylose, and has broad spectrum antibiotic resistance. O. anthropi has been isolated from water sources in is associated with nosocomial infections." ;
    flat:parents "C86619" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Ochrobactrum anthropi|Achromobacter subsp. Biotype 1|OCHROBACTRUM ANTHROPI" ;
.

ncit:C86621
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86621" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86621>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile with 1 to 3 polar flagella, catalase, cytochrome-c oxidase, and urease positive, indole and gelatinase negative, grows on MacConkey's agar, reduces nitrate, produces hydrogen sulfide, utilizes citrate, glycerol, and maltose, and has broad spectrum antibiotic resistance. O. intermedium is found in soil and is an opportunistic pathogen particularly in immunocompromised individuals or those with nosocomial infections." ;
    flat:parents "C86619" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Ochrobactrum intermedium|OCHROBACTRUM INTERMEDIUM" ;
.

ncit:C86622
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86622" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86622>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria and the family Cellulomonadaceae." ;
    flat:parents "C85923" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Oerskovia|OERSKOVIA" ;
.

ncit:C86623
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86623" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86623>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is yellow with extensively branched vegetative hyphae without an aerial mycelium which breaks into motile rod shaped elements, is catalase positive, reduces nitrate, hydrolyzes casein, gelatin and starch, is not acid-fast, mesophilic, utilizes acetate, lactate, and pyruvate. O. turbata is found in soil and rarely causes infections in humans." ;
    flat:parents "C86622" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Oerskovia turbata|OERSKOVIA TURBATA" ;
.

ncit:C86624
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86624" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86624>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, gram negative, coccobacilli shaped bacterium assigned to the phylum Proteobacteria and the family Alcaligenaceae." ;
    flat:parents "C85914" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Oligella|OLIGELLA" ;
.

ncit:C86625
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86625" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86625>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is motile using peritrichous flagella (most strains), non-spore forming, noncapsulated, moderately fastidious, oxidase, catalase and urease positive, indole negative, reduces nitrate and nitrite, nonhemolytic, not susceptible to penicillin, and does not produce hydrogen sulfide, pigment or odors, hydrolyze gelatin and ferment or oxidize carbohydrates. O. ureolytica is commensal to the genitourinary, but can become pathogenic during long term catheterization or in immunocompromised individuals." ;
    flat:parents "C86624" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Oligella ureolytica|CDC Group IVE|CDC Group Ive|OLIGELLA UREOLYTICA" ;
.

ncit:C86626
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86626" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86626>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, non-spore forming, noncapsulated oxidase and catalase positive, urease and indole negative, reduces nitrite, but not nitrate, nonhemolytic, moderately fastidious, susceptible to penicillin, and does not produce pigment, odors or hydrogen sulfide, ferment or oxidize carbohydrates, or hydrolyze gelatin. O. ureolytica is commensal to the genitourinary, but can become pathogenic during long term catheterization or in immunocompromised individuals." ;
    flat:parents "C86624" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Oligella urethralis|CDC Group M-4|OLIGELLA URETHRALIS" ;
.

ncit:C86627
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86627" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86627>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of anaerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria and the family Coriobacteriaceae." ;
    flat:parents "C85927" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Olsenella|OLSENELLA" ;
.

ncit:C86628
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86628" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86628>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is non-spore forming, catalase and indole negative, does not liquefy gelatin, hydrolyze hippurate, digest meat, or reduce nitrate, but does ferment glucose, glycogen, trehalose, and starch, as well as hydrolyze esculin. O. uli, also known as Lactobacillus uli, is found in human gingival crevices and periodontal pockets where it is associated with periodontal disease." ;
    flat:parents "C86627" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Olsenella uli|Lactobacillus uli|Lactobacillus uli|OLSENELLA ULI" ;
.

ncit:C86629
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86629" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86629>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria and the family Burkholderiaceae." ;
    flat:parents "C85920" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Pandoraea|PANDORAEA" ;
.

ncit:C86630
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86630" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86630>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile using a single polar flagella, non-spore forming, catalase positive, indole negative, does not reduce nitrate, liquefy gelatin, hydrolyze esculin or Tween 80, does not grow on O/F medium with D-glucose, nor fluoresce on King's B medium. P pnomenusa is found in soil and is pathogenic to humans having been isolated from the sputum of individuals with cystic fibrosis." ;
    flat:parents "C86629" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Pandoraea pnomenusa|PANDORAEA PNOMENUSA" ;
.

ncit:C86631
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86631" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86631>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram negative, rod shaped bacterium in the phylum Proteobacteria and the family Enterobacteriaceae." ;
    flat:parents "C85932" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Pantoea|PANTOEA" ;
.

ncit:C86632
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86632" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86632>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, rod shaped bacteria in the phylum Proteobacteria. This species is motile using peritrichous flagella, non-spore forming, indole and urease negative, noncapsulated, produces a yellow pigment, liquefies gelatin, reduces nitrate, hydrolyzes esculin, and is Voges-Proskauer reaction positive. P. agglomerans is found on plant surfaces, seeds, and water and is pathogenic in humans and some strains can be pathogenic to plants." ;
    flat:parents "C86631" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Pantoea agglomerans|Enterobacter agglomerans|Enterobacter agglomerans|PANTOEA AGGLOMERANS" ;
.

ncit:C86633
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86633" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86633>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of obligately anaerobic, Gram negative, bacterium assigned to the phylum Bacteroidetes and the family Porphyromonadaceae." ;
    flat:parents "C85955" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Parabacteroides|PARABACTEROIDES" ;
.

ncit:C86634
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86634" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86634>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of obligately anaerobic, Gram-negative, rod shaped bacteria assigned to the phylum Bacteroidetes. This species is indole negative, hydrolyzes starch, requires hemin for growth and reduces resazurin but not neutral red. P. distasonis, also known as Bacteroides distasonis, is a very common commensal microorganism in the human intestine, but can be pathogenic, though it is rare." ;
    flat:parents "C86633" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Parabacteroides distasonis|Bacteroides distasonis|Bacteroides distasonis|PARABACTEROIDES DISTASONIS" ;
.

ncit:C86635
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86635" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86635>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of obligately anaerobic, Gram-negative, rod shaped bacteria assigned to the phylum Bacteroidetes. This species is indole negative, hydrolyzes starch, but not gelatin, requires vitamin K and hemin for growth, hemolytic on rabbit's blood agar, reduces neutral red and resazurin, produces hydrogen sulfide after 5 days, and does not utilize lactate, threonine or gluconate. P. merdae, also known as Bacteroides merdae, is commensal to the human intestinal tract and is rarely associated with infections." ;
    flat:parents "C86633" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Parabacteroides merdae|Bacteroides fragilis T4-1|Bacteroides fragilis T4-1|Bacteroides merdae|Bacteroides merdae|PARABACTEROIDES MERDAE" ;
.

