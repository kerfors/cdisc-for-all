    flat:semantic%20type "Functional Concept" ;
    flat:synonyms "Extraamniotic Route of Administration|EXTRA-AMNIOTIC|EXTRA-AMNIOTIC|EXTRA-AMNIOTIC|Extra-Amniotic|Extra-Amniotic|Extraamniotic use|X-AMNI|X-AMNI" ;
.

