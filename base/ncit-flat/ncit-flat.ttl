.

ncit:C178025
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C178025" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C178025>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A chemical titration method described by van de Kamer, et al. in 1949 in which fecal fat is quantitatively measured by conversion of fecal lipids into fatty acids through saponification with ethanolic potassium hydroxide, release of the free fatty acids by the addition of hydrochloric acid and extraction into ether, and titration of the fatty acids against sodium hydroxide." ;
    flat:parents "C217467|C181463" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Van de Kamer Titration Method|VAN DE KAMER TITRATION METHOD" ;
.

ncit:C178026
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C178026" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C178026>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A technique that is used with flow cytometry to measure cytokine production in isolated cells. Cells are stimulated with an antigen or mitogen, and cytokine secretion is blocked using protein transport inhibitors. The cells are then stained with fluorochrome labeled monoclonal antibodies that target surface markers, fixed and permeabilized, and stained with fluorochrome labeled anti-cytokine monoclonal antibodies prior to analysis by flow cytometry." ;
    flat:parents "C74804|C113003" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Intracellular Cytokine Stain Flow Cytometric Assay|ICS|ICS|INTRACELLULAR CYTOKINE STAIN FLOW CYTOMETRIC ASSAY|Intracellular Cytokine Staining" ;
.

ncit:C178027
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C178027" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C178027>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A type of electrochemiluminescence assay that utilizes primary and secondary antibodies in a two-step binding process." ;
    flat:parents "C111194" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Indirect Binding Electrochemiluminescence Immunoassay|INDIRECT BINDING ELECTROCHEMILUMINESCENCE IMMUNOASSAY" ;
.

ncit:C178028
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C178028" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C178028>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A type of ELISA assay that uses a reference antigen to competitively bind labeled antibody against an antigen of interest. The strength of the signal interference caused by antibody bound to the reference antigen is used to determine the concentration of the antigen of interest." ;
    flat:parents "C16553" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Competitive Enzyme-linked Immunosorbent Assay|COMPETITIVE ELISA|Competitive ELISA|Competitive Immunoassay|Competitive Immunoassay|Inhibition ELISA|Inhibition ELISA" ;
.

ncit:C178029
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C178029" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C178029>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The evaluation of oneself or one's actions or performance without external input." ;
    flat:parents "C25217" ;
    flat:semantic%20type "Activity" ;
    flat:synonyms "Self Assessment|SELF ASSESSMENT" ;
.

ncit:C178030
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C178030" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C178030>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An immunoassay that utilizes the interactions between two molecules, or the binding of molecules to antibodies, to detect and quantify analytes of interest." ;
    flat:parents "C15958" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Ligand Binding Assay|LIGAND BINDING ASSAY" ;
.

ncit:C178031
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C178031" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C178031>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An immunoassay where results can be generated immediately or within minutes from antibody/antigen interactions with an analyte of interest in a biological specimen with little or no sample processing." ;
    flat:parents "C116640" ;
    flat:semantic%20type "Laboratory Procedure" ;
    flat:synonyms "Rapid Immunoassay|RAPID IMMUNOASSAY" ;
.

ncit:C178032
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C178032" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C178032>" ;
    flat:concept%20in%20subset "CDISC SDTM Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized set of ten equivalent paragraphs of text, based on everyday life reading demands with equivalent levels of difficulty, that is used to provide repeat assessments of reading performance for a wide range of subjects. It is available in multiple languages." ;
