ncit:C112397
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112397" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112397>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of enveloped, spherical shaped viruses with surface glycoproteins that are arranged in a T=12 icosahedral symmetrical lattice, in the family Bunyaviridae. The genome is composed of three linear, segmented single-strands of negative sense RNA.  Phelboviruses are mosquito-borne and humans, ruminants and camels are natural hosts. This genus causes influenza-like illness and rarely hemorrhagic fevers in humans." ;
    flat:parents "C112028" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Phlebovirus|PHLEBOVIRUS" ;
.

ncit:C112398
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112398" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112398>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of enveloped, spherical viruses in the family Paramyxoviridae. The genome is composed of a linear single-strand of negative sense RNA.  Pneumoviruses are found in human, cattle and rodents and cause disease of the respiratory tract in humans." ;
    flat:parents "C14308" ;
    flat:semantic%20type "Virus" ;
    flat:synonyms "Pneumovirus|PNEUMOVIRUS" ;
.

ncit:C112399
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112399" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112399>" ;
    flat:concept%20in%20subset "CDISC SDTM Anatomical Location Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The medial aspect of the posterior parietal lobe, which is bounded anteriorly by the marginal branch of the cingulate sulcus, posteriorly by the medial portion of the parieto-occipital fissure and inferiorly by the subparietal sulcus. It is involved in a wide range of higher-order cognitive function, such as episodic memory, visuospatial processing, reflections upon self, and aspects of consciousness." ;
    flat:parents "C13031" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Precuneus|PRECUNEUS" ;
.

ncit:C112400
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C112400" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C112400>" ;
