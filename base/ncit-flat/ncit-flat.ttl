    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86258>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram negative, rod shaped bacterium in the phylum Bacteroidetes and the family Flavobacteriaceae." ;
    flat:parents "C85936" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Chryseobacterium|CHRYSEOBACTERIUM" ;
.

ncit:C86259
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86259" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86259>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod shaped bacteria in the phylum Bacteroidetes. This bacteria is non motile, catalase and oxidase positive, indole positive, hydrolyzes starch and reduces nitrates and nitrites. C. gleum is most commonly found in soil and is rarely pathogenic, causing nosocomial infection in humans." ;
    flat:parents "C86258" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Chryseobacterium gleum|CHRYSEOBACTERIUM GLEUM|Flavobacterium gleum|Flavobacterium gleum" ;
.

ncit:C86260
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86260" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86260>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod shaped bacteria in the phylum Bacteroidetes. This bacteria is nonmotile, catalase and oxidase positive, non-fermentative, indole positive, hydrolyzes starch and can grow on cetrimide agar. C. indologenes is most commonly found in soil and water and is a rare pathogen, associated with meningitis in neonates and premature infants and nosocomial infections in adults." ;
    flat:parents "C86258" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Chryseobacterium indologenes|CHRYSEOBACTERIUM INDOLOGENES|Flavobacterium indologenes|Flavobacterium indologenes" ;
.

ncit:C86261
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86261" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86261>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram negative, rod shaped bacterium in the phylum Proteobacteria and the family Pseudomonadaceae." ;
    flat:parents "C85958" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Chryseomonas|CHRYSEOMONAS|Pseudomonas" ;
.

ncit:C86262
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86262" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86262>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile by peritrichous flagella, oxidase negative, produces acid from fermentation, utilizes citrate as a carbon source, indole positive and negative for H2S production. C. amalonaticus is most commonly found in feces, soil, water and sewage and is an opportunistic pathogen causing urinary tract infections, bacteremia and other systemic infections." ;
    flat:parents "C76273" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Citrobacter amalonaticus|CITROBACTER AMALONATICUS|Levinea amalonatica|Levinea amalonatica" ;
.

ncit:C86263
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86263" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86263>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile by peritrichous flagella, dimethyl reductase and arginine dehydrolase positive, indole variable and does not produce acid from salicin or sucrose. C. braakii is most commonly found in soil, food, water, and the intestinal tract of humans and animals and is an opportunistic pathogen in immunocompromised patients." ;
    flat:parents "C76273" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Citrobacter braakii|CITROBACTER BRAAKII" ;
.

ncit:C86264
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86264" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86264>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile by peritrichous flagella, citrate, indole and adonitol positive, hydrogen sulfide negative in Kliger's agar, phenylalanine negative and does not grow in KCN medium. C. farmeri is most commonly found in water, sewage, soil, and food and is an opportunistic, nosocomial pathogen." ;
    flat:parents "C76273" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Citrobacter farmeri|CITROBACTER FARMERI|Citrobacter amalonaticus Biogroup 1|Citrobacter amalonaticus Biogroup 1" ;
.

ncit:C86265
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86265" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86265>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile by peritrichous flagella, oxidase negative, catalase positive, grows in KCN medium, and successfully ferment sucrose, raffinose and melibiose. C. freundii is most commonly found in water, sewage, soil and food and is an opportunistic pathogen in neonates and immunocompromised patients." ;
    flat:parents "C76273" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Citrobacter freundii|CITROBACTER FREUNDII|Colobactrum freundii|Colobactrum freundii" ;
.

ncit:C86266
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86266" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86266>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A non taxonomic grouping of bacteria assigned to and including eight related species from the Citrobacter genus." ;
    flat:parents "C76273" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Citrobacter freundii Complex|CITROBACTER FREUNDII COMPLEX" ;
.

ncit:C86267
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86267" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86267>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile by peritrichous flagella, does not produce H2S in TSI agar, grows in media containing KCN, produces acid from adonitol and D-arabitol and does not decarboxylate lysine. C. koseri is found in soil, water, sewage and food and is a commensal organism of the urinary and gastrointestinal tracts of humans but may become pathogenic in immunocompromised individuals." ;
    flat:parents "C76273" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Citrobacter koseri|CITROBACTER KOSERI|Citrobacter diversus|Citrobacter diversus" ;
.

ncit:C86268
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86268" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86268>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile by peritrichous flagella, indole negative, ornithine decarboxylase negative and produces acid from dulcitol but not melibiose. C. youngae is a commensal organism of the gastrointestinal tract and may cause nosocomial infections." ;
    flat:parents "C76273" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Citrobacter youngae|CITROBACTER YOUNGAE" ;
.

ncit:C86269
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86269" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86269>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile, sporulating and produces acetone, butanol and ethanol in fermentation systems using maize mash, molasses, and other feedstocks. C. acetobutylicum is found commonly in soil, lake sediment, well water, and bovine, canine, and human feces." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium acetobutylicum|CLOSTRIDIUM ACETOBUTYLICUM" ;
.

ncit:C86270
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86270" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86270>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile, produces the type F toxin, does not hydrolyze gelatin, does not produce acid from trehalose, hydrolyzes esculin and reduces nitrate. C. baratii is an emerging human pathogen and a causative agent of botulism." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium baratii|CLOSTRIDIUM BARATII|Clostridium barati|Clostridium barati" ;
.

ncit:C86271
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86271" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86271>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile, sporulating, sacchrolytic, mesophilic, and produces acetate, butanol, ethanol, acetoin and acetyl methyl carbonil from fermentation. C. beijerinckii is found in the soil and feces and is an important organism used in commercial solvent production." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium beijerinckii|CLOSTRIDIUM BEIJERINCKII" ;
.

ncit:C86272
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86272" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86272>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is spore-forming, motile, produces low levels of indole and ferments mannose. C. bifermentans is found in cases of gaseous gangrene and in rotting meat." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium bifermentans|CLOSTRIDIUM BIFERMENTANS|Paraclostridium bifermentans" ;
.

ncit:C86273
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86273" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86273>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of strictly anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is motile, produces the type E toxin, can only grow in the absence of oxygen, produces butyric acid, forms endospores and ferments granulose. C. butyricum is a causative agent of botulism." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium butyricum|CLOSTRIDIUM BUTYRICUM|Clostridium pseudotetanicum|Clostridium pseudotetanicum" ;
.

ncit:C86274
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86274" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86274>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is indole positive, hydrolyzes gelatin, does not hydrolyze esculin and does not ferment mannose, sorbitol or trehalose. C. cadaveris is generally considered non-pathogenic but may be an emerging pathogen in immunocompromised individuals." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium cadaveris|CLOSTRIDIUM CADAVERIS" ;
.

ncit:C86275
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86275" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86275>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is non-motile, sporeforming, urease positive, catalase and indole negative and reduces sulfites and nitrates. C. celatum is part of the normal flora of the gastrointestinal tract and has been isolated from clinically normal human feces." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium celatum|CLOSTRIDIUM CELATUM" ;
.

ncit:C86276
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86276" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86276>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is nonsporulating, urease and catalase negative, weakly indole positive, ferments mannose and raffinose, is resistant to penicillin G and may appear gram variable due to staining difficulty. C. clostridioforme is part of the RIC group of clostridium, is considered to be pathogenic and is typically found with, and must be identified separately from, Clostridium bolteae and Clostridium hathewayi." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium clostridioforme|CLOSTRIDIUM CLOSTRIDIOFORME|Clostridium clostridiiforme|Clostridium clostridiiforme" ;
.

ncit:C86277
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86277" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86277>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is sporulating, produces glutamate mutase, hydrolyzes gelatin, is indole positive, lecithinase and lipase negative and does not ferment inositol, glucose or maltose. C. cochlearium is pathogenic." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium cochlearium|CLOSTRIDIUM COCHLEARIUM" ;
.

ncit:C86278
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86278" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86278>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is urease and lipase negative, ferments cellobiose, fructose, galactose but not mannitol, hydrolyzes esculin, degrades mucin in the gastrointestinal tract and may appear helically coiled under the microscope. C. cocleatum is a component of the intestinal microflora but may provide a mechanism by which other bacteria can colonize and infect, through its mucin degrading properties." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium cocleatum|CLOSTRIDIUM COCLEATUM" ;
.

ncit:C86279
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86279" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86279>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is indole negative, produces a weak exotoxin and is positive for nitrite reaction. C. fallax is pathogenic when exposed to open wounds on the body and is the causative agent of black leg disease in sheep as well as gas oedema." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium fallax|CLOSTRIDIUM FALLAX|Clostridium pseudofallax|Clostridium pseudofallax" ;
.

ncit:C86280
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86280" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86280>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of strictly anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is endospore forming, utilizes ethylene glycol as an energy source, is indole and catalase negative and does not hydrolyze esculin. C. glycolicum is an opportunistic pathogen in immunocompromised individuals and individuals with open wounds." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium glycolicum|CLOSTRIDIUM GLYCOLICUM|Terrisporobacter glycolicus" ;
.

ncit:C86281
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86281" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86281>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile, produces the type G toxin and is hemolytic. C. haemolyticum is found in soil and water and is pathogenic, being the causative agent of Red Water disease in grazing animals." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium haemolyticum|CLOSTRIDIUM HAEMOLYTICUM" ;
.

ncit:C86282
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86282" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86282>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is indole negative, liquefies gelatin, does not reduce nitrate and does not produce acid from lactose or ribose. C. histolyticum is pathogenic when exposed to open wounds on the body but not upon ingestion." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium histolyticum|CLOSTRIDIUM HISTOLYTICUM" ;
.

ncit:C86283
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86283" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86283>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is nonsporulating, urease, catalase and indole negative, ferments mannose but not raffinose, does not reduce nitrate, is pyrrolidonyl positive and may appear gram variable due to staining difficulty. C. innocuum is part of the RIC group of clostridium and is an opportunistic pathogen." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium innocuum|CLOSTRIDIUM INNOCUUM" ;
.

ncit:C86284
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86284" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86284>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is lecithinase positive, indole and lipase negative, hydrolyzes gelatin and does not ferment inositol, glucose or maltose. C. limosum is pathogenic and has been isolated from soil." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium limosum|CLOSTRIDIUM LIMOSUM|Clostridium Species CDC Group P-1" ;
.

ncit:C86285
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86285" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86285>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of obligately anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is endospore forming, hemolytic, requires the presence of thiols to grow in culture and produces a variety of toxins. C. novyi is pathogenic, causing gas gangrene within wounds and in individuals with diabetes." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium novyi|CLOSTRIDIUM NOVYI" ;
.

ncit:C86286
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86286" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86286>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is indole negative, ferments cellobiose, glucose, mannose and maltose but not ribose and does not reduce nitrate. C. oceanicum is considered non-pathogenic and has been isolated from marine sediments." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium oceanicum|CLOSTRIDIUM OCEANICUM" ;
.

ncit:C86287
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86287" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86287>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is endochitinase positive, mesophilic, hydrolyzes starch, reduces nitrate and is indole positive. C. paraputrificum is pathogenic in humans but not in rabbits or guinea pigs." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium paraputrificum|CLOSTRIDIUM PARAPUTRIFICUM" ;
.

ncit:C86288
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86288" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86288>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile, hydrolyzes gelatin, produces enterotoxin, is beta-hemolytic and catalase negative. C. perfringens is a food borne pathogen, being the causative agent of pig-bel syndrome and gas gangrene." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium perfringens|CLOSTRIDIUM PERFRINGENS|Clostridium welchii|Clostridium welchii" ;
.

ncit:C86289
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86289" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86289>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is indole negative, ferments glucose but not mannose and does not reduce nitrate. C. putrificum is considered pathogenic and may cause post-operative tetanus." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium putrificum|Botulobacillus botulinus|CLOSTRIDIUM PUTRIFICUM|Clostridium botulinum|Clostridium botulinum|Clostridium lentoputrescens|Clostridium lentoputrescens|Ermengemillus botulinus" ;
.

ncit:C86290
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86290" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86290>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is nonsporulating, urease, catalase and indole negative, pyrrolidonyl negative, does not reduce nitrate, weakly ferments mannose and raffinose and may appear gram variable due to staining difficulty. C. ramosum is part of the RIC group of clostridium and is an opportunistic pathogen." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium ramosum|Actinomyces ramosus|Actinomyces ramosus|Bacillus ramosus|CLOSTRIDIUM RAMOSUM|Erysipelatoclostridium ramosum|Nocardia ramosa|Ramibacterium ramosum" ;
.

ncit:C86291
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86291" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86291>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species can degrade lindane, a scabicide." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium rectum|CLOSTRIDIUM RECTUM" ;
.

ncit:C86292
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86292" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86292>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is sporeforming, hemolytic, produces exotoxins and is lecithinase, lipase, indole and urease negative. C. septicum is highly pathogenic; infection is most commonly associated with paraneoplastic syndrome and it is also a causative agent of gas gangrene." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium septicum|CLOSTRIDIUM SEPTICUM" ;
.

ncit:C86293
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86293" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86293>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is variably motile by peritrichous flagella, endosporeforming, catalase and lipase negative and nearly all strains do not ferment maltose. C. sordelli is a rare human pathogen, causing toxic shock syndrome most often associated with gynecological infections in females." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium sordellii|CLOSTRIDIUM SORDELLII|Paeniclostridium sordellii" ;
.

ncit:C86294
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86294" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86294>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is proteolytic, does not produce botulinum toxin, is beta-hemolytic and positive for indole. C. sporogenes is pathogenic and culture is associated with a foul odor." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium sporogenes|CLOSTRIDIUM SPOROGENES" ;
.

ncit:C86295
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86295" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86295>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Proteobacteria. This species is spore forming, motile, produces the type G toxin, does not hydrolyze esculin and is beta-hemolytic. C. subterminale is isolated from soil and is pathogenic, being a causative agent of botulism." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium subterminale|CLOSTRIDIUM SUBTERMINALE" ;
.

ncit:C86296
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86296" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86296>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is sporeforming, motile by flagella, indole negative, nonhemolytic, does not hydrolyze esculin and produces acid from glucose, mannose, fructose and galactose. C. symbiosum is an emerging pathogen but rarely isolated from clinical specimens." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium symbiosum|Bacteroides symbiosus|Bacteroides symbiosus|CLOSTRIDIUM SYMBIOSUM" ;
.

ncit:C86297
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86297" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86297>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is aerotolerant, non-exotoxin producing, ferments glucose, lactose, maltose and sucrose, reduces nitrate and is nonproteolytic. C. tertium has traditionally been considered nonpathogenic but has since been designated an emerging pathogen in immunocompromised and wound patients, causing necrotizing fasciitis and gas gangrene." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium tertium|CLOSTRIDIUM TERTIUM" ;
.

ncit:C86298
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86298" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86298>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Established Names and Unique Ingredient Identifier Codes Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is motile by peritrichous flagella, indole and lipase positive, lecithinase negative, hydrolyzes gelatin, ferments inositol and does not ferment glucose or maltose. C. tetani may colonize the intestinal tract of humans and is pathogenic, being the causative agent of Tetanus infection." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium tetani|CLOSTRIDIUM TETANI|CLOSTRIDIUM TETANI" ;
.

ncit:C86299
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86299" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86299>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is sporulating, ferments glucose and xylose and produces butyric acid and acetic acid as fermentation by-products. C. tyrobutyricum is present in milk and causes late-blowing defect in cheeses with high pH leading to product loss." ;
    flat:parents "C76275" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Clostridium tyrobutyricum|CLOSTRIDIUM TYROBUTYRICUM" ;
.

ncit:C86300
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86300" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86300>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of anaerobic, Gram positive, rod shaped bacterium in the phylum Actinobacteria and the family Coriobacteriaceae." ;
    flat:parents "C85927" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Collinsella|COLLINSELLA" ;
.

ncit:C86301
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86301" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86301>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of obligately anaerobic, Gram positive, rod shaped bacterium in the phylum Actinobacteria. This species is non-motile, nonsporulating, produces acid from maltose, lactose and glucose but not xylose, glycogen, sorbitol or inositol. C. aerofaciens is part of the intestinal microflora of humans and animals and is not considered to be pathogenic." ;
    flat:parents "C86300" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Collinsella aerofaciens|COLLINSELLA AEROFACIENS|Eubacterium aerofaciens|Eubacterium aerofaciens" ;
.

ncit:C86302
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86302" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86302>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacterium in the phylum Actinobacteria. This species is leucine arylamidase positive, lipase and trypsin negative, nonsporulating, non-motile, produces acid from ribose, glucose, mannose, cellobiose and salicin but not from maltose, lactose, trehalose, esculin or amygdalin. C. intestinalis is part of the intestinal microflora of humans and animals and is not considered to be pathogenic." ;
    flat:parents "C86300" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Collinsella intestinalis|COLLINSELLA INTESTINALIS" ;
.

ncit:C86303
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86303" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86303>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram negative, rod and cocci shaped bacterium assigned to the phylum Proteobacteria and the family Comamonadaceae." ;
    flat:parents "C85926" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Comamonas|COMAMONAS" ;
.

ncit:C86304
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86304" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86304>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod and cocci shaped bacterium assigned to the phylum Proteobacteria. This species is motile by polar, lophotrichous flagella, catalase-peroxidase, catalase and oxidase positive, degrades phenol and reduces nitrate. C. terrigena is found in soil and rarely found to be pathogenic in humans." ;
    flat:parents "C86303" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Comamonas terrigena|CDC Group EF-19|COMAMONAS TERRIGENA" ;
.

ncit:C86305
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86305" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86305>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod and cocci shaped bacterium assigned to the phylum Proteobacteria. This species is oxidase positive, non-fermenting and grows in plates containing testosterone. C. testosteroni is found in soil and water, is used in industry to breakdown industrial by-products, and is rarely found to be pathogenic in humans." ;
    flat:parents "C86303" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Comamonas testosteroni|COMAMONAS TESTOSTERONI|Pseudomonas testosteroni|Pseudomonas testosteroni" ;
.

ncit:C86306
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86306" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86306>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, oxidase negative, pyrazinamidase positive, reduces nitrate, urease negative, lipophilic, ferments glucose, but does not hydrolyze esculin. C. accolens is commensal in the upper respiratory tract, but can become pathogenic and has been isolated from infected wounds." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium accolens|CDC Coryneform Group G-1|CORYNEBACTERIUM ACCOLENS|Corynebacterium Group G-1" ;
.

ncit:C86307
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86307" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86307>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, oxidase, urease, indole and esculin negative, does not reduce nitrate, is non-fermenting, non-acid fast, and does not produce hydrogen sulfide; some subspecies are lipophilic and others non-lipophilic. C. afermentans is commensal, but can become pathogenic and has been associated with prosthetic valve endocarditis." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium afermentans|CORYNEBACTERIUM AFERMENTANS|Corynebacterium ANF-1|Corynebacterium ANF-1" ;
.

ncit:C86308
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86308" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86308>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase and urease positive, oxidase negative, non-acid fast, non-lipophilic, and does not produce hippurate. C. amycolatum is commensal to the human skin and mucous membranes and is known to cause prosthetic joint related infections, and pneumonia, especially in immunocompromised persons." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium amycolatum|CORYNEBACTERIUM AMYCOLATUM" ;
.

ncit:C86309
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86309" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86309>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase and pyrazinamidase positive, oxidase and urease negative, non-lipophilic, does not reduce nitrate, nor hydrolyze esculin, but does hydrolyze hippurate, and ferments glucose. C. argentoratense is commensal to the oropharyngeal region." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium argentoratense|CORYNEBACTERIUM ARGENTORATENSE" ;
.

ncit:C86310
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86310" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86310>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, oxidase negative, pyrazinamidase positive, does not reduce nitrate, negative for urease, ferments glucose, but does not hydrolyze esculin. C. auris is associated with ear infections in the younger population." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium auris|CORYNEBACTERIUM AURIS" ;
.

ncit:C86311
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86311" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86311>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, oxidase positive, slow growing, urease positive, and lipophilic. C. bovis is commensal to the bovine udder, but can be pathogenic in bovine and other species, including humans." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium bovis|CORYNEBACTERIUM BOVIS" ;
.

ncit:C86312
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86312" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86312>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Established Names and Unique Ingredient Identifier Codes Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, non-lipophilic, produces diphtheria toxin which inhibits elongation factor 2 (EF-2) thus preventing protein synthesis, forms polar granules, and is cultured in Loeffler's serum in a low iron environment or on tellurite agar. C diphtheriae is commensal in the skin and nasopharynx, but toxin producing strains are pathogenic to humans causing diphtheria; both an antitoxin and vaccine are available for disease prevention." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium diphtheriae|CORYNEBACTERIUM DIPHTHERIAE|CORYNEBACTERIUM DIPHTHERIAE" ;
.

ncit:C86313
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86313" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86313>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, and not acid fast. Some C. genitalium strains are commensal in the urinary tract while other strains are associated with urinary tract infections." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium genitalium|CORYNEBACTERIUM GENITALIUM" ;
.

ncit:C86314
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86314" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86314>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, reduces nitrate, hydrolyzes urea and esculin, is pyrazinamidase positive, and is negative for the CAMP test. C. kutscheri is commensal in rodent species and is associated with infections from rat bites." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium kutscheri|CORYNEBACTERIUM KUTSCHERI" ;
.

ncit:C86315
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86315" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86315>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, oxidase negative, urease negative, pyrazinamidase negative, lipophilic, does not hydrolyze esculin, ferments glucose and sucrose, and reduces nitrate. C. macginleyi is commensal to the ocular conjunctiva, but is also an opportunistic pathogen that causes conjunctivitis, corneal ulcerations, keratitis, endophthalmitis, septicemia and catheter related infections." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium macginleyi|CORYNEBACTERIUM MACGINLEYI" ;
.

ncit:C86316
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86316" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86316>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, reduces nitrate, does not produce hydrogen sulfide, non-lipophilic, and is indole negative. C. matruchotii is present in human dental plaques." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium matruchotii|Bacterionema matruchotii|Bacterionema matruchotii|CORYNEBACTERIUM MATRUCHOTII" ;
.

ncit:C86317
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86317" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86317>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming catalase and pyrazinamidase positive, indole and urease negative, non-lipophilic, does not reduce nitrate, ferments glucose, sucrose and maltose, hydrolyzes hippurate, but not casein or gelatin. C. minutissimum causes erythrasma and pruritic scaly rashes in diabetic patients." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium minutissimum|CORYNEBACTERIUM MINUTISSIMUM" ;
.

ncit:C86318
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86318" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86318>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase and urease positive, oxidase and indole negative, reduces nitrate and nitrite, hydrolyzes hippurate and starch, but not gelatin or casein, and does not produce hydrogen sulfide. C. pilosum causes urinary tract infection and pyelonephritis." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium pilosum|CORYNEBACTERIUM PILOSUM" ;
.

ncit:C86319
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86319" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86319>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, oxidase negative, non-acid fast, non-lipophilic, reduces nitrate, does not hydrolyze urea, starch, or gelatin, and does not ferment glucose, sucrose, or maltose. C. propinquum is commensal to the oropharyngeal flora." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium propinquum|CORYNEBACTERIUM PROPINQUUM" ;
.

ncit:C86320
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86320" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86320>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, oxidase negative, pyrazinamidase positive, non-lipophilic, reduces nitrate, urease positive, does not ferment glucose, sucrose, or maltose, and is reverse CAMP positive. C. pseudodiphtheriticum is commensal in the nasopharynx and is known to cause lower respiratory infections and endocarditis." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium pseudodiphtheriticum|CORYNEBACTERIUM PSEUDODIPHTHERITICUM|Corynebacterium hofmannii|Corynebacterium hofmannii" ;
.

ncit:C86321
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86321" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86321>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase and urease positive, oxidase and pyrazinamidase negative, non-lipophilic, reduces nitrate, and does not hydrolyze gelatin. C. pseudotuberculosis is known to cause caseous lymphadenitis in animals and can be pathogenic in humans." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium pseudotuberculosis|CORYNEBACTERIUM PSEUDOTUBERCULOSIS" ;
.

ncit:C86322
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86322" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86322>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, urease positive, pyrazinamidase positive, does not reduce nitrate, indole negative, non-lipophilic, ferments glucose, does not produce hydrogen sulfide, and does not hydrolyze gelatin. C. renale is an opportunistic pathogen that causes ascending urinary infection, pyelonephritis and abscesses." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium renale|CORYNEBACTERIUM RENALE" ;
.

ncit:C86323
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86323" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86323>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, urease negative, pyrazinamidase positive, reduces nitrate, ferments glucose and sucrose, non-lipophilic, indole negative, and hydrolyzes gelatin. C. striatum is commensal in the skin and nasal flora and is a pathogen known to cause bacteremia in immunocompromised patients with respiratory infections, skin ulcers, or during surgery." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium striatum|CORYNEBACTERIUM STRIATUM" ;
.

ncit:C86324
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86324" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86324>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, oxidase negative, does not reduce nitrate, hydrolyzes gelatin and hippurate but not urease or esculin and is not acid fast. C. ulcerans is commensal to the animal and human nasopharynx, but toxin producing strains can cause diphtherial-like illness." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium ulcerans|CORYNEBACTERIUM ULCERANS" ;
.

ncit:C86325
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86325" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86325>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, oxidase negative, pyrazinamidase positive, does not reduce nitrate, lipophilic, does not hydrolyze esculin or gelatin, and does not ferment glucose, maltose, or sucrose. C. urealyticum is commensal to the human skin and is known to cause urinary tract infections, kidney stones and pneumonia." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium urealyticum|CDC Coryneform Group D-2|CDC Group D2|CORYNEBACTERIUM UREALYTICUM|Corynebacterium Group D-2" ;
.

ncit:C86326
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86326" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86326>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram-positive, coryneform, pleomorphic bacilli assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, pyrazinamidase positive, reduces nitrate, urease negative, non-lipophilic, does not hydrolyze esculin or gelatin, and ferments glucose, sucrose and maltose. C. xerosis is commensal to the nasopharynx and skin in humans and is known to cause bacteremia, soft tissue infections, endocarditis, pharyngitis, and pneumonia especially in immunocompromised persons." ;
    flat:parents "C76308" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Corynebacterium xerosis|CORYNEBACTERIUM XEROSIS" ;
.

ncit:C86327
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86327" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86327>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Any bacteria whose shape is similar to those bacteria assigned to the Corynebacterium genus and have a cell wall that contains low levels of peptidoglycan and stains pink with the Gram staining technique." ;
    flat:parents "C62589" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Coryneform Gram Positive Bacillus|CORYNEFORM GRAM-POSITIVE BACILLUS|Coryneform Gram-Positive Rod|Coryneform Gram-positive Rod" ;
.

ncit:C86328
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86328" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86328>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, coccobacilli shaped bacteria in the phylum Proteobacteria. This species is obligately intracellular, sporeforming, acidophilic, pleomorphic and catalase positive. C. burnetti is pathogenic, being the causative agent of Q fever." ;
    flat:parents "C76309" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Coxiella burnetii|COXIELLA BURNETII" ;
.

ncit:C86329
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86329" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86329>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria in the phylum Proteobacteria. This species is obligately intracellular, acidophilic, indole negative and utilizes lactulose and putrescine as carbon sources. C. sakazakii is pathogenic, being the causative agent of meningitis and necrotizing enterocolitis, and is associated with tainted powdered infant formulas." ;
    flat:parents "C85974" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Cronobacter sakazakii|CRONOBACTER SAKAZAKII|Enterobacter sakazakii|Enterobacter sakazakii" ;
.

ncit:C86330
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86330" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86330>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram negative, rod and cocci shaped bacterium assigned to the phylum Proteobacteria and the family Burkholderiaceae." ;
    flat:parents "C85920" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Cupriavidus|CUPRIAVIDUS" ;
.

ncit:C86331
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86331" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86331>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod and coccus shaped bacterium assigned to the phylum Proteobacteria. This species is motile non-fermentative, oxidase and catalase positive, does not reduce nitrate and is indole negative. C. pauculus is found in water and has rarely been associated with human infection but may be considered pathogenic in immunocompromised individuals." ;
    flat:parents "C86330" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Cupriavidus pauculus|CDC Group IVC-2|CDC Group IVc-2|CUPRIAVIDUS PAUCULUS|Ralstonia paucula|Ralstonia paucula|Wautersia paucula|Wautersia paucula" ;
.

ncit:C86332
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86332" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86332>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria and the family Comamonadaceae." ;
    flat:parents "C85926" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Delftia|DELFTIA" ;
.

ncit:C86333
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86333" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86333>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria. This species is motile by polar or bi-polar tufts of flagella, does not hydrolyze esculin, indole negative and oxidase and catalase positive. D. acidovorans is found in soil and water and has been shown to be pathogenic in immunocompromised individuals." ;
    flat:parents "C86332" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Delftia acidovorans|Comamonas acidovorans|Comamonas acidovorans|DELFTIA ACIDOVORANS|Pseudomonas acidovorans|Pseudomonas acidovorans" ;
.

ncit:C86334
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86334" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86334>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram positive, rod and cocci shaped bacterium assigned to the phylum Actinobacteria and the family Dermabacteraceae." ;
    flat:parents "C85928" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Dermabacter|DERMABACTER" ;
.

ncit:C86335
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86335" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86335>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod and cocci shaped bacterium assigned to the phylum Actinobacteria. This species is catalase positive, ferments glucose and variably ferments xylose and does not reduce nitrate. D. hominis is an opportunistic pathogen in immunocompromised individuals." ;
    flat:parents "C86334" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Dermabacter hominis|DERMABACTER HOMINIS" ;
.

ncit:C86336
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86336" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86336>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, cocci shaped bacterium in the phylum Actinobacteria. This species is catalase, urease and oxidase positive, coagulase negative grows bright orange colonies in culture, does not hydrolyze esculin and is indole negative. D. nishinomiyaensis is found in water and on the skin of mammals and is considered to be non-pathogenic." ;
    flat:parents "C85975" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Dermacoccus nishinomiyaensis|DERMACOCCUS NISHINOMIYAENSIS|Micrococcus nishinomiyaensis|Micrococcus nishinomiyaensis" ;
.

ncit:C86337
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86337" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86337>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram positive, cocci shaped bacterium in the phylum Actinobacteria and the family Dermatophilaceae." ;
    flat:parents "C85930" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Dermatophilus|DERMATOPHILUS" ;
.

ncit:C86338
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86338" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86338>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, cocci shaped bacterium in the phylum Actinobacteria. This species is catalase positive, urease negative, slightly beta-hemolytic weekly ferments xylose. D. congolensis is pathogenic, being the causative agent of Dermatophilosis, also called Mud fever and Rainscald." ;
    flat:parents "C86337" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Dermatophilus congolensis|DERMATOPHILUS CONGOLENSIS" ;
.

ncit:C86339
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86339" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86339>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|CTRP Biomarker Terminology|CTRP Terminology" ;
    flat:definition "A genus of anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria and the family Desulfovibrionaceae." ;
    flat:display%20name "Desulfovibrio" ;
    flat:parents "C85931" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Desulfovibrio|DESULFOVIBRIO|Desulfomonas|Desulfomonas species" ;
.

ncit:C86340
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86340" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86340>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria. This species is motile by single polar flagellum, reduces sulfate and is catalase positive. D. desulfuricans is an infrequent pathogen and may be important in manufacturing for the bioreduction of metals including Uranium and Palladium. Phenotypically, it is indistinguishable from Desulfovibrio fairfieldensis." ;
    flat:parents "C86339" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Desulfovibrio desulfuricans|DESULFOVIBRIO DESULFURICANS" ;
.

ncit:C86341
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86341" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86341>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria. This species is motile, catalase positive, oxidase, urease and indole negative, produces hydrogen sulfide and is asaccharolytic. D. fairfieldensis is a commensal organism of the intestinal tract and is rarely seen to cause clinical disease." ;
    flat:parents "C86339" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Desulfovibrio fairfieldensis|DESULFOVIBRIO FAIRFIELDENSIS" ;
.

ncit:C86342
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86342" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86342>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria. This species is nonmotile, non-hemolytic and cannot reduce sulfate in the presence of acetate alone. D. piger has mostly been isolated from human clinical specimens and may be associated with inflammatory bowel disease." ;
    flat:parents "C86339" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Desulfovibrio piger|DESULFOVIBRIO PIGER|Desulfomonas pigra|Desulfomonas pigra" ;
.

ncit:C86343
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86343" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86343>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Any of a number of rod shaped bacteria that resemble Corynebacterium diphtheriae, either in morphology or etiology." ;
    flat:parents "C14329" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Diptheroid Bacillus|DIPHTHEROID BACILLUS" ;
.

ncit:C86344
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86344" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86344>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria and the family Enterobacteriaceae." ;
    flat:parents "C85932" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Edwardsiella|EDWARDSIELLA" ;
.

ncit:C86345
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86345" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86345>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria. This species is motile by peritrichous flagella, indole and oxidase negative and catalase positive. E. hoshinae is an occasional opportunist pathogen in humans and a pathogen in reptiles and amphibians." ;
    flat:parents "C86344" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Edwardsiella hoshinae|EDWARDSIELLA HOSHINAE" ;
.

ncit:C86346
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86346" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86346>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria. This species is nonmotile, indole, urease and oxidase negative, catalase positive and reduces nitrate. E. ictaluri is pathogenic in catfish." ;
    flat:parents "C86344" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Edwardsiella ictaluri|EDWARDSIELLA ICTALURI" ;
.

ncit:C86347
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86347" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86347>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria. This species is motile by peritrichous flagella, indole positive and hemolytic in culture. E. tarda is found in the intestinal tracts of snakes and seals and is a causative agent of gastroenteritis in humans." ;
    flat:parents "C86344" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Edwardsiella tarda|EDWARDSIELLA TARDA" ;
.

ncit:C86348
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86348" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86348>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|CTRP Biomarker Terminology|CTRP Terminology" ;
    flat:definition "A genus of aerobic, Gram positive, rod shaped bacterium in the phylum Actinobacteria and the family Coriobacteriaceae." ;
    flat:display%20name "Eggerthella" ;
    flat:parents "C85927" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Eggerthella|EGGERTHELLA" ;
.

ncit:C86349
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86349" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86349>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, rod shaped bacterium in the phylum Actinobacteria. This species is non-fermenting, liquefies gelatin, reduces nitrate, does not hydrolyzes esculin or starch, nonhemolytic and catalase negative. E. lenta is a commensal organism of the gastrointestinal tract and is rarely associated with infections." ;
    flat:parents "C86348" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Eggerthella lenta|EGGERTHELLA LENTA|Eubacterium lentum|Eubacterium lentum" ;
.

ncit:C86350
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86350" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86350>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria and the family Neisseriaceae." ;
    flat:parents "C85950" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Eikenella|EIKENELLA" ;
.

ncit:C86351
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86351" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86351>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria. This species is oxidase positive, catalase, urease and oxidase negative, indole negative and reduces nitrate. E. corrodens is generally classified as a commensal organism of the mouth and upper respiratory tract but may cause disease in patients with cancer." ;
    flat:parents "C86350" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Eikenella corrodens|CDC Group HB-1|EIKENELLA CORRODENS" ;
.

ncit:C86352
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86352" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86352>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of obligately aerobic, Gram negative, rod shaped bacterium in the phylum Bacteroidetes and the family Flavobacteriaceae." ;
    flat:parents "C85936" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Elizabethkingia|ELIZABETHKINGIA" ;
.

ncit:C86353
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86353" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86353>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of obligately aerobic, Gram negative, rod shaped bacterium in the phylum Bacteroidetes. This species is catalase, oxidase and indole positive, does not reduce nitrate, urease negative and hydrolyzes esculin. E. meningoceptica is pathogenic, being the causative agent of meningitis in newborns." ;
    flat:parents "C86352" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Elizabethkingia meningoceptica|Chryseobacterium meningosepticum|Chryseobacterium meningosepticum|ELIZABETHKINGIA MENINGOCEPTICA|Flavobacterium meningosepticum|Flavobacterium meningosepticum" ;
.

ncit:C86354
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86354" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86354>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram negative, rod or cocci shaped bacterium assigned to the phylum Bacteroidetes and the family Flavobacteriaceae." ;
    flat:parents "C85936" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Empedobacter|EMPEDOBACTER" ;
.

ncit:C86355
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86355" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86355>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod or cocci shaped bacterium assigned to the phylum Bacteroidetes. This species is resistant to colistin, hydrolyzes gelatin, does not hydrolyze esculin, urease negative and produces acid from glucose and maltose. E. brevis is involved in nosocomial infections, being a causative agent of meningitis." ;
    flat:parents "C86354" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Empedobacter brevis|EMPEDOBACTER BREVIS|Flavobacterium breve|Flavobacterium breve" ;
.

ncit:C86357
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86357" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86357>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium in the phylum Proteobacteria. This species is motile by peritrichous flagella, ferments lactose, indole negative, lysine decarboxylase negative and does not produce acid from sorbitol. E. amnigenus is an opportunistic pathogen in humans and can be found in water and soil." ;
    flat:parents "C76310" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterobacter amnigenus|ENTEROBACTER AMNIGENUS|Enterobacter amnigenus I|Lelliottia amnigena" ;
.

ncit:C86358
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86358" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86358>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium in the phylum Proteobacteria. This species is nonmotile, oxidase negative, ferments sucrose, hydrolyzes esculin and reduces nitrate. E. asburiae is endophytic in many plant species and an opportunistic pathogen in humans, causing community acquired pneumonia." ;
    flat:parents "C76310" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterobacter asburiae|CDC Enteric Group 17|CDC Enteric Group 17|ENTEROBACTER ASBURIAE" ;
.

ncit:C86359
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86359" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86359>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium in the phylum Proteobacteria. This species is motile by peritrichous flagella, catalase positive, reduces nitrate, hydrolyzes esculin, oxidase, indole and urease negative and not susceptible to erythromycin and penicillin. E. cancerogenus was isolated from the tree Populus canadensis and is known to cause infection in cases of severe trauma." ;
    flat:parents "C76310" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterobacter cancerogenus|CDC Enteric Group 19|CDC Enteric Group 19|ENTEROBACTER CANCEROGENUS|Enterobacter taylorae|Enterobacter taylorae" ;
.

ncit:C86360
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86360" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86360>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium in the phylum Proteobacteria. This species is motile by peritrichous flagella, oxidase, urease and indole negative, catalase positive, reduces nitrate, does not degrade pectate and produces acid from sorbitol. E. cloacae is associated with hospital-acquired urinary and respiratory tract infections and is used in industry for explosives biodegradation." ;
    flat:parents "C76310" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterobacter cloacae|ENTEROBACTER CLOACAE|Enterobacter cloacae Strain 1" ;
.

ncit:C86361
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86361" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86361>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium in the phylum Proteobacteria. This species is motile, indole negative, hydrolyzes esculin, oxidase negative, reduces nitrate and does not grow in culture in the presence of potassium cyanide. E. gergoviae is a common nosocomial pathogen, causing urinary tract infections." ;
    flat:parents "C76310" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterobacter gergoviae|ENTEROBACTER GERGOVIAE|Pluralibacter gergoviae" ;
.

ncit:C86362
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86362" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86362>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium in the phylum Proteobacteria. This species is motile, indole negative, does not hydrolyze gelatin, reduces nitrate and produces acid from mucate. E. hormachei is an opportunistic pathogen, causing nosocomial infections." ;
    flat:parents "C76310" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterobacter hormaechei|CDC Enteric Group 75|CDC Enteric Group 75|ENTEROBACTER HORMAECHEI" ;
.

ncit:C86364
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86364" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86364>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-positive, cocci shaped bacteria in the phylum Firmicutes. This species is nonmotile, non-spore forming, catalase negative, hydrolyzes esculin, but not starch or hippurate, produces hydrogen sulfide, and does not reduce nitrate. E. avium has been isolated from chicken feces and is commensal in the human GI tract, but can be pathogenic to humans and in some cases is vancomycin resistant." ;
    flat:parents "C76311" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterococcus avium|ENTEROCOCCUS AVIUM|Streptococcus avium|Streptococcus avium" ;
.

ncit:C86365
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86365" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86365>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-positive, cocci shaped bacteria in the phylum Firmicutes. This species is motile, non-spore forming, catalase negative, esculin positive, hippurate positive, does not produce hydrogen sulfide, does not reduce nitrate and does not hydrolyze casein, gelatin or urea. E. casseliflavus has been isolated from plants, silage, soil and is commensal in the human GI tract, but has been associated with various human infections and has low level vancomycin resistance." ;
    flat:parents "C76311" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterococcus casseliflavus|ENTEROCOCCUS CASSELIFLAVUS|Enterococcus flavescens" ;
.

ncit:C86366
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86366" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86366>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-positive, cocci shaped bacteria in the phylum Firmicutes. This species is nonmotile, non-spore forming, catalase negative, and hydrolyzes esculin. E. dispar has been isolated from human specimens." ;
    flat:parents "C76311" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterococcus dispar|ENTEROCOCCUS DISPAR" ;
.

ncit:C86367
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86367" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86367>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, cocci shaped bacteria in the phylum Firmicutes. This species is non-motile, ferments melibiose, does not ferment arabinose or citrate, does not reduce tetrazolium and is a lactic acid bacteria. E. durans is pathogenic in chickens but is rarely shown to be pathogenic in humans." ;
    flat:parents "C76311" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterococcus durans|ENTEROCOCCUS DURANS|Streptococcus durans|Streptococcus durans" ;
.

ncit:C86368
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86368" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86368>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Established Names and Unique Ingredient Identifier Codes Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, cocci shaped bacteria in the phylum Firmicutes. This species is catalase positive, oxidase negative, ferments citrate, does not ferment arabinose or melibiose, reduces tetrazolium and is a lactic acid bacteria. E. faecalis is a leading agent of nosocomial infections in humans." ;
    flat:parents "C76311" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterococcus faecalis|ENTEROCOCCUS FAECALIS|ENTEROCOCCUS FAECALIS|Streptococcus faecalis|Streptococcus faecalis" ;
.

ncit:C86369
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86369" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86369>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, cocci shaped bacteria in the phylum Firmicutes. This species is catalase negative, requires folic acid for growth in culture, ferments arabinose and melibiose, does not ferment citrate, does not reduce tetrazolium and is a lactic acid bacteria. E. faecium is a leading agent of nosocomial infections in humans." ;
    flat:parents "C76311" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterococcus faecium|ENTEROCOCCUS FAECIUM|Streptococcus faecium|Streptococcus faecium" ;
.

ncit:C86370
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86370" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86370>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-positive, cocci shaped bacteria in the phylum Firmicutes. This species is nonmotile, non-spore forming, catalase negative, does not hydrolyze gelatin, does not produce hydrogen sulfide and is esculin and hippurate positive. E. gallinarum has been isolated from the gastrointestinal tract of domestic fowl and is pathogenic in humans with some resistance to vancomycin." ;
    flat:parents "C76311" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterococcus gallinarum|ENTEROCOCCUS GALLINARUM" ;
.

ncit:C86371
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86371" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86371>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-positive, cocci shaped bacteria in the phylum Firmicutes. This species is nonmotile, non-spore forming, catalase negative, and hydrolyzes esculin but not hippurate. E. hirae was isolated from chicken and pig intestines and though rare, is pathogenic in humans." ;
    flat:parents "C76311" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterococcus hirae|ENTEROCOCCUS HIRAE" ;
.

ncit:C86372
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86372" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86372>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-positive, cocci shaped bacteria in the phylum Firmicutes. This species is nonmotile, non-spore forming, catalase negative, produces hydrogen sulfide, and hydrolyzes esculin, but not hippurate. E. malodoratus has been isolated from Gouda cheese." ;
    flat:parents "C76311" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterococcus malodoratus|ENTEROCOCCUS MALODORATUS" ;
.

ncit:C86373
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86373" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86373>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-positive, cocci shaped bacteria in the phylum Firmicutes. This species is nonmotile, non-spore forming, catalase negative, hydrolyzes esculin, but not hippurate. E. mundtii has been isolated from cow teats, plants and soil, and though rare is pathogenic in humans causing enophthalmitis." ;
    flat:parents "C76311" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterococcus mundtii|ENTEROCOCCUS MUNDTII" ;
.

ncit:C86374
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86374" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86374>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-positive, cocci shaped bacteria in the phylum Firmicutes. This species is nonmotile, non-spore forming, catalase negative, and hydrolyzes both hippurate and esculin. E. pseudoavium was isolated from bovine mastitis, but human infections are very rare." ;
    flat:parents "C76311" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterococcus pseudoavium|ENTEROCOCCUS PSEUDOAVIUM" ;
.

ncit:C86375
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86375" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86375>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-positive, cocci shaped bacteria in the phylum Firmicutes. This species is nonmotile, non-spore forming, catalase negative, and hydrolyzes esculin but not hippurate or starch. E raffinosus has been identified in numerous human specimens associated with bacteremia though its natural habitat has not been identified." ;
    flat:parents "C76311" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Enterococcus raffinosus|ENTEROCOCCUS RAFFINOSUS" ;
.

ncit:C86376
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86376" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86376>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram positive, rod shaped bacterium assigned to the phylum Firmicutes and the family Erysipelotrichaceae." ;
    flat:parents "C85934" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Erysipelothrix|ERYSIPELOTHRIX|Erysipelothrix insidiosa|Erysipelothrix insidiosa" ;
.

ncit:C86377
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86377" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86377>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacterium assigned to the phylum Firmicutes. This species is nonsporulating, not acid fast, decolorizes rapidly so may appear Gram negative, alpha-hemolytic and catalase and oxidase negative. E. rhusiopathiae is found in a variety of host animals including fish and swine as well as in feces and sewage. It is pathogenic in a variety of organisms including domestic swine and humans, causing both cutaneous and septicemic infections and the disease swine erysipelas." ;
    flat:parents "C86376" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Erysipelothrix rhusiopathiae|ERYSIPELOTHRIX RHUSIOPATHIAE" ;
.

ncit:C86378
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86378" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86378>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, non-spore forming, catalase, lysine and ornithine decarboxylase positive, oxidase, urease, lipase, protease, and indole negative, reduces nitrate, hydrolyzes esculin, and ferments mannitol and xylose. E. albertii, originally known as Halfnia alvei, causes diarrhea." ;
    flat:parents "C77208" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Escherichia albertii|ESCHERICHIA ALBERTII" ;
.

ncit:C86379
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86379" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86379>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile, non-spore forming, catalase positive, indole, citrate, and urease negative, does not produce hydrogen sulfide, and ferments xylose, but not mannitol. E. blattae was isolated from the hind-gut of cockroaches and is nonpathogenic to humans." ;
    flat:parents "C77208" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Escherichia blattae|ESCHERICHIA BLATTAE|Shimwellia blattae" ;
.

ncit:C86380
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86380" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86380>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria. This species is motile, indole positive, lysine decarboxylase, ornithine decarboxylase, and catalase positive, and negative for Vosges-Proskauer, citrate utilization, urea hydrolysis, phenylalanine deamination, arginine dihydrolase, growth in KCN and fermentation of lactose, sucrose, myo-inositol, D-sorbitol, raffinose and alpha-methyl-D-glucose. E. fergusonii can be isolated from the intestinal tract of warm blooded animals and from contaminated beef. In humans, this bacteria is most commonly responsible for wound infections, urinary tract infections, bacteremia, diarrhea, and pleural infections." ;
    flat:parents "C77208" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Escherichia fergusonii|CDC Enteric Group 10|CDC Enteric Group 10|ESCHERICHIA FERGUSONII" ;
.

ncit:C86381
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86381" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86381>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria. This species is motile, produces yellow pigment, ferments glucose, arabinose, mannitol, and rhamnose and is positive for ornithine decarboxylase and indole production. Negative reactions for lactose, melibiose, and sorbitol fermentation, arginine dihydrolase, H2S and urease production, lysine decarboxylase, and citrate. Most commonly isolated from environmental sources like drinking water distribution systems." ;
    flat:parents "C77208" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Escherichia hermannii|CDC Enteric Group 11|CDC Enteric Group 11|ESCHERICHIA HERMANNII" ;
.

ncit:C86382
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86382" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86382>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria. This species is motile, oxidase and indole negative, is fermentative and is most commonly isolated from animals, the environment, and potable water. E. vulneris is a human pathogen that can colonize the respiratory tract, female genital tract, and stool and has a particular propensity for wounds." ;
    flat:parents "C77208" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Escherichia vulneris|CDC Enteric Group 1|CDC Enteric Group 1|ESCHERICHIA VULNERIS" ;
.

ncit:C86383
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86383" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86383>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|CTRP Biomarker Terminology|CTRP Terminology" ;
    flat:definition "A genus of aerobic, Gram positive, rod shaped bacterium assigned to the phylum Firmicutes and the family Eubacteriaceae." ;
    flat:display%20name "Eubacterium" ;
    flat:parents "C85935" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Eubacterium|EUBACTERIUM" ;
.

ncit:C86384
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86384" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86384>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is nonmotile, non-spore forming, indole negative, reduces neutral red, but not nitrate, does not produce hydrogen sulfide, and does not hydrolyze hippurate, esculin, or starch. E. alactolyticum, also known as Pseudoramibacter alactolyticus, has been isolated from dental calculus and gingival crevices in individuals with periodontal disease." ;
    flat:parents "C86383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Eubacterium alactolyticum|EUBACTERIUM ALACTOLYTICUM|Pseudoramibacter alactolyticus" ;
.

ncit:C86385
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86385" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86385>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is nonmotile, non-spore forming, indole negative, reduces neutral red, but not nitrate, does not produce hydrogen sulfide, and hydrolyzes esculin, but not starch or hippurate. E. contortum has been isolated from human feces, vaginal swabs, and other sites of infection and nearly half of individuals with Crohn's disease have agglutinating antibodies to various strains." ;
    flat:parents "C86383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Eubacterium contortum|Catenabacterium contortum|EUBACTERIUM CONTORTUM" ;
.

ncit:C86386
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86386" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86386>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is nonmotile, non-spore forming, indole negative, hydrolyzes esculin, does not reduce nitrate, and ferments erythritol. E. limosum is commensal in the gastrointestinal tract and may be useful as a probiotic." ;
    flat:parents "C86383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Eubacterium limosum|EUBACTERIUM LIMOSUM" ;
.

ncit:C86387
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86387" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86387>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is nonmotile, non-spore forming, indole negative, reduces neutral red, and produces butyrate, but does not hydrolyze esculin or starch, digest gelatin, reduce nitrate, ferment carbohydrates, or produce hydrogen sulfide. E. nodatum was isolated from subgingival and supragingival samples in individuals with periodontal infections." ;
    flat:parents "C86383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Eubacterium nodatum|EUBACTERIUM NODATUM" ;
.

ncit:C86388
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86388" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86388>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is motile, non-spore forming, esculin positive, forms butyrate, produces abundant amounts of hydrogen, and utilizes glucose, cellobiose, melezitose, fructose, sucrose, raffinose, melibiose, starch, and inulin, but not glycerol. E. ractale is one of the most abundant species in the human gastrointestinal tract where it ferments carbohydrates." ;
    flat:parents "C86383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Eubacterium rectale|Agathobacter rectalis|EUBACTERIUM RECTALE" ;
.

ncit:C86389
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86389" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86389>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is non- spore forming, produces hydrogen, and ferments mannose, but not salicin or cellobiose. E. ventriosum is commensal to the human digestive tract." ;
    flat:parents "C86383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Eubacterium ventriosum|EUBACTERIUM VENTRIOSUM" ;
.

ncit:C86390
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86390" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86390>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria and the family Enterobacteriaceae." ;
    flat:parents "C85932" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Ewingella|EWINGELLA" ;
.

ncit:C86391
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86391" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86391>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria. This species is oxidase negative, fermentative, susceptible to ampicillin, amoxicillin-clavulanate, ceftazidime, ceftriaxone, cefotaxime, cefepime, ofloxacin, gentamicin, carbenicillin, and amikacin but resistant to cephalothin, penicillin G, and vancomycin. A rare human pathogen, it can be isolated from human blood, stool, urine, wounds, conjunctiva, respiratory tract, and peritoneal dialysate of immunocompromised patients." ;
    flat:parents "C86390" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Ewingella americana|CDC Enteric Group 40|EWINGELLA AMERICANA" ;
.

ncit:C86392
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86392" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86392>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram positive, cocci shaped bacterium assigned to the phylum Firmicutes and the family Aerococcaceae." ;
    flat:parents "C85913" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Facklamia|FACKLAMIA" ;
.

ncit:C86393
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86393" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86393>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of anaerobic, Gram positive, cocci shaped bacterium assigned to the phylum Firmicutes and the family Ruminococcaceae." ;
    flat:parents "C85961" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Faecalibacterium|FAECALIBACTERIUM" ;
.

ncit:C86394
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86394" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86394>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, cocci shaped bacteria assigned to the phylum Firmicutes. This species is nonmotile, non-spore forming, indole negative, utilizes acetate, hydrolyzes esculin, ferments fructose, starch, and inulin, but not arabinose, melibiose, raffinose, rhamnose, ribose or xylose, does not produce hydrogen or reduce nitrate, but does produce copious amounts of butyrate. F. prausnitzii is a major commensal microbe in the human digestive tract and may be useful as a probiotic in individuals with Crohn's disease, but can become pathogenic in other regions." ;
    flat:parents "C86393" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Faecalibacterium prausnitzii|FAECALIBACTERIUM PRAUSNITZII|Fusobacterium prausnitzii|Fusobacterium prausnitzii" ;
.

ncit:C86395
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86395" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86395>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Any rod shaped, anaerobic bacteria that can convert carbohydrates into acids and alcohols and has a cell wall contains low levels of peptidoglycan and stains pink with the Gram staining technique." ;
    flat:parents "C86421" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Fermentative Gram Negative Bacillus|FERMENTATIVE GRAM-NEGATIVE BACILLUS|Fermentative Gram-Negative Rod|Fermentative Gram-negative Rod" ;
.

ncit:C86396
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86396" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86396>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram negative, rod and cocci shaped bacterium assigned to the phylum Proteobacteria and the family Franciscellaceae." ;
    flat:parents "C85937" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Francisella|FRANCISELLA" ;
.

ncit:C86397
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86397" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86397>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, coccobacilli shaped bacterium in the phylum Proteobacteria. It has two main serotypes, Jellison Type A and Jellison Type B. This species is hemolytic, oxidase negative, catalase positive and nonfermentative. F. tularensis is pathogenic, being a causative agent of Tularemia which is mainly contracted when handling infected rabbits. This bacterium has been classified as a Category A critical biological agent due to its ease of dissemination by aerosol, causing high mortality with the potential for a major public health impact." ;
    flat:parents "C86396" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Francisella tularensis|FRANCISELLA TULARENSIS|Pasteurella tularensis|Pasteurella tularensis" ;
.

ncit:C86398
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86398" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86398>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram negative, rod shaped bacterium in the phylum Fusobacteria. This species is non-sporulating, has a slender shape with tapered ends and exhibits pleomorphic irregular staining. F. gonidiaformans is most commonly isolated from urogenital and intestinal tracts in humans and is pathogenic, most commonly linked to peritonsillar infection and bacteremia." ;
    flat:parents "C76323" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Fusobacterium gonidiaformans|FUSOBACTERIUM GONIDIAFORMANS" ;
.

ncit:C86399
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86399" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86399>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-negative, pleomorphic rod shaped bacteria in the phylum Fusobacteria. This species is non-spore forming, indole and superoxide dismutase negative, hydrolyzes esculin, reduces nitrate, does not produce lysine decarboxylase, and is the only member of the genus to have equimolar ratios of mesolanthionine and diaminopimelic acids within the cell membrane. F. mortiferum is commensal to the human intestinal tract, but can be pathogenic in other locations." ;
    flat:parents "C76323" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Fusobacterium mortiferum|FUSOBACTERIUM MORTIFERUM" ;
.

ncit:C86400
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86400" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86400>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-negative, rod shaped bacteria in the phylum Fusobacteria. This species is non-spore forming, indole and glutamine decarboxylase negative, hydrolyzes esculin, and does not reduce nitrate. F. necrogenes is commensal in the human intestinal tract, but is rarely associated with human infections." ;
    flat:parents "C76323" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Fusobacterium necrogenes|FUSOBACTERIUM NECROGENES" ;
.

ncit:C86401
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86401" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86401>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-negative, rod shaped bacteria in the phylum Fusobacteria. This species is non-spore forming, does not hydrolyze dextran and is superoxide dismutase and lysine decarboxylase negative. F. necrophorum is found in the intestinal tract of humans and animals, but is more likely to be associated with infections in animals." ;
    flat:parents "C76323" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Fusobacterium necrophorum|FUSOBACTERIUM NECROPHORUM|Fusobacterium necrophorum Biovar B" ;
.

ncit:C86404
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86404" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86404>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram negative, fusiform rod shaped bacterium in the phylum Fusobacteria. This species is non-sporulating, ferments fructose and glutamate and produces butyric acid as a major metabolic by-product. F. nucleatum is ubiquitously found in the normal flora of the oral cavity but may be associated with periodontal disease as well as preterm births, where isolates have been found in amniotic fluid, placenta, and chorioamnionic membranes of women delivering prematurely." ;
    flat:parents "C76323" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Fusobacterium nucleatum|FUSOBACTERIUM NUCLEATUM" ;
.

ncit:C86405
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86405" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86405>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-negative, fusiform rod shaped bacteria in the phylum Fusobacteria. This species is lipase negative, does not hydrolyze esculin, does not ferment carbohydrates, does not grow in bile, does not produce propionate from lactate or threonine, but does have phosphate activity. F. russii has been isolated from both animal and human feces and is associated with human infections particularly those caused by cat and dog bites." ;
    flat:parents "C76323" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Fusobacterium russii|FUSOBACTERIUM RUSSII" ;
.

ncit:C86406
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86406" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86406>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-negative, fusiform rod shaped bacteria in the phylum Fusobacteria. This species is non-spore forming, indole, catalase, urease, lipase, esculin and oxidase negative, does not produce hydrogen sulfide, but does reduce nitrate, produce large amounts of butyrate, and converts threonine to propionic acid. F. ulcerans causes ulcers in humans located in tropical nations however, this bacteria's natural habitat is unknown." ;
    flat:parents "C76323" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Fusobacterium ulcerans|FUSOBACTERIUM ULCERANS" ;
.

ncit:C86407
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86407" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86407>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-negative, fusiform rod shaped bacteria in the phylum Fusobacteria. This species is indole positive, catalase negative, produces propionate from threonine, but not lactate, does not hydrolyze esculin, starch or dextran, and does not reduce nitrate. F. varium has been isolated from human feces and sites of infection as well as the intestinal tract of rodents, roaches, and terminates." ;
    flat:parents "C76323" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Fusobacterium varium|FUSOBACTERIUM VARIUM|Fusobacterium necrophorum Biovar C|Fusobacterium necrophorum Biovar C|Fusobacterium pseudonecrophorum|Fusobacterium pseudonecrophorum" ;
.

ncit:C86408
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86408" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86408>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A bacterium that is assigned to the genus Streptococcus that is unable to facilitate red blood cell lysis." ;
    flat:parents "C76383" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Gamma-Hemolytic Streptococcus|Non-Hemolytic Streptococcus|Non-Hemolytic Streptococcus|STREPTOCOCCUS GAMMA-HEMOLYTIC" ;
.

ncit:C86409
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86409" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86409>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram positive, rod shaped bacterium assigned to the phylum Actinobacteria and the family Bifidobacteriaceae." ;
    flat:parents "C85918" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Gardnerella|GARDNERELLA" ;
.

ncit:C86410
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86410" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86410>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species has a very thin cell wall that may appear Gram negative under the microscope. G. vaginalis may be found in the genital tract or pharynx of humans and is a causative agent of bacterial vaginosis." ;
    flat:parents "C86409" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Gardnerella vaginalis|Corynebacterium vaginalis|Corynebacterium vaginalis|GARDNERELLA VAGINALIS" ;
.

ncit:C86411
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86411" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86411>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram variable, cocci shaped bacterium assigned to the phylum Firmicutes and the family Aerococcaceae." ;
    flat:parents "C85913" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Globicatella|GLOBICATELLA" ;
.

ncit:C86412
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86412" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86412>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, gram positive cocci shaped bacteria assigned to the Phylum Firmicutes. This species is catalase negative and does not produce hydrogen sulfide. G. sanguinis is rarely isolated from clinical samples but may be a causative agent of meningoencephalitis." ;
    flat:parents "C86411" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Globicatella sanguinis|GLOBICATELLA SANGUINIS|Globicatella sanguis|Globicatella sanguis" ;
.

ncit:C86413
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86413" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86413>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic Gram variable cocci shaped bacteria assigned to the phylum Firmicutes. This species is catalase negative, produces hydrogen sulfide, and may convert inulin to acid. G. sulfidifaciens may occur in pairs, chains or singly and is most often isolated from ruminants and pigs and is not a noted human pathogen." ;
    flat:parents "C86411" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Globicatella sulfidifaciens|GLOBICATELLA SULFIDIFACIENS" ;
.

ncit:C86414
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86414" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86414>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram positive, coryneform bacterium assigned to the phylum Actinobacteria and the family Gordoniaceae." ;
    flat:parents "C85939" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Gordonia|GORDONIA" ;
.

ncit:C86415
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86415" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86415>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, coryneform bacteria assigned to the phylum Actinobacteria. This species is catalase positive, slightly acid fast, nonmotile and metabolizes 4 aminobutyrate and L aspartate. G. aichiensis is an opportunistic pathogen in immunocompetent and immunosuppressed patients." ;
    flat:parents "C86414" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Gordonia aichiensis|GORDONIA AICHIENSIS|Gordona aichiensis|Gordona aichiensis|Tsukamurella aichiensis|Tsukamurella aichiensis" ;
.

ncit:C86416
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86416" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86416>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, coryneform bacteria assigned to the phylum Actinobacteria. This species is catalase positive, slightly acid fast, nonmotile and contains lipoparabinomannan like lipoglycans in the cell wall. G. bronchialis is an opportunistic pathogen, causing infection at medical device implantation sites and wound sites in surgical patients." ;
    flat:parents "C86414" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Gordonia bronchialis|GORDONIA BRONCHIALIS|Gordona bronchialis|Gordona bronchialis|Rhodococcus bronchialis|Rhodococcus bronchialis" ;
.

ncit:C86417
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86417" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86417>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, coryneform bacteria assigned to the phylum Actinobacteria. This species is catalase positive, slightly acid fast, nonmotile and produces mycobactin. G. rubripertincta is an opportunistic pathogen, causing infection at sites of catheterization." ;
    flat:parents "C86414" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Gordonia rubripertincta|GORDONIA RUBRIPERTINCTA|Gordona rubropertincta|Gordona rubropertincta|Rhodococcus rubripertincta|Rhodococcus rubripertincta" ;
.

ncit:C86418
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86418" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86418>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, coryneform bacteria assigned to the phylum Actinobacteria. This species is catalase positive, slightly acid fast, nonmotile and metabolizes D arabitol, succinate and caprate. G. sputi is an opportunistic pathogen, causing endocarditis and bacteremia in surgical and catheterized patients." ;
    flat:parents "C86414" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Gordonia sputi|GORDONIA SPUTI|Gordona sputi|Gordona sputi" ;
.

ncit:C86419
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86419" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86419>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram positive, coryneform bacteria assigned to the phylum Actinobacteria. This species is catalase positive, oxidase negative, nonmotile and slightly acid fast. G. terrae is normally found in the soil and infection in humans is rare, occurring mostly in immunosuppressed and immunocompromised patients." ;
    flat:parents "C86414" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Gordonia terrae|GORDONIA TERRAE|Gordona terrae|Gordona terrae|Rhodococcus terrae|Rhodococcus terrae" ;
.

ncit:C86420
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86420" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86420>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of motile, Gram positive, endospore forming rod shaped bacterium assigned to the phylum Firmicutes and the family Bacillaceae." ;
    flat:parents "C85915" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Gracilibacillus|GRACILIBACILLUS" ;
.

ncit:C86421
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86421" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86421>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Any rod shaped bacteria that contains low levels of peptidoglycan in its cell wall and stains pink with the Gram staining technique." ;
    flat:parents "C173514" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Gram Negative Bacillus|GRAM-NEGATIVE BACILLUS|Gram Negative Rods" ;
.

ncit:C86422
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86422" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86422>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Any spherical shaped bacteria that contains low levels of peptidoglycan in its cell wall and stains pink with the Gram staining technique." ;
    flat:parents "C173514" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Gram Negative Coccus|GRAM-NEGATIVE COCCUS" ;
.

ncit:C86424
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86424" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86424>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "Any spherical shaped bacteria that has a peptidoglycan rich cell wall that stains dark purple with the Gram staining technique." ;
    flat:parents "C173515" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Gram Positive Coccus|GRAM-POSITIVE COCCUS" ;
.

ncit:C86425
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86425" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86425>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram positive, cocci shaped, lactic acid bacterium assigned to the phylum Firmicutes and the family Carnobacteriaceae." ;
    flat:parents "C85922" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Granulicatella|GRANULICATELLA" ;
.

ncit:C86426
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86426" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86426>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram positive, rod or cocci shaped bacteria assigned to the phylum Firmicutes. This species is nonmotile, non spore forming, catalase and oxidase negative, and produces pyrrolidonyl arylamidase. G. adiancens is a pathogen which can be isolated from the throat, blood or urine and most commonly causes endocarditis." ;
    flat:parents "C86425" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Granulicatella adiacens|Abiotrophia adjacens|Abiotrophia adjacens|GRANULICATELLA ADIACENS|Streptococcus adjacens|Streptococcus adjacens" ;
.

ncit:C86427
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86427" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86427>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile by a single polar flagellum, oxidase positive, halophilic and produce acid from D glucose, L arabinose, D galactose and D mannose. G. hollisae is pathogenic to immunocompetent individuals and most commonly causes moderate to severe gastroenteritis." ;
    flat:parents "C85976" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Grimontia hollisae|GRIMONTIA HOLLISAE|Vibrio hollisae|Vibrio hollisae" ;
.

ncit:C86428
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86428" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86428>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is urease, catalase and oxidase positive, nonhemolytic and indole negative. H. aegyptius is a pathogen and the causative agent of conjunctivitis and Brazilian purpuric fever." ;
    flat:parents "C76324" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Haemophilus aegyptius|HAEMOPHILUS AEGYPTIUS" ;
.

ncit:C86429
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86429" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86429>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, indole positive, nonhemolytic and capable of mannitol fermentation. H. haemoglobinophilus is a commensal organism of the reproductive tract in canines and felines." ;
    flat:parents "C76324" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Haemophilus haemoglobinophilus|HAEMOPHILUS HAEMOGLOBINOPHILUS" ;
.

ncit:C86430
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86430" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86430>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is urease, catalase and oxidase positive, porphyrin negative and requires both X and V factors to grow in culture. H. haemolyticus is normally nonpathogenic but may cause disease in immunocompromised patients." ;
    flat:parents "C76324" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Haemophilus haemolyticus|HAEMOPHILUS HAEMOLYTICUS" ;
.

ncit:C86431
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86431" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86431>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Established Names and Unique Ingredient Identifier Codes Terminology" ;
    flat:definition "A species of facultatively anaerobic or aerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, catalase and oxidase positive, porphyrin negative, requires both X and V factors to grow in culture, and may be encapsulated or nonencapsulated. H. influenzae is an opportunistic pathogen causing a wide variety of infections including osteomyelitis, meningitis, conjunctivitis and pneumonia." ;
    flat:parents "C76324" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Haemophilus influenzae|H-Flu|H-flu|HAEMOPHILUS INFLUENZAE|HAEMOPHILUS INFLUENZAE" ;
.

ncit:C86432
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86432" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86432>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is oxidase and urease positive, catalase negative, porphyrin positive and can grow in culture with V factor alone. H. parahemolyticus is a commensal organism of the oropharyngeal and gastrointestinal tracts and rarely pathogenic in humans." ;
    flat:parents "C76324" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Haemophilus parahaemolyticus|HAEMOPHILUS PARAHAEMOLYTICUS" ;
.

ncit:C86433
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86433" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86433>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is oxidase, urease and porphyrin positive, can grow in culture with V factor alone, and requires putrescines for growth in culture. H. parainfluenzae is a commensal organism of the oral cavity and pharynx but may become pathogenic in immunocompromised individuals or individuals with underlying disease, being a causative agent of endocarditis." ;
    flat:parents "C76324" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Haemophilus parainfluenzae|HAEMOPHILUS PARAINFLUENZAE|Hemophilus parainfluenzae|Hemophilus parainfluenzae" ;
.

ncit:C86434
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86434" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86434>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria and the family Enterobacteriaceae." ;
    flat:parents "C85932" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Hafnia|HAFNIA" ;
.

ncit:C86435
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86435" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86435>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is oxidase negative, and ferments glucose, mannitol, and arabinose. H. alvei is found in water, soil and foods, is part of the gastrointestinal flora and is rarely pathogenic owing to the expression of few virulence factors." ;
    flat:parents "C86434" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Hafnia alvei|Enterobacter alvei|Enterobacter alvei|HAFNIA ALVEI" ;
.

ncit:C86436
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86436" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86436>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of Gram variable, motile, halophilic, rod shaped bacterium assigned to the phylum Firmicutes and the family Bacillaceae." ;
    flat:parents "C85915" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Halobacillus|HALOBACILLUS" ;
.

ncit:C86437
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86437" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86437>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of microaerophilic, Gram negative, helical rod shaped bacteria assigned to the phylum Proteobacteria. This species is oxidase and catalase positive, motile by a single polar flagellum and does not hydrolyze hippurate or indoxyl acetate effectively. H. cinaedi is found in the normal gut flora of hamsters and is an opportunistic pathogen in immunocompromised patients causing fever, gastroenteritis, bacteremia and recurrent cellulitis." ;
    flat:parents "C14296" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Helicobacter cinaedi|Campylobacter cinaedi|Campylobacter cinaedi|HELICOBACTER CINAEDI" ;
.

ncit:C86438
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86438" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86438>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of microaerophilic, Gram negative, helical rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile by a single polar flagellum, catalase positive, and hydrolyzes indoxyl acetate and arylsulfatase but not hippurate. H. fennelliae is part of the normal flora of human and animal intestines and is an opportunistic pathogen in immunocompromised patients." ;
    flat:parents "C14296" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Helicobacter fennelliae|Campylobacter fennelliae|Campylobacter fennelliae|HELICOBACTER FENNELLIAE" ;
.

ncit:C86439
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86439" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86439>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of microaerophilic, Gram negative, helical/vibroid shaped bacteria assigned to the phylum Proteobacteria. This species is motile by multiple flagella and is considered an animal model of Helicobacter infection in humans. H. mustelae is part of the normal flora of the ferret gastrointestinal tract and causes peptic ulcer disease and chronic atrophic gastritis." ;
    flat:parents "C14296" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Helicobacter mustelae|Campylobacter mustelae|Campylobacter mustelae|HELICOBACTER MUSTELAE" ;
.

ncit:C86440
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86440" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86440>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A non-taxonomic grouping of microaerophilic, Gram negative, spindle shaped bacteria assigned to the phylum Proteobacteria and the genus Helicobacter. These organisms are motile by bipolar, sheathed flagella and are composed of ten species of Helicobacter organisms including the species H. bilis and H. trogontum. Helicobacter rappini are pathogenic, causing abortion in animals and diarrheal symptoms in humans." ;
    flat:parents "C14296" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Helicobacter rappini|Flexispira rappini|Flexispira rappini|HELICOBACTER RAPPINI" ;
.

ncit:C86441
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86441" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86441>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, catalase negative, oxidase positive, encapsulated and nonacid fast. H. somni is a commensal organism of the ovine and bovine respiratory, vaginal and prepucal mucosa but may become pathogenic, causing infectious meningo encephalitis." ;
    flat:parents "C85977" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Histophilus somni|HISTOPHILUS SOMNI|Haemophilus somnus|Haemophilus somnus" ;
.

ncit:C86442
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86442" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86442>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of strictly anaerobic, Gram positive, rod shaped bacterium assigned to the phylum Firmicutes and the family Erysipelotrichaceae." ;
    flat:parents "C85934" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Holdemania|HOLDEMANIA" ;
.

ncit:C86443
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86443" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86443>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram positive, rod shaped bacteria assigned to the phylum Firmicutes. This species is catalase and indole negative, contains type B murein in its cell wall, is nonsporulating and hydrolyzes esculin. H. filiformis is most often isolated from feces." ;
    flat:parents "C86442" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Holdemania filiformis|HOLDEMANIA FILIFORMIS" ;
.

ncit:C86444
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86444" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86444>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of Gram negative, rod shaped bacterium assigned to the phylum Proteobacteria and the family Rhodospirillaceae." ;
    flat:parents "C85960" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Inquilinus|INQUILINUS" ;
.

ncit:C86445
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86445" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86445>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is oxidase and beta galactosidase positive and nonfermentative. I. limosus has been isolated from the respiratory tract of cystic fibrosus patients and is considered a multidrug resistant pathogen." ;
    flat:parents "C86444" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Inquilinus limosus|INQUILINUS LIMOSUS" ;
.

ncit:C86446
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86446" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86446>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of moderately halophilic, endospore forming, round bacterium assigned to the phylum Firmicutes and the family Planococcaceae." ;
    flat:parents "C85954" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Jeotgalibacillus|JEOTGALIBACILLUS" ;
.

ncit:C86447
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86447" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86447>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of obligately anaerobic, Gram negative, rod shaped bacterium assigned to the phylum Firmicutes and the family Lachonospiraceae." ;
    flat:parents "C85942" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Johnsonella|JOHNSONELLA" ;
.

ncit:C86448
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86448" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86448>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of obligately anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Firmicutes. This species is nonmotile, indole, oxidase and catalase negative, and nonfermentative. J. ignava is commonly found in the gingival crevices of the oral cavity and may cause gingivitis and periodontitis." ;
    flat:parents "C86447" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Johnsonella ignava|JOHNSONELLA IGNAVA" ;
.

ncit:C86449
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86449" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86449>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of Gram negative, rod and cocci shaped bacterium assigned to the phylum Proteobacteria and the family Neisseriaceae." ;
    flat:parents "C85950" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kingella|KINGELLA" ;
.

ncit:C86450
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86450" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86450>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod or cocci shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, oxidase positive and ferments glucose, although the latter characteristic may disappear upon continuous subcultivation. K. dentrificans is a commensal organism found in the upper respiratory tract and while it is thought to be mostly nonpathogenic, it has been associated with at least one case of infective endocarditis." ;
    flat:parents "C86449" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kingella denitrificans|CDC Group TM-1|KINGELLA DENITRIFICANS" ;
.

ncit:C86451
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86451" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86451>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, oxidase positive, catalase negative, beta hemolytic, and ferments maltose. K. kingae is part of the upper respiratory commensal flora but may become pathogenic in immunocompromised individuals." ;
    flat:parents "C86449" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kingella kingae|KINGELLA KINGAE|Moraxella kingae|Moraxella kingae" ;
.

ncit:C86452
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86452" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86452>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic or facultatively anaerobic, Gram negative, rod and coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, oxidase positive and catalase negative, and ferments glucose. K. oralis is normally found in small numbers in the oral cavity; periodontitis and gingivitis may correlate with increases in numbers of this species in the gingiva." ;
    flat:parents "C86449" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kingella oralis|KINGELLA ORALIS" ;
.

ncit:C86453
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86453" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86453>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, DNase and oxidase positive, catalase negative and nonsporulating. K. potus is normally found in the oral cavity of some mammals and may be pathogenic to humans upon infection." ;
    flat:parents "C86449" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kingella potus|KINGELLA POTUS" ;
.

ncit:C86454
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86454" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86454>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, oxidase negative and is covered by a large capsule. K. granulomatis is pathogenic and the causative agent of the sexually transmitted disease Donovanosis." ;
    flat:parents "C28165" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Klebsiella granulomatis|KLEBSIELLA GRANULOMATIS" ;
.

ncit:C86455
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86455" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86455>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, oxidase negative and indole positive. K. oxytoca is pathogenic, causing urinary tract infections, and is one of the major causes of neonatal bacteremia and septicemia." ;
    flat:parents "C28165" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Klebsiella oxytoca|K. oxytoca|KLEBSIELLA OXYTOCA" ;
.

ncit:C86456
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86456" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86456>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, oxidase and indole negative, encapsulated and lactose fermenting. K. pneumoniae is part of the normal flora of the mouth, intestines, and skin but may become pathogenic; it is the causative agent of Klebsiella pneumonia in immunocompromised, diabetic, and alcoholic patients." ;
    flat:parents "C28165" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Klebsiella ozaenae|KLEBSIELLA OZAENAE|Klebsiella pneumoniae subsp. ozaenae|Klebsiella pneumoniae subsp. ozaenae" ;
.

ncit:C86457
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86457" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86457>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Established Names and Unique Ingredient Identifier Codes Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, oxidase negative, and produces acid from glucose, mannitol, rhamnose, arabinose and amygdalin. K. ozaenae is pathogenic and a causative agent of ozena/atrophic rhinitis." ;
    flat:parents "C28165" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Klebsiella pneumoniae|K. pneumoniae|KLEBSIELLA PNEUMONIAE|KLEBSIELLA PNEUMONIAE" ;
.

ncit:C86458
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86458" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86458>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile and oxidase negative. K. rhinoscleromatis is pathogenic and the causative agent of rhinoscleroma, an upper respiratory disease of the nose and pharynx." ;
    flat:parents "C28165" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Klebsiella rhinoscleromatis|KLEBSIELLA RHINOSCLEROMATIS|Klebsiella pneumoniae subsp. rhinoscleromatis|Klebsiella pneumoniae subsp. rhinoscleromatis" ;
.

ncit:C86459
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86459" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86459>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, straight rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, oxidase negative, capsulated, non endosporeforming and produces isomaltulose from sucrose but does not produce indole. K. singaporensis is found in soil, and its pathogenic potential is unknown." ;
    flat:parents "C28165" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Klebsiella singaporensis|KLEBSIELLA SINGAPORENSIS|Klebsiella variicola" ;
.

ncit:C86460
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86460" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86460>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, oxidase and indole negative, and does not ferment adonitol. K. variicola is most commonly isolated from plants but may be an opportunistic pathogen in humans." ;
    flat:parents "C28165" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Klebsiella variicola|KLEBSIELLA VARIICOLA" ;
.

ncit:C86461
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86461" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86461>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram negative, rod shaped bacterium in the phylum Fusobacteria and the family Enterobacteriaceae." ;
    flat:parents "C85932" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kluyvera|KLUYVERA" ;
.

ncit:C86462
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86462" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86462>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile by peritrichous flagella, catalase and indole positive, oxidase negative, positive for lysine decarboxylase, and can grow on cefsulodin irgasan novobiocin agar in culture. K. ascorbata is rarely isolated from humans and tends to be pathogenic only in immunocompromised individuals." ;
    flat:parents "C86461" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kluyvera ascorbata|CDC Enteric Group 8|CDC Enteric Group 8|KLUYVERA ASCORBATA" ;
.

ncit:C86463
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86463" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86463>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile by peritrichous flagella, catalase and indole positive, oxidase negative, does not ferment dulcitol and cannot grow on cefsulodin irgasan novobiocin agar in culture. K. cryocrescens is normally found in milk, water, sewage, soil and sputum, and is an opportunistic pathogen in the hospital setting." ;
    flat:parents "C86461" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kluyvera cryocrescens|KLUYVERA CRYOCRESCENS" ;
.

ncit:C86464
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86464" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86464>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile by peritrichous flagella, catalase and indole positive, oxidase negative and does not ferment D sorbitol. K. georgiana is commonly isolated from human sputum and throat cultures and is an opportunistic pathogen." ;
    flat:parents "C86461" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kluyvera georgiana|KLUYVERA GEORGIANA" ;
.

ncit:C86465
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86465" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86465>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile by peritrichous flagella, catalase positive, oxidase and indole negative, and ferments sucrose, dulcitol and amygdalin. K. intermedia is commonly found in surface water and may be an opportunistic pathogen." ;
    flat:parents "C86461" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Kluyvera intermedia|Enterobacter intermedium|Enterobacter intermedium|Enterobacter intermedius|Enterobacter intermedius|KLUYVERA INTERMEDIA|Kluyvera cochleae|Kluyvera cochleae" ;
.

ncit:C86466
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86466" ;
