ncit:C71130
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C71130" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C71130>" ;
    flat:concept%20in%20subset "CDISC SDTM ECG Test Method Terminology|CDISC SDTM Terminology|CDISC SEND Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "An electrocardiogram (ECG) lead placement whereby the rightward oriented V leads progress from V1R, placed instead of the standard V2, to V6R. The V3 lead in the standard placement is replaced by V4R." ;
    flat:parents "C71100" ;
    flat:semantic%20type "Classification" ;
    flat:synonyms "12 Lead Placement Standard Extended Right|12-LEAD EXTENDED RIGHT|12-lead extended to the right by V5R, V4R, V3R|Standard 12-lead extended to the right by V5R, V4R, V3R" ;
.

