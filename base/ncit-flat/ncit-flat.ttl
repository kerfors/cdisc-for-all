    flat:semantic%20type "Functional Concept" ;
    flat:synonyms "Iontophoresis Route of Administration|ION|IONTOPHORESIS|IONTOPHORESIS|IONTOPHORESIS|Iontophoresis|Iontophoresis|Iontophoresis" ;
.

