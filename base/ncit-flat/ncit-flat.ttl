ncit:C123507
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123507" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123507>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic trypanosomatid protozoa in the family Trypanosomatidae. L. braziliensis is a New World pathogen. As well as causing localized cutaneous lesions in affected people, this species can also result in a destructive, progressive infection of mucosal tissue." ;
    flat:parents "C123421" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Leishmania braziliensis|LEISHMANIA BRAZILIENSIS|Leishmania brasiliensis|Leishmania viannia" ;
.

ncit:C123508
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123508" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123508>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic trypanosomatid protozoa in the family Trypanosomatidae. L. donovani causes both visceral and dermal leishmaniasis. This species is the primary cause of visceral leishmaniasis in the Indian subcontinent and East Africa." ;
    flat:parents "C123421" ;
    flat:semantic%20type "Eukaryote" ;
    flat:synonyms "Leishmania donovani|LEISHMANIA DONOVANI" ;
.

ncit:C123509
