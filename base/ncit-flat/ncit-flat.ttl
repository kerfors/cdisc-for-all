.

ncit:C86194
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86194" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86194>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of anaerobic, Gram-positive, bifid shaped bacterium assigned to the phylum Actinobacteria and the family Bifidobacteriaceae." ;
    flat:parents "C85918" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bifidobacterium|BIFIDOBACTERIUM" ;
.

ncit:C86195
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86195" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86195>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-positive, bifid shaped bacteria assigned to the phylum Actinobacteria. This species is nonmotile, catalase negative, does not reduce nitrate, and ferments lactose, arabinose, xylose, ribose, gluconate, cellobiose, and salicin. B. adolescentis is a commensal part of the normal human gastrointestinal tract flora and is sometimes added to dairy products to be used as a probiotic." ;
    flat:parents "C86194" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bifidobacterium adolescentis|BIFIDOBACTERIUM ADOLESCENTIS" ;
.

ncit:C86196
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86196" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86196>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase and indole negative, does not reduce nitrate and ferments arabinose, xylose, ribose, lactose, salicin, and starch. B. angulatum is generally found in V-shaped arrangements and is a commensal part of the normal human gastrointestinal tract flora." ;
    flat:parents "C86194" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bifidobacterium angulatum|BIFIDOBACTERIUM ANGULATUM" ;
.

ncit:C86197
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86197" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86197>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase and indole negative and ferments only lactose and cellobiose. B. bifidum is a commensal part of the normal human gastrointestinal tract and vaginal flora and is used in the fermentation of dairy products and as a probiotic." ;
    flat:parents "C86194" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bifidobacterium bifidum|BIFIDOBACTERIUM BIFIDUM" ;
.

ncit:C86198
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86198" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86198>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species nonmotile, non-spore forming, catalase and indole negative, does not reduce nitrate and ferments arabinose, xylose, ribose, gluconate, cellobiose, lactose, mannitol, melezitose, salicin, and starch. B. dentium is an opportunistic pathogen associated with tooth decay." ;
    flat:parents "C86194" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bifidobacterium dentium|BIFIDOBACTERIUM DENTIUM|Bifidobacterium appendicitis|Bifidobacterium appendicitis" ;
.

ncit:C86199
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86199" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86199>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is nonmotile, nonsporeforming, catalase and indole negative and ferments arabinose, xylose, ribose, lactose and melezitose. B. longum is non-pathogenic, and it helps maintain a healthy digestive system." ;
    flat:parents "C86194" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bifidobacterium longum|BIFIDOBACTERIUM LONGUM" ;
.

ncit:C86200
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86200" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86200>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of anaerobic, Gram-negative, rod shaped bacterium assigned to the phylum Proteobacteria and the family Desulfovibrionaceae." ;
    flat:parents "C85931" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bilophila|BILOPHILA" ;
.

ncit:C86201
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86201" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86201>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of anaerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, non-spore forming, catalase positive, indole and lipase negative, stimulated by bile, reduces nitrate, produces hydrogen sulfide, does not hydrolyze starch or esculin, and most strains are urease positive. B. wadsworthia are pleomorphic rods with swollen ends and is associated with appendicitis." ;
    flat:parents "C86200" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bilophila wadsworthia|BILOPHILA WADSWORTHIA" ;
.

ncit:C86202
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86202" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86202>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram-negative, coccobacilli-shaped bacterium assigned to the phylum Proteobacteria and the family Alcaligenaceae." ;
    flat:parents "C85914" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bordetella|BORDETELLA" ;
.

ncit:C86203
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86203" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86203>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of strictly aerobic, Gram-negative, capsulated rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile using 5 to 8 peritrichous flagella, oxidase, urease, and indole negative, does not reduce nitrate, and does not hydrolyze esculin or gelatin. B. avium is found in avian species where it causes bordetellosis, but is nonpathogenic in humans." ;
    flat:parents "C86202" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bordetella avium|BORDETELLA AVIUM" ;
.

ncit:C86204
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86204" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86204>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is motile and urease positive in MIU culture media, oxidase, catalase, and citrate positive, indole negative, does not produce hydrogen sulfide and sodium citrate is its only carbon source B. bronchispetica is found in the respiratory tract of domestic and wild animals where it is pathogenic, but rarely is found in humans." ;
    flat:parents "C86202" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bordetella bronchiseptica|BORDETELLA BRONCHISEPTICA|Bordetella bronchicanis|Bordetella bronchicanis" ;
.

ncit:C86205
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86205" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86205>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, oxidase negative, urease and citrate positive, does not reduce nitrate, and grows on MacConkey agar. B. parapertussis is found in the respiratory tract of mammals where it usually causes a mild form of whooping cough." ;
    flat:parents "C86202" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Bordetella parapertussis|BORDETELLA PARAPERTUSSIS" ;
.

ncit:C86206
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86206" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86206>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram-negative, spiral shaped bacteria assigned to the phylum Spirochaetes and the family Spirochaetaceae." ;
    flat:parents "C85965" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Borrelia|BORRELIA" ;
.

ncit:C86207
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86207" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86207>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A taxonomic grouping of facultatively anaerobic, Gram-positive or Gram-variable, rod shaped bacteria that can be assigned to the genus Brevibacillus." ;
    flat:parents "C85908" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Brevibacillus|BREVIBACILLUS" ;
.

ncit:C86208
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86208" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86208>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-positive, Gram-negative or Gram-variable, rod shaped bacteria assigned to the phylum Firmicutes. This species is motile, catalase positive, indole negative, reduces nitrate, hydrolyzes casein and gelatin, but not starch or urea and forms spores with a distinct canoe shaped body that is attached to the side of the spore in a lateral position within the sporangium. B laterosporus is found in soil, water, insects and their larvae, and may be pathogenic in humans." ;
    flat:parents "C86207" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Brevibacillus laterosporus|BREVIBACILLUS LATEROSPORUS" ;
.

ncit:C86209
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86209" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86209>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria and the family Brevibacteriaceae." ;
    flat:parents "C85905" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Brevibacterium|BREVIBACTERIUM" ;
.

ncit:C86210
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86210" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86210>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, oxidase negative, does not reduce nitrate, but does hydrolyze gelatin and casein. B. casei has a distinctive cheese smell, is commonly found in milk products and on human skin, but is pathogenic and known to be associated with sepsis, meningitis, and peritonitis." ;
    flat:parents "C86209" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Brevibacterium casei|BREVIBACTERIUM CASEI" ;
.

ncit:C86211
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86211" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86211>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-positive, rod shaped bacteria assigned to the phylum Actinobacteria. This species is nonmotile, non-spore forming, catalase positive, oxidase negative, reduces nitrate and hydrolyzes gelatin and casein. B. epidermidis is a commensal part of human skin, but can be pathogenic in other locations." ;
    flat:parents "C86209" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Brevibacterium epidermidis|BREVIBACTERIUM EPIDERMIDIS" ;
.

ncit:C86212
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86212" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86212>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria and the family Caulobacteraceae." ;
    flat:parents "C85907" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Brevundimonas|BREVUNDIMONAS" ;
.

ncit:C86213
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86213" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86213>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile using a singular polar flagellum, oxidase and catalase positive, indole negative, does not reduce nitrates and does not hydrolyze esculin. B. diminuta is found in water and is pathogenic in humans." ;
    flat:parents "C86212" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Brevundimonas diminuta|BREVUNDIMONAS DIMINUTA|Pseudomonas diminuta|Pseudomonas diminuta" ;
.

ncit:C86214
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86214" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86214>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile using a singular polar flagellum, oxidase and catalase positive, indole negative, hydrolyzes esculin, but does not reduce nitrates. B. vesicularis is pathogenic in humans." ;
    flat:parents "C86212" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Brevundimonas vesicularis|BREVUNDIMONAS VESICULARIS|Pseudomonas vesicularis|Pseudomonas vesicularis" ;
.

ncit:C86215
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86215" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86215>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram-negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria and the family Brucellaceae." ;
    flat:parents "C85919" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Brucella|BRUCELLA" ;
.

ncit:C86216
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86216" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86216>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, non-spore forming, reduces nitrates, produces hydrogen sulfide, is positive for catalase, oxidase and urease, grows in basic fuchsin but not thionine, and is positive for Tiblisi and Weybridge phage lysis. B abortus is found in cattle where it causes abortions and causes brucellosis in humans." ;
    flat:parents "C86215" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Brucella abortus|BRUCELLA ABORTUS" ;
.

ncit:C86217
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86217" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86217>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, non-spore forming, reduces nitrates, does not produce hydrogen sulfide, positive for catalase, oxidase and urease, does not grow in thionine and may or may not grow in basic fuchsin, and is negative for Tiblisi and Weybridge phage lysis. B. canis is found in canines where it can cause abortions and causes brucellosis in humans." ;
    flat:parents "C86215" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Brucella canis|BRUCELLA CANIS" ;
.

ncit:C86218
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86218" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86218>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Established Names and Unique Ingredient Identifier Codes Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, non-spore forming, catalase, oxidase and urease positive, reduces nitrates, does not produce hydrogen sulfide, grows in both basic fuchsin and thionine, and is negative for Tiblisi and Weybridge phage lysis. B. melitensis is found in goats and sheep and is pathogenic to these species as well as causes brucellosis in humans." ;
    flat:parents "C86215" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Brucella melitensis|BRUCELLA MELITENSIS|BRUCELLA MELITENSIS" ;
.

ncit:C86219
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86219" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86219>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, coccobacilli shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, non-spore forming, catalase, oxidase and urease positive, reduces nitrates, produces hydrogen sulfide, grows in thionine, but not basic fuchsin, and is positive for Weybridge phage lysis, but negative for Tiblisi phage lysis. B. suis is found in swine and is pathogenic to these species as well as causes brucellosis in humans." ;
    flat:parents "C86215" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Brucella suis|BRUCELLA SUIS" ;
.

ncit:C86220
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86220" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86220>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria and the family Enterobacteriaceae." ;
    flat:parents "C85932" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Budvicia|BUDVICIA" ;
.

ncit:C86221
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86221" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86221>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is non-spore forming, non-encapsulated, oxidase and indole negative, catalase positive, reduces nitrates, hydrolyzes urea, but not esculin and is motile using a peritrichous flagella however, some strains can be nonmotile. B. aquatica is found in water and small mammals and is pathogenic to humans." ;
    flat:parents "C86220" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Budvicia aquatica|BUDVICIA AQUATICA" ;
.

ncit:C86222
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86222" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86222>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of aerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria and the family Burkholderiaceae." ;
    flat:parents "C85920" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Burkholderia|BURKHOLDERIA" ;
.

ncit:C86223
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86223" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86223>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is non-spore forming, motile, catalase and oxidase positive, indole negative and does not hydrolyze esculin or starch. B. cenocepacia is naturally found in soil, water and vegetation and is capable of degrading industrial waste, herbicides, and vegetation as well as producing many antibacterial and antifungal agents. In humans, this species is pathogenic and associated with cystic fibrosis." ;
    flat:parents "C86222" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Burkholderia cenocepacia|BURKHOLDERIA CENOCEPACIA" ;
.

ncit:C86224
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86224" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86224>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A non taxonomic grouping of bacteria assigned to and including at least nine related species from the Burkholderia genus." ;
    flat:parents "C86222" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Burkholderia cepacia Complex|BURKHOLDERIA CEPACIA COMPLEX" ;
.

ncit:C86225
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86225" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86225>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile, indole and oxidase negative, catalase positive, negative for lysine decarboxylation, and does not reduce nitrate. B. gladioli is found on the gladiolus plant where it is pathogenic, causes vegetation to decay, and is pathogenic to humans." ;
    flat:parents "C86222" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Burkholderia gladioli|BURKHOLDERIA GLADIOLI|Pseudomonas gladioli|Pseudomonas gladioli" ;
.

ncit:C86226
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86226" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86226>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is nonmotile, encapsulated, catalase positive, oxidase and indole negative, and hydrolyzes starch. B mallei is found in contaminated soil, causes Glanders disease in horses, mules, donkeys, and humans, and has been developed and used as a biological weapon by the Germans, Russians and Japanese." ;
    flat:parents "C86222" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Burkholderia mallei|Actinobacillus mallei|Actinobacillus mallei|BURKHOLDERIA MALLEI" ;
.

ncit:C86227
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86227" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86227>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram-negative, rod shaped bacteria assigned to the phylum Proteobacteria. This species is motile, non-spore forming, oxidase and catalase positive and indole negative. B. pseudomallei is found in contaminated soil, water, and produce and causes melioidosis in humans with the highest rate of disease occurring in southeast Asia." ;
    flat:parents "C86222" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Burkholderia pseudomallei|BURKHOLDERIA PSEUDOMALLEI|Burkholderia pseudomalle|Burkholderia pseudomalle|Pseudomonas pseudomallei|Pseudomonas pseudomallei" ;
.

ncit:C86228
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86228" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86228>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram-negative, bacilli assigned to the phylum Proteobacteria and the family Enterobacteriaceae." ;
    flat:parents "C85932" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Buttiauxella|BUTTIAUXELLA" ;
.

ncit:C86229
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86229" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86229>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, bacilli assigned to the phylum Proteobacteria. This species is motile using a peritrichous flagella, non-spore forming, oxidase negative, catalase positive, ferments sugar, reduces nitrate, and hydrolyzes esculin. B. agrestis is commensal in the throat and pathogenic in immunocompromised individuals with wound infections or appendicitis." ;
    flat:parents "C86228" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Buttiauxella agrestis|BUTTIAUXELLA AGRESTIS" ;
.

ncit:C86230
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86230" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86230>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of microaerophilic, Gram-negative, curved or spiral bacilli assigned to the phylum Proteobacteria. This species is motile with a single flagellum at each pole, non-spore forming, oxidase positive, and does not hydrolyze hippurate. C. coli is commensal in pigs, associated with indigenously acquired food borne disease, and recognized as the second most common pathogen for human campylobacteriosis." ;
    flat:parents "C76211" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Campylobacter coli|CAMPYLOBACTER COLI" ;
.

ncit:C86231
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86231" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86231>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of microaerophilic, Gram-negative, curved or spiral bacilli assigned to the phylum Proteobacteria. This species is motile with a single polar flagellum, non-spore forming, oxidase positive, catalase negative, indole negative, urease negative, reduces both nitrate and nitrite, but does not hydrolyze starch, gelatin, esculin or casein. C. concisus is normally found in the human oral cavity and is a commensal part of the normal flora of the human gastrointestinal tract, but is associated with gingival inflammation, periodontal lesions, Crohn's disease in immunodeficient patients, and is considered responsible for infective gastroenteritis and septicemia seen uniquely in children." ;
    flat:parents "C76211" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Campylobacter concisus|CAMPYLOBACTER CONCISUS|CDC Group EF-22" ;
.

ncit:C86232
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86232" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86232>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of microaerophilic, Gram-negative, curved or spiral bacilli assigned to the phylum Proteobacteria. This species is motile using a single polar flagellum, non-spore forming, oxidase positive, catalase negative and produces both formate and acetate. C. curvus, formerly known as Wolinella curva, is a rare pathogen associated with cases of bloody and Brainerd's diarrhea." ;
    flat:parents "C76211" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Campylobacter curvus|CAMPYLOBACTER CURVUS|Wolinella curva|Wolinella curva" ;
.

ncit:C86233
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86233" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86233>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of microaerophilic, Gram-negative, curved or spiral bacilli assigned to the phylum Proteobacteria. This species is motile using a single polar flagellum, oxidase positive, catalase positive, indole negative, reduces nitrates, and does not produce hydrogen sulfide. C. fetus is an opportunistic microbe that causes bacteremia, thrombophlebitis, septicemia, and is a suspected pathogen in immunocompromised patients with gastrointestinal symptoms. In sheep and cattle this bacterium is known to cause abortions, infertility, enteritis and bovine genital campylobacteriosis." ;
    flat:parents "C76211" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Campylobacter fetus|CAMPYLOBACTER FETUS|Vibrio fetus|Vibrio fetus" ;
.

ncit:C86234
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86234" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86234>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of microaerophilic, Gram-negative, straight bacilli assigned to the phylum Proteobacteria This species is nonmotile, non-spore forming, catalase negative, oxidase negative urease negative, indole negative, reduces nitrate and nitrite, but does not hydrolyze casein, starch or esculin. C. gracilis, known formerly as Bacteroides gracilis, is mostly found in deep tissue infections." ;
    flat:parents "C76211" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Campylobacter gracilis|Bacteroides gracilis|Bacteroides gracilis|CAMPYLOBACTER GRACILIS" ;
.

ncit:C86235
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86235" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86235>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|FDA Established Names and Unique Ingredient Identifier Codes Terminology" ;
    flat:definition "A species of microaerophilic, Gram-negative, curved or spiral bacilli assigned to the phylum Proteobacteria. This species is motile with a flagellum at each pole, non-spore forming, oxidase positive, and hydrolyzes hippurate. C. jejuni is the most common pathogen in the United States causing bacterial diarrhea and gastroenteritis and is also linked to Guillain Barre syndrome." ;
    flat:parents "C76211" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Campylobacter jejuni|CAMPYLOBACTER JEJUNI|CAMPYLOBACTER JEJUNI" ;
.

ncit:C86236
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86236" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86236>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of microaerophilic, Gram-negative, curved or spiral bacilli assigned to the phylum Proteobacteria. This species is motile using a single flagellum at each pole, non-spore forming, oxidase positive, catalase positive, reduces nitrate, produces hydrogen sulfide, and does not hydrolyze hippurate nor ferment glucose. C. lari is associated in recurrent gastroenteritis in children, causes septicemia and enteritis in immunodeficient patients and is commensal in healthy seagulls, birds, mussels and oysters." ;
    flat:parents "C76211" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Campylobacter lari|CAMPYLOBACTER LARI|Campylobacter laridis|Campylobacter laridis" ;
.

ncit:C86237
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86237" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86237>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of microaerophilic, Gram-negative, straight bacilli assigned to the phylum Proteobacteria This species is motile using a single polar flagellum, non-spore forming, catalase negative, oxidase negative urease negative, indole negative, reduces nitrate and nitrite, but does not hydrolyze casein, starch or esculin.  C. rectus, formerly known as Wolinella recta, is a periodontal pathogen causing chronic periodontitis and extraoral abscesses and has been associated with causing intrauterine fetal growth retardation." ;
    flat:parents "C76211" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Campylobacter rectus|CAMPYLOBACTER RECTUS|Wolinella recta|Wolinella recta" ;
.

ncit:C86238
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86238" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86238>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of microaerophilic, Gram-negative, curved or spiral bacilli assigned to the phylum Proteobacteria. This species is motile using a single polar or bipolar flagellum, non-spore forming, oxidase positive, catalase negative, reduces nitrate, but not nitrite, and does not hydrolyze hippurate nor produce hydrogen sulfide. C. upsaliensis is a pathogen associated with gastroenteritis, acute watery diarrhea, septicemia, abscesses, inflammatory bowel disease, periodontitis and bacteremia in normal hosts and in those with opportunistic infections in immunocompromised individuals or HIV infected patients." ;
    flat:parents "C76211" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Campylobacter upsaliensis|CAMPYLOBACTER UPSALIENSIS" ;
.

ncit:C86239
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86239" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86239>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, fusiform, filamentous bacilli assigned to the phylum Bacteroidetes. This species is motile, non-spore forming, oxidase positive catalase positive, indole and urease negative, reduces nitrite, but not nitrate, and hydrolyzes esculin. C. canimorsus can be transmitted to humans through dog or cat bites where the bacteria causes septicemia and meningitis in humans particularly individuals that have undergone a splenectomy or alcoholism." ;
    flat:parents "C76269" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Capnocytophaga canimorsus|CAPNOCYTOPHAGA CANIMORSUS|CDC Group DF-2" ;
.

ncit:C86240
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86240" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86240>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, fusiform, filamentous bacilli assigned to the phylum Bacteroidetes. This species is motile, non-spore forming, oxidase, catalase, and indole negative, does not hydrolyze esculin, nor produce hydrogen sulfide. C. gingivalis is part of the normal gingival flora in humans, but can cause periodontitis." ;
    flat:parents "C76269" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Capnocytophaga gingivalis|CAPNOCYTOPHAGA GINGIVALIS" ;
.

ncit:C86241
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86241" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86241>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, fusiform, filamentous bacilli assigned to the phylum Bacteroidetes. This species is motile, non-spore forming, oxidase, catalase, and indole negative, does not produce hydrogen sulfide and does not hydrolyze gelatin, or starch, but does hydrolyze esculin. C. ochracea is a member of the normal gingival flora but can become pathogenic causing sepsis especially in immunocompromised individuals." ;
    flat:parents "C76269" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Capnocytophaga ochracea|CAPNOCYTOPHAGA OCHRACEA" ;
.

ncit:C86242
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86242" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86242>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, fusiform, filamentous bacilli assigned to the phylum Bacteroidetes. This species is motile, non-spore forming, catalase, oxidase, urease and indole negative, reduces nitrate, hydrolyzes gelatin and does not produce hydrogen sulfide. C. sputigena is a member of the normal gingival flora but can become pathogenic causing sepsis especially in immunocompromised individuals." ;
    flat:parents "C76269" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Capnocytophaga sputigena|CAPNOCYTOPHAGA SPUTIGENA" ;
.

ncit:C86243
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86243" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86243>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram-negative, straight bacilli assigned to the phylum Proteobacteria and the family Cardiobacteriaceae." ;
    flat:parents "C85921" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Cardiobacterium|CARDIOBACTERIUM" ;
.

ncit:C86244
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86244" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86244>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, straight bacilli assigned to the phylum Proteobacteria. This species is nonmotile, non-spore forming, catalase negative, oxidase and indole positive, and does not reduce nitrate. C. hominis is commensal in the human nasal flora, but is associated with culture negative endocarditis after a dental procedure, especially in those with a pre-existing heart valve disorder or a prosthetic valve." ;
    flat:parents "C86243" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Cardiobacterium hominis|CARDIOBACTERIUM HOMINIS|CDC Group IID" ;
.

ncit:C86245
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86245" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86245>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of facultatively anaerobic, Gram-negative, bacilli assigned to the phylum Proteobacteria and the family Enterobacteriaceae." ;
    flat:parents "C85932" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Cedecea|CEDECEA" ;
.

ncit:C86246
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86246" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86246>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, bacilli assigned to the phylum Proteobacteria. This species is motile using 5 to 9 flagella, non-spore forming, catalase positive, oxidase negative, lipase positive, indole negative, ornithine decarboxylase positive, ferments sucrose, reduces nitrate, does not produce hydrogen sulfide, and only weakly hydrolyzes esculin. C. davisae is pathogenic to immunocompromised patients causing super infections and nosocomially acquired bacteremia." ;
    flat:parents "C86245" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Cedecea davisae|CDC Enteric Group 15|CEDECEA DAVISAE" ;
.

ncit:C86247
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86247" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86247>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, bacilli assigned to the phylum Proteobacteria. This species is motile, non-spore forming, catalase positive, oxidase negative, lipase positive, indole negative, ornithine decarboxylase negative, does not ferment sucrose, reduces nitrate, does not produce hydrogen sulfide, and hydrolyzes esculin. C. lapagei is pathogenic especially in immunocompromised patients." ;
    flat:parents "C86245" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Cedecea lapagei|CEDECEA LAPAGEI" ;
.

ncit:C86248
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
