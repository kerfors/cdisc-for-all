    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of parasitic nematodes in the family Ancylostomatidae. N. americanus can be passed person-to-person through contact with infested feces." ;
    flat:parents "C123426" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Necator americanus|NECATOR AMERICANUS" ;
.

