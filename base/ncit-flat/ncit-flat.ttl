ncit:C191036
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C191036" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C191036>" ;
    flat:concept%20in%20subset "CDISC Clinical Classification Category Terminology|CDISC Clinical Classification Terminology|CDISC QRS Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized clinical tool, published in 1980 by Harvey et al. as a simplified version of the Crohn Disease Activity Index (CDAI), that assesses and scores five patient parameters (well-being, abdominal pain, number of liquid or soft stools, abdominal mass, and complications) to stratify Crohn's disease severity." ;
    flat:parents "C118969" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Harvey-Bradshaw Index Clinical Classification|HBI|HBI|HBI01" ;
.

ncit:C191037
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C191037" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C191037>" ;
    flat:concept%20in%20subset "CDISC Clinical Classification Category Terminology|CDISC Clinical Classification Terminology|CDISC QRS Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized classification system adapted from the Vienne Classification in 2008 that stratifies patients with Crohn disease based on age at diagnosis, extent of disease, and disease behavior over time." ;
    flat:parents "C118969" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Montreal Classification for Crohn's Disease Clinical Classification|MCHR01|MONTREAL CLASSIFICATION CROHN'S|Montreal Classification" ;
.

ncit:C191038
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C191038" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C191038>" ;
    flat:concept%20in%20subset "CDISC Clinical Classification Category Terminology|CDISC Clinical Classification Terminology|CDISC QRS Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized scoring system originally developed in 2003 and modified in 2017 that utilizes quantitative radiological evaluation to assess the severity and disease response in perianal fistulizing Crohn disease." ;
    flat:parents "C118969" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Modified Van Assche Index Clinical Classification|MVAI|MVAI|MVAI1" ;
.

ncit:C191039
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C191039" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C191039>" ;
    flat:concept%20in%20subset "CDISC Clinical Classification Category Terminology|CDISC Clinical Classification Terminology|CDISC QRS Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized scoring system developed by Rutgeerts et al. in 1990 that is used to assess postoperative disease recurrence in patients that have undergone ileocecal resection as treatment for Crohn disease." ;
    flat:parents "C118969" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Rutgeerts Score Clinical Classification|RUTG01|RUTGEERTS SCORE|Rutgeerts Score" ;
.

ncit:C191040
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C191040" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C191040>" ;
    flat:concept%20in%20subset "CDISC Clinical Classification Category Terminology|CDISC Clinical Classification Terminology|CDISC QRS Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized index developed in 1978 by Fredriksson et al. that combines psoriasis disease severity (measured as erythema, infiltration, and desquamation) and body surface area involvement over 4 body regions (head, trunk, upper and lower extremities) to assess progress during treatment." ;
    flat:parents "C118969" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Psoriasis Area and Severity Index Fredriksson Version Clinical Classification|PASI FREDRIKSSON|PASI Fredriksson Version|PASI03" ;
.

ncit:C191041
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C191041" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C191041>" ;
    flat:concept%20in%20subset "CDISC Clinical Classification Category Terminology|CDISC Clinical Classification Terminology|CDISC QRS Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A standardized index developed in 2004 by the Committee for Medicinal Products for Human Use (CHMP) that combines psoriasis disease severity (measured as erythema, infiltration, and desquamation) and body surface area involvement over 4 body regions (head, trunk, upper and lower extremities) to assess progress during treatment." ;
    flat:parents "C118969" ;
    flat:semantic%20type "Intellectual Product" ;
    flat:synonyms "Psoriasis Area and Severity Index European Medical Agency Version Clinical Classification|PASI EMA|PASI EMA Version|PASI04" ;
.

ncit:C191042
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C191042" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C191042>" ;
