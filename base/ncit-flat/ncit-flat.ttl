    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13278>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|GDC Terminology|GDC Value Terminology|mCode Genomic Specimen Type Value Set|mCode Terminology" ;
