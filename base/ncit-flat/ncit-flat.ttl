    flat:parents "C85932" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Plesiomonas|PLESIOMONAS" ;
.

ncit:C86652
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C86652" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C86652>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of facultatively anaerobic, Gram-negative, rod shaped bacteria in the phylum Proteobacteria. This species is motile, oxidase, catalase, ornithine and lysine decarboxylase, and arginine dihydrolase positive, Voges-Proskauer test negative, reduces nitrate, but does not hydrolyze urea or liquefy gelatin. P. shigelloides is naturally found in fresh water and other marine environments as well as on their inhabitants and causes gastroenteritis in humans and other types of infections in immunocompromised individuals." ;
    flat:parents "C86651" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Plesiomonas shigelloides|Aeromonas shigelloides|Aeromonas shigelloides|PLESIOMONAS SHIGELLOIDES" ;
.

