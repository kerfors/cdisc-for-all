    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C142243>" ;
    flat:concept%20in%20subset "CDISC SDTM Cardiovascular Test Code Terminology|CDISC SDTM Cardiovascular Test Name Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "The left ventricular mass divided by the subject's body surface area." ;
    flat:parents "C112025|C100084" ;
    flat:semantic%20type "Diagnostic Procedure" ;
    flat:synonyms "Left Ventricular Mass Index|LVMASIDX" ;
.

