    flat:synonyms "Improved|Better|IMPROVED|It improved" ;
.

ncit:C12547
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C12547" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12547>" ;
    flat:concept%20in%20subset "CDISC SDTM Specimen Type Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology|CTRP Biomarker Terminology|CTRP Terminology" ;
    flat:definition "Large, phagocytic mononuclear leukocytes produced in the vertebrate bone marrow and released into the blood; contain a large, oval or somewhat indented nucleus surrounded by voluminous cytoplasm and numerous organelles." ;
    flat:display%20name "Monocyte" ;
    flat:parents "C12529" ;
    flat:semantic%20type "Cell" ;
    flat:synonyms "Monocyte|MONOCYTE|Monocytes|monocyte" ;
.

