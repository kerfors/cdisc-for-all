    flat:definition "An image of blood vessels constructed using magnetic resonance imaging." ;
    flat:display%20name "MRI-Based Angiogram" ;
    flat:parents "C16290" ;
    flat:semantic%20type "Laboratory or Test Result" ;
    flat:synonyms "MRI-Based Angiogram|MAGNETIC RESONANCE ANGIOGRAPHY|MRA|MRA|Magnetic Resonance Angiogram" ;
.

