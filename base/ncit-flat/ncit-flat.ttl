    flat:parents "C13031" ;
    flat:semantic%20type "Body Part, Organ, or Organ Component" ;
    flat:synonyms "Temporal Lobe|Brain, Temporal lobe|TEMPORAL LOBE|Temporal lobe|Temporal lobe structure (body structure)|temporal lobe" ;
.

ncit:C123530
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123530" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123530>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of unicellular obligate parasitic fungi in the family Nosematidae. Most species within this genus are limited to a specific insect or other arthropod host. Nosema apis is a cause of colony collapse in honeybees." ;
    flat:parents "C123335" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Nosema|NOSEMA" ;
.

ncit:C123531
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123531" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123531>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of soil fungi in the family Myxotrichaceae with dark, erect conidiophores that terminate in an irregular system of tree-like branches . Species within the genus are commonly isolated from wood, wood pulp, and soil. They are not known to pose a health hazard to humans." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Oidiodendron|OIDIODENDRON" ;
.

ncit:C123532
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123532" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123532>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of fungi in the subphylum Pezizomycotina with species grouped within orders Sordariales, Hypocreales, and Eurotiales. Some species within these genera cause opportunistic infections and allergic disorders in humans." ;
    flat:parents "C77167" ;
    flat:semantic%20type "Fungus" ;
    flat:synonyms "Paecilomyces|PAECILOMYCES" ;
.

ncit:C123533
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123533" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123533>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of Gram-positive, motile, spore-forming bacteria in the family Paenibacillaceae. P. glucanolyticus is positive for catalase, hydrolysis of carboxymethyl cellulose, and hydrolysis of starch. It is negative for hydrolysis of chitin and urea. The species is native to soil." ;
    flat:parents "C123336" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Paenibacillus glucanolyticus|Bacillus glucanolyticus|PAENIBACILLUS GLUCANOLYTICUS" ;
.

ncit:C123534
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123534" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123534>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of aerobic, Gram negative, rod shaped bacterium in the family Burkholderiaceae. This species is positive for catalase, growth on Drigalsky agar, growth in 0.5 and 1.5% NaCl, assimilation of d-gluconate, l-malate and phenylacetate, acid and alkaline phosphatase, and leucine arylamidase activity. P. apista is found in the soil and also in the sputum of cystic fibrosis patients." ;
    flat:parents "C86629" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Pandoraea apista|PANDORAEA APISTA" ;
.

ncit:C123535
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123535" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123535>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of obligately anaerobic, non-spore-forming, non-motile, Gram negative, rod-shaped bacterium in the family Porphyromonadaceae. This species is negative for urease and nitrate reduction. Acid is produced from cellobiose, glucose, rhamnose, sucrose, trehalose and xylose, but not from arabinose or xylan. P. goldsteinii was isolated from human clinical specimens of intestinal origin." ;
    flat:parents "C86633" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Parabacteroides goldsteinii|Bacteroides goldsteinii|PARABACTEROIDES GOLDSTEINII" ;
.

ncit:C123536
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C123536" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C123536>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A species of obligately anaerobic, non-spore-forming, non-motile, Gram negative, rod-shaped bacterium in the family Porphyromonadaceae. This species is negative for urease, indole, catalase, and digestion of gelatin; mannose and raffinose are fermented. P. johnsonii was isolated from human feces." ;
    flat:parents "C86633" ;
    flat:semantic%20type "Bacterium" ;
    flat:synonyms "Parabacteroides johnsonii|PARABACTEROIDES JOHNSONII" ;
.

ncit:C123537
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
