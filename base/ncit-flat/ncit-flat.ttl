    flat:parents "C123338" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Fasciolopsis" ;
.

ncit:C122023
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122023" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122023>" ;
    flat:concept%20in%20subset "CDISC SDTM Microorganism Terminology|CDISC SDTM Terminology|Clinical Data Interchange Standards Consortium Terminology" ;
    flat:definition "A genus of parasitic nematodes in the family Gnathostomatidae. The Gnathostoma lifecycle involves copepods as the first intermediate host; fish, frogs, or snakes as the second intermediate host; and pigs, cats, dogs, or wild animals as its natural definitive host. Humans may become infested by eating infested fish or fowl. Infestation causes gnathostomiasis." ;
    flat:parents "C14248" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Gnathostoma|GNATHOSTOMA" ;
.

ncit:C122024
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122024" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122024>" ;
    flat:definition "The taxanomic phylum of flatworms. Flatworms have simple bilateral symmetry, are unsegmented, soft-bodied, and have no body cavity and no specialized circulatory or respiratory organs." ;
    flat:parents "C14182" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Platyhelminthes|Platyhelminth" ;
.

ncit:C122025
    a <https://kerfors.github.io/cdisc-for-all/def/ncit-flat#Thesaurus> ;
    flat:code "C122025" ;
    flat:concept%20IRI "<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C122025>" ;
    flat:definition "A genus of cyclophyllid tapeworms in the family Taeniidae. The definitive hosts for echinococcus are carnivorous predators; humans become by zoonotic transfer. Infection with Echinococcus results in hydatid disease, also known as echinococcosis." ;
    flat:parents "C122045" ;
    flat:semantic%20type "Animal" ;
    flat:synonyms "Echinococcus" ;
.

