    cosmos_bc:shortName "Direct Bilirubin Measurement" ;
    cosmos_bc:synonyms
        "BILDIR" ,
        "Conjugated Bilirubin + Albumin-Bound Bilirubin" ,
        "Conjugated Bilirubin + Delta Bilirubin" ,
        "Direct Bilirubin" ;
.

