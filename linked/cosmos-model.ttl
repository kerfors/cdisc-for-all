r2:C74563
    a cosmos_bc:BiomedicalConcept ;
    cosmos_bc:categories "Subject Characteristics" ;
    cosmos_bc:conceptId "C74563" ;
    cosmos_bc:dataElementConcepts
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C74563/C25372> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C74563/C70856> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C74563/C82515> ;
    cosmos_bc:definition "A classification system used by dermatologists to determine a person's risk for sunburn. The classification is based on the skin complexion and the degree of tolerance to sun exposure and it relates to the amount of melanin pigment in the skin. It was developed by Dr. Thomas Fitzpatrick in 1975 to determine patient's skin reaction to laser and light therapy treatments. According to this system, there are six skin varieties classified from I to VI." ;
    cosmos_bc:ncitCode "C74563" ;
    cosmos_bc:packageDate "2026-07-14" ;
    cosmos_bc:parentConceptId "C74562" ;
    cosmos_bc:resultScales "Ordinal" ;
    cosmos_bc:shortName "Fitzpatrick Classification Scale" ;
    cosmos_bc:synonyms
        "Fitzpatrick Classification Scale" ,
        "Fitzpatrick Skin Classification" ,
        "Fitzpatrick Skin Phototype" ,
        "Fitzpatrick Skin Type System" ,
        "SKINCLAS" ,
        "Skin Classification" ;
.

