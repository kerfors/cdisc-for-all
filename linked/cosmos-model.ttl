r2:C191040
    a cosmos_bc:BiomedicalConcept ;
    cosmos_bc:categories
        "Clinical or Research Assessment Classification" ,
        "PASI FREDRIKSSON" ,
        "PASI03" ,
        "Psoriasis Area and Severity Index Fredriksson Version Clinical Classification" ,
