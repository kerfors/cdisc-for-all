r2:C160723
    a cosmos_bc:BiomedicalConcept ;
    cosmos_bc:categories
        "Disease Response" ,
        "Tumor Results" ;
    cosmos_bc:conceptId "C160723" ;
    cosmos_bc:dataElementConcepts
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C160723/C171435> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C160723/C25372> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C160723/C25692> ,
