r2:C17241
    a cosmos_bc:BiomedicalConcept ;
    cosmos_bc:categories "Laboratory Tests" ;
    cosmos_bc:conceptId "C17241" ;
    cosmos_bc:definition "Laboratory analysis of urine, commonly used to aid in the diagnosis of disease or to detect the presence of a specific substance. It involves examination of the urine by physical or chemical means as well as microscopic examination that helps to screen for urinary tract infections, renal disease, and diseases of other organs, that result in abnormal metabolites (break-down products) appearing in the urine." ;
    cosmos_bc:ncitCode "C17241" ;
    cosmos_bc:packageDate "2025-04-01" ;
    cosmos_bc:parentConceptId "C49237" ;
    cosmos_bc:shortName "Urinalysis" ;
    cosmos_bc:synonyms
        "UA" ,
        "Urine Test" ;
.

