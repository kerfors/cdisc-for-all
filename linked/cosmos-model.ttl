        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C16818/C171000> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C16818/C25185> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C16818/C25372> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C16818/C25692> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C16818/C54215> ;
    cosmos_bc:definition "A type of radiography used specifically to examine breast tissue. The procedure utilizes a low-dose of x-rays or radiation to generate an image. A mammography exam or mammogram, is used as a screening tool to detect early breast cancer in women experiencing no symptoms and to detect and diagnose breast disease." ;
    cosmos_bc:ncitCode "C16818" ;
    cosmos_bc:packageDate "2025-09-23" ;
    cosmos_bc:parentConceptId "C16502" ;
    cosmos_bc:resultScales "Nominal" ;
    cosmos_bc:shortName "Mammography" ;
    cosmos_bc:synonyms "MG" ;
.

r2:C17007
    a cosmos_bc:BiomedicalConcept ;
    cosmos_bc:categories
        "Diagnostic Imaging" ,
        "Medical Imaging" ,
        "Tomography" ;
    cosmos_bc:conceptId "C17007" ;
    cosmos_bc:dataElementConcepts
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C17007/C117511> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C17007/C117512> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C17007/C117529> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C17007/C117530> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C17007/C127786> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C17007/C13717> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C17007/C171000> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C17007/C25185> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C17007/C25372> ,
        <https://kerfors.github.io/cdisc-for-all/id/cosmos/cdisc_biomedical_concepts_latest/C17007/C25692> ;
    cosmos_bc:definition "A technique for measuring the gamma radiation produced by collisions of electrons and positrons (anti-electrons) within living tissue. In positron emission tomography (PET), a subject is given a dose of a positron-emitting radionuclide attached to a metabolically active substance (for example, 2-fluoro-2-deoxy-D-glucose (FDG), which is similar to a naturally occurring sugar, glucose, with the addition of a radioactive fluorine atom). When living tissue containing the positron emitter is bombarded by electrons, gamma radiation produced by collisions of electrons and positrons is detected by a scanner, revealing in fine detail the tissue location of the metabolically-active substance administered." ;
    cosmos_bc:ncitCode "C17007" ;
    cosmos_bc:packageDate "2026-07-14" ;
    cosmos_bc:parentConceptId "C38093" ;
    cosmos_bc:resultScales "Nominal" ;
    cosmos_bc:shortName "Positron Emission Tomography" ;
    cosmos_bc:synonyms
        "PET" ,
        "PET Scan" ;
.

