PREFIX cat: <https://kerfors.github.io/cdisc-for-all/catalog#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX spdx: <http://spdx.org/rdf/terms#>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

cat:catalog
    a dcat:Catalog ;
    dcterms:description "CDISC and NCIt content as published, linked: the base graphs (one per source, as published), the link graphs, the COSMoS model graph, Link_Check (the SHACL validation report) and the SSSOM mapping set." ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:title "cdisc-for-all" ;
    rdfs:seeAlso <https://github.com/kerfors/cdisc-for-all> ;
    dcat:dataset
        cat:sssom ,
        <https://kerfors.github.io/cdisc-for-all/check/link-check> ,
        <https://kerfors.github.io/cdisc-for-all/graph/by-rule> ,
        <https://kerfors.github.io/cdisc-for-all/graph/cosmos> ,
        <https://kerfors.github.io/cdisc-for-all/graph/cosmos-model> ,
        <https://kerfors.github.io/cdisc-for-all/graph/links> ,
        <https://kerfors.github.io/cdisc-for-all/graph/nci-code-cui-map> ,
        <https://kerfors.github.io/cdisc-for-all/graph/ncit-flat> ,
        <https://kerfors.github.io/cdisc-for-all/graph/nsv-registry> ,
        <https://kerfors.github.io/cdisc-for-all/graph/sdtm-ct> ,
        <https://kerfors.github.io/cdisc-for-all/graph/sdtm-model> ,
        <https://kerfors.github.io/cdisc-for-all/graph/sdtmig> ,
        <https://kerfors.github.io/cdisc-for-all/graph/sdtmig-fragments> ,
        <https://kerfors.github.io/cdisc-for-all/graph/vocabulary> ;
    dcat:landingPage <https://kerfors.github.io/cdisc-for-all/> ;
.

