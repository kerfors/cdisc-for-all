<https://kerfors.github.io/cdisc-for-all/catalog#linkset/sdtmig_variable_to_model_variable>
    a void:Linkset ;
    dcterms:accessRights "Built locally, not published: it starts from or ends at a sign-in source." ;
    dcterms:description "An SDTMIG variable row to the SDTM Model variable row it is an instance of." ;
    dcterms:title "sdtmig variable to model variable" ;
    dcterms:type "by rule" ;
    void:linkPredicate <https://kerfors.github.io/cdisc-for-all/rule/sdtmig/SDTMIG#Variable%20Name/sdtm-model/SDTM> ;
    void:objectsTarget <https://kerfors.github.io/cdisc-for-all/graph/sdtm-model> ;
    void:subjectsTarget <https://kerfors.github.io/cdisc-for-all/graph/sdtmig> ;
    rdfs:comment "Rule: The first that matches: the Model row with the same Class, Dataset Name and Variable Name; else the Model row without a Dataset Name, with the same Class, whose Variable Name is the general name (the IG Variable Name with its Dataset Name prefix replaced by \"--\", or the Variable Name itself if it does not start with the Dataset Name); else the same for Class General Observations; for Class Findings About, else the same for Class Findings." ;
.

